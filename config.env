# POMPPC — configuration de la baseline QEMU mac99 / Mac OS X 10.4 PPC
# Sourcé par tous les scripts. Modifie ici, pas dans les scripts.

# --- Binaire QEMU ---
# "qemu-system-ppc" (paquet distro) pour la baseline.
# Plus tard, pointer vers un build source pour hacker le JIT :
#   QEMU_BIN=/home/gistarcade/src/qemu/build/qemu-system-ppc
# Build source (pour profiling + patchs). Repli sur le paquet distro si absent.
QEMU_BIN="${QEMU_BIN:-/home/gistarcade/src/qemu/build/qemu-system-ppc}"

# --- Machine émulée ---
# mac99 = Power Mac G4 (New World). via=pmu => contrôleur PMU, requis par OS X.
MACHINE="mac99,via=pmu"
CPU="g4"          # 7400/7410. Altivec présent (crucial pour OS X).
RAM_MB="1024"     # OpenBIOS/OF instables au-delà de ~1.5G. 1024 = sûr pour 10.4.
SMP="1"           # BASELINE = monoprocesseur. Le SMP OpenPIC viendra plus tard.

# --- Affichage ---
# Framebuffer logiciel (pas d'accel). Résolution passée à OpenFirmware.
RES="1024x768x32"

# --- Fichiers ---
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DISK="$ROOT/disks/tiger.qcow2"
DISK_SIZE="16G"

# Image d'installation Tiger PPC — À FOURNIR PAR TOI (tu dois la posséder).
# Dépose ton ISO/DMG ici et ajuste le nom :
INSTALL_MEDIA="$ROOT/images/MacOSX.4.iso"

# --- Réseau ---
# sungem = Sun GEM, OS X 10.4 a le driver natif. user-mode NAT, aucun privilège requis.
# NONET=1 pour désactiver (utile si le binaire n'a pas SLIRP compilé).
NETDEV="user,id=net0"
NETNIC="sungem,netdev=net0"
if [ -n "${NONET:-}" ]; then
  NET_ARGS=()
else
  NET_ARGS=(-netdev "$NETDEV" -device "$NETNIC")
fi
