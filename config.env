# POMPPC — configuration de la baseline QEMU mac99 / Mac OS X 10.4 PPC
# Sourcé par tous les scripts. Modifie ici, pas dans les scripts.

# --- Binaire QEMU ---
# Par défaut : le build source (profiling, patchs, device qfb-pci, SMP mac99),
# à l'emplacement que produit scripts/build_qemu_qfb.sh ($HOME/src/qemu).
# Repli automatique sur le paquet distro s'il est absent — suffisant pour la
# baseline, mais run_tiger.sh/run_os9.sh ont besoin du build source (Screamer,
# OpenBIOS unifié, qfb-pci). Pour forcer un autre binaire :
#   QEMU_BIN=/chemin/vers/qemu-system-ppc ./run_tiger.sh
# ${HOME:-} : les scripts tournent sous 'set -u', ne pas exploser si HOME manque (cron).
QEMU_SRC_BIN="${QEMU_SRC_BIN:-${HOME:-}/src/qemu/build/qemu-system-ppc}"
if [ -z "${QEMU_BIN:-}" ]; then
  if [ -x "$QEMU_SRC_BIN" ]; then
    QEMU_BIN="$QEMU_SRC_BIN"
  else
    QEMU_BIN="$(command -v qemu-system-ppc || echo "$QEMU_SRC_BIN")"
  fi
fi

# --- Machine émulée ---
# mac99 = Power Mac G4 (New World). via=pmu => contrôleur PMU, requis par OS X.
MACHINE="mac99,via=pmu"
CPU="g4"          # 7400/7410. Altivec présent (crucial pour OS X).
RAM_MB="1024"     # OpenBIOS/OF instables au-delà de ~1.5G. 1024 = sûr pour 10.4.
SMP="1"           # Défaut des scripts de baseline (scripts/*.sh) = monoprocesseur.
                  # run_tiger.sh lance 2 cœurs (MTTCG + bring-up GPIO KeyLargo) ;
                  # OS 9 reste mono-cœur. SMP=N surcharge run_tiger.sh.

# --- Affichage ---
# Framebuffer logiciel (pas d'accel). Résolution passée à OpenFirmware.
RES="1024x768x32"

# --- Fichiers ---
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DISK="$ROOT/disks/tiger.qcow2"
DISK_SIZE="16G"

# Image d'installation Tiger PPC — À FOURNIR PAR TOI (tu dois la posséder).
# Dépose ton ISO/DMG dans images/ (créer le dossier) et ajuste le nom :
INSTALL_MEDIA="${INSTALL_MEDIA:-$ROOT/images/MacOSX.4.iso}"

# --- Mac OS 9 (run_os9.sh) ---
# Disque OS 9 et CD d'installation 9.2.2 — le CD est À FOURNIR PAR TOI aussi.
# Dépose-le dans disks/ ou pointe-le ailleurs :  OS9_CD=/chemin/os9.iso ./run_os9.sh
OS9_DISK="${OS9_DISK:-$ROOT/disks/os9.qcow2}"
OS9_DISK_SIZE="8G"
OS9_CD="${OS9_CD:-$ROOT/disks/os9-install.iso}"

# --- Réseau ---
# sungem = Sun GEM, OS X 10.4 a le driver natif. user-mode NAT, aucun privilège requis.
# NONET=1 pour désactiver (utile si le binaire n'a pas SLIRP compilé).
NETDEV="user,id=net0"
NETNIC="sungem,netdev=net0"
if [ -n "${NONET:-}" ]; then
  NET_ARGS=()
else
  NET_ARGS=(-netdev "$NETDEV" -device "$NETNIC")
fi
