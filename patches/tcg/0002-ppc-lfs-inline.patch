+/*
+ * x-lfs-inline: helper_todouble() (the ISA's DOUBLE, fpu_helper.c) as
+ * branch-free integer ops.  u = the float32 bits, zero-extended.
+ *
+ *   abs = u & 0x7fffffff, sign = (u ^ abs) << 32
+ *   k   = max(clz64(abs), 40)        40 for normals, Inf and NaN;
+ *                                    40 + s for a denormal (the helper's
+ *                                    shift s = clz32 - 8, 1..23); 64 for 0
+ *   m   = abs << (k - 11)            fraction; a denormal's msb lands on
+ *                                    bit 52 (the helper's 29 + s)
+ *   e   = (936 - k) << 52            exponent bias: 896 for normals
+ *                                    (1023 - 127), 896 - s for a denormal,
+ *                                    whose msb then adds the implicit 1
+ *   e   = 0x700 << 52  if abs >= 0x7f800000   (Inf/NaN: 0xff + 0x700 =
+ *                                    0x7ff, fraction kept, sNaN not quieted)
+ *   e   = 0            if abs == 0   (m is 0 too: signed zero)
+ *   ret = (m + e) | sign
+ *
+ * All shift counts stay in [29, 53]: no out-of-range TCG shift.  Proof:
+ * POMPPC tools/tcg/lfsproof.c (all 2^32 inputs against the helper's code).
+ */
+static void gen_todouble_inline(TCGv_i64 dest, TCGv_i64 u)
+{
+    TCGv_i64 abs = tcg_temp_new_i64();
+    TCGv_i64 sign = tcg_temp_new_i64();
+    TCGv_i64 k = tcg_temp_new_i64();
+    TCGv_i64 m = tcg_temp_new_i64();
+    TCGv_i64 e = tcg_temp_new_i64();
+
+    tcg_gen_andi_i64(abs, u, 0x7fffffff);
+    tcg_gen_xor_i64(sign, u, abs);
+    tcg_gen_shli_i64(sign, sign, 32);
+    tcg_gen_clzi_i64(k, abs, 64);
+    tcg_gen_umax_i64(k, k, tcg_constant_i64(40));
+    tcg_gen_subi_i64(m, k, 11);
+    tcg_gen_shl_i64(m, abs, m);
+    tcg_gen_subfi_i64(e, 936, k);
+    tcg_gen_shli_i64(e, e, 52);
+    tcg_gen_movcond_i64(TCG_COND_GEU, e, abs, tcg_constant_i64(0x7f800000),
+                        tcg_constant_i64(0x700ull << 52), e);
+    tcg_gen_movcond_i64(TCG_COND_EQ, e, abs, tcg_constant_i64(0),
+                        tcg_constant_i64(0), e);
+    tcg_gen_add_i64(dest, m, e);
+    tcg_gen_or_i64(dest, dest, sign);
+}
+
+/*
+ * x-lfs-inline: helper_tosingle() (the ISA's SINGLE: no rounding, the
+ * fraction is truncated) as branch-free integer ops.  x = the float64 bits.
+ *
+ *   exp = x[62:52]
+ *   exp > 896 (single-precision normal range and above, Inf, NaN, and the
+ *              out-of-range exponents the ISA leaves undefined, done the
+ *              same way as the helper):
+ *     hi = x[63:62] << 30 | x[58:29]
+ *   else (denormal result for 874 <= exp <= 896, signed zero below):
+ *     lo = x[63] << 31 | ((1 << 52 | x[51:0]) >> min(926 - exp, 63))
+ *          926 - exp is 30..926 here; a shift of 53 or more leaves 0,
+ *          which is the helper's signed zero for exp < 874
+ *   ret = exp > 896 ? hi : lo        only the low 32 bits are stored
+ *
+ * Proof: POMPPC tools/tcg/lfsproof.c (every sign/exponent/top-20-fraction
+ * crossed with low words, plus edge cases, against the helper's code).
+ */
+static void gen_tosingle_inline(TCGv_i64 dest, TCGv_i64 x)
+{
+    TCGv_i64 exp = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 sh = tcg_temp_new_i64();
+
+    tcg_gen_extract_i64(exp, x, 52, 11);
+    tcg_gen_shri_i64(hi, x, 29);
+    tcg_gen_shri_i64(t, x, 62);
+    tcg_gen_deposit_i64(hi, hi, t, 30, 2);
+    tcg_gen_andi_i64(lo, x, (1ull << 52) - 1);
+    tcg_gen_ori_i64(lo, lo, 1ull << 52);
+    tcg_gen_subfi_i64(sh, 926, exp);
+    tcg_gen_umin_i64(sh, sh, tcg_constant_i64(63));
+    tcg_gen_shr_i64(lo, lo, sh);
+    tcg_gen_shri_i64(t, x, 32);
+    tcg_gen_andi_i64(t, t, 0x80000000);
+    tcg_gen_or_i64(lo, lo, t);
+    tcg_gen_movcond_i64(TCG_COND_GTU, dest, exp, tcg_constant_i64(896),
+                        hi, lo);
+}
+
 static void gen_qemu_ld32fs(DisasContext *ctx, TCGv_i64 dest, TCGv addr)
 {
-    TCGv_i32 tmp = tcg_temp_new_i32();
+    TCGv_i32 tmp;
+
+    if (ctx->lfs_inline) {
+        TCGv_i64 u = tcg_temp_new_i64();
+        tcg_gen_qemu_ld_i64(u, addr, ctx->mem_idx, DEF_MEMOP(MO_UL));
+        gen_todouble_inline(dest, u);
+        return;
+    }
+    tmp = tcg_temp_new_i32();
     tcg_gen_qemu_ld_i32(tmp, addr, ctx->mem_idx, DEF_MEMOP(MO_UL));
     gen_helper_todouble(dest, tmp);
 }
