+/*
+ * POMPPC tcg/0043: fill slot @h of the jump cache with @tb for @pc.  With
+ * x-jc-2way, a valid previous occupant of h moves to h ^ 1 (same page
+ * group), with its mmu_idx (logged there for x-jc-idx), unless h ^ 1 holds
+ * a valid entry whose own slot it is: an entry at home is never pushed out
+ * by another slot's overflow, so a pattern without conflict in the one-way
+ * cache keeps all its hits.  A TB invalidated meanwhile by another thread
+ * carries CF_INVALID and never matches again, wherever it sits
+ * (tb_jmp_cache_inval_tb clears both ways).
+ */
+static inline void tb_jmp_cache_fill(CPUState *cpu, CPUJumpCache *jc,
+                                     uint32_t h, vaddr pc,
+                                     TranslationBlock *tb)
+{
+#ifndef CONFIG_USER_ONLY
+    if (tb_jmp_cache_2way) {
+        TranslationBlock *old = qatomic_read(&jc->array[h].tb);
+        TranslationBlock *nb = qatomic_read(&jc->array[h ^ 1].tb);
+
+        if (old && old != tb && !(tb_cflags(old) & CF_INVALID) &&
+            (!nb || (tb_cflags(nb) & CF_INVALID) ||
+             tb_jmp_cache_hash_func(jc->array[h ^ 1].pc) != (h ^ 1))) {
+            jc->array[h ^ 1].pc = jc->array[h].pc;
+            tb_jmp_cache_set_idx(jc, h ^ 1, jc->idx[h]);
+            qatomic_set(&jc->array[h ^ 1].tb, old);
+        }
+    }
+#endif
+    jc->array[h].pc = pc;
+#ifndef CONFIG_USER_ONLY
+    tb_jmp_cache_set_idx(jc, h, cpu_mmu_index(cpu, true)); /* tcg/0008 */
+#endif
+    qatomic_set(&jc->array[h].tb, tb);
+}
