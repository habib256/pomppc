diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -25,6 +25,17 @@
 #define TB_JMP_CACHE_MAX (1 << TB_JMP_CACHE_MAX_BITS)
 extern unsigned tb_jmp_cache_bits;
 extern bool tb_jmp_cache_word; /* fixed before CPU realize, x-jc-word */
+/*
+ * POMPPC tcg/0043 (x-jc-2way, accelerator property, fixed before CPU
+ * realize): a pc is looked for in slot h then in slot h ^ 1, which is in
+ * the same page group (tb_jmp_cache_clear_page and the per-mmu_idx log of
+ * x-jc-idx stay exact); a new entry goes to h and the previous occupant of
+ * h moves to h ^ 1 unless an entry at home sits there; a hit in h ^ 1 is
+ * swapped into h.  The inline probe of x-ret-inline checks h only (an
+ * inline second probe slowed the hit path down): the second way is looked
+ * at by tb_lookup, from helper_lookup_tb_ptr, before the hash table.
+ */
+extern bool tb_jmp_cache_2way;
 extern bool tb_jmp_cache_bits_frozen;
 #define TB_JMP_CACHE_SIZE (1u << tb_jmp_cache_bits)
 
