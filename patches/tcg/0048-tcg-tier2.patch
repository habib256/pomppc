+        if (r->spr[i] != env->spr[i]) {
+            snprintf(why, whylen, "spr %d trace 0x" TARGET_FMT_lx " blocs 0x"
+                     TARGET_FMT_lx, i, r->spr[i], env->spr[i]);
+            return true;
+        }
+    }
