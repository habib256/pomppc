                 break;
             }
 
+            if (unlikely(cpu->t2_pending)) {
+                t2_form(cpu);           /* POMPPC tcg/0048 */
+                last_tb = NULL;
+            }
+
             tb = tb_lookup(cpu, s, 0);
             if (tb == NULL) {
                 CPUJumpCache *jc;
@@ -1274,6 +1775,18 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 last_tb = NULL;
