+static bool t2_continue(DisasContext *ctx, int slot, target_ulong dest)
+{
+    if (NARROW_MODE(ctx)) {
+        dest = (uint32_t)dest;
+    }
+    dest &= ~3;
+    if (!ctx->base.t2_path || ctx->singlestep_flags ||
+        ctx->t2_nexit >= T2_MAX_PATH ||
+        !translator_t2_continue(&ctx->base, ctx->base.pc_next, dest, slot)) {
+        return false;
+    }
