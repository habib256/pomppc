+/*
+ * POMPPC tcg/0048 (x-tier2): second level, without a compiler.
+ *
+ * A TB counts its executions (gen_t2_counter); at the x-tier2-th one,
+ * helper_t2_hot() records it in cpu->t2_pending and requests an exit, so
+ * that the main loop sees it within a TB or two.  There, t2_form() follows
+ * the direct exits that TCG chained (jmp_dest[0]: branch taken or
+ * unconditional, jmp_dest[1]: fall through), the more executed successor
+ * first, while it stays in the page of the hot TB, until it would revisit
+ * a TB, run out of chained successors or pass T2 limits; then it throws
+ * the hot TB away and translates the path again as ONE TB, a "trace"
+ * (TB->t2_state = T2_TRACE): the target's translator does not stop at the
+ * branches of the path (translator_t2_continue) and turns their other side
+ * into a side exit.  Same TCG ops as the TBs it is made of, one prologue,
+ * guest registers kept in host registers across the former TB boundaries
+ * (TCG syncs them at each side exit), no goto_tb between them.  The trace
+ * replaces the hot TB in the hash table (same pc, flags, cflags): chained
+ * callers are unlinked by the invalidation and chain to it next time;
+ * code modification and tb_flush throw it away like any TB (it covers
+ * its whole page for invalidation).
+ */
+enum {
+    T2S_ASK, T2S_FORM, T2S_DROP, T2S_SHORT, T2S_TBS, T2S_INSNS, T2S_GONE,
+    T2S_VRUN, T2S_VOK, T2S_VBAD, T2S_VSKIP, T2S_VEXC, T2S_VNOLOG, T2S_VACC,
+    T2S_CUT, T2S_LCUT, T2S_N
+};
+static uint64_t t2_g[T2S_N];
+static bool t2_atexit_done;
+
+static void t2_report(void)
+{
+    if (!t2_g[T2S_ASK]) {
+        return;
+    }
+    fprintf(stderr, "x-tier2 : %" PRIu64 " demandes, %" PRIu64 " traces "
+            "(%" PRIu64 " blocs, %" PRIu64 " instructions invité), %" PRIu64
+            " écartées (contexte changé ou bloc invalidé), %" PRIu64
+            " sans suite chaînée, %" PRIu64 " raccourcies (coupées par TCG)\n",
+            t2_g[T2S_ASK], t2_g[T2S_FORM], t2_g[T2S_TBS], t2_g[T2S_INSNS],
+            t2_g[T2S_DROP] + t2_g[T2S_GONE], t2_g[T2S_SHORT], t2_g[T2S_CUT]);
+    if (t2_g[T2S_VRUN]) {
+        fprintf(stderr, "x-tier2-verify : %" PRIu64 " traces vérifiées, "
+                "%" PRIu64 " identiques, %" PRIu64 " DIVERGENCES, %" PRIu64
+                " non vérifiables (atomique, base de temps, journal plein), "
+                "%" PRIu64 " exceptions, %" PRIu64 " sans copie journalisée "
+                "(%" PRIu64 " copies coupées par TCG) ; %" PRIu64
+                " accès rejoués\n",
+                t2_g[T2S_VRUN], t2_g[T2S_VOK], t2_g[T2S_VBAD],
+                t2_g[T2S_VSKIP], t2_g[T2S_VEXC], t2_g[T2S_VNOLOG],
+                t2_g[T2S_LCUT], t2_g[T2S_VACC]);
+    }
+}
+
+/*
+ * x-tier2-verify=N: one trace entry in N is checked.  The trace is run in
+ * its "log" copy (same path, CF_T2_LOG: every guest access logged, no
+ * chaining, no exit check): that run is the real one.  Then the registers
+ * go back to the entry state and the TBs the trace was made of are run in
+ * their "replay" copies (CF_T2_REPLAY: loads return the logged values in
+ * order, stores are compared with the log and not done) until the log is
+ * consumed and the guest pc is where the trace left; the registers must
+ * then be those the trace left, which are put back.  Traces are neither
+ * chained to nor put in the jump cache in this mode, so that every entry
+ * goes through the main loop.
+ */
+#define T2_LOG_MAX 4096
+typedef struct T2Log {
+    uint32_t n, pos;
+    bool overflow, unverif, diverged;
+    char why[160];
+    struct {
+        uint64_t addr, val;
+        uint32_t memop, st;
+    } e[T2_LOG_MAX];
+    void *e0, *e1;
+} T2Log;
+
+void HELPER(t2_log)(CPUArchState *env, uint64_t addr, uint64_t val,
+                    uint32_t memop, uint32_t st)
+{
+    T2Log *l = env_cpu(env)->t2_log;
+
+    if (!l || !env_cpu(env)->t2_vrun) {
+        return;
+    }
+    if (l->n >= T2_LOG_MAX) {
+        l->overflow = true;
+        return;
+    }
+    l->e[l->n].addr = addr;
+    l->e[l->n].val = val;
+    l->e[l->n].memop = memop;
+    l->e[l->n].st = st;
+    l->n++;
+}
+
+static void t2_diverge(T2Log *l, const char *what, uint64_t addr,
+                       uint64_t val, uint32_t memop)
+{
+    if (!l->diverged) {
+        l->diverged = true;
+        snprintf(l->why, sizeof(l->why),
+                 "%s : accès %u/%u adresse 0x%" PRIx64 " valeur 0x%" PRIx64
+                 " memop 0x%x", what, l->pos, l->n, addr, val, memop);
+    }
+}
+
+uint64_t HELPER(t2_rld)(CPUArchState *env, uint64_t addr, uint32_t memop)
+{
+    T2Log *l = env_cpu(env)->t2_log;
+
+    if (l->pos >= l->n) {
+        t2_diverge(l, "lecture en trop", addr, 0, memop);
+        return 0;
+    }
+    if (l->e[l->pos].st || l->e[l->pos].addr != addr ||
+        l->e[l->pos].memop != memop) {
+        t2_diverge(l, "lecture différente", addr, 0, memop);
+    }
+    return l->e[l->pos++].val;
+}
+
+void HELPER(t2_rst)(CPUArchState *env, uint64_t addr, uint64_t val,
+                    uint32_t memop)
+{
+    T2Log *l = env_cpu(env)->t2_log;
+
+    if (l->pos >= l->n) {
+        t2_diverge(l, "écriture en trop", addr, val, memop);
+        return;
+    }
+    if (!l->e[l->pos].st || l->e[l->pos].addr != addr ||
+        l->e[l->pos].memop != memop || l->e[l->pos].val != val) {
+        t2_diverge(l, "écriture différente", addr, val, memop);
+    }
+    l->pos++;
+}
+
+/* replay: a TB of the path starts; consume the trace's marker for it */
+void HELPER(t2_rmark)(CPUArchState *env, uint64_t pc)
+{
+    T2Log *l = env_cpu(env)->t2_log;
+
+    /* (the head TB of the trace has no marker: a mismatch is left alone,
+     * and a wrong path shows as an unconsumed log at the end) */
+    if (l->pos < l->n && l->e[l->pos].memop == T2_MARK &&
+        l->e[l->pos].addr == pc) {
+        l->pos++;
+    }
+}
+
+/*
+ * Something the log cannot stand for: an atomic, the time base, or a guest
+ * access the log does not see (t2_foreign_access).  In the logged run (the
+ * real one) it is done and the check is given up; in the replay it must
+ * not be done at all (memory would be touched twice, a store with the
+ * registers of the entry): the replay is abandoned, the cleanup of
+ * cpu_exec puts back the state the trace left.
+ */
+static void t2_unverif(CPUState *cpu)
+{
+    T2Log *l = cpu->t2_log;
+
+    if (l && cpu->t2_vrun) {
+        l->unverif = true;
+        if (cpu->t2_vrun == 2) {
+            cpu_loop_exit(cpu);
+        }
+    }
+}
+
+void HELPER(t2_unverif)(CPUArchState *env)
+{
+    t2_unverif(env_cpu(env));
+}
+
+void t2_foreign_access(CPUState *cpu)
+{
+    /* POMPPC_T2_MUTANT=3: the defect of 21/10 (tools/tcg/t2proof.sh) */
+    static int mutant = -1;
+
+    if (mutant < 0) {
+        mutant = getenv("POMPPC_T2_MUTANT") ? atoi(getenv("POMPPC_T2_MUTANT")) : 0;
+    }
+    if (mutant != 3) {
+        t2_unverif(cpu);
+    }
+}
+
+#define T2_VFLAGS (CF_NOIRQ | CF_NO_GOTO_TB | CF_NO_GOTO_PTR)
+
+static TranslationBlock *QEMU_DISABLE_CFI
+t2_exec_one(CPUState *cpu, TranslationBlock *tb)
+{
+    uintptr_t ret;
+
+    qemu_thread_jit_execute();
+    ret = tcg_qemu_tb_exec(cpu_env(cpu), tb->tc.ptr);
+    cpu->neg.can_do_io = true;
+    return tcg_splitwx_to_rw((void *)(ret & ~TB_EXIT_MASK));
+}
+
+/* Returns false if the trace was not run (the caller runs it). */
+static bool t2_verify(CPUState *cpu, TCGTBCPUState s, TranslationBlock *trace)
+{
+#ifndef CONFIG_USER_ONLY
+    T2Log *l = cpu->t2_log;
+    TCGTBCPUState sl = s;
+    TranslationBlock *lt;
+    vaddr end_pc;
+    char why[160];
+    int steps;
+    static int nreport;
+    vaddr rpc[8];
+
+    if (!cpu->t2_regs) {
+        return false;
+    }
+    if (!l) {
+        l = cpu->t2_log = g_new0(T2Log, 1);
+        l->e0 = g_malloc0(cpu->t2_regs_size);
+        l->e1 = g_malloc0(cpu->t2_regs_size);
+    }
+    sl.cflags |= CF_T2_LOG | T2_VFLAGS;
+    lt = tb_htable_lookup(cpu, sl);
+    if (!lt || lt->t2_state != T2_TRACE) {
+        qatomic_add(&t2_g[T2S_VNOLOG], 1);
+        return false;
+    }
+    qatomic_add(&t2_g[T2S_VRUN], 1);
+    cpu->t2_regs(cpu, l->e0, 0, NULL, 0);
+    l->n = l->pos = 0;
+    l->overflow = l->unverif = l->diverged = false;
+    cpu->t2_vrun = 1;                   /* an exception here is real */
+    t2_exec_one(cpu, lt);
+    cpu->t2_vrun = 0;
+    end_pc = cpu->cc->tcg_ops->get_tb_cpu_state(cpu).pc;
+    cpu->t2_regs(cpu, l->e1, 0, NULL, 0);
+    if (l->overflow || l->unverif) {
+        qatomic_add(&t2_g[T2S_VSKIP], 1);
+        return true;
+    }
+
+    /* replay the TBs the trace was made of, from the entry state */
+    cpu->t2_regs(cpu, l->e0, 1, NULL, 0);
+    l->pos = 0;
+    for (steps = 0; steps < T2_MAX_PATH + 8; steps++) {
+        TCGTBCPUState sr = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+        TranslationBlock *rt;
+
+        if (steps && l->pos == l->n && sr.pc == end_pc) {
+            break;
+        }
+        if (steps < 8) {
+            rpc[steps] = sr.pc;
+        }
+        if (sr.flags != s.flags || l->diverged) {
+            t2_diverge(l, "contexte changé", sr.pc, 0, 0);
+            break;
+        }
+        sr.cflags = curr_cflags(cpu) | CF_T2_REPLAY | T2_VFLAGS;
+        rt = tb_htable_lookup(cpu, sr);
+        if (!rt) {
+            mmap_lock();
+            rt = tb_gen_code(cpu, sr);
+            mmap_unlock();
+        }
+        cpu->t2_vrun = 2;
+        t2_exec_one(cpu, rt);
+        cpu->t2_vrun = 0;
+    }
+    if (!l->diverged && steps == T2_MAX_PATH + 8) {
+        t2_diverge(l, "pas de fin", end_pc, 0, 0);
+    }
+    if (!l->diverged && l->pos != l->n) {
+        t2_diverge(l, "accès manquants", 0, 0, 0);
+    }
+    qatomic_add(&t2_g[T2S_VACC], l->pos);
+    if (!l->diverged && cpu->t2_regs(cpu, l->e1, 2, why, sizeof(why))) {
+        l->diverged = true;
+        snprintf(l->why, sizeof(l->why), "registres : %s", why);
+    }
+    if (l->diverged) {
+        qatomic_add(&t2_g[T2S_VBAD], 1);
+        if (qatomic_fetch_inc(&nreport) < 30) {
+            fprintf(stderr, "x-tier2-verify : DIVERGENCE trace 0x%" VADDR_PRIx
+                    " (%u instructions, sortie 0x%" VADDR_PRIx ") : %s ; blocs",
+                    trace->pc, trace->icount, end_pc, l->why);
+            for (int k = 0; k < steps && k < 8; k++) {
+                fprintf(stderr, " 0x%" VADDR_PRIx, rpc[k]);
+            }
+            fprintf(stderr, " ; journal");
+            for (uint32_t k = 0; k < l->n && k < 24; k++) {
+                fprintf(stderr, " %c%" PRIx64, l->e[k].memop == T2_MARK ? '>' :
+                        l->e[k].st ? 'w' : 'r', l->e[k].addr);
+            }
+            fprintf(stderr, "\n");
+        }
+    } else {
+        qatomic_add(&t2_g[T2S_VOK], 1);
+    }
+    cpu->t2_regs(cpu, l->e1, 1, NULL, 0);      /* the real state */
+    return true;
+#else
+    return false;
+#endif
+}
+
+void HELPER(t2_hot)(CPUArchState *env, void *ptb)
+{
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb = ptb;
+
+    if (tb->t2_state != T2_NONE || cpu->t2_pending) {
+        return;
+    }
+    tb->t2_state = T2_ASKED;
+    cpu->t2_pending = tb;
+    qatomic_add(&t2_g[T2S_ASK], 1);
+    if (!qatomic_xchg(&t2_atexit_done, true)) {
+        atexit(t2_report);
+    }
+    /* leave the chain at the next TB start (cleared by cpu_handle_interrupt) */
+    qatomic_set(&cpu->neg.icount_decr.u16.high, -1);
+}
+
+#define T2_MAX_INSNS 384
+
+static TranslationBlock *t2_dest(TranslationBlock *tb, int n)
+{
+    return (TranslationBlock *)(qatomic_read(&tb->jmp_dest[n]) & ~(uintptr_t)1);
+}
+
+static void t2_form(CPUState *cpu)
+{
+#ifndef CONFIG_USER_ONLY
+    TranslationBlock *a = cpu->t2_pending, *cur, *seen[T2_MAX_PATH + 1];
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    T2Path path = { .n = 0 };
+    int nseen = 0, insns = 0;
+    vaddr page;
+
+    cpu->t2_pending = NULL;
+    s.cflags = curr_cflags(cpu);
+    /*
+     * Translate in the context the TB was hot in: same flags (MSR, mode)
+     * and the same physical page for its pc under the current MMU state.
+     */
+    if ((tb_cflags(a) & CF_INVALID) || a->flags != s.flags ||
+        a->cs_base != s.cs_base || tb_cflags(a) != s.cflags ||
+        (tb_cflags(a) & CF_PCREL) || tb_page_addr1(a) != -1 ||
+        get_page_addr_code(cpu_env(cpu), a->pc) != tb_page_addr0(a)) {
+        qatomic_add(&t2_g[T2S_DROP], 1);
+        return;
+    }
+    page = a->pc & TARGET_PAGE_MASK;
+    cur = a;
+    seen[nseen++] = a;
+    insns = a->icount;
+    while (path.n < T2_MAX_PATH && path.n < cpu->t2_maxtb) {
+        TranslationBlock *d0 = t2_dest(cur, 0), *d1 = t2_dest(cur, 1);
+        TranslationBlock *nx;
+        int slot, i;
+
+        if (d0 && (!d1 || d0->t2_count >= d1->t2_count)) {
+            nx = d0;
+            slot = 0;
+        } else if (d1) {
+            nx = d1;
+            slot = 1;
+        } else {
+            break;
+        }
+        if ((nx->pc & TARGET_PAGE_MASK) != page || nx->flags != a->flags ||
+            nx->cs_base != a->cs_base || tb_cflags(nx) != s.cflags ||
+            tb_page_addr1(nx) != -1 || nx->t2_state == T2_TRACE ||
+            insns + nx->icount > T2_MAX_INSNS) {
+            break;
+        }
+        for (i = 0; i < nseen && seen[i] != nx; i++) {
+        }
+        if (i < nseen) {
+            break;              /* back to a TB of the path: a loop exit */
+        }
+        path.e[path.n].end = cur->pc + cur->size;
+        path.e[path.n].next = nx->pc;
+        path.e[path.n].slot = slot;
+        path.n++;
+        seen[nseen++] = nx;
+        insns += nx->icount;
+        cur = nx;
+    }
+    if (path.n == 0) {
+        qatomic_add(&t2_g[T2S_SHORT], 1);
+        return;
+    }
+
+    s.pc = a->pc;
+    mmap_lock();
+    tb_phys_invalidate(a, -1);
+    for (;;) {
+        int k, sum;
+
+        cpu->t2_path = &path;
+        cur = tb_gen_code(cpu, s);
+        cpu->t2_path = NULL;
+        if (cur->t2_state != T2_TRACE) {
+            break;
+        }
+        for (k = 0, sum = seen[0]->icount;
+             k < path.n && sum + seen[k + 1]->icount <= cur->icount; k++) {
+            sum += seen[k + 1]->icount;
+        }
+        if (sum == cur->icount) {
+            /*
+             * The trace ends where a TB of its path ends: all of it, or it
+             * stopped where TB k stopped (an instruction that ends a TB
+             * without a branch: isync, mtmsr...).  Checkable as it is.
+             */
+            path.n = k;
+            insns = sum;
+            break;
+        }
+        /*
+         * TCG cut the trace inside one of its TBs: tb_gen_code halves
+         * max_insns when a TB runs out of temps or of host code space.
+         * Such a trace runs correctly, but the replay of x-tier2-verify
+         * (whole TBs) cannot stop where it ends: translate it again with
+         * the TBs of the path that fit.  Cut inside its first TB (only the
+         * logged copy could be, normally): kept as is, not checked.
+         */
+        qatomic_add(&t2_g[T2S_CUT], 1);
+        if (k == 0) {
+            insns = -1;
+            break;
+        }
+        tb_phys_invalidate(cur, -1);
+        path.n = k;
+        insns = sum;
+    }
+    mmap_unlock();
+    /*
+     * x-tier2-verify: the logged copy must be the same path, of the same
+     * length (its access logging uses more temps and code: if TCG cuts it
+     * shorter than the trace, it is thrown away and the trace is not
+     * checked).
+     */
+    if (cur->t2_state == T2_TRACE && cpu->t2_verify && cur->icount == insns) {
+        TCGTBCPUState sl = s;
+        TranslationBlock *lt;
+
+        sl.cflags |= CF_T2_LOG | T2_VFLAGS;
+        mmap_lock();
+        cpu->t2_path = &path;
+        lt = tb_gen_code(cpu, sl);
+        cpu->t2_path = NULL;
+        if (lt->t2_state == T2_TRACE && lt->icount != cur->icount) {
+            tb_phys_invalidate(lt, -1);
+            qatomic_add(&t2_g[T2S_LCUT], 1);
+        }
+        mmap_unlock();
+    }
+    if (cur->t2_state == T2_TRACE) {
+        qatomic_add(&t2_g[T2S_FORM], 1);
+        qatomic_add(&t2_g[T2S_TBS], path.n + 1);
+        qatomic_add(&t2_g[T2S_INSNS], cur->icount);
+    } else {
+        qatomic_add(&t2_g[T2S_GONE], 1);
+    }
+#endif
+}
+
 /* Return the current PC from CPU, which may be cached in TB. */
 static vaddr log_pc(CPUState *cpu, const TranslationBlock *tb)
 {
@@ -795,6 +1274,23 @@ static void cpu_exec_longjmp_cleanup(CPUState *cpu)
 {
     /* Non-buggy compilers preserve this; assert the correct value. */
     g_assert(cpu == current_cpu);
+    cpu->t2_path = NULL;        /* POMPPC tcg/0048: a trace cut short */
+    if (cpu->t2_vrun) {
+        /*
+         * x-tier2-verify: an exception in the logged run of a trace is
+         * real (state restored from that TB); one in the replay cannot
+         * come from the guest's own path: put back the trace's result.
+         */
+        T2Log *l = cpu->t2_log;
+        bool replay = cpu->t2_vrun == 2;
+
+        cpu->t2_vrun = 0;
+        qatomic_add(&t2_g[replay && l->unverif ? T2S_VSKIP : T2S_VEXC], 1);
+        if (replay) {
+            cpu->t2_regs(cpu, l->e1, 1, NULL, 0);
+            cpu->exception_index = -1;
+        }
+    }
 
 #ifdef CONFIG_USER_ONLY
     clear_helper_retaddr();
