 }
 
 /*
@@ -378,8 +387,97 @@ void check_tlb_flush(CPUPPCState *env, bool global)
 
     /* Then handle local ones */
     if (env->tlb_need_flush & TLB_NEED_LOCAL_FLUSH) {
-        env->tlb_need_flush &= ~TLB_NEED_LOCAL_FLUSH;
+        env->tlb_need_flush &= ~(TLB_NEED_LOCAL_FLUSH | TLB_NEED_SR_CHECK);
         tlb_flush(cs);
+        if (env->sr_tlb) {
+            /* every mmu_idx is empty: any segment set describes it */
+            ppc_sr_tlb_rebase(env);
+        }
+        return;
+    }
+
+    /* x-sr-tlb: segment registers changed since the last sync point */
+    if (env->tlb_need_flush & TLB_NEED_SR_CHECK) {
+        env->tlb_need_flush &= ~TLB_NEED_SR_CHECK;
+        ppc_sr_tlb_check(env);
+    }
+}
+
+/*
+ * x-sr-tlb (32-bit hash MMU).  The two translated mmu_idx of a 32-bit
+ * Book S CPU are 0 (MSR[PR] = 1) and 1 (MSR[PR] = 0); 2 and 3 are real mode,
+ * where segment registers play no part.  See the invariant in cpu.h.
+ */
+static inline bool sr_snap_equal(CPUPPCState *env, int i)
+{
+    return env->sr_snap_gen[i] == env->sr_gen ||
+           !memcmp(env->sr_snap[i], env->sr, sizeof(env->sr_snap[i]));
+}
+
+/* Called with the TLB of every mmu_idx empty (synchronous local flush). */
+void ppc_sr_tlb_rebase(CPUPPCState *env)
+{
+    for (int i = 0; i < 2; i++) {
+        memcpy(env->sr_snap[i], env->sr, sizeof(env->sr_snap[i]));
+        env->sr_snap_gen[i] = env->sr_gen;
+        env->sr_snap_ok[i] = true;
+    }
+}
+
+/*
+ * A TLB entry of mmu_idx is about to be filled with the current segment
+ * registers.  If they differ from the set the mmu_idx is tagged with, its
+ * entries become mixed: the tag is dropped and the next check flushes it.
+ */
+void ppc_sr_tlb_fill(CPUPPCState *env, int mmu_idx)
+{
+    if (mmu_idx > 1 || !env->sr_snap_ok[mmu_idx]) {
+        return;
+    }
+    if (env->sr_snap_gen[mmu_idx] == env->sr_gen) {
+        return;
+    }
+    if (sr_snap_equal(env, mmu_idx)) {
+        env->sr_snap_gen[mmu_idx] = env->sr_gen;
+    } else {
+        env->sr_snap_ok[mmu_idx] = false;
+    }
+}
+
+/*
+ * Sync point, or MSR change: the translated mmu_idx the CPU is going to use
+ * (instruction and data side) must describe the current segment registers.
+ * Those that do not are flushed, then tagged with the current set.  The
+ * other one is left alone until it is used again: its entries only matter
+ * once the CPU switches back to it, which goes through here.
+ */
+void ppc_sr_tlb_check(CPUPPCState *env)
+{
+    uint16_t flush = 0;
+    int idx[2] = { ppc_env_mmu_index(env, true), ppc_env_mmu_index(env, false) };
+
+    for (int k = 0; k < 2; k++) {
+        int i = idx[k];
+        if (i > 1 || (flush & (1 << i))) {
+            continue;
+        }
+        if (env->sr_snap_ok[i] && sr_snap_equal(env, i)) {
+            env->sr_snap_gen[i] = env->sr_gen;
+            if (env->sr_verify && !(env->tlb_need_flush &
+                                    (TLB_NEED_LOCAL_FLUSH | TLB_NEED_GLOBAL_FLUSH)) &&
+                ++env->sr_verify_n >= env->sr_verify) {
+                env->sr_verify_n = 0;
+                ppc_sr_tlb_verify(env, i);
+            }
+            continue;
+        }
+        flush |= 1 << i;
+        memcpy(env->sr_snap[i], env->sr, sizeof(env->sr_snap[i]));
+        env->sr_snap_gen[i] = env->sr_gen;
+        env->sr_snap_ok[i] = true;
+    }
+    if (flush) {
+        tlb_flush_by_mmuidx(env_cpu(env), flush);
     }
 }
 #endif /* !CONFIG_USER_ONLY */
