+/*
+ * x-sr-tlb-verify: the entries an x-sr-tlb check keeps (where the stock code
+ * would have flushed them) must translate, now, to the physical page they
+ * hold.  Each valid entry of mmu_idx (main table and victim table) is
+ * re-translated by ppc_xlate(); a different page, or no translation, is a
+ * divergence.  ppc_xlate() may set the PTE's R bit, as the refill after a
+ * flush would: proof mode only.
+ */
+static void sr_verify_entry(CPUPPCState *env, int mmu_idx,
+                            CPUTLBEntry *e, CPUTLBEntryFull *full)
+{
+    PowerPCCPU *cpu = env_archcpu(env);
+    MMUAccessType t;
+    uint64_t a;
+    hwaddr raddr;
+    int psize, prot;
+
+    if (!(e->addr_read & TLB_INVALID_MASK)) {
+        a = e->addr_read; t = MMU_DATA_LOAD;
+    } else if (!(e->addr_code & TLB_INVALID_MASK)) {
+        a = e->addr_code; t = MMU_INST_FETCH;
+    } else if (!(e->addr_write & TLB_INVALID_MASK)) {
+        a = e->addr_write; t = MMU_DATA_STORE;
+    } else {
+        return;
+    }
+    a &= TARGET_PAGE_MASK;
+    env->sr_verify_entries++;
+    if (!ppc_xlate(cpu, a, t, &raddr, &psize, &prot, mmu_idx, false) ||
+        (raddr & TARGET_PAGE_MASK) != (full->phys_addr & TARGET_PAGE_MASK)) {
+        if (env->sr_verify_bad++ < 20) {
+            /*
+             * Another CPU that has just invalidated the PTE may not have
+             * reached its tlbie/sync yet: until it does, a stale entry is
+             * architecturally usable here.  Report what the others have
+             * pending, to tell that window from a real divergence.
+             */
+            CPUState *o;
+            uint32_t others = 0;
+            CPU_FOREACH(o) {
+                if (o != env_cpu(env)) {
+                    others |= cpu_env(o)->tlb_need_flush;
+                }
+            }
+            fprintf(stderr, "x-sr-tlb-verify: DIVERGENCE cpu %d idx %d ea 0x%"
+                    PRIx64 " tlb 0x%" HWADDR_PRIx " now 0x%" HWADDR_PRIx
+                    " (other CPUs pending flush 0x%x)\n",
+                    env_cpu(env)->cpu_index, mmu_idx, a, full->phys_addr,
+                    raddr, others);
+        }
+    }
+}
+
+void ppc_sr_tlb_verify(CPUPPCState *env, int mmu_idx)
+{
+    CPUState *cs = env_cpu(env);
+    CPUTLBDescFast *f = &cs->neg.tlb.f[mmu_idx];
+    CPUTLBDesc *d = &cs->neg.tlb.d[mmu_idx];
+    size_t n = (f->mask >> CPU_TLB_ENTRY_BITS) + 1;
+
+    for (size_t j = 0; j < n; j++) {
+        sr_verify_entry(env, mmu_idx, &f->table[j], &d->fulltlb[j]);
+    }
+    for (size_t j = 0; j < CPU_VTLB_SIZE; j++) {
+        sr_verify_entry(env, mmu_idx, &d->vtable[j], &d->vfulltlb[j]);
+    }
+    if ((++env->sr_verify_runs & 0x3ff) == 0) {
+        fprintf(stderr, "x-sr-tlb-verify: cpu %d, %" PRIu64 " checks kept, "
+                "%" PRIu64 " entries re-translated, %" PRIu64 " divergent\n",
+                cs->cpu_index, env->sr_verify_runs, env->sr_verify_entries,
+                env->sr_verify_bad);
+    }
+}
+
 bool ppc_cpu_tlb_fill(CPUState *cs, vaddr eaddr, int size,
                       MMUAccessType access_type, int mmu_idx,
                       bool probe, uintptr_t retaddr)
@@ -1367,6 +1463,9 @@ bool ppc_cpu_tlb_fill(CPUState *cs, vaddr eaddr, int size,
 
     if (ppc_xlate(cpu, eaddr, access_type, &raddr,
