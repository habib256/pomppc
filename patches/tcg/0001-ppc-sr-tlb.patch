diff --git a/target/ppc/cpu.h b/target/ppc/cpu.h
index f03c04e99..ec52bd6f2 100644
--- a/target/ppc/cpu.h
+++ b/target/ppc/cpu.h
@@ -1281,6 +1281,33 @@ struct CPUArchState {
     uint32_t tlb_need_flush; /* Delayed flush needed */
 #define TLB_NEED_LOCAL_FLUSH   0x1
 #define TLB_NEED_GLOBAL_FLUSH  0x2
+#define TLB_NEED_SR_CHECK      0x4  /* segment registers changed (x-sr-tlb) */
+    /*
+     * "Segment-tagged TLB" mode (x-sr-tlb property, 32-bit hash MMU only).
+     * A segment register write no longer flushes the whole softmmu TLB at
+     * the next context synchronisation: each translated mmu_idx (0 = user,
+     * 1 = supervisor) remembers the segment register set its entries were
+     * filled under (sr_snap), and is flushed only when it is about to be used
+     * under a different set.  Invariant, for i in {0, 1}:
+     *   sr_snap_ok[i]  =>  every TLB entry of mmu_idx i was filled while
+     *                      env->sr[0..15] == sr_snap[i][0..15].
+     * sr_gen counts segment register changes; sr_snap_gen[i] == sr_gen means
+     * sr_snap[i] was last seen equal to env->sr (no compare needed).
+     * See ppc_sr_tlb_fill() and ppc_sr_tlb_check() in mmu_helper.c.
+     */
+    bool sr_tlb;
+    bool sr_snap_ok[2];
+    uint32_t sr_gen;
+    uint32_t sr_snap_gen[2];
+    target_ulong sr_snap[2][16];
+    /*
+     * x-sr-tlb-verify=N (proof mode, N > 0): every Nth time a check keeps an
+     * mmu_idx instead of flushing it, re-translate each of its valid entries
+     * from the page table and compare the physical page (stderr summary).
+     */
+    uint32_t sr_verify;
+    uint32_t sr_verify_n;
+    uint64_t sr_verify_runs, sr_verify_entries, sr_verify_bad;
 #endif
 
     /* Other registers */
