+/*
+ * POMPPC tcg/0060: drop the jump cache entries of any TB that may overlap
+ * @page (pc on it, or on the previous page and crossing into it).  Stock
+ * clears the two page groups whole (x-jc-clear-exact off).  Only the owning
+ * CPU writes its entries, as in tb_jmp_cache_clear_page.
+ */
+static void tb_jmp_cache_clear_tb_page(CPUState *cpu, vaddr page)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    vaddr prev = page - TARGET_PAGE_SIZE;
+    bool exact = tb_jmp_cache_clear_exact;
+    bool count = cpu->ret_verify;
+    uint64_t n = 0, other = 0;
+
+    if (unlikely(!jc)) {
+        return;
+    }
+    if (!exact && !count) {
+        tb_jmp_cache_clear_page(cpu, prev);
+        tb_jmp_cache_clear_page(cpu, page);
+        return;
+    }
+    for (int g = 0; g < 2; g++) {
+        vaddr p = g ? page : prev;
+        unsigned i0 = tb_jmp_cache_hash_page(p);
+
+        for (unsigned i = i0; i < i0 + TB_JMP_PAGE_SIZE; i++) {
+            TranslationBlock *tb = qatomic_read(&jc->array[i].tb);
+            vaddr pc = jc->array[i].pc;
+            bool hit;
+
+            if (!tb) {
+                continue;
+            }
+            hit = (pc & TARGET_PAGE_MASK) == page ||
+                  ((pc & TARGET_PAGE_MASK) == prev &&
+                   ((pc + tb->size - 1) & TARGET_PAGE_MASK) != prev);
+            n++;
+            other += !hit;
+            if (hit || !exact) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+        }
+    }
+    if (count) {
+        qatomic_inc(&pomppc_jc_clr[0]);
+        qatomic_add(&pomppc_jc_clr[1], n);
+        qatomic_add(&pomppc_jc_clr[2], other);
+    }
+}
