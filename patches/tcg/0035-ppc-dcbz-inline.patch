+    if (ctx->dcbz_inline) {
+        /*
+         * POMPPC tcg/0035 (x-dcbz-inline).  helper_dcbz: line = EA & ~31;
+         * the reservation is dropped if it covers the line (before the
+         * access, as the helper does: also on a fault); probe_write of the
+         * line, then memset, or four cpu_stq_mmu of zero on I/O.  A 32-byte
+         * aligned line never crosses a page: the first store faults (at the
+         * line, as a store, as the probe does) or none does.  The four
+         * stores are those of the I/O path; in RAM the bytes are the same.
+         */
+        TCGv line = tcg_temp_new();
+        TCGv t = tcg_temp_new();
+        TCGv_i64 zero = tcg_constant_i64(0);
+
+        tcg_gen_andi_tl(line, tcgv_addr, ~(target_ulong)31);
+        tcg_gen_andi_tl(t, cpu_reserve, ~(target_ulong)31);
+        tcg_gen_movcond_tl(TCG_COND_EQ, cpu_reserve, t, line,
+                           tcg_constant_tl(-1), cpu_reserve);
+        for (int i = 0; i < 32; i += 8) {
+            tcg_gen_addi_tl(t, line, i);
+            tcg_gen_qemu_st_i64(zero, t, ctx->mem_idx,
+                                DEF_MEMOP(MO_UQ | MO_UNALN));
+        }
+        if (ctx->dcbz_verify) {
+            gen_helper_dcbz_verify(tcg_env, tcgv_addr);
+        }
+        return;
+    }
     gen_helper_dcbz(tcg_env, tcgv_addr, tcg_constant_i32(ctx->mem_idx));
 }
 
