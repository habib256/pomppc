+/*
+ * x-dcbz-inline-verify (POMPPC tcg/0035).  After an inline dcbz of EA: the
+ * line the helper would have zeroed (EA & ~(dcache_line_size - 1)) reads as
+ * zero through the TLB, and the reservation no longer covers it.  I/O pages
+ * are not re-read (counted).
+ */
+void helper_dcbz_verify(CPUPPCState *env, target_ulong addr)
+{
+    int size = env->dcache_line_size;
+    target_ulong line = addr & ~(target_ulong)(size - 1);
+    int mmu_idx = ppc_env_mmu_index(env, false);
+    uint8_t *host = tlb_vaddr_to_host(env, line, MMU_DATA_STORE, mmu_idx);
+    bool bad = (env->reserve_addr & ~(target_ulong)(size - 1)) == line;
+
+    if (!host) {
+        env->dcbzv_io++;
+    } else {
+        for (int i = 0; i < size; i++) {
+            bad |= host[i] != 0;
+        }
+    }
+    if (bad && env->dcbzv_bad++ < 20) {
+        fprintf(stderr, "dcbz-inline-verify: DIVERGENCE ea 0x" TARGET_FMT_lx
+                " line 0x" TARGET_FMT_lx " reserve 0x" TARGET_FMT_lx "\n",
+                addr, line, (target_ulong)env->reserve_addr);
+    }
+    if ((++env->dcbzv_n & 0x3ffff) == 0) {
+        fprintf(stderr, "dcbz-inline-verify: cpu %d, %" PRIu64 " checked, %"
+                PRIu64 " on I/O (not re-read), %" PRIu64 " divergent\n",
+                env_cpu(env)->cpu_index, env->dcbzv_n, env->dcbzv_io,
+                env->dcbzv_bad);
+    }
+}
