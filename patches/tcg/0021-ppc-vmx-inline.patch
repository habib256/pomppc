diff --git a/target/ppc/translate/vmx-impl.c.inc b/target/ppc/translate/vmx-impl.c.inc
index 4c1e071..6c91ad8 100644
--- a/target/ppc/translate/vmx-impl.c.inc
+++ b/target/ppc/translate/vmx-impl.c.inc
@@ -101,9 +101,57 @@ TRANS(LVEBX, do_ldst_ve_X, 1, gen_helper_LVEBX);
 TRANS(LVEHX, do_ldst_ve_X, 2, gen_helper_LVEHX);
 TRANS(LVEWX, do_ldst_ve_X, 4, gen_helper_LVEWX);
 
-TRANS(STVEBX, do_ldst_ve_X, 1, gen_helper_STVEBX);
-TRANS(STVEHX, do_ldst_ve_X, 2, gen_helper_STVEHX);
-TRANS(STVEWX, do_ldst_ve_X, 4, gen_helper_STVEWX);
+/*
+ * x-vmx-inline (POMPPC tcg/0021): stvebx/stvehx/stvewx without their helper
+ * (a call without flags: every TCG global written back and reloaded).  In
+ * big-endian mode the helper stores element (EA & 15) / size of vS, counted
+ * from the most significant end, with cpu_st*_be_data_ra at the masked EA:
+ * that is the doubleword (EA & 8 ? low : high) shifted right by
+ * 64 - 8 * size - 8 * (EA & 7), stored here by one qemu_st of the same size,
+ * endianness, mmu_idx and address (same faults, same DAR/DSISR).
+ * Little-endian mode keeps the helper (element index and byte swap).
+ */
+static bool do_stve_X(DisasContext *ctx, arg_X *a, int size,
+                      void (*helper)(TCGv_env, TCGv_ptr, TCGv))
+{
+    TCGv EA;
+    TCGv_i64 ea, d, lo, t;
+
+    if (!ctx->vmx_inline || ctx->le_mode) {
+        return do_ldst_ve_X(ctx, a, size, helper);
+    }
+    REQUIRE_INSNS_FLAGS(ctx, ALTIVEC);
+    REQUIRE_VECTOR(ctx);
+    gen_set_access_type(ctx, ACCESS_INT);
+    EA = do_ea_calc(ctx, a->ra, cpu_gpr[a->rb]);
+    if (size > 1) {
+        tcg_gen_andi_tl(EA, EA, ~(size - 1));
+    }
+    ea = tcg_temp_new_i64();
+    d = tcg_temp_new_i64();
+    lo = tcg_temp_new_i64();
+    t = tcg_temp_new_i64();
+    tcg_gen_extu_tl_i64(ea, EA);
+    get_avr64(d, a->rt, true);
+    get_avr64(lo, a->rt, false);
+    tcg_gen_andi_i64(t, ea, 8);
+    tcg_gen_movcond_i64(TCG_COND_NE, d, t, tcg_constant_i64(0), lo, d);
+    tcg_gen_andi_i64(t, ea, 7);
+    tcg_gen_shli_i64(t, t, 3);
+    tcg_gen_subfi_i64(t, 64 - 8 * size, t);
+    tcg_gen_shr_i64(d, d, t);
+    tcg_gen_qemu_st_i64(d, EA, ctx->mem_idx,
+                        size == 1 ? MO_UB : size == 2 ? MO_BEUW : MO_BEUL);
+    if (ctx->vmx_verify) {
+        gen_helper_vmx_verify_stve(tcg_env, tcg_constant_i32(size | a->rt << 8),
+                                   EA, d);
+    }
+    return true;
+}
+
+TRANS(STVEBX, do_stve_X, 1, gen_helper_STVEBX);
+TRANS(STVEHX, do_stve_X, 2, gen_helper_STVEHX);
+TRANS(STVEWX, do_stve_X, 4, gen_helper_STVEWX);
 
 static void gen_mfvscr(DisasContext *ctx)
 {
@@ -352,10 +400,79 @@ GEN_VXFORM_V(vsubuwm, MO_32, tcg_gen_gvec_sub, 0, 18);
 GEN_VXFORM_V(vsubudm, MO_64, tcg_gen_gvec_sub, 0, 19);
 GEN_VXFORM(vmrghb, 6, 0);
 GEN_VXFORM(vmrghh, 6, 1);
-GEN_VXFORM(vmrghw, 6, 2);
 GEN_VXFORM(vmrglb, 6, 4);
 GEN_VXFORM(vmrglh, 6, 5);
-GEN_VXFORM(vmrglw, 6, 6);
+
+/*
+ * x-vmx-inline (POMPPC tcg/0021): vmrghw/vmrglw (helpers TCG_CALL_NO_RWG)
+ * as four i64 ops.  The high doubleword of a vector holds its words 0
+ * (bits 63:32) and 1; vmrghw makes a.W0 b.W0 a.W1 b.W1 from the high
+ * doublewords of vA and vB, vmrglw the same from the low ones.  Both
+ * operands are read before vD is written (vD may be vA or vB).
+ */
+enum { VMXV_SLDOI, VMXV_MRGHW, VMXV_MRGLW };
+
+/* x-vmx-verify: the two operands, saved before the inline ops */
+static void gen_vmxv_save(int ra, int rb)
+{
+    TCGv_i128 t = tcg_temp_new_i128();
+
+    tcg_gen_ld_i128(t, tcg_env, avr_full_offset(ra));
+    tcg_gen_st_i128(t, tcg_env, offsetof(CPUPPCState, vmxv_in[0]));
+    tcg_gen_ld_i128(t, tcg_env, avr_full_offset(rb));
+    tcg_gen_st_i128(t, tcg_env, offsetof(CPUPPCState, vmxv_in[1]));
+}
+
+static void gen_vmrgw(DisasContext *ctx, bool high)
+{
+    TCGv_ptr ra, rb, rd;
+    TCGv_i64 a, b, rh, rl;
+
+    if (unlikely(!ctx->altivec_enabled)) {
+        gen_exception(ctx, POWERPC_EXCP_VPU);
+        return;
+    }
+    if (!ctx->vmx_inline) {
+        ra = gen_avr_ptr(rA(ctx->opcode));
+        rb = gen_avr_ptr(rB(ctx->opcode));
+        rd = gen_avr_ptr(rD(ctx->opcode));
+        if (high) {
+            gen_helper_vmrghw(rd, ra, rb);
+        } else {
+            gen_helper_vmrglw(rd, ra, rb);
+        }
+        return;
+    }
+    if (ctx->vmx_verify) {
+        gen_vmxv_save(rA(ctx->opcode), rB(ctx->opcode));
+    }
+    a = tcg_temp_new_i64();
+    b = tcg_temp_new_i64();
+    rh = tcg_temp_new_i64();
+    rl = tcg_temp_new_i64();
+    get_avr64(a, rA(ctx->opcode), high);
+    get_avr64(b, rB(ctx->opcode), high);
+    tcg_gen_shri_i64(rh, b, 32);
+    tcg_gen_deposit_i64(rh, a, rh, 0, 32);      /* a.W0 : b.W0 */
+    tcg_gen_deposit_i64(rl, b, a, 32, 32);      /* a.W1 : b.W1 */
+    set_avr64(rD(ctx->opcode), rh, true);
+    set_avr64(rD(ctx->opcode), rl, false);
+    if (ctx->vmx_verify) {
+        gen_helper_vmx_verify(tcg_env,
+                              tcg_constant_i32((high ? VMXV_MRGHW : VMXV_MRGLW)
+                                               | rD(ctx->opcode) << 8));
+    }
+}
+
+static void gen_vmrghw(DisasContext *ctx)
+{
+    gen_vmrgw(ctx, true);
+}
+
+static void gen_vmrglw(DisasContext *ctx)
+{
+    gen_vmrgw(ctx, false);
+}
 
