diff --git a/target/ppc/mem_helper.c b/target/ppc/mem_helper.c
index d3f505f..b9df49e 100644
--- a/target/ppc/mem_helper.c
+++ b/target/ppc/mem_helper.c
@@ -459,6 +459,114 @@ STVE(STVEWX, cpu_stl_be_data_ra, bswap32, u32)
 #undef I
 #undef LVE
 
+/*
+ * POMPPC tcg/0021, x-vmx-verify: each instruction that x-vmx-inline
+ * translates inline is re-done here by the original code and compared.
+ * vsldoi, vmrghw, vmrglw: the original helper on the operands saved before
+ * the inline ops (env->vmxv_in); on a divergence, vD gets the helper's
+ * value.  stvebx/stvehx/stvewx (big-endian): the element the STVE helper
+ * above would have stored, same expression, against the value stored.
+ * Summary on stderr every 2^26 checks and at exit.
+ */
+static uint64_t vmxv_n[2], vmxv_bad[2];
+static bool vmxv_atexit;
+
+static void vmxv_report(void)
+{
+    fprintf(stderr, "vmx-verify: %" PRIu64 " permutations (vsldoi, vmrg[hl]w),"
+            " %" PRIu64 " rangements (stve[bhw]x) vérifiés, %" PRIu64
+            " + %" PRIu64 " divergences\n",
+            qatomic_read(&vmxv_n[0]), qatomic_read(&vmxv_n[1]),
+            qatomic_read(&vmxv_bad[0]), qatomic_read(&vmxv_bad[1]));
+}
+
+static void vmxv_count(int k, bool bad)
+{
+    if (!qatomic_read(&vmxv_atexit)) {
+        qatomic_set(&vmxv_atexit, true);
+        atexit(vmxv_report);
+    }
+    if (bad) {
+        qatomic_inc(&vmxv_bad[k]);
+    }
+    if ((qatomic_fetch_inc(&vmxv_n[k]) & ((1u << 26) - 1)) == 0) {
+        vmxv_report();
+    }
+}
+
+void helper_vmx_verify(CPUPPCState *env, uint32_t desc)
+{
+    enum { VMXV_SLDOI, VMXV_MRGHW, VMXV_MRGLW };    /* vmx-impl.c.inc */
+    int rd = (desc >> 8) & 31;
+    ppc_avr_t ref, *r = cpu_avr_ptr(env, rd);
+    bool bad;
+
+    switch (desc & 0xff) {
+    case VMXV_SLDOI:
+        helper_vsldoi(&ref, &env->vmxv_in[0], &env->vmxv_in[1], desc >> 16);
+        break;
+    case VMXV_MRGHW:
+        helper_vmrghw(&ref, &env->vmxv_in[0], &env->vmxv_in[1]);
+        break;
+    case VMXV_MRGLW:
+        helper_vmrglw(&ref, &env->vmxv_in[0], &env->vmxv_in[1]);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    bad = ref.VsrD(0) != r->VsrD(0) || ref.VsrD(1) != r->VsrD(1);
+    if (bad && qatomic_read(&vmxv_bad[0]) < 20) {
+        fprintf(stderr, "vmx-verify: op %u v%d: en ligne %016" PRIx64 "%016"
+                PRIx64 ", helper %016" PRIx64 "%016" PRIx64 "\n",
+                desc & 0xff, rd, r->VsrD(0), r->VsrD(1),
+                ref.VsrD(0), ref.VsrD(1));
+    }
+    if (bad) {
+        *r = ref;
+    }
+    vmxv_count(0, bad);
+}
+
+void helper_vmx_verify_stve(CPUPPCState *env, uint32_t desc,
+                            target_ulong addr, uint64_t val)
+{
+    int size = desc & 0xff;
+    ppc_avr_t *r = cpu_avr_ptr(env, (desc >> 8) & 31);
+    uint64_t ref, got;
+    bool bad;
+
+#define STVE_REF(element)                                               \
+    do {                                                                \
+        size_t n_elems = ARRAY_SIZE(r->element);                        \
+        int adjust = HI_IDX * (n_elems - 1);                            \
+        int sh = sizeof(r->element[0]) >> 1;                            \
+        int index = (addr & 0xf) >> sh;                                 \
+        ref = r->element[LO_IDX ? index : (adjust - index)];            \
+        got = val & (uint64_t)(typeof(r->element[0]))-1;                \
+    } while (0)
+    switch (size) {
+    case 1:
+        STVE_REF(u8);
+        break;
+    case 2:
+        STVE_REF(u16);
+        break;
+    case 4:
+        STVE_REF(u32);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+#undef STVE_REF
+    bad = ref != got;
+    if (bad && qatomic_read(&vmxv_bad[1]) < 20) {
+        fprintf(stderr, "vmx-verify: stve %d octet(s) à " TARGET_FMT_lx
+                " : rangé %" PRIx64 ", helper %" PRIx64 "\n",
+                size, addr, got, ref);
+    }
+    vmxv_count(1, bad);
+}
+
 #ifdef TARGET_PPC64
 #define GET_NB(rb) ((rb >> 56) & 0xFF)
 
