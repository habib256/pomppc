+/*
+ * x-fp-native64 (POMPPC tcg/0016): the double-precision forms.  Every
+ * operand a float64 zero or normal (fpi_zon64), one IEEE float64 operation
+ * correctly rounded to nearest-even by the host: bit for bit what
+ * float64_add/sub/mul/muladd compute for them.  Back to the helpers:
+ * overflow; a tiny sum other than zero (exact, but FPRF would say
+ * denormal); a non-zero product whose result is tiny, DBL_MIN included
+ * (an underflow, PowerPC detecting tininess before rounding).
+ */
+static inline bool fpi_zon64(uint64_t x)
+{
+    int exp = extract64(x, 52, 11);
+
+    if (exp == 0) {
+        return (x << 1) == 0;
+    }
+    return exp != 0x7ff;
+}
+
+static inline double fpi_d(uint64_t x)
+{
+    union { double d; uint64_t u; } v = { .u = x };
+    return v.d;
+}
+
+static inline uint64_t fpi_u(double d)
+{
+    union { double d; uint64_t u; } v = { .d = d };
+    return v.u;
+}
+
+static inline QEMU_ALWAYS_INLINE uint64_t fpi_fp64(uint64_t a, uint64_t b,
+                                                  uint64_t c, uint32_t op)
+{
+    double fa, fb, fc, r;
+
+    switch (op) {
+    case FPI_ADD:
+    case FPI_SUB:
+        if (!fpi_zon64(a) || !fpi_zon64(b)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_d(a);
+        fb = fpi_d(b);
+        r = op == FPI_ADD ? fa + fb : fa - fb;
+        if (isinf(r) || (r != 0 && fabs(r) < DBL_MIN)) {
+            return FPI_FAIL;
+        }
+        return fpi_u(r);
+    case FPI_MUL:
+        if (!fpi_zon64(a) || !fpi_zon64(c)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_d(a);
+        fc = fpi_d(c);
+        r = fa * fc;
+        if (fa != 0 && fc != 0 && (isinf(r) || fabs(r) <= DBL_MIN)) {
+            return FPI_FAIL;
+        }
+        return fpi_u(r);
+    case FPI_MADD:
+    case FPI_MSUB:
+    case FPI_NMADD:
+    case FPI_NMSUB:
+        if (!fpi_zon64(a) || !fpi_zon64(b) || !fpi_zon64(c)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_d(a);
+        fb = fpi_d(b);
+        fc = fpi_d(c);
+        if (op == FPI_MSUB || op == FPI_NMSUB) {
+            fb = -fb;
+        }
+        r = fma(fa, fc, fb);
+        if (fa != 0 && fc != 0 && (isinf(r) || fabs(r) <= DBL_MIN)) {
+            return FPI_FAIL;
+        }
+        if (op == FPI_NMADD || op == FPI_NMSUB) {
+            r = -r;             /* after rounding, zero included */
+        }
+        return fpi_u(r);
+    }
+    return FPI_FAIL;
+}
