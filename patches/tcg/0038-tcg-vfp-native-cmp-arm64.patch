+#elif defined(__aarch64__) && !HOST_BIG_ENDIAN
+/*
+ * POMPPC tcg/0038: on an aarch64 host, the model of the NEON emitter
+ * (tcg/aarch64/tcg-target.c.inc, tcg_out_ppc_vfp_cmp()), lane for lane; the
+ * name vfnc_x86() is kept for the verifier and tools/tcg/vfpcmpproof.c.
+ * Written on the x86 PC: NOT RUN, NOT PROVEN (docs/parite-arm64-
+ * 0031-0035.md).  The same decisions as the x86_64 model; what differs:
+ *
+ *   compares  fcmeq / fcmge / fcmgt (vn OP vm, so a OP b directly);
+ *   vcfsx     scvtf, vcfux ucvtf: uint32 -> float32 in one rounding
+ *             (no split in halves), then the same exact scaling by 2^-uim;
+ *   vct*      fcvtzs / fcvtzu already saturate (INT32_MIN/MAX, 0/UINT32_MAX)
+ *             and give 0 for a NaN, as cvtsdsw/cvtsduw: only VSCR[SAT] is
+ *             computed apart, from x (x >= 2^31 or x < -2^31; vctuxs:
+ *             x >= 2^32 or x <= -1).
+ *
+ * FPCR is assumed at its default (round to nearest, FZ = 0, AH = 0), as for
+ * tcg/0003 and tcg/0022.
+ */
+static inline float32x4_t vfnc_pow2(int e)
+{
+    return vreinterpretq_f32_u32(vdupq_n_u32((uint32_t)(127 + e) << 23));
+}
+
+/* lanes of x (as t = x << 1) that are neither a NaN nor a denormal */
+static inline uint32x4_t vfnc_good(uint32x4_t x)
+{
+    uint32x4_t t = vaddq_u32(x, x);
+    uint32x4_t d = vorrq_u32(vcgeq_u32(t, vdupq_n_u32(0x01000000)),
+                             vceqzq_u32(t));                /* not denormal */
+
+    return vandq_u32(d, vcgeq_u32(vdupq_n_u32(0xff000000), t)); /* not NaN */
+}
+
+static bool vfnc_x86(int kind, int uim, bool gate, const uint32_t *pa,
+                     const uint32_t *pb, uint32_t *pr, bool *sat)
+{
+    uint32x4_t ia = vld1q_u32(pa), ib = vld1q_u32(pb), r, hi, lo;
+    float32x4_t a = vreinterpretq_f32_u32(ia), b = vreinterpretq_f32_u32(ib);
+    float32x4_t x;
+
+    *sat = false;
+    switch (kind) {
+    case VFNC_CMPEQ:
+    case VFNC_CMPGE:
+    case VFNC_CMPGT:
+    case VFNC_CMPB:
+        if (vmaxvq_u32(vmvnq_u32(vandq_u32(vfnc_good(ia), vfnc_good(ib))))) {
+            return false;
+        }
+        if (kind == VFNC_CMPEQ) {
+            r = vceqq_f32(a, b);
+        } else if (kind == VFNC_CMPGE) {
+            r = vcgeq_f32(a, b);
+        } else if (kind == VFNC_CMPGT) {
+            r = vcgtq_f32(a, b);
+        } else {
+            /* bit 31: !(a <= b) = a > b ; bit 30: !(a >= -b) = -b > a */
+            r = vorrq_u32(vandq_u32(vcgtq_f32(a, b), vdupq_n_u32(0x80000000)),
+                          vandq_u32(vcgtq_f32(vnegq_f32(b), a),
+                                    vdupq_n_u32(0x40000000)));
+        }
+        break;
+    case VFNC_CFSX:
+    case VFNC_CFUX:
+        if (!gate) {
+            return false;
+        }
+        x = kind == VFNC_CFSX ? vcvtq_f32_s32(vreinterpretq_s32_u32(ib))
+                              : vcvtq_f32_u32(ib);
+        if (uim) {
+            x = vmulq_f32(x, vfnc_pow2(-uim));
+        }
+        r = vreinterpretq_u32_f32(x);
+        break;
+    default:            /* VFNC_CTSXS, VFNC_CTUXS */
+        x = uim ? vmulq_f32(b, vfnc_pow2(uim)) : b;
+        if (kind == VFNC_CTSXS) {
+            r = vreinterpretq_u32_s32(vcvtq_s32_f32(x));
+            hi = vcgeq_f32(x, vfnc_pow2(31));
+            lo = vcgtq_f32(vdupq_n_f32(-2147483648.0f), x);
+        } else {
+            r = vcvtq_u32_f32(x);
+            hi = vcgeq_f32(x, vfnc_pow2(32));
+            lo = vcgeq_f32(vdupq_n_f32(-1.0f), x);     /* trunc(x) < 0 */
+        }
+        *sat = vmaxvq_u32(vorrq_u32(hi, lo)) != 0;
+        break;
+    }
+    vst1q_u32(pr, r);
+    return true;
+}
 #else
 static bool vfnc_x86(int kind, int uim, bool gate, const uint32_t *pa,
                      const uint32_t *pb, uint32_t *pr, bool *sat)
