+/*
+ * POMPPC tcg/0038 (x-vfp-native-cmp): the kinds of tcg/0034 on aarch64.
+ * Written on the x86 PC (06/10/2026): NOT RUN, NOT PROVEN, to be built
+ * and proven on the M4 (docs/parite-arm64-0031-0035.md) before any use.
+ * On the PC it was only compiled by the aarch64 clang of the Android NDK
+ * (tools/tcg/a64syntax.sh) and its raw encodings checked against that
+ * clang's assembler (tools/tcg/a64enc-check.py).
+ * Its model, lane for lane: the aarch64 branch of vfnc_x86() in
+ * target/ppc/int_helper.c (bloc « vfp-native-cmp »).
+ *
+ *   vcmpeqfp vcmpgefp vcmpgtfp vcmpbfp  every lane of vA and vB neither a
+ *       NaN nor a denormal (t = x << 1: t == 0 or 0x01000000 <=u t, and
+ *       t <=u 0xff000000; infinities are fine), then fcmeq / fcmge / fcmgt
+ *       (vcmpbfp: bit 31 = a > b, bit 30 = -b > a); any state of
+ *       vec_status.  Else the helper without Rc; CR6 in TCG ops (tcg/0034).
+ *   vcfsx vcfux  the gate of x-vfp-native (as tcg_out_ppc_vfp()), scvtf /
+ *       ucvtf (FPCR rounding: to nearest even), then * 2^-uim, exact.
+ *   vctsxs vctuxs  always: x = b * 2^uim (exact, or an infinity that
+ *       saturates the same way), fcvtzs / fcvtzu (toward zero, saturating,
+ *       NaN -> 0: exactly cvtsdsw / cvtsduw of the helper on these values);
+ *       VSCR[SAT] |= 1 when a lane saturated (x >= 2^31 or x < -2^31;
+ *       vctuxs: x >= 2^32 or x <= -1), branch-free: vscr_sat.u32[0] is
+ *       read, or'ed and written back (args[6] is its env offset).
+ *
+ * Same frame as tcg_out_ppc_vfp(): no TCG operand, TCG_OPF_CALL_CLOBBER,
+ * scratch X9-X11 and V0-V7, V16-V19; every test accumulated in PVF_G,
+ * then one cbnz to the stub before vD is stored.  FPCR at its default (to
+ * nearest, FZ = 0, AH = 0), as for tcg/0022.
+ */
+#define PVF_FCMEQ4S     0x4e20e400      /* vd = vn == vm (float) */
+#define PVF_FCMGE4S     0x6e20e400      /* vd = vn >= vm (float) */
+#define PVF_FCMGT4S     0x6ea0e400      /* vd = vn > vm (float) */
+#define PVF_FMUL4S      0x6e20dc00      /* vd = vn * vm */
+#define PVF_SCVTF4S     0x4e21d800      /* int32 -> float32, FPCR rounding */
+#define PVF_UCVTF4S     0x6e21d800      /* uint32 -> float32 */
+#define PVF_FCVTZS4S    0x4ea1b800      /* float32 -> int32, toward zero */
+#define PVF_FCVTZU4S    0x6ea1b800      /* float32 -> uint32, toward zero */
+
+static void pvf_dup(TCGContext *s, TCGReg d, uint32_t v)
+{
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, d, dup_const(MO_32, v));
+}
+
+/* the float 2^e, broadcast */
+static void pvf_pow2(TCGContext *s, TCGReg d, int e)
+{
+    pvf_dup(s, d, (uint32_t)(127 + e) << 23);
+}
+
+/*
+ * d = all-ones in the lanes of t (an operand << 1) that are neither a NaN
+ * nor a denormal (vfnc_good()): t >=u 0x01000000 or t == 0, and t <=u
+ * 0xff000000.  k1 = 0x01000000, k4 = 0xff000000.
+ */
+static void pvf_good(TCGContext *s, TCGReg d, TCGReg t, TCGReg k1, TCGReg k4,
+                     TCGReg u)
+{
+    pvf_3(s, PVF_CMHS4S, d, t, k1);         /* t >=u 0x01000000 */
+    pvf_2(s, PVF_CMEQ0_4S, u, t);           /* t == 0 */
+    pvf_3(s, PVF_ORR16B, d, d, u);
+    pvf_3(s, PVF_CMHS4S, u, k4, t);         /* 0xff000000 >=u t */
+    pvf_3(s, PVF_AND16B, d, d, u);
+}
+
+static void tcg_out_ppc_vfp_cmp(TCGContext *s, const TCGArg *args)
+{
+    const TCGReg xa = TCG_REG_V0, xb = TCG_REG_V1, xm = TCG_REG_V2;
+    const TCGReg r = TCG_REG_V3, t = TCG_REG_V4, u = TCG_REG_V5;
+    const TCGReg k1 = TCG_REG_V6, k4 = TCG_REG_V7, ok = TCG_REG_V16;
+    const TCGReg hi = TCG_REG_V17, lo = TCG_REG_V18, c = TCG_REG_V19;
+    unsigned kind = args[0];
+    int uim = args[4];
+    TCGLabelQemuLdst *l;
+    TCGReg x;
+
+    tcg_out_ld(s, TCG_TYPE_V128, xb, TCG_AREG0, args[3]);
+
+    switch (kind) {
+    case PVF_CMPEQ:
+    case PVF_CMPGE:
+    case PVF_CMPGT:
+    case PVF_CMPB:
+        tcg_out_ld(s, TCG_TYPE_V128, xa, TCG_AREG0, args[2]);
+        /* every lane of vA and vB neither a NaN nor a denormal */
+        pvf_dup(s, k1, 0x01000000);
+        pvf_dup(s, k4, 0xff000000);
+        pvf_3(s, PVF_ADD4S, t, xa, xa);
+        pvf_good(s, ok, t, k1, k4, u);
+        pvf_3(s, PVF_ADD4S, t, xb, xb);
+        pvf_good(s, hi, t, k1, k4, u);
+        pvf_3(s, PVF_AND16B, ok, ok, hi);
+        pvf_2(s, PVF_NOT16B, ok, ok);
+        pvf_2(s, PVF_UMAXV4S, ok, ok);
+        pvf_2(s, PVF_UMOVWS0, PVF_G, ok);
+        if (kind == PVF_CMPEQ) {
+            pvf_3(s, PVF_FCMEQ4S, r, xa, xb);
+        } else if (kind == PVF_CMPGE) {
+            pvf_3(s, PVF_FCMGE4S, r, xa, xb);           /* a >= b */
+        } else if (kind == PVF_CMPGT) {
+            pvf_3(s, PVF_FCMGT4S, r, xa, xb);           /* a > b */
+        } else {
+            /* bit 31: a > b (!(a <= b)); bit 30: -b > a (!(a >= -b)) */
+            pvf_3(s, PVF_FCMGT4S, hi, xa, xb);
+            pvf_2(s, PVF_FNEG4S, t, xb);
+            pvf_3(s, PVF_FCMGT4S, lo, t, xa);
+            pvf_dup(s, c, 0x80000000);
+            pvf_3(s, PVF_AND16B, hi, hi, c);
+            pvf_dup(s, c, 0x40000000);
+            pvf_3(s, PVF_AND16B, lo, lo, c);
+            pvf_3(s, PVF_ORR16B, r, hi, lo);
+        }
+        break;
+    case PVF_CFSX:
+    case PVF_CFUX:
+        /* the gate of x-vfp-native, in PVF_G (as tcg_out_ppc_vfp()) */
+        tcg_out_movi(s, TCG_TYPE_I64, PVF_G, 0);
+        for (int w = 0; w < 2; w++) {
+            if (args[7 + 3 * w]) {
+                tcg_out_ld(s, TCG_TYPE_I64, PVF_T2, TCG_AREG0,
+                           args[6 + 3 * w]);
+                tcg_out_movi(s, TCG_TYPE_I64, PVF_T1, args[7 + 3 * w]);
+                pfp_rrr(s, PFP_ANDX, PVF_T2, PVF_T2, PVF_T1, 0);
+                tcg_out_movi(s, TCG_TYPE_I64, PVF_T1, args[8 + 3 * w]);
+                pfp_rrr(s, 0xca000000 /* eor x */, PVF_T2, PVF_T2,
+                        PVF_T1, 0);
+                pfp_rrr(s, PFP_ORRX, PVF_G, PVF_G, PVF_T2, 0);
+            }
+        }
+        pvf_2(s, kind == PVF_CFSX ? PVF_SCVTF4S : PVF_UCVTF4S, r, xb);
+        if (uim) {
+            pvf_pow2(s, c, -uim);                       /* exact scaling */
+            pvf_3(s, PVF_FMUL4S, r, r, c);
+        }
+        break;
+    default:            /* PVF_CTSXS, PVF_CTUXS: no slow path */
+        x = xb;
+        if (uim) {
+            pvf_pow2(s, c, uim);
+            pvf_3(s, PVF_FMUL4S, xm, xb, c);
+            x = xm;
+        }
+        if (kind == PVF_CTSXS) {
+            pvf_2(s, PVF_FCVTZS4S, r, x);
+            pvf_pow2(s, c, 31);
+            pvf_3(s, PVF_FCMGE4S, hi, x, c);            /* x >= 2^31 */
+            pvf_dup(s, k1, 0xcf000000);                 /* -2^31 */
+            pvf_3(s, PVF_FCMGT4S, lo, k1, x);           /* x < -2^31 */
+        } else {
+            pvf_2(s, PVF_FCVTZU4S, r, x);
+            pvf_pow2(s, c, 32);
+            pvf_3(s, PVF_FCMGE4S, hi, x, c);            /* x >= 2^32 */
+            pvf_dup(s, k1, 0xbf800000);                 /* -1.0 */
+            pvf_3(s, PVF_FCMGE4S, lo, k1, x);           /* x <= -1 */
+        }
+        /* VSCR[SAT] |= any lane saturated (set_vscr_sat()), no branch */
+        pvf_3(s, PVF_ORR16B, t, hi, lo);
+        pvf_2(s, PVF_UMAXV4S, t, t);
+        pvf_2(s, PVF_UMOVWS0, PVF_T1, t);
+        tcg_out_logicali(s, Ilogic_imm_ANDI, TCG_TYPE_I32, PVF_T1, PVF_T1, 1);
+        tcg_out_ld(s, TCG_TYPE_I32, PVF_T2, TCG_AREG0, args[6]);
+        pfp_rrr(s, PFP_ORRX, PVF_T2, PVF_T2, PVF_T1, 0);
+        tcg_out_st(s, TCG_TYPE_I32, PVF_T2, TCG_AREG0, args[6]);
+        tcg_out_st(s, TCG_TYPE_V128, r, TCG_AREG0, args[1]);
+        return;
+    }
+
+    /* compares, vcf*: any test failed, the helper out of line */
+    l = new_ldst_label(s);
+    l->is_ppc_vfp = true;
+    l->fp_sel = kind;
+    l->fp_slow = (const void *)args[5];
+    for (int i = 0; i < 4; i++) {
+        l->vfp_off[i] = args[1 + i];
+    }
+    l->label_ptr[0] = s->code_ptr;
+    tcg_out_insn(s, cbz, CBNZ, TCG_TYPE_I64, PVF_G, 0);
+    tcg_out_st(s, TCG_TYPE_V128, r, TCG_AREG0, args[1]);
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
