+/* POMPPC tcg/0015 (x-tb-fast), see include/sysemu/cpu-timers.h */
+int64_t cpu_get_clock_offset(bool *ticking)
+{
+    int64_t off;
+    bool on;
+    unsigned start;
+
+    do {
+        start = seqlock_read_begin(&timers_state.vm_clock_seqlock);
+        off = timers_state.cpu_clock_offset;
+        on = timers_state.cpu_ticks_enabled;
+    } while (seqlock_read_retry(&timers_state.vm_clock_seqlock, start));
+
+    *ticking = on;
+    return off;
+}
