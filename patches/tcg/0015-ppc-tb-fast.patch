+/*
+ * POMPPC tcg/0015 (x-tb-fast), docs/tcg-g4.md section 23.
+ *
+ * Stock mftb: qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) = cpu_clock_offset +
+ * get_clock(), then muldiv64() and its 128-bit division.  With x-tb-fast,
+ * get_clock() is the host counter (qemu_raw_clock_enable(), include/qemu/
+ * timer.h) and this path computes the very same value: offset + cntvct + K,
+ * divided by 1e9 / tb_freq (floor, as muldiv64, when tb_freq divides 1e9).
+ * x-tb-verify recomputes the stock value right after: fast - stock must be
+ * 0, or negative by the ticks elapsed between the two reads.
+ */
+static int tbf_div;                 /* 1e9 / tb_freq, 0: stock path */
+static int64_t tbf_dmin = INT64_MAX, tbf_dmax = INT64_MIN;
+static uint64_t tbf_n, tbf_pos, tbf_late;
+static bool tbf_atexit;
+
+static void tbf_report(void)
+{
+    fprintf(stderr, "tb-verify: %" PRIu64 " lectures, écart rapide-origine "
+            "%" PRId64 "..%" PRId64 " ticks, %" PRIu64 " positifs (faux), "
+            "%" PRIu64 " < -25 (lecture d'origine retardée)\n",
+            qatomic_read(&tbf_n), tbf_dmin, tbf_dmax,
+            qatomic_read(&tbf_pos), qatomic_read(&tbf_late));
+}
+
+static void tbf_init(CPUPPCState *env, uint32_t freq)
+{
+    if (env->tb_fast && freq && NANOSECONDS_PER_SECOND % freq == 0 &&
+        qemu_raw_clock_enable()) {
+        tbf_div = NANOSECONDS_PER_SECOND / freq;
+    }
+}
+
+/* Returns true and the TB in *tb when the fast path applies. */
+static inline bool tbf_load(CPUPPCState *env, uint64_t *tb)
+{
+    ppc_tb_t *tb_env = env->tb_env;
+    bool ticking;
+    int64_t ns;
+    uint64_t v;
+
+    if (unlikely(!tbf_div || tb_env->tb_freq * (uint64_t)tbf_div !=
+                 NANOSECONDS_PER_SECOND)) {
+        return false;
+    }
+    ns = cpu_get_clock_offset(&ticking);
+    if (ticking) {
+        ns += get_clock();
+    }
+    v = (uint64_t)ns / (uint64_t)tbf_div + tb_env->tb_offset;
+    if (unlikely(env->tb_verify)) {
+        uint64_t s = cpu_ppc_get_tb(tb_env, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                    tb_env->tb_offset);
+        int64_t d = (int64_t)(v - s);
+
+        if (!qatomic_read(&tbf_atexit)) {
+            qatomic_set(&tbf_atexit, true);
+            atexit(tbf_report);
+        }
+        if (d < tbf_dmin) {         /* racy min/max: diagnostic only */
+            tbf_dmin = d;
+        }
+        if (d > tbf_dmax) {
+            tbf_dmax = d;
+        }
+        if (d > 0) {
+            if (qatomic_fetch_inc(&tbf_pos) < 20) {
+                fprintf(stderr, "tb-verify: cpu %d rapide %" PRIu64
+                        " > origine %" PRIu64 "\n",
+                        env_cpu(env)->cpu_index, v, s);
+            }
+        } else if (d < -25) {
+            qatomic_inc(&tbf_late);
+        }
+        if ((qatomic_fetch_inc(&tbf_n) & ((1u << 26) - 1)) == 0) {
+            tbf_report();
+        }
+    }
+    *tb = v;
+    return true;
+}
