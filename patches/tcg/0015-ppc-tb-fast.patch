@@ -1109,6 +1198,7 @@ void cpu_ppc_tb_init(CPUPPCState *env, uint32_t freq)
 
     tb_env->tb_freq = freq;
     tb_env->decr_freq = freq;
+    tbf_init(env, freq);            /* POMPPC tcg/0015 */
