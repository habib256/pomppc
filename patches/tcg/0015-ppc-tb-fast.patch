@@ -49,6 +50,57 @@ static void __attribute__((constructor)) init_get_clock(void)
 #else
 
 int use_rt_clock;
+int qemu_raw_clock;
+int64_t qemu_raw_clock_k;
+
+/* POMPPC tcg/0015, see include/qemu/timer.h */
+bool qemu_raw_clock_enable(void)
+{
+#if defined(__aarch64__)
+    static int state;               /* 0 not tried, 1 on, -1 refused */
+    uint64_t f, c1, c2;
+    int64_t m, lo = INT64_MIN, hi = INT64_MAX;
+    struct timespec ts;
+    int i;
+
+    if (state) {
+        return state > 0;
+    }
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(f));
+    if (f != 1000000000ULL || !use_rt_clock) {
+        fprintf(stderr, "x-tb-fast : cntfrq %" PRIu64 " Hz, horloge d'origine\n", f);
+        state = -1;
+        return false;
+    }
+    /* CLOCK_MONOTONIC = floor_res(cnt + C) near now: bound C from both sides */
+    for (i = 0; i < 20000; i++) {
+        asm volatile("mrs %0, cntvct_el0" : "=r"(c1));
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        asm volatile("mrs %0, cntvct_el0" : "=r"(c2));
+        m = ts.tv_sec * 1000000000LL + ts.tv_nsec;
+        lo = MAX(lo, m - (int64_t)c2);
+        hi = MIN(hi, m + 1000 - (int64_t)c1);
+    }
+    /*
+     * macOS steps CLOCK_MONOTONIC on its 24 MHz tick (41.7 ns): the two
+     * bounds may cross by that much.
+     */
+    if (lo - hi > 100 || hi - lo > 2000) {
+        fprintf(stderr, "x-tb-fast : CLOCK_MONOTONIC ne suit pas cntvct "
+                "(%" PRId64 "..%" PRId64 "), horloge d'origine\n", lo, hi);
+        state = -1;
+        return false;
+    }
+    /* lo: the counter lands at or just above CLOCK_MONOTONIC, never below */
+    qemu_raw_clock_k = lo;
+    smp_wmb();
+    qemu_raw_clock = 1;
+    state = 1;
+    return true;
+#else
+    return false;
+#endif
+}
 
