     DEFINE_PROP_BOOL("x-tb-fast", PowerPCCPU, env.tb_fast, false),
diff --git a/util/qemu-timer-common.c b/util/qemu-timer-common.c
index 3047f08..0f5165b 100644
--- a/util/qemu-timer-common.c
+++ b/util/qemu-timer-common.c
@@ -52,6 +52,7 @@ static void __attribute__((constructor)) init_get_clock(void)
 int use_rt_clock;
 int qemu_raw_clock;
 int64_t qemu_raw_clock_k;
+uint64_t qemu_raw_clock_mult;
 
 /* POMPPC tcg/0015, see include/qemu/timer.h */
 bool qemu_raw_clock_enable(void)
@@ -97,6 +98,103 @@ bool qemu_raw_clock_enable(void)
     qemu_raw_clock = 1;
     state = 1;
     return true;
+#elif defined(__x86_64__) && defined(__linux__)
+    /* POMPPC tcg/0018, see include/qemu/timer.h */
+    static int state;               /* 0 not tried, 1 on, -1 refused */
+    uint32_t a, b, c, d;
+    uint64_t c0, c1, mult;
+    int64_t m0, m1, m, t1, t2, lo = INT64_MIN, hi = INT64_MAX;
+    char src[32] = "";
+    FILE *f;
+    int i;
+
+    if (state) {
+        return state > 0;
+    }
+    /* invariant TSC (CPUID 0x80000007 EDX[8]) */
+    asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                 : "a"(0x80000000u), "c"(0));
+    if (a >= 0x80000007u) {
+        asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                     : "a"(0x80000007u), "c"(0));
+    } else {
+        d = 0;
+    }
+    /* the kernel keeps time with it: synchronized and stable on this host */
+    f = fopen("/sys/devices/system/clocksource/clocksource0/"
+              "current_clocksource", "r");
+    if (f) {
+        if (!fgets(src, sizeof(src), f)) {
+            src[0] = 0;
+        }
+        fclose(f);
+    }
+    if (!(d & (1u << 8)) || strcmp(src, "tsc\n") || !use_rt_clock) {
+        fprintf(stderr, "x-tb-fast : TSC %s, source d'horloge « %.*s », "
+                "horloge d'origine\n", d & (1u << 8) ? "invariant" : "variable",
+                (int)strcspn(src, "\n"), src);
+        state = -1;
+        return false;
+    }
+    /*
+     * The TSC rate in ns: two (TSC, CLOCK_MONOTONIC) pairs 20 ms apart, each
+     * the tightest of 32 bracketed reads (~2 ppm).
+     */
+    for (int p = 0; p < 2; p++) {
+        uint64_t best = UINT64_MAX, cb = 0;
+        int64_t mb = 0;
+
+        if (p) {
+            do {
+                m = get_clock();
+            } while (m - m0 < 20 * 1000 * 1000);
+        }
+        for (i = 0; i < 32; i++) {
+            struct timespec ts;
+            uint64_t x1, x2;
+
+            x1 = __builtin_ia32_rdtsc();
+            clock_gettime(CLOCK_MONOTONIC, &ts);
+            x2 = __builtin_ia32_rdtsc();
+            if (x2 - x1 < best) {
+                best = x2 - x1;
+                cb = x1 + (x2 - x1) / 2;
+                mb = ts.tv_sec * 1000000000LL + ts.tv_nsec;
+            }
+        }
+        if (p) {
+            c1 = cb;
+            m1 = mb;
+        } else {
+            c0 = cb;
+            m0 = mb;
+        }
+    }
+    mult = ((uint64_t)(m1 - m0) << 32) / (c1 - c0);
+    qemu_raw_clock_mult = mult;
+    /* CLOCK_MONOTONIC = floor_res(tsc_ns + C) near now: bound C both sides */
+    for (i = 0; i < 20000; i++) {
+        struct timespec ts;
+
+        t1 = qemu_raw_clock_tsc_ns();
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        t2 = qemu_raw_clock_tsc_ns();
+        m = ts.tv_sec * 1000000000LL + ts.tv_nsec;
+        lo = MAX(lo, m - t2);
+        hi = MIN(hi, m + 1 - t1);
+    }
+    if (lo - hi > 100 || hi - lo > 2000) {
+        fprintf(stderr, "x-tb-fast : CLOCK_MONOTONIC ne suit pas le TSC "
+                "(%" PRId64 "..%" PRId64 "), horloge d'origine\n", lo, hi);
+        state = -1;
+        return false;
+    }
+    /* lo: the counter lands at or just above CLOCK_MONOTONIC, never below */
+    qemu_raw_clock_k = lo;
+    smp_wmb();
+    qemu_raw_clock = 1;
+    state = 1;
+    return true;
 #else
     return false;
 #endif
