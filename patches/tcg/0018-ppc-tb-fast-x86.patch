diff --git a/hw/ppc/ppc.c b/hw/ppc/ppc.c
index f402b17..b66601d 100644
--- a/hw/ppc/ppc.c
+++ b/hw/ppc/ppc.c
@@ -527,7 +527,8 @@ int64_t cpu_ppc_load_tb_offset(CPUPPCState *env)
  * Stock mftb: qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) = cpu_clock_offset +
  * get_clock(), then muldiv64() and its 128-bit division.  With x-tb-fast,
  * get_clock() is the host counter (qemu_raw_clock_enable(), include/qemu/
- * timer.h) and this path computes the very same value: offset + cntvct + K,
+ * timer.h) and this path computes the very same value: offset + cntvct + K
+ * (x86_64, tcg/0018: offset + tsc_ns + K),
  * divided by 1e9 / tb_freq (floor, as muldiv64, when tb_freq divides 1e9).
  * x-tb-verify recomputes the stock value right after: fast - stock must be
  * 0, or negative by the ticks elapsed between the two reads.
diff --git a/include/qemu/timer.h b/include/qemu/timer.h
index 30ec688..0060d1e 100644
--- a/include/qemu/timer.h
+++ b/include/qemu/timer.h
@@ -845,6 +845,26 @@ extern int use_rt_clock;
 extern int qemu_raw_clock;
 extern int64_t qemu_raw_clock_k;
 bool qemu_raw_clock_enable(void);
+/*
+ * POMPPC tcg/0018 (x-tb-fast on x86_64 Linux hosts): the invariant TSC,
+ * when the kernel itself keeps time with it (synchronized across CPUs),
+ * scaled to ns by qemu_raw_clock_mult (32.32 fixed point, calibrated once
+ * against CLOCK_MONOTONIC), plus the same K: ~7 ns per read instead of ~20.
+ */
+extern uint64_t qemu_raw_clock_mult;
+
+static inline int64_t qemu_raw_clock_tsc_ns(void)
+{
+#if defined(__x86_64__)
+    uint32_t lo, hi;
+
+    asm volatile("rdtsc" : "=a"(lo), "=d"(hi));
+    return (int64_t)(((unsigned __int128)((uint64_t)hi << 32 | lo) *
+                      qemu_raw_clock_mult) >> 32);
+#else
+    return 0;
+#endif
+}
 
 static inline int64_t get_clock(void)
 {
@@ -854,6 +874,10 @@ static inline int64_t get_clock(void)
         asm volatile("mrs %0, cntvct_el0" : "=r"(v));
         return (int64_t)v + qemu_raw_clock_k;
     }
+#elif defined(__x86_64__) && defined(__linux__)
+    if (qemu_raw_clock) {
+        return qemu_raw_clock_tsc_ns() + qemu_raw_clock_k;
+    }
 #endif
     if (use_rt_clock) {
         struct timespec ts;
diff --git a/target/ppc/cpu.h b/target/ppc/cpu.h
index 478e5be..3b64972 100644
--- a/target/ppc/cpu.h
+++ b/target/ppc/cpu.h
@@ -1482,7 +1482,8 @@ struct CPUArchState {
     bool msr_nobql_verify;
     /*
      * x-tb-fast (POMPPC tcg/0015): mftb/mftbu compute the time base from
-     * the host counter (cntvct_el0 at 1 GHz, calibrated once against
