+        struct PomppcDwSlot *s = &c->dw[k];
+
+        if (!(s->idx && s->lo < end && start < s->hi)) {
+            continue;
+        }
+        for (work = s->idx & ~scan; work; work &= work - 1) {
+            int mmu_idx = ctz32(work);
+            CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
