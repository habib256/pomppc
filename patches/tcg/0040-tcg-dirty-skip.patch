+/*
+ * The stock test of tlb_reset_dirty_range_locked, the entry read first:
+ * the slow flags (TLB_MMIO, TLB_DISCARD_WRITE) are read only when the
+ * entry says it has some (TLB_FORCE_SLOW).  Returns true if it changed it.
+ */
+static inline bool pomppc_reset_dirty_one(CPUTLBEntryFull *full,
+                                          CPUTLBEntry *ent,
+                                          uintptr_t start, uintptr_t length)
+{
+    const uintptr_t addr = ent->addr_write;
+
+    if (addr & (TLB_INVALID_MASK | TLB_NOTDIRTY)) {
+        return false;
+    }
+    if ((addr & TLB_FORCE_SLOW) &&
+        (full->slow_flags[MMU_DATA_STORE] & (TLB_MMIO | TLB_DISCARD_WRITE))) {
+        return false;
+    }
+    if (((addr & TARGET_PAGE_MASK) + ent->addend - start) < length) {
+        qatomic_set(&ent->addr_write, addr | TLB_NOTDIRTY);
+        return true;
+    }
+    return false;
+}
