+/*
+ * POMPPC tcg/0040 (x-dirty-skip): record, with tlb_c.lock held, that an
+ * entry of mmu_idx whose write side tlb_reset_dirty() may change maps the
+ * host page at @host, in RAM block @rb (NULL if unknown: dw_over), at
+ * @index of the table of mmu_idx (or in its victim TLB).
+ */
+static void pomppc_dw_slot_add(struct PomppcDwSlot *s, int mmu_idx,
+                               unsigned index)
+{
+    if (unlikely(!s->bm[mmu_idx])) {
+        s->bm[mmu_idx] = bitmap_new(POMPPC_DW_BITS);
+    }
+    s->idx |= 1u << mmu_idx;
+    set_bit(index & (POMPPC_DW_BITS - 1), s->bm[mmu_idx]);
+}
+
+static void pomppc_dw_note(CPUState *cpu, int mmu_idx, uintptr_t host,
+                           RAMBlock *rb, unsigned index)
+{
+    CPUTLBCommon *c = &cpu->neg.tlb.c;
+    struct PomppcDwSlot *s, *free_slot = NULL;
+
+    host &= TARGET_PAGE_MASK;
+    if (rb) {
+        for (int k = 0; k < POMPPC_DW_SLOTS; k++) {
+            s = &c->dw[k];
+            if (s->rb == rb) {
+                s->lo = MIN(s->lo, host);
+                s->hi = MAX(s->hi, host + TARGET_PAGE_SIZE);
+                pomppc_dw_slot_add(s, mmu_idx, index);
+                return;
+            }
+            if (!s->rb && !free_slot) {
+                free_slot = s;
+            }
+        }
+        if (free_slot) {
+            free_slot->rb = rb;
+            free_slot->lo = host;
+            free_slot->hi = host + TARGET_PAGE_SIZE;
+            pomppc_dw_slot_add(free_slot, mmu_idx, index);
+            return;
+        }
+    }
+    c->dw_over |= 1u << mmu_idx;
+}
+
+/* the RAM block holding @host: a slot's block when one does, else a lookup */
+static RAMBlock *pomppc_dw_block(CPUState *cpu, uintptr_t host)
+{
+    CPUTLBCommon *c = &cpu->neg.tlb.c;
+    ram_addr_t ofs;
+
+    for (int k = 0; k < POMPPC_DW_SLOTS; k++) {
+        RAMBlock *rb = c->dw[k].rb;
+
+        if (rb && host - (uintptr_t)qemu_ram_get_host_addr(rb) <
+                  qemu_ram_get_max_length(rb)) {
+            return rb;
+        }
+    }
+    return qemu_ram_block_from_host((void *)host, false, &ofs);
+}
