+                                   start, length);
+        }
+        for (unsigned int i = 0; i < CPU_VTLB_SIZE; i++) {
+            pomppc_reset_dirty_one(&desc->vfulltlb[i], &desc->vtable[i],
+                                   start, length);
+        }
+    }
+    for (int k = 0; k < POMPPC_DW_SLOTS; k++) {
+        struct PomppcDwSlot *s = &c->dw[k];
+
+        if (s->idx && start <= s->lo && s->hi <= end) {
+            for (work = s->idx; work; work &= work - 1) {
+                bitmap_zero(s->bm[ctz32(work)], POMPPC_DW_BITS);
+            }
+            s->rb = NULL;
+            s->idx = 0;
+        }
+    }
+    if (unlikely(cpu->dirty_skip_verify)) {
+        uint64_t bad = 0;
+
+        for (int mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
+            CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
+            CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
+            unsigned int n = tlb_n_entries(fast);
+
+            for (unsigned int i = 0; i < n; i++) {
+                bad += pomppc_reset_dirty_one(&desc->fulltlb[i],
+                                              &fast->table[i], start, length);
+            }
+            for (unsigned int i = 0; i < CPU_VTLB_SIZE; i++) {
+                bad += pomppc_reset_dirty_one(&desc->vfulltlb[i],
+                                              &desc->vtable[i], start, length);
+            }
+        }
+        c->dw_vchk++;
+        if (bad) {
+            c->dw_vbad += bad;
+            fprintf(stderr, "x-dirty-skip-verify: cpu %d DIVERGENCE %" PRIu64
+                    " entries left to reset in [%p, +0x%zx), scanned 0x%x\n",
+                    cpu->cpu_index, bad, (void *)start, (size_t)length, scan);
+        }
+        if ((c->dw_vchk & 1023) == 0) {
+            fprintf(stderr, "x-dirty-skip-verify: cpu %d %" PRIu64 " checks, %"
+                    PRIu64 " divergences, %" PRIu64 " calls %" PRIu64
+                    " skipped %" PRIu64 " mmu_idx scanned %" PRIu64
+                    " marked entries\n",
+                    cpu->cpu_index, c->dw_vchk, c->dw_vbad, c->dw_calls,
