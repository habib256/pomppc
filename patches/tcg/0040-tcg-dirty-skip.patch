+#define POMPPC_DW_BITS 16384
+    struct PomppcDwSlot {
+        RAMBlock *rb;
+        uintptr_t lo, hi;
+        MMUIdxMap idx;
+        unsigned long *bm[NB_MMU_MODES];
+    } dw[POMPPC_DW_SLOTS];
+    MMUIdxMap dw_over;
+    /*
+     * x-dirty-skip counters: calls, skipped, mmu_idx scanned whole, marked
+     * entries visited, verify
+     */
+    uint64_t dw_calls, dw_skip, dw_idx, dw_ent, dw_vchk, dw_vbad;
