+/*
+ * x-tlb-base (POMPPC tcg/0052, docs/tcg-g4.md section 41).  A D-form load
+ * on base rA goes through ctx->tlbb[rA] (TCGTlbBase, tcg-op-ldst.c): the
+ * first one is a plain qemu_ld, the next ones check that their address
+ * lies in the page the first one checked, and then skip the TLB lookup.
+ * Exact for any address (the test is on the address itself, not on rA):
+ * killing a base when rA is written only keeps the test likely to pass.
+ * What the cache must not outlive is the validity of the kept TLB addend:
+ * within a TB this vCPU's TLB only changes in its own thread -- in a helper
+ * (tlbie, mtsr, mtmsr, SDR1, BAT...: any call kills every base, but the
+ * checkers below), or in the slow path of another access (tlb_fill: a
+ * replaced or evicted entry, whose mapping stays valid); flushes requested
+ * by other threads or by memory map changes run between TBs.  Labels and
+ * branches kill every base (the two EBB temps of a promoted base die
+ * there), the end of the TB as well.
+ */
+static void tlbb_kill_all(DisasContext *ctx)
+{
+    for (int r = 0; r < 32; r++) {
+        if (ctx->tlbb[r].first) {
+            tcg_tlbb_kill(&ctx->tlbb[r]);
+        }
+    }
+}
+
+/* the checkers that touch neither the TLB nor the MMU state */
+static bool tlbb_call_ok(TCGOp *op)
+{
+    return tcg_op_is_call_to(op, helper_tlbb_verify) ||
+           tcg_op_is_call_to(op, helper_fpn_verify) ||
+           tcg_op_is_call_to(op, helper_fpn_lfs) ||
+           tcg_op_is_call_to(op, helper_vfn_save) ||
+           tcg_op_is_call_to(op, helper_vfn_verify) ||
+           tcg_op_is_call_to(op, helper_vfnc_verify);
+}
+
+/* after each instruction: what it did to the bases (as fpk_scan()) */
+static void tlbb_scan(DisasContext *ctx, TCGOp *start)
+{
+    const int lo = offsetof(CPUPPCState, gpr[0]);
+    const int hi = offsetof(CPUPPCState, gpr[32]);
+    TCGOp *op;
+
+    for (op = QTAILQ_NEXT(start, link); op; op = QTAILQ_NEXT(op, link)) {
+        const TCGOpDef *def = &tcg_op_defs[op->opc];
+
+        switch (op->opc) {
+        case INDEX_op_insn_start:
+            return;
+        case INDEX_op_call:
+            if (!tlbb_call_ok(op)) {
+                tlbb_kill_all(ctx);
+            }
+            break;
+        case INDEX_op_st8:
+        case INDEX_op_st16:
+        case INDEX_op_st32:
+        case INDEX_op_st:
+        case INDEX_op_st_vec:
+            /* a GPR written behind its global: every base */
+            if (op->args[1] == tcgv_ptr_arg(tcg_env)) {
+                int o = (int)op->args[2];
+                if (o + 32 > lo && o < hi) {
+                    tlbb_kill_all(ctx);
+                }
+            }
+            break;
+        default:
+            if (def->flags & (TCG_OPF_BB_END | TCG_OPF_COND_BRANCH)) {
+                tlbb_kill_all(ctx);
+                break;
+            }
+            for (int i = 0; i < def->nb_oargs; i++) {
+                for (int r = 1; r < 32; r++) {
+                    if (op->args[i] == temp_arg(tcgv_tl_temp(cpu_gpr[r])) &&
+                        ctx->tlbb[r].first) {
+                        tcg_tlbb_kill(&ctx->tlbb[r]);
+                    }
+                }
+            }
+            break;
+        }
+    }
+}
+
+/* before the load of a D-form instruction: its base, or NULL */
+static TCGTlbBase *tlbb_arm(DisasContext *ctx, int ra, TCGv displ)
+{
+    TCGTlbBase *b;
+
+    if (!ctx->tlb_base || tcgv_tl_temp(displ)->kind != TEMP_CONST) {
+        return NULL;
+    }
+    b = &ctx->tlbb[ra];
+    tcg_tlbb_arm(b);
+    return b;
+}
+
+/*
+ * after it: disarmed (the load may not have taken it); x-tlb-base-verify
+ * on a covered load
+ */
+static void tlbb_done(DisasContext *ctx, TCGTlbBase *b, unsigned covered,
+                      TCGv ea, MemOp mop)
+{
+    tcg_tlbb_arm(NULL);
+    if (b && ctx->tlbb_verify && b->nb_covered != covered) {
+        gen_helper_tlbb_verify(tcg_env, ea, b->negp, b->adend,
+                               tcg_constant_i32(memop_size(mop) |
+                                                ctx->mem_idx << 8));
+    }
+}
