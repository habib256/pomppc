+/*
+ * POMPPC tcg/0052 (x-tlb-base): INDEX_op_qemu_ld_tlbb0/1, see tcg-opc.h.
+ *
+ * tlbb0 (data, negp, adend <- addr): the qemu_ld fast path, with the TLB
+ * addend loaded into adend instead of L0, and negp = -L1: on a hit, L1 is
+ * the address of the page (addr + size - 1 masked by TARGET_PAGE_MASK,
+ * a_mask = 0 here, equal to the comparator: the access does not cross).
+ * negp and adend are "new register" outputs (not addr); they are written
+ * before the access, which writes data (that may be L0, L1 or addr) last.
+ * The slow path sets negp to TARGET_PAGE_SIZE: ea + 0x1000 > 0x1000 - size
+ * for every 32-bit or 64-bit ea below 2^64 - 2^12.
+ *
+ *     mov  L0, addr ; shr ; and [env mask] ; add [env table]
+ *     lea  L1, [addr + size - 1] ; and L1, PAGE_MASK ; cmp L1, [L0 + cmp]
+ *     jne  slow
+ *     mov  adend, [L0 + addend]
+ *     mov  negp, L1 ; neg negp
+ *     mov  data, [addr + adend]
+ *
+ * tlbb1 (data <- addr, negp, adend):
+ *
+ *     lea  L0, [negp + addr]       ; 64-bit: ea - page, addr zero-extended
+ *     cmp  L0, PAGE_SIZE - size    ; unsigned: ea .. ea + size - 1 in page
+ *     ja   ool
+ *     mov  data, [addr + adend]
+ *   raddr:
+ *
+ *   ool: the whole qemu_ld (prepare_host_addr: TLB lookup, its own slow
+ *     path), data, jmp raddr.
+ *
+ * addr: a 32-bit guest address is zero-extended in its register, as for
+ * the fast path of qemu_ld ([addr + L0]).
+ */
+static void tcg_out_qemu_ld_tlbb(TCGContext *s, TCGType type,
+                                 const TCGArg *args, bool covered)
+{
+    MemOpIdx oi = args[4];
+    MemOp mop = get_memop(oi);
+    TCGLabelQemuLdst *l;
+    HostAddress h;
+
+    tcg_debug_assert(tcg_use_softmmu);
+    tcg_debug_assert(memop_alignment_bits(mop) == 0);
+    tcg_debug_assert((mop & MO_SIZE) <= MO_64);
+    if (!covered) {
+        TCGReg data = args[0], negp = args[1], adend = args[2];
+        TCGReg addr = args[3];
+
+        l = prepare_host_addr_ix(s, &h, addr, oi, true, adend);
+        tcg_out_mov(s, TCG_TYPE_I64, negp, TCG_REG_L1);
+        tcg_out_modrm(s, OPC_GRP3_Ev + P_REXW, EXT3_NEG, negp);
+        tcg_out_qemu_ld_direct(s, data, -1, h, type, mop);
+        l->tlbb_kind = 1;
+        l->tlbb_negp = negp;
+    } else {
+        TCGReg data = args[0], addr = args[1], negp = args[2];
+        TCGReg adend = args[3];
+
+        tcg_out_modrm_sib_offset(s, OPC_LEA + P_REXW, TCG_REG_L0,
+                                 negp, addr, 0, 0);
+        tgen_arithi(s, ARITH_CMP + P_REXW, TCG_REG_L0,
+                    TARGET_PAGE_SIZE - memop_size(mop), 0);
+        l = new_ldst_label(s);
+        l->is_ld = true;
+        l->oi = oi;
+        l->addr_reg = addr;
+        l->tlbb_kind = 2;
+        tcg_out_opc(s, OPC_JCC_long + JCC_JA, 0, 0, 0);
+        l->label_ptr[0] = s->code_ptr;
+        s->code_ptr += 4;
+        h.base = addr;
+        h.index = adend;
+        h.ofs = 0;
+        h.seg = 0;
+        h.aa = atom_and_align_for_opc(s, mop, MO_ATOM_WITHIN16, false);
+        tcg_out_qemu_ld_direct(s, data, -1, h, type, mop);
+    }
+    l->type = type;
+    l->datalo_reg = args[0];
+    l->datahi_reg = -1;
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
+/* the out-of-line part of a qemu_ld_tlbb1: the whole qemu_ld */
+static bool tcg_out_qemu_ld_tlbb_slow_path(TCGContext *s,
+                                           TCGLabelQemuLdst *l)
+{
+    TCGLabelQemuLdst *ld;
+    HostAddress h;
+
+    tcg_patch32(l->label_ptr[0], s->code_ptr - l->label_ptr[0] - 4);
+    ld = prepare_host_addr(s, &h, l->addr_reg, l->oi, true);
+    tcg_out_qemu_ld_direct(s, l->datalo_reg, -1, h, l->type,
+                           get_memop(l->oi));
+    ld->type = l->type;
+    ld->datalo_reg = l->datalo_reg;
+    ld->datahi_reg = -1;
+    ld->raddr = l->raddr;
+    tcg_out_jmp(s, l->raddr);
+    return true;
+}
