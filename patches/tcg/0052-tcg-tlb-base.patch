+/*
+ * x-tlb-base-verify (POMPPC tcg/0052, docs/tcg-g4.md section 41): after
+ * each load that went through qemu_ld_tlbb1.  When its test passed
+ * (ea + negp <= page size - size: the access was [ea + adend], no TLB
+ * lookup), the TLB is probed for ea (without fault, nor fill when the
+ * entry is there) and must give a RAM page with no flag at host address
+ * ea + adend.  "Absent": the probe found no readable translation (the
+ * guest changed its page table without tlbie since the first load, which
+ * the architecture lets the TLB keep): counted, not compared.  Summary on
+ * stderr every 2^26 checks and at exit.
+ */
+static uint64_t tlbbv_ok, tlbbv_bad, tlbbv_gone, tlbbv_full;
+static bool tlbbv_atexit;
+
+static void tlbbv_report(void)
+{
+    fprintf(stderr, "tlb-base-verify: %" PRIu64 " chargements couverts "
+            "vérifiés, %" PRIu64 " divergences, %" PRIu64 " absents ; %"
+            PRIu64 " par le chemin complet (adresse hors de la page)\n",
+            qatomic_read(&tlbbv_ok) + qatomic_read(&tlbbv_bad),
+            qatomic_read(&tlbbv_bad), qatomic_read(&tlbbv_gone),
+            qatomic_read(&tlbbv_full));
+}
+
+void helper_tlbb_verify(CPUPPCState *env, target_ulong ea, uint64_t negp,
+                        uint64_t adend, uint32_t desc)
+{
+    unsigned size = desc & 0xff;
+    int mmu_idx = desc >> 8;
+    void *host = NULL;
+    int flags;
+
+    if (!qatomic_read(&tlbbv_atexit)) {
+        qatomic_set(&tlbbv_atexit, true);
+        atexit(tlbbv_report);
+    }
+    if ((uint64_t)ea + negp > TARGET_PAGE_SIZE - size) {
+        qatomic_inc(&tlbbv_full);
+        return;
+    }
+    flags = probe_access_flags(env, ea, 0, MMU_DATA_LOAD, mmu_idx, true,
+                               &host, 0);
+    if (flags & TLB_INVALID_MASK) {
+        qatomic_inc(&tlbbv_gone);
+    } else if (flags || host != (void *)(uintptr_t)((uint64_t)ea + adend)) {
+        if (qatomic_fetch_inc(&tlbbv_bad) < 20) {
+            fprintf(stderr, "tlb-base-verify: DIVERGENCE nip 0x%08" PRIx64
+                    " ea 0x%08" PRIx64 " taille %u idx %d : drapeaux 0x%x,"
+                    " hôte %p au lieu de %p\n", (uint64_t)env->nip,
+                    (uint64_t)ea, size, mmu_idx, flags, host,
+                    (void *)(uintptr_t)((uint64_t)ea + adend));
+        }
+    } else {
+        qatomic_inc(&tlbbv_ok);
+    }
+    if (((qatomic_read(&tlbbv_ok) + 1) & ((1u << 26) - 1)) == 0) {
+        tlbbv_report();
+    }
+}
