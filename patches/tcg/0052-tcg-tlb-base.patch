--- a/target/ppc/mem_helper.c
+++ b/target/ppc/mem_helper.c
@@ -481,6 +481,66 @@ STVE(STVEWX, cpu_stl_be_data_ra, bswap32, u32)
  * above would have stored, same expression, against the value stored.
  * Summary on stderr every 2^26 checks and at exit.
