+    tcg_out_vex_modrm(s, OPC_PCMPEQD, d, u, d);         /* denormal */
+    tcg_out_vex_modrm(s, OPC_PMINUD, u, t, k2);
+    tcg_out_vex_modrm(s, OPC_PCMPEQD, u, u, t);         /* not a NaN */
+    tcg_out_vex_modrm(s, OPC_PANDN, d, d, u);
