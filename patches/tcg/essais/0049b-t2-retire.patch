 static unsigned t2_nctr;
 
+/*
+ * POMPPC_T2_RETIRE=1: a TB that got hot and gave no trace (t2_form: no
+ * chained successor) would count its executions for ever, 6 host
+ * instructions at its head: +17 % on t2bench when all TBs count.  Its
+ * physical pc is noted and the TB translated again without its counter
+ * (T2_DONE).  Forgotten at tb_flush; a page whose code changes keeps its
+ * notes (a missed trace at worst, never a wrong one).
+ */
+bool t2_retire_on;
+static GHashTable *t2_retire_set;
+static QemuSpin t2_retire_spin;
+
+static void __attribute__((constructor)) t2_retire_init(void)
+{
+    t2_retire_on = getenv("POMPPC_T2_RETIRE") &&
+                   strcmp(getenv("POMPPC_T2_RETIRE"), "0");
+    qemu_spin_init(&t2_retire_spin);
+    t2_retire_set = g_hash_table_new(g_int64_hash, g_int64_equal);
+}
+
+void t2_retire(tb_page_addr_t phys_pc)
+{
+    int64_t *k = g_new(int64_t, 1);
+
+    *k = phys_pc;
+    qemu_spin_lock(&t2_retire_spin);
+    if (!g_hash_table_add(t2_retire_set, k)) {
+        k = NULL;
+    }
+    qemu_spin_unlock(&t2_retire_spin);
+    g_free(k);
+}
+
+bool t2_retired(tb_page_addr_t phys_pc)
+{
+    int64_t k = phys_pc;
+    bool r;
+
+    qemu_spin_lock(&t2_retire_spin);
+    r = g_hash_table_contains(t2_retire_set, &k);
+    qemu_spin_unlock(&t2_retire_spin);
+    return r;
+}
+
+static gboolean t2_retire_free(gpointer k, gpointer v, gpointer d)
+{
+    g_free(k);
+    return TRUE;
+}
+
+void t2_retire_flush(void)
+{
+    qemu_spin_lock(&t2_retire_spin);
+    g_hash_table_foreach_remove(t2_retire_set, t2_retire_free, NULL);
+    qemu_spin_unlock(&t2_retire_spin);
+}
+
