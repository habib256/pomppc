+/*
+ * POMPPC essai (tbreplay-sys, accel/tcg/cpu-exec.c): translate the block at
+ * pc where the game ran it -- MSR as in user mode (PR, IR, DR, FP, VR, FE0,
+ * FE1, ME), IBAT0 maps the 128 KiB around pc onto RAM at 64 MiB.
+ */
+bool pomppc_tbreplay_setup(CPUState *cs, vaddr pc, hwaddr *phys);
+bool pomppc_tbreplay_setup(CPUState *cs, vaddr pc, hwaddr *phys)
+{
+    CPUPPCState *env = cpu_env(cs);
+    const hwaddr scratch = 0x04000000;
+
+    env->IBAT[0][0] = (pc & 0xfffe0000) | 3;    /* BEPI, BL = 128 KiB, Vs Vp */
+    env->IBAT[1][0] = scratch | 2;              /* BRPN, PP = read/write */
+    env->msr = (1ull << MSR_PR) | (1ull << MSR_IR) | (1ull << MSR_DR) |
+               (1ull << MSR_FP) | (1ull << MSR_VR) | (1ull << MSR_FE0) |
+               (1ull << MSR_FE1) | (1ull << MSR_ME);
+    hreg_compute_hflags(env);
+    tlb_flush(cs);
+    env->nip = pc;
+    *phys = scratch + (pc & 0x1ffff);
+    return true;
+}
