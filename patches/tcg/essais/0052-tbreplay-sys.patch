+/*
+ * POMPPC essai (patches/tcg/essais, docs/tcg-g4.md section 41.4): the
+ * system-mode tbreplay.  POMPPC_TBREPLAY_SYS=blocs.bin (tools/tcg/tbreplay.py
+ * format: big-endian u32 address, u32 n, n words): at the first cpu_exec,
+ * each block is put in guest RAM and translated at its own address
+ * (pomppc_tbreplay_setup(), target code: an instruction BAT onto the RAM),
+ * never run, then QEMU exits.  With -d in_asm,out_asm, the journal of the
+ * blocks as the system translator emits them, softmmu TLB included.
+ */
+bool pomppc_tbreplay_setup(CPUState *cs, vaddr pc, hwaddr *phys)
+    __attribute__((weak));
+
+static void pomppc_tbreplay_sys(CPUState *cpu)
+{
+    static int started;
+    const char *f = getenv("POMPPC_TBREPLAY_SYS");
+    gchar *buf;
+    gsize len, i = 0;
+    int nb = 0, lost = 0;
+
+    if (!f || !pomppc_tbreplay_setup) {
+        return;
+    }
+    if (qatomic_xchg(&started, 1)) {
+        for (;;) {                              /* the other vCPUs: idle */
+            g_usleep(1000000);
+        }
+    }
+    if (!g_file_get_contents(f, &buf, &len, NULL)) {
+        fprintf(stderr, "tbreplay-sys : %s illisible\n", f);
+        exit(1);
+    }
+    while (i + 8 <= len) {
+        uint32_t pc = ldl_be_p(buf + i), k = ldl_be_p(buf + i + 4);
+        hwaddr phys;
+
+        i += 8;
+        if (i + 4 * k > len) {
+            break;
+        }
+        if (pomppc_tbreplay_setup(cpu, pc, &phys)) {
+            physical_memory_write(phys, buf + i, 4 * k);
+            if (sigsetjmp(cpu->jmp_env, 0) == 0) {
+                TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+
+                s.cflags = curr_cflags(cpu);
+                mmap_lock();
+                tb_gen_code(cpu, s);
+                mmap_unlock();
+                nb++;
+            } else {
+                cpu_exec_longjmp_cleanup(cpu);
+                lost++;
+            }
+        }
+        i += 4 * k;
+    }
+    fflush(NULL);
+    fprintf(stderr, "tbreplay-sys : %d blocs traduits, %d perdus\n", nb, lost);
+    exit(0);
+}
