diff --git a/target/ppc/translate.c b/target/ppc/translate.c
index 461645712..9077ce977 100644
--- a/target/ppc/translate.c
+++ b/target/ppc/translate.c
@@ -189,6 +189,7 @@ struct DisasContext {
     bool fpu_enabled;
     bool fp_inline, fp_verify;  /* x-fp-inline, x-fp-verify (tcg/0007) */
     bool ret_inline, ret_verify; /* x-ret-inline, x-ret-verify (tcg/0008) */
+    bool isync_chain;            /* x-isync-chain (tcg/0009) */
     bool altivec_enabled;
     bool vsx_enabled;
     bool spe_enabled;
@@ -2931,7 +2932,17 @@ static void gen_isync(DisasContext *ctx)
         gen_check_tlb_flush(ctx, false);
     }
     tcg_gen_mb(TCG_MO_ALL | TCG_BAR_SC);
-    ctx->base.is_jmp = DISAS_EXIT_UPDATE;
+    /*
+     * POMPPC tcg/0009 (x-isync-chain).  Nothing an isync synchronises needs
+     * the main loop: a TLB flush it performs above is synchronous, TBs are
+     * looked up again with the new translation (DISAS_CHAIN_UPDATE goes
+     * through helper_lookup_tb_ptr, never goto_tb), modified code has been
+     * invalidated by the store itself, and pending interrupts, exit
+     * requests and queued work are seen by the next TB's prologue
+     * (icount_decr).  Tiger executes ~10^6 isync per second (kernel entry
+     * and exit), each one a round trip through cpu_exec.
+     */
+    ctx->base.is_jmp = ctx->isync_chain ? DISAS_CHAIN_UPDATE : DISAS_EXIT_UPDATE;
 }
 
