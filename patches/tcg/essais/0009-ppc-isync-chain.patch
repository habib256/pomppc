@@ -6533,6 +6544,7 @@ static void ppc_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
     ctx->fp_verify = ctx->fp_inline && env->fp_verify;
     ctx->ret_inline = env->ret_inline;
     ctx->ret_verify = cs->ret_verify;
+    ctx->isync_chain = env->isync_chain;
     ctx->spe_enabled = (hflags >> HFLAGS_SPE) & 1;
     ctx->altivec_enabled = (hflags >> HFLAGS_VR) & 1;
     ctx->vsx_enabled = (hflags >> HFLAGS_VSX) & 1;
