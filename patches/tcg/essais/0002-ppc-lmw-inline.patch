 /***                    Integer load and store multiple                    ***/
 
+/*
+ * x-lmw-inline: lmw/stmw as (32 - r) word loads/stores in the generated code
+ * when [EA, EA + 4 * (32 - r)) lies within one page, the helper otherwise.
+ * Within one page every word has the same translation and permissions, so
+ * either the first access faults (nothing done yet) or none does: the
+ * all-or-nothing behaviour of the helper, which probes the whole range
+ * before touching a register or memory, is kept.  Same memop (big-endian
+ * word, zero-extended into the GPR, no alignment check), same mmu_idx, same
+ * order, EA taken once before any register is written.  No address wrap is
+ * possible inside a page.
+ */
+static void gen_ldst_multiple_inline(DisasContext *ctx, TCGv ea, int r0,
+                                     bool store, TCGv_i32 treg)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv off = tcg_temp_new();
+    TCGv a = tcg_temp_new();
+    int nb = (32 - r0) * 4;
+
+    tcg_gen_andi_tl(off, ea, ~TARGET_PAGE_MASK);
+    tcg_gen_brcondi_tl(TCG_COND_GTU, off, TARGET_PAGE_SIZE - nb, slow);
+    tcg_gen_mov_tl(a, ea);
+    for (int r = r0; r < 32; r++) {
+        if (store) {
+            tcg_gen_qemu_st_tl(cpu_gpr[r], a, ctx->mem_idx, DEF_MEMOP(MO_UL));
+        } else {
+            tcg_gen_qemu_ld_tl(cpu_gpr[r], a, ctx->mem_idx, DEF_MEMOP(MO_UL));
+        }
+        if (r < 31) {
+            tcg_gen_addi_tl(a, a, 4);
+        }
+    }
+    tcg_gen_br(done);
+    gen_set_label(slow);
+    if (store) {
+        gen_helper_stmw(tcg_env, ea, treg);
+    } else {
+        gen_helper_lmw(tcg_env, ea, treg);
+    }
+    gen_set_label(done);
+}
+
 /* lmw */
 static void gen_lmw(DisasContext *ctx)
 {
@@ -2765,6 +2809,10 @@ static void gen_lmw(DisasContext *ctx)
     t0 = tcg_temp_new();
     t1 = tcg_constant_i32(rD(ctx->opcode));
     gen_addr_imm_index(ctx, t0, 0);
+    if (ctx->lmw_inline) {
+        gen_ldst_multiple_inline(ctx, t0, rD(ctx->opcode), false, t1);
+        return;
+    }
     gen_helper_lmw(tcg_env, t0, t1);
 }
 
@@ -2782,6 +2830,10 @@ static void gen_stmw(DisasContext *ctx)
     t0 = tcg_temp_new();
     t1 = tcg_constant_i32(rS(ctx->opcode));
     gen_addr_imm_index(ctx, t0, 0);
+    if (ctx->lmw_inline) {
+        gen_ldst_multiple_inline(ctx, t0, rS(ctx->opcode), true, t1);
+        return;
+    }
     gen_helper_stmw(tcg_env, t0, t1);
 }
 
@@ -6496,6 +6548,7 @@ static void ppc_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
     ctx->has_cfar = !!(env->flags & POWERPC_FLAG_CFAR);
     ctx->has_bhrb = !!(env->flags & POWERPC_FLAG_BHRB);
 #endif
+    ctx->lmw_inline = env->lmw_inline;
     ctx->lazy_tlb_flush = env->mmu_model == POWERPC_MMU_32B
         || env->mmu_model & POWERPC_MMU_64;
 
