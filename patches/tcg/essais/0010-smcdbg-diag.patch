+/*
+ * Invalidate the TBs that overlap [@start, @last] (within one page), for an
+ * instruction-cache synchronisation of the guest (PowerPC icbi, x-icbi-sync).
+ *
+ * A store to a page holding code invalidates the TBs of the written bytes
+ * *before* the store is performed (notdirty_write).  With MTTCG another
+ * vCPU can translate the old bytes in between and link a TB that no later
+ * store has invalidated yet: the guest's own synchronisation (dcbst, sync,
+ * icbi, isync, then a flag) does not help, the stale TB stays valid until
+ * the next store to those bytes.  icbi comes after the store in program
+ * order: invalidating here closes the window.  The overlap is tested with
+ * the page lock held, so a translation in progress (it holds the lock from
+ * before it reads the code until the TB is linked) is waited for; a
+ * translation that starts after reads the new bytes.  Returns true if TBs
+ * were invalidated.
+ */
+bool tb_invalidate_phys_line_sync(tb_page_addr_t start, tb_page_addr_t last)
+{
+    PageDesc *pd = page_find(start >> TARGET_PAGE_BITS);
+    TranslationBlock *tb;
+    PageForEachNext n;
+    bool hit = false;
+
+    tcg_debug_assert(((start ^ last) & TARGET_PAGE_MASK) == 0);
+    if (!pd) {
+        return false;
+    }
+    page_lock(pd);
+    PAGE_FOR_EACH_TB(start, last, pd, tb, n) {
+        tb_page_addr_t tb_start = tb_page_addr0(tb);
+        tb_page_addr_t tb_last = tb_start + tb->size - 1;
+
+        if (n == 0) {
+            tb_last = MIN(tb_last, tb_start | ~TARGET_PAGE_MASK);
+        } else {
+            tb_start = tb_page_addr1(tb);
+            tb_last = tb_start + (tb_last & ~TARGET_PAGE_MASK);
+        }
+        if (!(tb_last < start || tb_start > last)) {
+            hit = true;
+            break;
+        }
+    }
+    page_unlock(pd);
+    if (hit) {
+        /* takes the locks of every page of the TBs found, in order */
+        tb_invalidate_phys_range(start, last);
+    }
+    return hit;
+}
