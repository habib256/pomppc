+/* ---- SMCDBG : instrumentation de diagnostic (POMPPC_SMCDBG=1) ---- */
+bool smcdbg_on;
+typedef struct SmcEv {
+    uint64_t seq;
+    uint64_t page;
+    int32_t cpu;
+    char type;
+    uint32_t arg;
+    uint64_t vaddr;
+} SmcEv;
+#define SMCDBG_RING (1u << 21)
+static SmcEv *smcdbg_ring;
+static uint64_t smcdbg_seq;
+
+static void __attribute__((constructor)) smcdbg_init(void)
+{
+    const char *e = getenv("POMPPC_SMCDBG");
+    if (e && *e && *e != '0') {
+        smcdbg_on = true;
+        smcdbg_ring = calloc(SMCDBG_RING, sizeof(SmcEv));
+        fprintf(stderr, "smcdbg: actif\n");
+    }
+}
+
+static void smcdbg_ev(uint64_t page, char type, uint32_t arg, uint64_t vaddr)
+{
+    uint64_t s;
+    SmcEv *e;
+
+    if (likely(!smcdbg_on)) {
+        return;
+    }
+    s = qatomic_fetch_inc(&smcdbg_seq);
+    e = &smcdbg_ring[s & (SMCDBG_RING - 1)];
+    e->page = page & TARGET_PAGE_MASK;
+    e->cpu = current_cpu ? current_cpu->cpu_index : -1;
+    e->type = type;
+    e->arg = arg;
+    e->vaddr = vaddr;
+    qatomic_store_release(&e->seq, s + 1);
+}
+
+bool tb_smcdbg_page(tb_page_addr_t page, TranslationBlock *tb, int *ntb);
+
+static int smcdbg_dumps;
+
+static void smcdbg_dump(CPUState *cpu, TranslationBlock *tb, uint32_t cur,
+                        long n)
+{
+    ram_addr_t ra = tb_page_addr0(tb), page = ra & TARGET_PAGE_MASK;
+    uintptr_t hpage = (uintptr_t)qemu_map_ram_ptr(NULL, page);
+    bool code_dirty = cpu_physical_memory_get_dirty_flag(page, DIRTY_MEMORY_CODE);
+    int ntb = 0;
+    bool inlist = tb_smcdbg_page(page, tb, &ntb);
+    uint64_t s, last = qatomic_read(&smcdbg_seq);
+    CPUState *c;
+    int k = 0;
+
+    fprintf(stderr, "smcdbg[%d]: cpu%d tb %p pc %" VADDR_PRIx " ram %" PRIx64
+            " w0 %08x mem %08x apres %ld recherches ; cflags %x inval %d"
+            " CODE-sale %d dans-la-liste %d blocs-de-la-page %d\n",
+            smcdbg_dumps, cpu->cpu_index, tb, tb->pc, (uint64_t)ra,
+            tb->smcdbg_w0, cur, n, tb_cflags(tb),
+            !!(tb_cflags(tb) & CF_INVALID), code_dirty, inlist, ntb);
+    CPU_FOREACH(c) {
+        int mmu_idx;
+        qemu_spin_lock(&c->neg.tlb.c.lock);
+        for (mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
+            unsigned int i, nent = tlb_n_entries(&c->neg.tlb.f[mmu_idx]);
+            for (i = 0; i < nent + CPU_VTLB_SIZE; i++) {
+                CPUTLBEntry *te = i < nent ? &c->neg.tlb.f[mmu_idx].table[i]
+                                  : &c->neg.tlb.d[mmu_idx].vtable[i - nent];
+                uint64_t aw = te->addr_write;
+                if (aw == -1 || (aw & TLB_INVALID_MASK)) {
+                    continue;
+                }
+                if ((aw & TARGET_PAGE_MASK) + te->addend == hpage) {
+                    fprintf(stderr, "smcdbg:   tlb cpu%d mmu%d %s%u vaddr %"
+                            PRIx64 " addr_write bas %" PRIx64 " NOTDIRTY %d\n",
+                            c->cpu_index, mmu_idx, i < nent ? "p" : "v",
+                            i < nent ? i : i - nent, aw & TARGET_PAGE_MASK,
+                            aw & ~TARGET_PAGE_MASK, !!(aw & TLB_NOTDIRTY));
+                }
+            }
+        }
+        qemu_spin_unlock(&c->neg.tlb.c.lock);
+    }
+    /* derniers evenements de la page, du plus recent au plus ancien */
+    for (s = last; s > 0 && last - s < SMCDBG_RING && k < 60; s--) {
+        SmcEv *e = &smcdbg_ring[(s - 1) & (SMCDBG_RING - 1)];
+        if (qatomic_load_acquire(&e->seq) != s || e->page != page) {
+            continue;
+        }
+        fprintf(stderr, "smcdbg:   ev -%" PRIu64 " cpu%d %c %u vaddr %" PRIx64 "\n",
+                last - s, e->cpu, e->type, e->arg, e->vaddr);
+        k++;
+    }
+    smcdbg_dumps++;
+}
+
+void smcdbg_check(CPUState *cpu, TranslationBlock *tb);
+void smcdbg_check(CPUState *cpu, TranslationBlock *tb)
+{
+    static __thread TranslationBlock *last_tb;
+    static __thread long n;
+    ram_addr_t ra;
+    uint32_t cur;
+
+    if (tb->size != 8 || tb->icount != 2) {
+        return;
+    }
+    ra = tb_page_addr0(tb);
+    if (ra == -1) {
+        return;
+    }
+    cur = ldl_be_p(qemu_map_ram_ptr(NULL, ra));
+    if (cur == tb->smcdbg_w0) {
+        last_tb = NULL;
+        return;
+    }
+    if (last_tb != tb) {
+        last_tb = tb;
+        n = 0;
+    }
+    if (++n == 20000 && smcdbg_dumps < 40) {
+        smcdbg_dump(cpu, tb, cur, n);
+    }
+}
+/* ---- fin SMCDBG ---- */
