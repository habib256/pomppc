+/*
+ * Write-protect a page before its code is read by the translator
+ * (called with @pd locked).  A page without TBs is not protected: another
+ * vCPU may store to it through a TLB entry without TLB_NOTDIRTY.  If the
+ * protection were only set when the TB is linked (tb_page_add), a store
+ * landing between the translator's read of the guest code and the link
+ * would never be seen, and the stale TB would stay valid until the next
+ * write to the page.  Protecting first makes every later store take the
+ * notdirty path, which blocks on the page lock held here and invalidates
+ * the new TB once it is linked.
+ */
+static void tb_page_protect_locked(PageDesc *pd, tb_page_addr_t paddr)
+{
+    if (!pd->first_tb) {
+        tlb_protect_code(paddr & TARGET_PAGE_MASK);
+    }
+}
