@@ -317,6 +331,11 @@ static void tcg_accel_class_init(ObjectClass *oc, void *data)
         "log2 of the number of jump-cache entries per CPU, 12 (stock) "
         "to 16 (POMPPC tcg/0011, docs/tcg-g4.md 18)");
 
+    object_class_property_add_bool(oc, "x-jc-mix",
+        tcg_get_jc_mix, tcg_set_jc_mix);
+    object_class_property_set_description(oc, "x-jc-mix",
+        "Jump-cache hash folds the whole page number (POMPPC tcg/0011)");
+
     object_class_property_add(oc, "x-jit-addr", "uint64",
         tcg_get_jit_addr, tcg_set_jit_addr, NULL, NULL);
     object_class_property_set_description(oc, "x-jit-addr",
