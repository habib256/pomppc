diff --git a/accel/tcg/tb-hash.h b/accel/tcg/tb-hash.h
index a0c61f2..9dcda52 100644
--- a/accel/tcg/tb-hash.h
+++ b/accel/tcg/tb-hash.h
@@ -35,9 +35,31 @@
 #define TB_JMP_ADDR_MASK (TB_JMP_PAGE_SIZE - 1)
 #define TB_JMP_PAGE_MASK (TB_JMP_CACHE_SIZE - TB_JMP_PAGE_SIZE)
 
+/*
+ * POMPPC tcg/0011 (x-jc-mix): the stock page part only sees the page-number
+ * bits 12 .. 12 + 2 * TB_JMP_PAGE_BITS; everything above is ignored, so code
+ * at the same low address in different 16 MiB regions (kernel, application,
+ * frameworks at 0x9xxxxxxx under Mac OS X) always collides.  With x-jc-mix
+ * the page part folds the whole page number (xor of successive slices of
+ * TB_JMP_CACHE_BITS - TB_JMP_PAGE_BITS bits).  It stays a function of the
+ * page number alone: all the pcs of a page still share the TB_JMP_PAGE_SIZE
+ * slots from tb_jmp_cache_hash_page(), which tb_jmp_cache_clear_page needs.
+ */
+static inline unsigned int tb_jmp_cache_mix_page(vaddr pc)
+{
+    unsigned hb = tb_jmp_cache_bits - TB_JMP_PAGE_BITS;
+    vaddr p = pc >> TARGET_PAGE_BITS;
+
+    p ^= (p >> hb) ^ (p >> (2 * hb)) ^ (p >> (3 * hb));
+    return (p << TB_JMP_PAGE_BITS) & TB_JMP_PAGE_MASK;
+}
+
 static inline unsigned int tb_jmp_cache_hash_page(vaddr pc)
 {
     vaddr tmp;
+    if (tb_jmp_cache_mix) {
+        return tb_jmp_cache_mix_page(pc);
+    }
     tmp = pc ^ (pc >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS));
     return (tmp >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS)) & TB_JMP_PAGE_MASK;
 }
@@ -46,6 +68,9 @@ static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 {
     vaddr tmp;
     tmp = pc ^ (pc >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS));
+    if (tb_jmp_cache_mix) {
+        return tb_jmp_cache_mix_page(pc) | (tmp & TB_JMP_ADDR_MASK);
+    }
     return (((tmp >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS)) & TB_JMP_PAGE_MASK)
            | (tmp & TB_JMP_ADDR_MASK));
 }
