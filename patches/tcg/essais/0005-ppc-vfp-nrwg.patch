 #undef VARITHFPFMA
 
+/*
+ * x-vfp-nrwg: the same helpers under TCG_CALL_NO_RWG.  Legal: they read and
+ * write only the AVRs (env->vsr) and env->vec_status, neither of which is a
+ * TCG global, and raise no guest exception (AltiVec has no FP traps).
+ */
+void helper_vaddfp_nrwg(CPUPPCState *env, ppc_avr_t *r, ppc_avr_t *a,
+                        ppc_avr_t *b)
+{
+    helper_vaddfp(env, r, a, b);
+}
+void helper_vsubfp_nrwg(CPUPPCState *env, ppc_avr_t *r, ppc_avr_t *a,
+                        ppc_avr_t *b)
+{
+    helper_vsubfp(env, r, a, b);
+}
+void helper_vmaddfp_nrwg(CPUPPCState *env, ppc_avr_t *r, ppc_avr_t *a,
+                         ppc_avr_t *b, ppc_avr_t *c)
+{
+    helper_vmaddfp(env, r, a, b, c);
+}
+void helper_vnmsubfp_nrwg(CPUPPCState *env, ppc_avr_t *r, ppc_avr_t *a,
+                          ppc_avr_t *b, ppc_avr_t *c)
+{
+    helper_vnmsubfp(env, r, a, b, c);
+}
+
