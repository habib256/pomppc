--- /dev/null
+++ b/accel/tcg/retv-instr.c.inc
@@ -0,0 +1,153 @@
+/*
+ * RETV : instrumentation temporaire (cas « sans traduction » de
+ * x-ret-verify), incluse à la fin de cputlb.c.  POMPPC_RV_WATCH=<pc> :
+ * journal des événements de la page de ce pc (entrée de code du TLB de
+ * mmu_idx 1 présente/absente et par quel chemin, entrée du cache de sauts
+ * de ce pc présente/absente et par quel chemin, remplissages, SR/BAT/SDR1)
+ * et de tous les tlbie ; imprimé à la divergence par le crochet de la cible.
+ */
+uint64_t pomppc_rv_watch;
+void (*pomppc_rv_dump_fn)(CPUState *cpu, vaddr pc);
+static QemuSpin rv_spin;
+static uint64_t rv_seq;
+#define RV_LOG 512
+static struct RvEv {
+    uint64_t seq, ns, a, b;
+    int cpu;
+    const char *what;
+} rv_log[RV_LOG], rv_tlbie[RV_LOG];
+static unsigned rv_log_n, rv_tlbie_n;
+static int8_t rv_tlb_state[16], rv_jc_state[16];
+static int64_t rv_t0;
+
+static void __attribute__((constructor)) rv_init(void)
+{
+    const char *w = getenv("POMPPC_RV_WATCH");
+
+    qemu_spin_init(&rv_spin);
+    memset(rv_tlb_state, -1, sizeof(rv_tlb_state));
+    memset(rv_jc_state, -1, sizeof(rv_jc_state));
+    if (w) {
+        pomppc_rv_watch = strtoull(w, NULL, 0);
+    }
+}
+
+static void rv_put(struct RvEv *ring, unsigned *n, CPUState *cpu,
+                   const char *what, uint64_t a, uint64_t b)
+{
+    int64_t now = get_clock_realtime();
+
+    qemu_spin_lock(&rv_spin);
+    if (!rv_t0) {
+        rv_t0 = now;
+    }
+    ring[(*n)++ % RV_LOG] = (struct RvEv){ ++rv_seq, now - rv_t0, a, b,
+                                           cpu ? cpu->cpu_index : -1, what };
+    qemu_spin_unlock(&rv_spin);
+}
+
+void pomppc_rv_log(CPUState *cpu, const char *what, uint64_t a, uint64_t b)
+{
+    if (pomppc_rv_watch) {
+        rv_put(rv_log, &rv_log_n, cpu, what, a, b);
+    }
+}
+
+void pomppc_rv_tlbie(CPUState *cpu, uint64_t ea, uint64_t nip)
+{
+    rv_put(rv_tlbie, &rv_tlbie_n, cpu, "tlbie", ea, nip);
+}
+
+/* imprime les anneaux ; @mark(ea) : un tlbie de ce PTEG primaire */
+void pomppc_rv_print(bool (*mark)(CPUState *, uint64_t), CPUState *cpu,
+                     unsigned last_tlbie)
+{
+    qemu_spin_lock(&rv_spin);
+    fprintf(stderr, "retv: --- journal de la page (%u événements, les %u"
+            " derniers) ---\n", rv_log_n, MIN(rv_log_n, RV_LOG));
+    for (unsigned k = rv_log_n > RV_LOG ? rv_log_n - RV_LOG : 0;
+         k < rv_log_n; k++) {
+        struct RvEv *e = &rv_log[k % RV_LOG];
+        fprintf(stderr, "retv:  #%" PRIu64 " t=%.6f cpu %d %-28s 0x%"
+                PRIx64 " 0x%" PRIx64 "\n", e->seq, e->ns / 1e9, e->cpu,
+                e->what, e->a, e->b);
+    }
+    last_tlbie = MIN(last_tlbie, RV_LOG);
+    fprintf(stderr, "retv: --- %u derniers tlbie (sur %u) ; * : même PTEG"
+            " primaire que la page surveillée ---\n",
+            MIN(rv_tlbie_n, last_tlbie), rv_tlbie_n);
+    for (unsigned k = rv_tlbie_n > last_tlbie ? rv_tlbie_n - last_tlbie : 0;
+         k < rv_tlbie_n; k++) {
+        struct RvEv *e = &rv_tlbie[k % RV_LOG];
+        fprintf(stderr, "retv:  #%" PRIu64 " t=%.6f cpu %d tlbie ea 0x%08"
+                PRIx64 " nip 0x%08" PRIx64 "%s\n", e->seq, e->ns / 1e9,
+                e->cpu, e->a, e->b, mark && mark(cpu, e->a) ? " *" : "");
+    }
+    qemu_spin_unlock(&rv_spin);
+}
+
+static bool rv_tlb_has(CPUState *cpu, int idx, vaddr page)
+{
+    CPUTLBDesc *d = &cpu->neg.tlb.d[idx];
+    CPUTLBDescFast *f = cpu_tlb_fast(cpu, idx);
+
+    if (!f->table) {
+        return false;
+    }
+    if (tlb_hit_page(tlb_entry(cpu, idx, page)->addr_code, page)) {
+        return true;
+    }
+    for (int k = 0; k < CPU_VTLB_SIZE; k++) {
+        if (tlb_hit_page(d->vtable[k].addr_code, page)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* entrée de code de la page surveillée dans le TLB de mmu_idx 1 */
+void pomppc_rv_tlb_check(CPUState *cpu, const char *site)
+{
+    vaddr page = pomppc_rv_watch & TARGET_PAGE_MASK;
+    int c = cpu->cpu_index & 15;
+    int8_t now;
+
+    if (likely(!pomppc_rv_watch)) {
+        return;
+    }
+    now = rv_tlb_has(cpu, 1, page);
+    if (now != rv_tlb_state[c]) {
+        rv_tlb_state[c] = now;
+        pomppc_rv_log(cpu, now ? "TLB code idx1 : PRÉSENTE" :
+                      "TLB code idx1 : absente", page, (uintptr_t)site);
+        fprintf(stderr, "retv: cpu %d TLB code idx1 page 0x%" VADDR_PRIx
+                " %s (%s)\n", cpu->cpu_index, page,
+                now ? "présente" : "absente", site);
+    }
+}
+
+/* entrée du cache de sauts du pc surveillé */
+void pomppc_rv_jc_check(CPUState *cpu, const char *site)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    int c = cpu->cpu_index & 15;
+    unsigned h;
+    TranslationBlock *tb;
+    int8_t now;
+
+    if (likely(!pomppc_rv_watch) || !jc) {
+        return;
+    }
+    h = tb_jmp_cache_hash_func(pomppc_rv_watch);
+    tb = qatomic_read(&jc->array[h].tb);
+    now = tb && jc->array[h].pc == pomppc_rv_watch;
+    if (now != rv_jc_state[c]) {
+        rv_jc_state[c] = now;
+        pomppc_rv_log(cpu, now ? "cache de sauts : PRÉSENTE" :
+                      "cache de sauts : absente", (uintptr_t)tb,
+                      jc->idx[h]);
+        fprintf(stderr, "retv: cpu %d cache de sauts pc 0x%" PRIx64
+                " %s (%s) tb %p idx %d\n", cpu->cpu_index, pomppc_rv_watch,
+                now ? "présente" : "absente", site, (void *)tb, jc->idx[h]);
+    }
+}
