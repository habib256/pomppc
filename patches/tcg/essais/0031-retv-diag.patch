+/*
+ * RETV (instrumentation temporaire) : la PTE de @ea dans la table hachée,
+ * sans effet de bord ; *pteg : adresse physique du PTEG primaire.
+ * Rend l'adresse physique de la PTE, -1 si aucune.
+ */
+hwaddr pomppc_rv_pte(PowerPCCPU *cpu, target_ulong ea, uint32_t *pte0,
+                     uint32_t *pte1, hwaddr *pteg)
+{
+    target_ulong sr = cpu->env.sr[(ea >> 28) & 15];
+    ppc_hash_pte32_t pte = { 0, 0 };
+    uint32_t vsid = sr & SR32_VSID;
+    uint32_t pgidx = (ea & ~SEGMENT_MASK_256M) >> TARGET_PAGE_BITS;
+    hwaddr off;
+
+    *pteg = ppc_hash32_hpt_base(cpu) + get_pteg_offset32(cpu, vsid ^ pgidx);
+    off = ppc_hash32_htab_lookup(cpu, sr, ea, &pte);
+    *pte0 = pte.pte0;
+    *pte1 = pte.pte1;
+    return off == -1 ? -1 : ppc_hash32_hpt_base(cpu) + off;
+}
