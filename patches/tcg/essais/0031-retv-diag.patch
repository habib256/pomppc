+static bool rv_same_pteg(CPUState *cs, uint64_t ea)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    uint32_t p0, p1;
+    hwaddr g1, g2;
+
+    pomppc_rv_pte(cpu, pomppc_rv_watch, &p0, &p1, &g1);
+    pomppc_rv_pte(cpu, ea, &p0, &p1, &g2);
+    return g1 == g2;
+}
+
+static void rv_dump_pteg(PowerPCCPU *cpu, hwaddr g, const char *nm)
+{
+    CPUState *cs = CPU(cpu);
+    hwaddr base = cpu->env.spr[SPR_SDR1] & 0xffff0000;
+    uint32_t idx = (g - base) / 64;
+
+    fprintf(stderr, "retv: PTEG %s 0x%08" PRIx64 " (indice 0x%x)\n", nm,
+            (uint64_t)g, idx);
+    for (int i = 0; i < 8; i++) {
+        uint32_t p0 = ldl_phys(cs->as, g + i * 8);
+        uint32_t p1 = ldl_phys(cs->as, g + i * 8 + 4);
+        uint32_t vsid = (p0 >> 7) & 0xffffff, h = (p0 >> 6) & 1;
+        uint32_t api = p0 & 0x3f;
+        /* page dans le segment : API (6 bits hauts) et 10 bits du hachage */
+        uint32_t hash = h ? ~idx : idx;
+        uint32_t pg = (api << 10) | ((hash ^ vsid) & 0x3ff);
+
+        fprintf(stderr, "retv:   [%d] %08x %08x  V=%u H=%u VSID 0x%06x"
+                " page-du-segment 0x%04x RPN 0x%08x WIMG %x PP %u\n", i, p0,
+                p1, p0 >> 31, h, vsid, pg, p1 & ~0xfffu, (p1 >> 3) & 15,
+                p1 & 3);
+    }
+}
+
+static void rv_dump(CPUState *cs, vaddr pc)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    CPUPPCState *env = &cpu->env;
+    uint32_t p0, p1;
+    hwaddr g, pte;
+    uint32_t vsid = env->sr[(pc >> 28) & 15] & 0xffffff;
+    uint32_t pgidx = (pc & 0x0fffffff) >> 12;
+
+    fprintf(stderr, "retv: msr 0x%" PRIx64 " nip 0x%" PRIx64 " sdr1 0x%"
+            PRIx64 " sr[%d] 0x%" PRIx64 " mmu_idx %d tlb_need_flush 0x%x\n",
+            (uint64_t)env->msr, (uint64_t)env->nip,
+            (uint64_t)env->spr[SPR_SDR1], (int)((pc >> 28) & 15),
+            (uint64_t)env->sr[(pc >> 28) & 15], ppc_env_mmu_index(env, true),
+            env->tlb_need_flush);
+    for (int i = 0; i < env->nb_BATs; i++) {
+        fprintf(stderr, "retv: IBAT%d %08" PRIx64 " %08" PRIx64
+                "  DBAT%d %08" PRIx64 " %08" PRIx64 "\n", i,
+                (uint64_t)env->IBAT[0][i], (uint64_t)env->IBAT[1][i], i,
+                (uint64_t)env->DBAT[0][i], (uint64_t)env->DBAT[1][i]);
+    }
+    pte = pomppc_rv_pte(cpu, pc, &p0, &p1, &g);
+    fprintf(stderr, "retv: page 0x%04x du segment, VSID 0x%06x : PTE %s"
+            " 0x%" PRIx64 " (%08x %08x)\n", pgidx, vsid,
+            pte == (hwaddr)-1 ? "ABSENTE" : "à", (uint64_t)pte, p0, p1);
+    rv_dump_pteg(cpu, g, "primaire");
+    {
+        hwaddr base = env->spr[SPR_SDR1] & 0xffff0000;
+        hwaddr mask = ((env->spr[SPR_SDR1] & 0x1ff) << 16) | 0xffc0;
+        rv_dump_pteg(cpu, base + ((~(hwaddr)(vsid ^ pgidx) * 64) & mask),
+                     "secondaire");
+    }
+    pomppc_rv_print(rv_same_pteg, cs, 96);
+}
+
+static void __attribute__((constructor)) rv_dump_init(void)
+{
+    pomppc_rv_dump_fn = rv_dump;
+}
 
