 /* update the TLBs so that writes to code in the virtual page 'addr'
    can be detected */
+uint64_t smcstat_r1, smcstat_r2, smcstat_r3, smcstat_prot, smcstat_tb;
+static uint64_t smcstat_n;
+void smcstat_print(void);
+/* releve periodique (POMPPC_SMCSTAT_S secondes, 15 par defaut ; 0 : aucun) */
+static void *smcstat_thread(void *arg)
+{
+    unsigned s = (unsigned)(uintptr_t)arg;
+    for (;;) {
+        sleep(s);
+        smcstat_print();
+    }
+    return NULL;
+}
+static void __attribute__((constructor)) smcstat_init(void)
+{
+    const char *e = getenv("POMPPC_SMCSTAT_S");
+    unsigned s = e ? atoi(e) : 15;
+    pthread_t th;
+    atexit(smcstat_print);
+    if (s && pthread_create(&th, NULL, smcstat_thread, (void *)(uintptr_t)s) == 0) {
+        pthread_detach(th);
+    }
+}
+void smcstat_print(void)
+{
+    fprintf(stderr, "smcstat: t=%ld protections %" PRIu64 " blocs-sur-page-neuve %" PRIu64
+            " course1(ecrit-pendant-traduction) %" PRIu64
+            " course2(set_dirty) %" PRIu64 " course3(remplissage) %" PRIu64 "\n",
+            (long)time(NULL), smcstat_prot, smcstat_tb, smcstat_r1, smcstat_r2, smcstat_r3);
+}
