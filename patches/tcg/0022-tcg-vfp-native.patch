+/* vfp-native-gate: début (extrait tel quel par POMPPC tools/tcg/vfpproof.sh) */
+/*
+ * POMPPC tcg/0022 (x-vfp-native): vfp_can_use_fpu() of int_helper.c,
+ *   !no_hardfloat && (flags & inexact) && rounding == nearest_even &&
+ *   !rebias_overflow && !rebias_underflow,
+ * as ((window 0 & mask0) == val0 && (window 1 & mask1) == val1), the two
+ * windows being the first and the last 8 bytes of the float_status (they
+ * overlap when it is smaller than 16 bytes: 12 with GCC on x86_64, with
+ * no_hardfloat in byte 8), for the generated code.  The bit-field layout
+ * is the compiler's: each field is set alone in a zeroed float_status and
+ * its bytes read back; a field goes to the first window that holds all of
+ * them.  If one fits in neither, x-vfp-native is left off (vfn_gate_ok).
+ */
+static bool vfn_field(const float_status *f, uint64_t *m)
+{
+    uint8_t raw[sizeof(float_status)];
+    size_t sz = sizeof(raw), lo = sz, hi = 0;
+    uint64_t w;
+
+    memcpy(raw, f, sz);
+    for (size_t i = 0; i < sz; i++) {
+        if (raw[i]) {
+            lo = MIN(lo, i);
+            hi = i;
+        }
+    }
+    if (lo == sz) {
+        return false;
+    }
+    if (hi < 8) {
+        memcpy(&w, raw, 8);
+        m[0] |= w;
+        return true;
+    }
+    if (lo >= sz - 8) {
+        memcpy(&w, raw + sz - 8, 8);
+        m[1] |= w;
+        return true;
+    }
+    return false;
+}
+
+static void ppc_vfn_gate_init(CPUPPCState *env)
+{
+    float_status f;
+    uint8_t raw[sizeof(float_status)];
+    uint64_t m[2] = { 0, 0 }, v;
+    bool ok = sizeof(float_status) >= 8 && sizeof(float_status) <= 16;
+
+    if (ok) {
+        memset(&f, 0, sizeof(f));
+        f.no_hardfloat = 1;
+        ok &= vfn_field(&f, m);
+        memset(&f, 0, sizeof(f));
+        f.float_exception_flags = float_flag_inexact;
+        ok &= vfn_field(&f, m);
+        memset(&f, 0, sizeof(f));
+        f.float_rounding_mode = 7;              /* the whole 3-bit field */
+        ok &= vfn_field(&f, m);
+        memset(&f, 0, sizeof(f));
+        f.rebias_overflow = 1;
+        ok &= vfn_field(&f, m);
+        memset(&f, 0, sizeof(f));
+        f.rebias_underflow = 1;
+        ok &= vfn_field(&f, m);
+    }
+    env->vfn_gate_ok = ok;
+    if (!ok) {
+        if (env->vfp_native) {
+            warn_report("x-vfp-native: float_status layout not supported, "
+                        "the original helpers are used");
+        }
+        return;
+    }
+    memset(&f, 0, sizeof(f));
+    f.float_exception_flags = float_flag_inexact;
+    f.float_rounding_mode = float_round_nearest_even;
+    memcpy(raw, &f, sizeof(raw));
+    env->vfn_gate_ofs[0] = 0;
+    env->vfn_gate_ofs[1] = sizeof(float_status) - 8;
+    for (int k = 0; k < 2; k++) {
+        memcpy(&v, raw + env->vfn_gate_ofs[k], 8);
+        env->vfn_gate_mask[k] = m[k];
+        env->vfn_gate_val[k] = v & m[k];
+    }
+}
+/* vfp-native-gate: fin */
