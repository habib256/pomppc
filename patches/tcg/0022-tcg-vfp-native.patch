+
+static void gen_vfp_native(DisasContext *ctx, int kind, int rd, int ra,
+                           int rb, int rc, const void *helper)
+{
+    const CPUPPCState *env = ctx->env;
+    intptr_t vs = offsetof(CPUPPCState, vec_status);
+
+    if (ctx->vfp_nverify) {
+        gen_helper_vfn_save(tcg_env, tcg_constant_i32(ra | rb << 8 | rc << 16));
+    }
+    tcg_gen_ppc_vfp(kind, avr_full_offset(rd), avr_full_offset(ra),
+                    avr_full_offset(rb), avr_full_offset(rc), helper,
+                    vs + env->vfn_gate_ofs[0], env->vfn_gate_mask[0],
+                    env->vfn_gate_val[0],
+                    vs + env->vfn_gate_ofs[1], env->vfn_gate_mask[1],
+                    env->vfn_gate_val[1]);
+    if (ctx->vfp_nverify) {
+        gen_helper_vfn_verify(tcg_env, tcg_constant_i32(kind | rd << 8));
+    }
