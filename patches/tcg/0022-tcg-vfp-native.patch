 #undef VARITHFPFMA
 
+/*
+ * POMPPC tcg/0022, x-vfp-native-verify: before each INDEX_op_ppc_vfp the
+ * operands and vec_status are saved (helper_vfn_save); after it, the
+ * instruction is re-done from them by the per-lane loop of softfloat, as
+ * QEMU without x-vfp-fast does it, and vD and the whole vec_status must be
+ * equal.  On a divergence the reference values are written back.  Also
+ * counts the operations the inline short path should have taken
+ * (vfp_add4()/vfp_fma4() succeed and no lane is infinite).  Summary on
+ * stderr every 2^26 checks and at exit.
+ */
+enum { VFN_ADD, VFN_SUB, VFN_MADD, VFN_NMSUB };     /* vmx-impl.c.inc */
+static uint64_t vfn_n, vfn_short, vfn_bad;
+static bool vfn_atexit;
+
+static void vfn_report(void)
+{
+    fprintf(stderr, "vfp-native-verify: %" PRIu64 " opérations vérifiées "
+            "(%" PRIu64 " prédites par le chemin court), %" PRIu64
+            " divergences\n", qatomic_read(&vfn_n), qatomic_read(&vfn_short),
+            qatomic_read(&vfn_bad));
+}
+
+void helper_vfn_save(CPUPPCState *env, uint32_t regs)
+{
+    env->vfn_in[0] = *cpu_avr_ptr(env, regs & 31);
+    env->vfn_in[1] = *cpu_avr_ptr(env, (regs >> 8) & 31);
+    env->vfn_in[2] = *cpu_avr_ptr(env, (regs >> 16) & 31);
+    env->vfn_vs = env->vec_status;
+}
+
+void helper_vfn_verify(CPUPPCState *env, uint32_t desc)
+{
+    int kind = desc & 3, rd = (desc >> 8) & 31, i;
+    ppc_avr_t *a = &env->vfn_in[0], *b = &env->vfn_in[1], *c = &env->vfn_in[2];
+    ppc_avr_t ref, fast, *r = cpu_avr_ptr(env, rd);
+    float_status s = env->vfn_vs, sf = env->vfn_vs;
+    bool ok, bad;
+
+    for (i = 0; i < ARRAY_SIZE(ref.f32); i++) {
+        switch (kind) {
+        case VFN_ADD:
+            ref.f32[i] = float32_add(a->f32[i], b->f32[i], &s);
+            break;
+        case VFN_SUB:
+            ref.f32[i] = float32_sub(a->f32[i], b->f32[i], &s);
+            break;
+        case VFN_MADD:
+            ref.f32[i] = float32_muladd(a->f32[i], c->f32[i], b->f32[i], 0, &s);
+            break;
+        default:
+            ref.f32[i] = float32_muladd(a->f32[i], c->f32[i], b->f32[i],
+                                        float_muladd_negate_result |
+                                        float_muladd_negate_c, &s);
+            break;
+        }
+    }
+    /* the inline short path: x-vfp-fast's, without an infinite lane */
+    if (kind <= VFN_SUB) {
+        ok = env->vfp_fast &&
+             vfp_add4(&sf, fast.u32, a->u32, b->u32, kind == VFN_SUB);
+    } else {
+        ok = env->vfp_fast &&
+             vfp_fma4(&sf, fast.u32, a->u32, b->u32, c->u32,
+                      kind == VFN_MADD ? 0 : float_muladd_negate_result |
+                                             float_muladd_negate_c);
+    }
+    for (i = 0; ok && i < 4; i++) {
+        ok = (fast.u32[i] & 0x7fffffff) != 0x7f800000;
+    }
+    if (ok) {
+        qatomic_inc(&vfn_short);
+    }
+    bad = ref.VsrD(0) != r->VsrD(0) || ref.VsrD(1) != r->VsrD(1) ||
+          memcmp(&s, &env->vec_status, sizeof(s));
+    if (bad) {
+        if (qatomic_fetch_inc(&vfn_bad) < 20) {
+            fprintf(stderr, "vfp-native-verify: op %d v%d : %08x %08x %08x %08x"
+                    " flags %04x, attendu %08x %08x %08x %08x flags %04x\n",
+                    kind, rd, r->VsrW(0), r->VsrW(1), r->VsrW(2), r->VsrW(3),
+                    get_float_exception_flags(&env->vec_status),
+                    ref.VsrW(0), ref.VsrW(1), ref.VsrW(2), ref.VsrW(3),
+                    get_float_exception_flags(&s));
+        }
+        *r = ref;
+        env->vec_status = s;
+    }
+    if (!qatomic_read(&vfn_atexit)) {
+        qatomic_set(&vfn_atexit, true);
+        atexit(vfn_report);
+    }
+    if ((qatomic_fetch_inc(&vfn_n) & ((1u << 26) - 1)) == 0) {
+        vfn_report();
+    }
+}
