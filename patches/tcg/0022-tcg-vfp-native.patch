+    const TCGReg k1 = TCG_REG_XMM3, k2 = TCG_REG_XMM4, z = TCG_REG_XMM6;
+    const TCGReg ta = TCG_REG_XMM7, tb = TCG_REG_XMM8, tc = TCG_REG_XMM9;
+    const TCGReg ok = TCG_REG_XMM10, t = TCG_REG_XMM11, u = TCG_REG_XMM12;
+    unsigned kind = args[0];
+    bool fma = kind >= PVF_MADD;
+    TCGLabelQemuLdst *l = new_ldst_label(s);
+    TCGReg r;
+
+    l->is_ppc_vfp = true;
+    l->fp_sel = kind;
+    l->fp_slow = (const void *)args[5];
+    for (int i = 0; i < 4; i++) {
+        l->vfp_off[i] = args[1 + i];
+    }
+
+    /* the gate: (window & mask) == value, for each window with a mask */
+    for (int w = 0; w < 2; w++) {
+        if (args[7 + 3 * w]) {
+            tcg_out_ld(s, TCG_TYPE_I64, TCG_REG_RAX, TCG_AREG0,
+                       args[6 + 3 * w]);
+            tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_RCX, args[7 + 3 * w]);
+            tgen_arithr(s, ARITH_AND + P_REXW, TCG_REG_RAX, TCG_REG_RCX);
+            tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_RCX, args[8 + 3 * w]);
+            tgen_arithr(s, ARITH_CMP + P_REXW, TCG_REG_RAX, TCG_REG_RCX);
+            pfp_jslow(s, l, JCC_JNE);
+        }
+    }
+
+    tcg_out_ld(s, TCG_TYPE_V128, xa, TCG_AREG0, args[2]);
+    tcg_out_ld(s, TCG_TYPE_V128, xb, TCG_AREG0, args[3]);
+    if (fma) {
+        tcg_out_ld(s, TCG_TYPE_V128, xc, TCG_AREG0, args[4]);
+    }
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k1, dup_const(MO_32, 0x01000000));
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k2, dup_const(MO_32, 0xfdffffff));
+    tcg_out_vex_modrm(s, OPC_PXOR, z, z, z);
+
+    /* operands: zero or normal */
+    tcg_out_vex_modrm(s, OPC_PADDD, ta, xa, xa);
+    tcg_out_vex_modrm(s, OPC_PADDD, tb, xb, xb);
+    pvf_zon(s, ok, ta, k1, k2, z, u);
+    pvf_zon(s, t, tb, k1, k2, z, u);
+    tcg_out_vex_modrm(s, OPC_PAND, ok, ok, t);
+    if (fma) {
+        tcg_out_vex_modrm(s, OPC_PADDD, tc, xc, xc);
+        pvf_zon(s, t, tc, k1, k2, z, u);
+        tcg_out_vex_modrm(s, OPC_PAND, ok, ok, t);
+        /*
+         * xb = a * c + b (vmaddfp), a * c - b (vnmsubfp, negated below):
+         * one rounding each, as fmaf(a, c, b ^ sign) in vfp_fma4_fma3()
+         */
+        tcg_out_vex_modrm(s, kind == PVF_MADD ? PVF_VFMADD231PS
+                                              : PVF_VFMSUB231PS, xb, xa, xc);
+        r = xb;
+        /* exempt: a zero product */
+        tcg_out_vex_modrm(s, OPC_PCMPEQD, t, ta, z);
+        tcg_out_vex_modrm(s, OPC_PCMPEQD, u, tc, z);
+        tcg_out_vex_modrm(s, OPC_POR, t, t, u);
+    } else {
+        tcg_out_vex_modrm(s, kind == PVF_ADD ? PVF_VADDPS : PVF_VSUBPS,
+                          xc, xa, xb);                  /* a + b, a - b */
+        r = xc;
+        /* exempt: both operands zero */
+        tcg_out_vex_modrm(s, OPC_POR, t, ta, tb);
+        tcg_out_vex_modrm(s, OPC_PCMPEQD, t, t, z);
+    }
+
+    /* the result: FLT_MIN < |r| < inf, or exempt */
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k1, dup_const(MO_32, 0x01000001));
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k2, dup_const(MO_32, 0xfdfffffe));
+    tcg_out_vex_modrm(s, OPC_PADDD, u, r, r);
+    tcg_out_vex_modrm(s, OPC_PSUBD, u, u, k1);
+    tcg_out_vex_modrm(s, OPC_PMINUD, ta, u, k2);
+    tcg_out_vex_modrm(s, OPC_PCMPEQD, u, ta, u);
+    tcg_out_vex_modrm(s, OPC_POR, u, u, t);
+    tcg_out_vex_modrm(s, OPC_PAND, ok, ok, u);
+
+    /* any lane not ok: the helper, out of line */
+    tcg_out_vex_modrm(s, PVF_VMOVMSKPS, TCG_REG_EAX, 0, ok);
+    tgen_arithi(s, ARITH_CMP, TCG_REG_EAX, 15, 0);
+    pfp_jslow(s, l, JCC_JNE);
+
+    if (kind == PVF_NMSUB) {
+        /* negated after the rounding, zero included (float32_chs) */
+        tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, t,
+                         dup_const(MO_32, 0x80000000));
+        tcg_out_vex_modrm(s, OPC_PXOR, r, r, t);
+    }
+    tcg_out_st(s, TCG_TYPE_V128, r, TCG_AREG0, args[1]);
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
+/*
+ * The stub: helper(env, &vD, &vA, &vB, &vC) in rdi rsi rdx rcx r8 (vC is
+ * vA for vaddfp/vsubfp, whose helper has no fifth argument).  The helper
+ * raises no exception: no return address is needed.
+ */
+static bool tcg_out_ppc_vfp_slow_path(TCGContext *s, TCGLabelQemuLdst *l)
+{
+    for (unsigned i = 0; i < l->fp_njmp; i++) {
+        tcg_patch32(l->fp_jmp[i], s->code_ptr - l->fp_jmp[i] - 4);
+    }
+    tcg_out_mov(s, TCG_TYPE_PTR, tcg_target_call_iarg_regs[0], TCG_AREG0);
+    for (int i = 0; i < 4; i++) {
+        tcg_out_addi_ptr(s, tcg_target_call_iarg_regs[1 + i], TCG_AREG0,
+                         l->vfp_off[i]);
+    }
+    tcg_out_branch(s, 1, l->fp_slow);
+    tcg_out_jmp(s, l->raddr);
+    return true;
+}
+#endif /* TCG_TARGET_PPC_VFP_IMPL */
