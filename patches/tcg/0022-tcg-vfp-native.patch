+/*
+ * POMPPC tcg/0022 (x-vfp-native): INDEX_op_ppc_vfp.  NOT BUILT on the x86
+ * host where it was written (03/10/2026): to be compiled and proven on the
+ * M4 (docs/tcg-g4.md section 28) before any use.
+ *
+ * vaddfp/vsubfp/vmaddfp/vnmsubfp: the short path of x-vfp-fast
+ * (target/ppc/int_helper.c, vfp_add4()/vfp_fma4(): fadd/fmaf per lane on
+ * this host) on the four lanes at once, NEON 4S, FPCR at its default (as
+ * for those functions).  The same decisions as the x86_64 emitter, with
+ * t = x << 1 and the unsigned compares NEON has:
+ *
+ *   gate     or of (window & mask) ^ value over two 64-bit windows of
+ *            vec_status (cpu_init.c, ppc_vfn_gate_init()), in a GPR
+ *   operand  t == 0, or 0x01000000 <=u t <u 0xff000000
+ *   result   0x01000000 <u t <u 0xff000000 (FLT_MIN < |r| < inf), or exempt:
+ *            both operands zero (add/sub), a zero product (FMA)
+ *
+ * Every test is accumulated without a branch (umaxv of the failed lanes,
+ * or'ed with the gate), then one cbnz to the stub, which calls the original
+ * helper; an infinite lane goes there too, so the short path writes vD and
+ * nothing else.  The op is TCG_OPF_CALL_CLOBBER: X9-X11 and V0-V7,
+ * V16-V18 are scratch here (V8-V15 are callee-saved, V31 is TCG_VEC_TMP0).
+ */
+enum { PVF_ADD, PVF_SUB, PVF_MADD, PVF_NMSUB };
+
+/* raw A64 AdvSIMD encodings, Q = 1 (128 bits) */
+#define PVF_ADD4S       0x4ea08400      /* add  vd.4s, vn.4s, vm.4s */
+#define PVF_SUB4S       0x6ea08400      /* sub */
+#define PVF_CMHI4S      0x6ea03400      /* vd = vn >u vm */
+#define PVF_CMHS4S      0x6ea03c00      /* vd = vn >=u vm */
+#define PVF_AND16B      0x4e201c00
+#define PVF_ORR16B      0x4ea01c00
+#define PVF_FADD4S      0x4e20d400      /* fadd vd.4s, vn.4s, vm.4s */
+#define PVF_FSUB4S      0x4ea0d400      /* vd = vn - vm */
+#define PVF_FMLA4S      0x4e20cc00      /* vd = vd + vn * vm, one rounding */
+#define PVF_FNEG4S      0x6ea0f800      /* fneg vd.4s, vn.4s */
+#define PVF_CMEQ0_4S    0x4ea09800      /* vd = vn == 0 */
+#define PVF_NOT16B      0x6e205800
+#define PVF_UMAXV4S     0x6eb0a800      /* umaxv sd, vn.4s */
+#define PVF_UMOVWS0     0x0e043c00      /* umov wd, vn.s[0] */
+
+/* call-clobbered GPRs, free here (no operand, TCG_OPF_CALL_CLOBBER) */
+#define PVF_G           TCG_REG_X9
+#define PVF_T1          TCG_REG_X10
+#define PVF_T2          TCG_REG_X11
+
+static void pvf_3(TCGContext *s, uint32_t insn, TCGReg d, TCGReg n, TCGReg m)
+{
+    tcg_out32(s, insn | (m & 31) << 16 | (n & 31) << 5 | (d & 31));
+}
+
+static void pvf_2(TCGContext *s, uint32_t insn, TCGReg d, TCGReg n)
+{
+    tcg_out32(s, insn | (n & 31) << 5 | (d & 31));
+}
+
+/* d = all-ones in the lanes of t (an operand << 1) that are a zero or normal */
+static void pvf_zon(TCGContext *s, TCGReg d, TCGReg t, TCGReg k1, TCGReg k4,
+                    TCGReg u)
+{
+    pvf_3(s, PVF_CMHS4S, d, t, k1);         /* t >=u 0x01000000 */
+    pvf_3(s, PVF_CMHI4S, u, k4, t);         /* 0xff000000 >u t */
+    pvf_3(s, PVF_AND16B, d, d, u);
+    pvf_2(s, PVF_CMEQ0_4S, u, t);           /* t == 0 */
+    pvf_3(s, PVF_ORR16B, d, d, u);
+}
+
+static void tcg_out_ppc_vfp(TCGContext *s, const TCGArg *args)
+{
+    const TCGReg xa = TCG_REG_V0, xb = TCG_REG_V1, xc = TCG_REG_V2;
+    const TCGReg k1 = TCG_REG_V3, k4 = TCG_REG_V4;
+    const TCGReg ta = TCG_REG_V5, tb = TCG_REG_V6, tc = TCG_REG_V7;
+    const TCGReg ok = TCG_REG_V16, t = TCG_REG_V17, u = TCG_REG_V18;
+    unsigned kind = args[0];
+    bool fma = kind >= PVF_MADD;
+    TCGLabelQemuLdst *l;
+    TCGReg r;
+
+    /*
+     * the gate, in PVF_G: the or of (window & mask) ^ value over the two
+     * windows, 0 when it passes.  Not in TMP0-2: tcg_out_ld() takes TMP0
+     * for an offset beyond its immediate (the AVRs are past spr_cb[])
+     */
+    tcg_out_movi(s, TCG_TYPE_I64, PVF_G, 0);
+    for (int w = 0; w < 2; w++) {
+        if (args[7 + 3 * w]) {
+            tcg_out_ld(s, TCG_TYPE_I64, PVF_T2, TCG_AREG0,
+                       args[6 + 3 * w]);
+            tcg_out_movi(s, TCG_TYPE_I64, PVF_T1, args[7 + 3 * w]);
+            pfp_rrr(s, PFP_ANDX, PVF_T2, PVF_T2, PVF_T1, 0);
+            tcg_out_movi(s, TCG_TYPE_I64, PVF_T1, args[8 + 3 * w]);
+            pfp_rrr(s, 0xca000000 /* eor x */, PVF_T2, PVF_T2,
+                    PVF_T1, 0);
+            pfp_rrr(s, PFP_ORRX, PVF_G, PVF_G, PVF_T2, 0);
+        }
+    }
+
+    tcg_out_ld(s, TCG_TYPE_V128, xa, TCG_AREG0, args[2]);
+    tcg_out_ld(s, TCG_TYPE_V128, xb, TCG_AREG0, args[3]);
+    if (fma) {
+        tcg_out_ld(s, TCG_TYPE_V128, xc, TCG_AREG0, args[4]);
+    }
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k1, dup_const(MO_32, 0x01000000));
+    tcg_out_dupi_vec(s, TCG_TYPE_V128, MO_32, k4, dup_const(MO_32, 0xff000000));
+
+    /* operands: zero or normal */
+    pvf_3(s, PVF_ADD4S, ta, xa, xa);
+    pvf_3(s, PVF_ADD4S, tb, xb, xb);
+    pvf_zon(s, ok, ta, k1, k4, u);
+    pvf_zon(s, t, tb, k1, k4, u);
+    pvf_3(s, PVF_AND16B, ok, ok, t);
+    if (fma) {
+        pvf_3(s, PVF_ADD4S, tc, xc, xc);
+        pvf_zon(s, t, tc, k1, k4, u);
+        pvf_3(s, PVF_AND16B, ok, ok, t);
+        /* xb = a * c + b, or a * c + -b (vnmsubfp, negated below) */
+        if (kind == PVF_NMSUB) {
+            pvf_2(s, PVF_FNEG4S, xb, xb);
+        }
+        pvf_3(s, PVF_FMLA4S, xb, xa, xc);
+        r = xb;
+        /* exempt: a zero product */
+        pvf_2(s, PVF_CMEQ0_4S, t, ta);
+        pvf_2(s, PVF_CMEQ0_4S, u, tc);
+        pvf_3(s, PVF_ORR16B, t, t, u);
+    } else {
+        pvf_3(s, kind == PVF_ADD ? PVF_FADD4S : PVF_FSUB4S, xc, xa, xb);
+        r = xc;
+        /* exempt: both operands zero */
+        pvf_3(s, PVF_ORR16B, t, ta, tb);
+        pvf_2(s, PVF_CMEQ0_4S, t, t);
+    }
+
+    /* the result: FLT_MIN < |r| < inf, or exempt */
+    pvf_3(s, PVF_ADD4S, ta, r, r);
+    pvf_3(s, PVF_CMHI4S, u, ta, k1);
+    pvf_3(s, PVF_CMHI4S, tb, k4, ta);
+    pvf_3(s, PVF_AND16B, u, u, tb);
+    if (kind != PVF_NMSUB) pvf_3(s, PVF_ORR16B, u, u, t);
+    pvf_3(s, PVF_AND16B, ok, ok, u);
+
+    /* any lane not ok, or the gate: the helper, out of line */
+    pvf_2(s, PVF_NOT16B, ok, ok);
+    pvf_2(s, PVF_UMAXV4S, ok, ok);
+    pvf_2(s, PVF_UMOVWS0, PVF_T1, ok);
+    pfp_rrr(s, PFP_ORRX, PVF_G, PVF_G, PVF_T1, 0);
+    l = new_ldst_label(s);
+    l->is_ppc_vfp = true;
+    l->fp_sel = kind;
+    l->fp_slow = (const void *)args[5];
+    for (int i = 0; i < 4; i++) {
+        l->vfp_off[i] = args[1 + i];
+    }
+    l->label_ptr[0] = s->code_ptr;
+    tcg_out_insn(s, cbz, CBNZ, TCG_TYPE_I64, PVF_G, 0);
+
+    if (kind == PVF_NMSUB) {
+        pvf_2(s, PVF_FNEG4S, r, r);         /* after the rounding */
+    }
+    tcg_out_st(s, TCG_TYPE_V128, r, TCG_AREG0, args[1]);
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
+/* The stub: helper(env, &vD, &vA, &vB, &vC) in x0-x4; no exception raised */
+static bool tcg_out_ppc_vfp_slow_path(TCGContext *s, TCGLabelQemuLdst *l)
+{
+    if (!reloc_pc19(l->label_ptr[0], tcg_splitwx_to_rx(s->code_ptr))) {
+        return false;
+    }
+    tcg_out_mov(s, TCG_TYPE_PTR, TCG_REG_X0, TCG_AREG0);
+    for (int i = 0; i < 4; i++) {
+        tcg_out_addi_ptr(s, TCG_REG_X1 + i, TCG_AREG0, l->vfp_off[i]);
+    }
+    tcg_out_call_int(s, l->fp_slow);
+    tcg_out_goto(s, l->raddr);
+    return true;
+}
