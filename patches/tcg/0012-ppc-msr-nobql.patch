diff --git a/target/ppc/excp_helper.c b/target/ppc/excp_helper.c
index 9f811af..ef7dc18 100644
--- a/target/ppc/excp_helper.c
+++ b/target/ppc/excp_helper.c
@@ -2156,16 +2156,133 @@ static int ppc_next_unmasked_interrupt(CPUPPCState *env)
  *  - When cs->halted is changed and the CPU has a different interrupt masking
  *    logic in power-saving mode (e.g., POWER7/8/9/10);
  */
+/*
+ * POMPPC tcg/0012 (x-msr-nobql), docs/tcg-g4.md section 19.
+ *
+ * The stock function takes the BQL at every mtmsr and rfi (twice per rfi
+ * with the EXITTB request), although it nearly always leaves
+ * CPU_INTERRUPT_HARD as it was.  Inputs: env->pending_interrupts, written
+ * by other threads under the BQL (ppc_set_irq, followed by a locked
+ * ppc_maybe_interrupt), and state owned by this vCPU (msr...).
+ *
+ * Writers: every locked ppc_maybe_interrupt() brackets its read of the
+ * inputs and its update of HARD with irq_seq odd / even, with a full
+ * barrier between "irq_seq odd" and the read of env->msr.
+ * Lock-free reader (this vCPU, after writing its own state):
+ *   full barrier; s = irq_seq (acquire); s odd -> locked path;
+ *   r = next unmasked interrupt; h = HARD bit; read barrier;
+ *   irq_seq != s -> locked path; (r != 0) != h -> locked path; else done.
+ * If no locked update overlapped [first, last read of irq_seq], either it
+ * finished before (acquire: its pending_interrupts and HARD are seen, and
+ * the decision is the one the stock code would take now), or it starts
+ * after the last read: then (Dekker, both sides W; mb; R) it reads the new
+ * msr, and its own result, computed from the latest inputs, is final --
+ * exactly the result of the stock serialization.
+ * When HARD is already set and r != 0, cpu_interrupt() from the vCPU itself
+ * would also set icount_decr.high: done here too.
+ */
+static uint64_t mnb_fast, mnb_slow, mnb_bad, mnb_exittb, mnb_total;
+static bool mnb_atexit;
+
+static void mnb_report(void)
+{
+    fprintf(stderr, "msr-nobql-verify: %" PRIu64 " décisions sans verrou, %"
+            PRIu64 " passages au verrou, %" PRIu64 " divergences, %" PRIu64
+            " EXITTB supprimés\n", qatomic_read(&mnb_fast),
+            qatomic_read(&mnb_slow), qatomic_read(&mnb_bad),
+            qatomic_read(&mnb_exittb));
+}
+
+static void mnb_count(CPUPPCState *env, uint64_t *c)
+{
+    if (unlikely(env->msr_nobql_verify)) {
+        if (!qatomic_read(&mnb_atexit)) {
+            qatomic_set(&mnb_atexit, true);
+            atexit(mnb_report);
+        }
+        qatomic_inc(c);
+        if ((qatomic_fetch_inc(&mnb_total) & ((1u << 26) - 1)) == 0) {
+            mnb_report();
+        }
+    }
+}
+
+void ppc_nobql_exittb_count(CPUPPCState *env)
+{
+    mnb_count(env, &mnb_exittb);
+}
+
+static bool ppc_maybe_interrupt_nolock(CPUPPCState *env, CPUState *cs)
+{
+    uint32_t s;
+    bool r, h;
+
+    smp_mb();                     /* our msr (...) writes before irq_seq */
+    s = qatomic_load_acquire(&env->irq_seq);
+    if (s & 1) {
+        return false;
+    }
+    r = ppc_next_unmasked_interrupt(env) != 0;
+    h = qatomic_read(&cs->interrupt_request) & CPU_INTERRUPT_HARD;
+    smp_rmb();
+    if (qatomic_read(&env->irq_seq) != s || r != h) {
+        return false;
+    }
+    if (r) {
+        qatomic_set(&cs->neg.icount_decr.u16.high, -1);
+    }
+    if (unlikely(env->msr_nobql_verify)) {
+        /* proof: under the BQL the stock code must leave HARD as it is */
+        bool r2;
+
+        bql_lock();
+        r2 = ppc_next_unmasked_interrupt(env) != 0;
+        h = cs->interrupt_request & CPU_INTERRUPT_HARD;
+        if (r2 != h) {
+            if (qatomic_fetch_inc(&mnb_bad) < 50) {
+                fprintf(stderr, "msr-nobql-verify: DIVERGENCE cpu %d msr 0x%"
+                        PRIx64 " pending 0x%x : sans verrou %d, HARD %d, "
+                        "sous verrou %d\n", cs->cpu_index, (uint64_t)env->msr,
+                        env->pending_interrupts, r, h, r2);
+            }
+            if (r2) {
+                cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+            } else {
+                cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+            }
+        }
+        bql_unlock();
+    }
+    mnb_count(env, &mnb_fast);
+    return true;
+}
+
 void ppc_maybe_interrupt(CPUPPCState *env)
 {
     CPUState *cs = env_cpu(env);
+
+    if (env->msr_nobql && tcg_enabled() && !bql_locked() &&
+        qemu_cpu_is_self(cs)) {
+        if (ppc_maybe_interrupt_nolock(env, cs)) {
+            return;
+        }
+        mnb_count(env, &mnb_slow);
+    }
+
     BQL_LOCK_GUARD();
 
+    if (env->msr_nobql) {
+        qatomic_set(&env->irq_seq, env->irq_seq + 1);       /* odd */
+        smp_mb();                  /* irq_seq odd before reading env->msr */
+    }
     if (ppc_next_unmasked_interrupt(env)) {
         cpu_interrupt(cs, CPU_INTERRUPT_HARD);
     } else {
         cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
     }
+    if (env->msr_nobql) {
+        qatomic_store_release(&env->irq_seq, env->irq_seq + 1);   /* even */
+    }
 }
 
