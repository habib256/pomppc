-            gen_qemu_st32fs(ctx, t0, ea);
+            if (!gen_stfs_known(ctx, rt, t0, ea)) {
+                gen_qemu_st32fs(ctx, t0, ea);
+            }
         } else {
             gen_qemu_st64_i64(ctx, t0, ea);
