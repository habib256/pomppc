@@ -1808,6 +1808,31 @@ static inline void gen_qemu_st32fiw(DisasContext *ctx, TCGv_i64 arg1, TCGv arg2)
 GEN_STXF(stfiw, st32fiw, 0x17, 0x1E, PPC_FLOAT_STFIWX);
 
 /*            Floating-point Load/Store Instructions                         */
+/*
+ * x-stfs-known (POMPPC tcg/0047, docs/tcg-g4.md section 38): frS is known
+ * to hold a float32 zero or normal (x-fp-known: written in this TB by an
+ * INDEX_op_ppc_fp32 short path, FPK_R or'ed into it, which leaves the TB
+ * otherwise).  SINGLE() of the ISA then is bits 63:62 || 58:29 of frS:
+ * exponent > 896, or a zero (whose denormal path gives the sign alone, the
+ * same bits).  Returns false (the whole conversion) when it is not known.
+ */
+static bool gen_stfs_known(DisasContext *ctx, int rs, TCGv_i64 src, TCGv addr)
+{
+    TCGv_i64 v, t;
+
+    if (!ctx->stfs_known || !((ctx->fpk_valid >> rs) & 1)) {
+        return false;
+    }
+    fpk_rely(ctx->fpk_prod[rs], FPK_R);
+    v = tcg_temp_new_i64();
+    t = tcg_temp_new_i64();
+    tcg_gen_shri_i64(v, src, 29);
+    tcg_gen_shri_i64(t, src, 62);
+    tcg_gen_deposit_i64(v, v, t, 30, 2);
+    tcg_gen_qemu_st_i64(v, addr, ctx->mem_idx, DEF_MEMOP(MO_UL));
+    return true;
+}
