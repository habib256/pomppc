+/* POMPPC tcg/0011: x-jc-bits, size of the jump cache (tb-jmp-cache.h) */
+static void tcg_get_jc_bits(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    uint32_t value = tb_jmp_cache_bits;
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void tcg_set_jc_bits(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+    if (value < TB_JMP_CACHE_BITS || value > TB_JMP_CACHE_MAX_BITS) {
+        error_setg(errp, "x-jc-bits must be between %d and %d",
+                   TB_JMP_CACHE_BITS, TB_JMP_CACHE_MAX_BITS);
+        return;
+    }
+    if (tb_jmp_cache_bits_frozen && value != tb_jmp_cache_bits) {
+        error_setg(errp, "x-jc-bits cannot change once a CPU exists");
+        return;
+    }
+    tb_jmp_cache_bits = value;
+}
