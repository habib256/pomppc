+/*
+ * POMPPC tcg/0014 (x-fp-native): INDEX_op_ppc_fp32.
+ *
+ * The short path of x-fp-inline (target/ppc/fpu_helper.c, "fp-inline"
+ * block) done by the host FPU inline, with every test of that short path,
+ * branch-free, accumulated in one register; when any of them fails, a
+ * branch to an out-of-line stub that calls the C helper given by the op
+ * (the whole x-fp-flat helper: short path or original sequence), exactly as
+ * the qemu_ld/st slow paths do.  The op is TCG_OPF_CALL_CLOBBER: no live
+ * value is left in a call-clobbered register, so the call-clobbered GPRs
+ * that hold no argument and V0-V3 are free scratch here.
+ *
+ * PowerPC FPSCR bits (QEMU numbering, target/ppc/cpu.h; the translator
+ * checks them at build time): XX = 25, XE = 3, UE = 5, OE = 6, RN = 1:0,
+ * FPRF = 16:12 (FPCC = 15:12), FI = 17.
+ */
+#define PFP_XX          (1ull << 25)
+#define PFP_TRAPS       ((1ull << 3) | (1ull << 5) | (1ull << 6))
+#define PFP_FI          (1ull << 17)
+
+enum { PFP_ADD, PFP_SUB, PFP_MUL, PFP_MADD, PFP_MSUB, PFP_NMADD, PFP_NMSUB,
+       PFP_CMPU };
+enum { PFP_EQ = 0, PFP_NE = 1, PFP_HS = 2, PFP_LO = 3, PFP_HI = 8,
+       PFP_LS = 9, PFP_GE = 10, PFP_LT = 11, PFP_GT = 12 };
+
+/* raw A64 encodings (64-bit forms) */
+static void pfp_lsl(TCGContext *s, TCGReg d, TCGReg n, unsigned sh)
+{
+    tcg_out32(s, 0xd3400000 | ((64 - sh) & 63) << 16 | (63 - sh) << 10 |
+              n << 5 | d);                              /* ubfm */
+}
+
+static void pfp_lsr(TCGContext *s, TCGReg d, TCGReg n, unsigned sh)
+{
+    tcg_out32(s, 0xd3400000 | sh << 16 | 63 << 10 | n << 5 | d);
+}
+
+static void pfp_rrr(TCGContext *s, uint32_t insn, TCGReg d, TCGReg n,
+                    TCGReg m, unsigned lsl)
+{
+    tcg_out32(s, insn | m << 16 | lsl << 10 | n << 5 | d);
+}
+#define PFP_SUBX        0xcb000000
+#define PFP_ANDX        0x8a000000
+#define PFP_ORRX        0xaa000000
+#define PFP_LSLVX       0x9ac02000
+
+static void pfp_cmp(TCGContext *s, TCGReg n, TCGReg m)
+{
+    tcg_out32(s, 0xeb00001f | m << 16 | n << 5);        /* subs xzr */
+}
+
+static void pfp_cmpi(TCGContext *s, TCGReg n, unsigned imm12)
+{
+    tcg_out32(s, 0xf100001f | imm12 << 10 | n << 5);
+}
+
+static void pfp_ccmp(TCGContext *s, TCGReg n, TCGReg m, unsigned nzcv,
+                     unsigned cond)
+{
+    tcg_out32(s, 0xfa400000 | m << 16 | cond << 12 | n << 5 | nzcv);
+}
+
+static void pfp_ccmpi(TCGContext *s, TCGReg n, unsigned imm5, unsigned nzcv,
+                      unsigned cond)
+{
+    tcg_out32(s, 0xfa400800 | imm5 << 16 | cond << 12 | n << 5 | nzcv);
+}
+
+/* csel / csinc / csneg: d = cond ? n : (m | m + 1 | -m) */
+static void pfp_cs(TCGContext *s, uint32_t insn, TCGReg d, TCGReg n,
+                   TCGReg m, unsigned cond)
+{
+    tcg_out32(s, insn | m << 16 | cond << 12 | n << 5 | d);
+}
+#define PFP_CSEL        0x9a800000
+#define PFP_CSINC       0x9a800400
+#define PFP_CSNEG       0xda800400
+
+/* scalar FP, V registers 0-3 */
+static void pfp_fmov_dx(TCGContext *s, unsigned vd, TCGReg xn)
+{
+    tcg_out32(s, 0x9e670000 | xn << 5 | vd);
+}
+
+static void pfp_fmov_xd(TCGContext *s, TCGReg xd, unsigned vn)
+{
+    tcg_out32(s, 0x9e660000 | vn << 5 | xd);
+}
+
+static void pfp_fcvt_sd(TCGContext *s, unsigned sd, unsigned dn)
+{
+    tcg_out32(s, 0x1e624000 | dn << 5 | sd);            /* double -> single */
+}
+
+static void pfp_fcvt_ds(TCGContext *s, unsigned dd, unsigned sn)
+{
+    tcg_out32(s, 0x1e22c000 | sn << 5 | dd);            /* single -> double */
+}
+
+static void pfp_f3(TCGContext *s, uint32_t insn, unsigned d, unsigned n,
+                   unsigned m)
+{
+    tcg_out32(s, insn | m << 16 | n << 5 | d);
+}
+#define PFP_FADDS       0x1e202800
+#define PFP_FSUBS       0x1e203800
+#define PFP_FMULS       0x1e200800
+
+static void pfp_fneg(TCGContext *s, unsigned d, unsigned n)
+{
+    tcg_out32(s, 0x1e214000 | n << 5 | d);
+}
+
+/* sd = sa + sn * sm, one rounding */
+static void pfp_fmadd(TCGContext *s, unsigned d, unsigned n, unsigned m,
+                      unsigned a)
+{
+    tcg_out32(s, 0x1f000000 | m << 16 | a << 10 | n << 5 | d);
+}
+
+static TCGReg pfp_scratch(TCGRegSet *used)
+{
+    for (TCGReg r = TCG_REG_X0; r <= TCG_REG_X15; r++) {
+        if (!tcg_regset_test_reg(*used, r)) {
+            tcg_regset_set_reg(*used, r);
+            return r;
+        }
+    }
+    g_assert_not_reached();
+}
+
+/*
+ * One operand, x = frA/frB/frC as a double: t = x << 1, and "bad" gets
+ * incremented unless x is a float32 zero or normal: t == 0, or its low 29
+ * fraction bits are zero and its exponent is in [0x381, 0x47e] (the test of
+ * fpi_zon()).  k1 = 0x381 << 53, k2 = 0xfe << 53, u a scratch.
+ */
+static void pfp_zon(TCGContext *s, TCGReg bad, TCGReg t, TCGReg x,
+                    TCGReg k1, TCGReg k2, TCGReg u)
+{
+    pfp_lsl(s, t, x, 1);
+    pfp_rrr(s, PFP_SUBX, u, t, k1, 0);
+    tcg_out_logicali(s, Ilogic_imm_ANDSI, TCG_TYPE_I64, TCG_REG_XZR, t,
+                     0x3ffffffe);                       /* low 29 bits */
+    pfp_ccmp(s, u, k2, 2, PFP_EQ);      /* bits clear: u - k2 ; else C (hs) */
+    pfp_ccmpi(s, t, 0, 4, PFP_HS);      /* hs: t == 0 ? ; else Z */
+    pfp_cs(s, PFP_CSINC, bad, bad, bad, PFP_EQ);        /* !Z: bad + 1 */
+}
+
+static void tcg_out_ppc_fp32(TCGContext *s, const TCGArg *args)
+{
+    TCGReg xr = args[0], xnf = args[1];
+    TCGReg xa = args[2], xb = args[3], xc = args[4], xf = args[5];
+    unsigned sel = args[6], op = sel & 0xff;
+    uint64_t fst = args[8];
+    TCGRegSet used = 0;
+    TCGReg bad, k1, k3, ta, tc = TCG_REG_XZR, tr, t, u;
+    TCGLabelQemuLdst *l;
+
+    tcg_regset_set_reg(used, xr);
+    tcg_regset_set_reg(used, xnf);
+    tcg_regset_set_reg(used, xa);
+    tcg_regset_set_reg(used, xb);
+    tcg_regset_set_reg(used, xc);
+    tcg_regset_set_reg(used, xf);
+    bad = pfp_scratch(&used);
+    k3 = pfp_scratch(&used);
+    ta = pfp_scratch(&used);
+    t = pfp_scratch(&used);
+
+    /* the gate: XX = 1, XE = OE = UE = 0 (and RN = 00 but for fcmpu) */
+    tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP0,
+                 PFP_XX | PFP_TRAPS | (op == PFP_CMPU ? 0 : 3));
+    pfp_rrr(s, PFP_ANDX, bad, xf, TCG_REG_TMP0, 0);
+    tcg_out_logicali(s, Ilogic_imm_EORI, TCG_TYPE_I64, bad, bad, PFP_XX);
+
+    if (op == PFP_CMPU) {
+        /*
+         * fpi_fcmpu(): no NaN (magnitude > 0x7ff0...), then a signed
+         * comparison of sign-magnitude turned into two's complement.
+         */
+        TCGReg tb = pfp_scratch(&used);
+
+        tcg_out_movi(s, TCG_TYPE_I64, k3, 0x7ff0000000000000ull);
+        tcg_out_logicali(s, Ilogic_imm_ANDI, TCG_TYPE_I64, ta, xa, INT64_MAX);
+        tcg_out_logicali(s, Ilogic_imm_ANDI, TCG_TYPE_I64, tb, xb, INT64_MAX);
+        pfp_cmp(s, ta, k3);
+        pfp_cs(s, PFP_CSINC, bad, bad, bad, PFP_LS);
+        pfp_cmp(s, tb, k3);
+        pfp_cs(s, PFP_CSINC, bad, bad, bad, PFP_LS);
+        pfp_cmpi(s, xa, 0);
+        pfp_cs(s, PFP_CSNEG, ta, ta, ta, PFP_GE);
+        pfp_cmpi(s, xb, 0);
+        pfp_cs(s, PFP_CSNEG, tb, tb, tb, PFP_GE);
+        tcg_out_movi(s, TCG_TYPE_I64, xr, 2);
+        tcg_out_movi(s, TCG_TYPE_I64, t, 4);
+        pfp_cmp(s, ta, tb);
+        pfp_cs(s, PFP_CSEL, xr, t, xr, PFP_GT);
+        tcg_out_movi(s, TCG_TYPE_I64, t, 8);
+        pfp_cs(s, PFP_CSEL, xr, t, xr, PFP_LT);
+        /* fpi_fpscr_fcmpu(): FPCC = crf, FI = 1 */
+        tcg_out_logicali(s, Ilogic_imm_ANDI, TCG_TYPE_I64, xnf, xf,
+                         ~(uint64_t)0xf000);
+        pfp_rrr(s, PFP_ORRX, xnf, xnf, xr, 12);
+        tcg_out_logicali(s, Ilogic_imm_ORRI, TCG_TYPE_I64, xnf, xnf, PFP_FI);
+    } else {
+        bool use_b = op != PFP_MUL;
+        bool use_c = op >= PFP_MUL;
+
+        k1 = pfp_scratch(&used);
+        tr = pfp_scratch(&used);
+        u = TCG_REG_TMP2;
+        /* operands: fpi_zon(), k2 in TMP1 */
+        tcg_out_movi(s, TCG_TYPE_I64, k1, 0x381ull << 53);
+        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP1, 0xfeull << 53);
+        pfp_zon(s, bad, ta, xa, k1, TCG_REG_TMP1, u);
+        if (use_b) {
+            pfp_zon(s, bad, t, xb, k1, TCG_REG_TMP1, u);
+        }
+        if (use_c) {
+            tc = pfp_scratch(&used);
+            pfp_zon(s, bad, tc, xc, k1, TCG_REG_TMP1, u);
+        }
+
+        /* the operation, float32, as helper_fp32_fast() */
+        pfp_fmov_dx(s, 0, xa);
+        pfp_fcvt_sd(s, 0, 0);
+        if (use_b) {
+            pfp_fmov_dx(s, 1, xb);
+            pfp_fcvt_sd(s, 1, 1);
+        }
+        if (use_c) {
+            pfp_fmov_dx(s, 2, xc);
+            pfp_fcvt_sd(s, 2, 2);
+        }
+        switch (op) {
+        case PFP_ADD:
+            pfp_f3(s, PFP_FADDS, 3, 0, 1);
+            break;
+        case PFP_SUB:
+            pfp_f3(s, PFP_FSUBS, 3, 0, 1);
+            break;
+        case PFP_MUL:
+            pfp_f3(s, PFP_FMULS, 3, 0, 2);
+            break;
+        case PFP_MADD:
+            pfp_fmadd(s, 3, 0, 2, 1);                   /* a * c + b */
+            break;
+        case PFP_MSUB:
+            pfp_fneg(s, 1, 1);
+            pfp_fmadd(s, 3, 0, 2, 1);                   /* a * c + -b */
+            break;
+        case PFP_NMADD:
+            pfp_fmadd(s, 3, 0, 2, 1);
+            pfp_fneg(s, 3, 3);                          /* after rounding */
+            break;
+        case PFP_NMSUB:
+            pfp_fneg(s, 1, 1);
+            pfp_fmadd(s, 3, 0, 2, 1);
+            pfp_fneg(s, 3, 3);
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        pfp_fcvt_ds(s, 3, 3);
+        pfp_fmov_xd(s, xr, 3);
+
+        /* the result: tr = r << 1, k3 = infinity << 1 */
+        pfp_lsl(s, tr, xr, 1);
+        tcg_out_movi(s, TCG_TYPE_I64, k3, 0xffe0000000000000ull);
+        if (op <= PFP_SUB) {
+            /* any finite sum */
+            pfp_cmp(s, tr, k3);
+            pfp_cs(s, PFP_CSINC, bad, bad, bad, PFP_NE);
+        } else {
+            /* a zero product, or FLT_MIN < |r| < inf */
+            pfp_cmpi(s, ta, 0);
+            pfp_ccmpi(s, tc, 0, 4, PFP_NE);
+            pfp_cs(s, PFP_CSINC, t, TCG_REG_XZR, TCG_REG_XZR, PFP_NE);
+            pfp_cmp(s, tr, k1);
+            pfp_ccmp(s, tr, k3, 2, PFP_HI);
+            pfp_ccmpi(s, t, 0, 0, PFP_HS);
+            pfp_cs(s, PFP_CSINC, bad, bad, bad, PFP_NE);
+        }
+
+        /* fpi_fpscr_arith(): FPRF of r (+-zero, +-normal), FI = 1 */
+        pfp_lsr(s, TCG_REG_TMP0, xr, 63);                       /* neg */
+        pfp_lsl(s, TCG_REG_TMP1, TCG_REG_TMP0, 4);
+        tcg_out_logicali(s, Ilogic_imm_ORRI, TCG_TYPE_I64, TCG_REG_TMP1,
+                         TCG_REG_TMP1, 2);                      /* 0x02/0x12 */
+        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP2, 4);
+        pfp_rrr(s, PFP_LSLVX, TCG_REG_TMP2, TCG_REG_TMP2, TCG_REG_TMP0, 0);
+        pfp_cmpi(s, tr, 0);
+        pfp_cs(s, PFP_CSEL, TCG_REG_TMP2, TCG_REG_TMP1, TCG_REG_TMP2, PFP_EQ);
+        tcg_out_logicali(s, Ilogic_imm_ANDI, TCG_TYPE_I64, xnf, xf,
+                         ~(uint64_t)(0x1f000 | PFP_FI));
+        pfp_rrr(s, PFP_ORRX, xnf, xnf, TCG_REG_TMP2, 12);
+        tcg_out_logicali(s, Ilogic_imm_ORRI, TCG_TYPE_I64, xnf, xnf, PFP_FI);
+    }
+
+    /* any test failed: the helper, out of line */
+    l = new_ldst_label(s);
+    l->is_ppc_fp32 = true;
+    l->fp_sel = sel;
+    l->fp_in[0] = xa;
+    l->fp_in[1] = xb;
+    l->fp_in[2] = xc;
+    l->fp_out[0] = xr;
+    l->fp_out[1] = xnf;
+    l->fp_slow = (const void *)args[7];
+    l->label_ptr[0] = s->code_ptr;
+    tcg_out_insn(s, cbz, CBNZ, TCG_TYPE_I64, bad, 0);
+
+    /* short path: soft-float exception flags = inexact (primed) */
+    tcg_out_movi(s, TCG_TYPE_I32, t, fst >> 32);
+    tcg_out_ldst(s, Ildst_imm_STRH, t, TCG_AREG0, (uint32_t)fst, 1);
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
+/*
+ * The stub: x0 = env, x1-x3 = frA frB frC, w4 = selector, x5 = return
+ * address in the generated code (for a deferred FP exception); the helper
+ * returns (result, FPSCR) in x0:x1.  Arguments and results go through the
+ * reserved temporaries, so any register assignment is fine.
+ */
+static bool tcg_out_ppc_fp32_slow_path(TCGContext *s, TCGLabelQemuLdst *l)
+{
+    if (!reloc_pc19(l->label_ptr[0], tcg_splitwx_to_rx(s->code_ptr))) {
+        return false;
+    }
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_TMP0, l->fp_in[0]);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_TMP1, l->fp_in[1]);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_TMP2, l->fp_in[2]);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_X1, TCG_REG_TMP0);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_X2, TCG_REG_TMP1);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_X3, TCG_REG_TMP2);
+    tcg_out_mov(s, TCG_TYPE_PTR, TCG_REG_X0, TCG_AREG0);
+    tcg_out_movi(s, TCG_TYPE_I32, TCG_REG_X4, l->fp_sel);
+    tcg_out_movi(s, TCG_TYPE_PTR, TCG_REG_X5, (uintptr_t)l->raddr);
+    tcg_out_call_int(s, l->fp_slow);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_REG_X0);
+    tcg_out_mov(s, TCG_TYPE_I64, TCG_REG_TMP1, TCG_REG_X1);
+    tcg_out_mov(s, TCG_TYPE_I64, l->fp_out[0], TCG_REG_TMP0);
+    tcg_out_mov(s, TCG_TYPE_I64, l->fp_out[1], TCG_REG_TMP1);
+    tcg_out_goto(s, l->raddr);
+    return true;
+}
