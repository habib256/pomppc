+/*
+ * x-fp-native (POMPPC tcg/0014): INDEX_op_ppc_fp32, the short path by the
+ * host FPU in the generated code, ppc_fp32_native_slow() (the x-fp-flat
+ * helper) out of line otherwise.  sel = op | frT (or bf) << 8.
+ */
+/* the FPSCR layout the host op hard-codes (tcg/aarch64/tcg-target.c.inc) */
+QEMU_BUILD_BUG_ON(FP_XX != 1u << 25 || FP_XE != 1u << 3 || FP_UE != 1u << 5 ||
+                  FP_OE != 1u << 6 || FP_RN != 3 || FPSCR_FPRF != 12 ||
+                  FP_FPRF != 0x1f << 12 || FP_FPCC != 0xf << 12 ||
+                  FP_FI != 1u << 17);
+
+static void gen_fp_native(DisasContext *ctx, TCGv_i64 r, TCGv_i64 nf, int op,
+                          int t, TCGv_i64 a, TCGv_i64 b, TCGv_i64 c)
+{
+    TCGv_i64 f = tcg_temp_new_i64();
+    unsigned sel = op | t << 8;
+
+    tcg_gen_extu_tl_i64(f, cpu_fpscr);
+    tcg_gen_ppc_fp32(r, nf, a, b, c, f, sel, ppc_fp32_native_slow,
+                     PPC_FP_FLAGS_OFS |
+                     (uint64_t)float_flag_inexact << 32);
+    if (ctx->fp_verify) {
+        tcg_gen_st_i32(tcg_constant_i32(sel), tcg_env,
+                       offsetof(CPUPPCState, fpn_sel));
+        if (op == FPI_CMPU) {
+            /* the helper reads env->crf[bf]: the op's value */
+            tcg_gen_extrl_i64_i32(cpu_crf[t], r);
+        }
+        tcg_gen_trunc_i64_tl(cpu_fpscr, nf);
+        gen_helper_fpn_verify(tcg_env, a, b, c, f, r, nf);
+    }
+}
+
+static bool do_fp_native(DisasContext *ctx, int op, int frt, int fra, int frb,
+                         int frc, bool rc)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 c = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    TCGv_i64 nf = tcg_temp_new_i64();
+
+    REQUIRE_INSNS_FLAGS(ctx, FLOAT);
+    REQUIRE_FPU(ctx);
+
+    get_fpr(a, fra);
+    if (op == FPI_ADD || op == FPI_SUB || op >= FPI_MADD) {
+        get_fpr(b, frb);
+    } else {
+        tcg_gen_movi_i64(b, 0);
+    }
+    if (op >= FPI_MUL) {
+        get_fpr(c, frc);
+    } else {
+        tcg_gen_movi_i64(c, 0);
+    }
+    gen_fp_native(ctx, r, nf, op, frt, a, b, c);
+    set_fpr(frt, r);
+    tcg_gen_trunc_i64_tl(cpu_fpscr, nf);
+    if (unlikely(rc)) {
+        gen_set_cr1_from_fpscr(ctx);
+    }
+    return true;
+}
+
+static void gen_fcmpu_native(DisasContext *ctx, arg_X_bf *x)
+{
+    int bf = x->bf;
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    TCGv_i64 nf = tcg_temp_new_i64();
+
+    get_fpr(a, x->ra);
+    get_fpr(b, x->rb);
+    gen_fp_native(ctx, r, nf, FPI_CMPU, bf, a, b, tcg_constant_i64(0));
+    tcg_gen_extrl_i64_i32(cpu_crf[bf], r);
+    tcg_gen_trunc_i64_tl(cpu_fpscr, nf);
+}
