+
+/*
+ * x-fp-native (POMPPC patches/tcg/0014, docs/tcg-g4.md section 22).
+ *
+ * INDEX_op_ppc_fp32 (tcg/aarch64) does the short path of x-fp-inline with
+ * the host FPU in the generated code and, when one of its tests fails,
+ * calls this function from an out-of-line stub: not a TCG helper, a plain
+ * C function with the stub's own convention.  sel = op | frT (bf) << 8; ra
+ * is the return address in the generated code, as GETPC() would be.  It is
+ * the whole x-fp-flat helper: short path or original sequence.
+ */
+Int128 ppc_fp32_native_slow(CPUPPCState *env, uint64_t a, uint64_t b,
+                            uint64_t c, uint32_t sel, uintptr_t ra)
+{
+    uint32_t op = sel & 0xff, frt = (sel >> 8) & 0xff;
+
+    if (op == FPI_CMPU) {
+        return fcmpu_flat(env, a, b, env->fpscr, frt, ra);
+    }
+    return fp32_flat(env, a, b, c, env->fpscr, op, frt, ra);
+}
+
+/*
+ * x-fp-verify with x-fp-native: after each native op, the original
+ * sequence is run again from the FPSCR the op started from, and its
+ * result, FPSCR and soft-float flags compared with what the op produced.
+ * The whole state it touches is saved and put back, so the guest runs
+ * exactly as without it.  Not when the original sequence could raise an
+ * exception from here -- FP exceptions enabled in the MSR and a trap armed
+ * in the FPSCR (VE OE UE ZE XE), or a deferred FP exception already
+ * pending: counted apart.  (DOOM 3 runs with MSR[FE] != 0 and no trap.)
+ */
+static uint64_t fpn_ok[FPI_NOPS], fpn_bad[FPI_NOPS], fpn_fast[FPI_NOPS];
+static uint64_t fpn_skip, fpn_total;
+static bool fpn_atexit;
+
+static void fpn_report(void)
+{
+    uint64_t ok = 0, bad = 0, fast = 0;
+    int i;
+
+    for (i = 0; i < FPI_NOPS; i++) {
+        ok += qatomic_read(&fpn_ok[i]);
+        bad += qatomic_read(&fpn_bad[i]);
+        fast += qatomic_read(&fpn_fast[i]);
+    }
+    fprintf(stderr, "fp-native-verify: %" PRIu64 " vérifiés (%" PRIu64
+            " par le chemin court), %" PRIu64 " divergences, %" PRIu64
+            " non vérifiés (MSR[FE] et trappe armée) ;", ok + bad, fast, bad,
+            qatomic_read(&fpn_skip));
+    for (i = 0; i < FPI_NOPS; i++) {
+        fprintf(stderr, " %s %" PRIu64 "/%" PRIu64 "/%" PRIu64, fpi_names[i],
+                qatomic_read(&fpn_ok[i]), qatomic_read(&fpn_fast[i]),
+                qatomic_read(&fpn_bad[i]));
+    }
+    fprintf(stderr, "\n");
+}
+
+void helper_fpn_verify(CPUPPCState *env, uint64_t a, uint64_t b, uint64_t c,
+                       uint64_t fpscr_old, uint64_t r, uint64_t nf)
+{
+    CPUState *cs = env_cpu(env);
+    uint32_t sel = env->fpn_sel, op = sel & 0xff, frt = (sel >> 8) & 0xff;
+    target_ulong fpscr_after = env->fpscr;
+    int flags_after = get_float_exception_flags(&env->fp_status);
+    int excp = cs->exception_index, err = env->error_code;
+    uint32_t crf_after = op == FPI_CMPU ? env->crf[frt] : 0;
+    uint64_t ref;
+    bool fast, good;
+
+    if (!qatomic_read(&fpn_atexit)) {
+        qatomic_set(&fpn_atexit, true);
+        atexit(fpn_report);
+    }
+    if (fp_exceptions_enabled(env) &&
+        ((fpscr_old & (FP_VE | FP_OE | FP_UE | FP_ZE | FP_XE)) ||
+         (excp == POWERPC_EXCP_PROGRAM && (err & POWERPC_EXCP_FP)))) {
+        qatomic_inc(&fpn_skip);
+        return;
+    }
+    if (op == FPI_CMPU) {
+        fast = fpi_fcmpu(fpscr_old, a, b) != 0;
+    } else {
+        fast = fpi_gate(fpscr_old) &&
+               helper_fp32_fast(a, b, c, op) != FPI_FAIL;
+    }
+    env->fpscr = fpscr_old;
+    helper_reset_fpstatus(env);
+    if (op == FPI_CMPU) {
+        do_fcmpu(env, a, b, frt, 0);
+        do_float_check_status(env, true, 0);
+        ref = env->crf[frt];
+        env->crf[frt] = crf_after;
+    } else {
+        ref = fpf_slow(env, op, a, b, c, 0);
+        helper_compute_fprf_float64(env, ref);
+        do_float_check_status(env, true, 0);
+    }
+    good = ref == r && env->fpscr == nf &&
+           get_float_exception_flags(&env->fp_status) == flags_after &&
+           cs->exception_index == excp && env->error_code == err &&
+           fpscr_after == nf;
+    if (!good) {
+        fprintf(stderr, "fp-native-verify: DIVERGENCE %s a=%016" PRIx64
+                " b=%016" PRIx64 " c=%016" PRIx64 " fpscr=%08" PRIx64
+                " : natif %016" PRIx64 " fpscr %08" PRIx64 " drapeaux %x"
+                ", helpers %016" PRIx64 " fpscr %08" PRIx64 " drapeaux %x"
+                " excp %d->%d\n", fpi_names[op], a, b, c, fpscr_old, r, nf,
+                flags_after, ref, (uint64_t)env->fpscr,
+                get_float_exception_flags(&env->fp_status), excp,
+                cs->exception_index);
+    }
+    env->fpscr = fpscr_after;
+    set_float_exception_flags(flags_after, &env->fp_status);
+    cs->exception_index = excp;
+    env->error_code = err;
+    qatomic_inc(good ? &fpn_ok[op] : &fpn_bad[op]);
+    if (fast) {
+        qatomic_inc(&fpn_fast[op]);
+    }
+    if ((qatomic_fetch_inc(&fpn_total) & ((1u << 24) - 1)) == 0) {
+        fpn_report();
+    }
+}
