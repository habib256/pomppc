diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
index fdf6d8ac1..dd6d27887 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -663,3 +663,44 @@ void tcg_flush_jmp_cache(CPUState *cpu)
         qatomic_set(&jc->array[i].tb, NULL);
     }
 }
+
+/*
+ * POMPPC tcg/0008 (x-jc-idx).  An entry of the jump cache stands for "pc
+ * under these flags runs this TB", which was found through the code TLB
+ * of one mmu_idx (jc->idx[i], recorded at insertion by the owning CPU).
+ * Flushing the TLB of other mmu_idx cannot change that translation, so
+ * only the entries of the flushed mmu_idx are dropped.
+ */
+void tcg_flush_jmp_cache_idx(CPUState *cpu, uint16_t idxmap)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+
+    QEMU_BUILD_BUG_ON(NB_MMU_MODES > TB_JMP_IDX_MAX);
+    if (unlikely(jc == NULL)) {
+        return;
+    }
+    for (int k = 0; k < TB_JMP_IDX_MAX; k++) {
+        unsigned n;
+
+        if (!((idxmap >> k) & 1)) {
+            continue;
+        }
+        n = jc->log_n[k];
+        if (n > TB_JMP_IDX_LOG) {
+            for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+                if (jc->idx[i] == k) {
+                    qatomic_set(&jc->array[i].tb, NULL);
+                }
+            }
+        } else {
+            for (unsigned j = 0; j < n; j++) {
+                unsigned h = jc->log[k][j];
+                /* the slot may have been refilled under another mmu_idx since */
+                if (jc->idx[h] == k) {
+                    qatomic_set(&jc->array[h].tb, NULL);
+                }
+            }
+        }
+        jc->log_n[k] = 0;
+    }
+}
