+/*
+ * POMPPC tcg/0008, x-ret-inline + x-ret-verify: the inline jump-cache probe
+ * found @ptb; check it as helper_lookup_tb_ptr would have chosen, and run
+ * the stock helper instead when it disagrees.
+ */
+const void *HELPER(lookup_tb_ptr_check)(CPUArchState *env, void *ptb)
+{
+#ifndef CONFIG_USER_ONLY
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb = ptb;
