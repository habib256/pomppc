+ * POMPPC tcg/0008 (x-ret-verify): get_page_addr_code() that never raises a
+ * guest exception.  -1: not RAM (as get_page_addr_code), -2: no translation.
+ */
+tb_page_addr_t pomppc_code_phys_nofault(CPUArchState *env, vaddr addr)
+{
+    CPUTLBEntryFull *full;
+    void *p;
+    int flags;
+
+    flags = probe_access_internal(env_cpu(env), addr, 1, MMU_INST_FETCH,
+                                  cpu_mmu_index(env_cpu(env), true), true,
+                                  &p, &full, 0, false);
+    if (flags & TLB_INVALID_MASK) {
+        return -2;
+    }
