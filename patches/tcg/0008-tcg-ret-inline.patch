diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index c3a505e39..24bda0552 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -28,6 +28,36 @@ typedef struct CPUJumpCache {
         TranslationBlock *tb;
         vaddr pc;
     } array[TB_JMP_CACHE_SIZE];
+    /*
+     * POMPPC tcg/0008 (x-jc-idx): instruction mmu_idx under which array[i]
+     * was looked up.  Written and read by the owning CPU only.
+     */
+    uint8_t idx[TB_JMP_CACHE_SIZE];
+    /*
+     * Slots filled under each mmu_idx since the last drop of that mmu_idx,
+     * so that tcg_flush_jmp_cache_idx visits only them (a few hundred,
+     * instead of the whole table: ~7000 drops per second under Tiger).
+     * log_n[i] > TB_JMP_IDX_LOG: overflowed, scan the whole table.
+     */
+#define TB_JMP_IDX_MAX 16
+#define TB_JMP_IDX_LOG 1024
+    uint16_t log_n[TB_JMP_IDX_MAX];
+    uint16_t log[TB_JMP_IDX_MAX][TB_JMP_IDX_LOG];
 } CPUJumpCache;
 
+/* POMPPC tcg/0008: record the instruction mmu_idx of a slot being filled */
+static inline void tb_jmp_cache_set_idx(CPUJumpCache *jc, uint32_t h, int idx)
+{
+    unsigned n;
+
+    jc->idx[h] = idx;                /* idx < NB_MMU_MODES <= TB_JMP_IDX_MAX */
+    n = jc->log_n[idx];
+    if (n < TB_JMP_IDX_LOG) {
+        jc->log[idx][n] = h;
+    }
+    if (n <= TB_JMP_IDX_LOG) {
+        jc->log_n[idx] = n + 1;
+    }
+}
+
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
