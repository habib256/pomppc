+#ifndef CONFIG_USER_ONLY
+/*
+ * POMPPC tcg/0008, x-ret-verify.  Every TB taken from the jump cache (main
+ * loop, helper_lookup_tb_ptr, and the inline lookup of x-ret-inline) is
+ * compared with what a full physical lookup gives now -- what the stock
+ * code finds after the jump cache has been cleared.  The physical page is
+ * probed without raising a guest exception (a proof mode may fill the TLB,
+ * nothing else).  Divergent TBs are not run: the caller falls back to the
+ * stock lookup.  Summary on stderr, periodically and at exit.
+ */
+enum { RV_LOOP, RV_HELPER, RV_INLINE, RV_N };
+static const char *const rv_name[RV_N] = { "boucle", "helper", "en-ligne" };
+static uint64_t rv_hit[RV_N], rv_miss[RV_N], rv_bad[RV_N], rv_race[RV_N];
+static uint64_t rv_nophys[RV_N], rv_jc_drop, rv_jc_skip, rv_total;
+/* misses: entry dropped (same pc, no tb), other pc (conflict), same pc other flags/cflags */
+static uint64_t rv_m_drop, rv_m_other, rv_m_flags;
+static bool rv_atexit;
+
+static void rv_report(void)
+{
+    fprintf(stderr, "ret-verify:");
+    for (int i = 0; i < RV_N; i++) {
+        fprintf(stderr, " %s %" PRIu64 " vérifiés / %" PRIu64 " ratés,"
+                " %" PRIu64 " divergences, %" PRIu64 " courses, %" PRIu64
+                " sans traduction ;", rv_name[i],
+                qatomic_read(&rv_hit[i]), qatomic_read(&rv_miss[i]),
+                qatomic_read(&rv_bad[i]), qatomic_read(&rv_race[i]),
+                qatomic_read(&rv_nophys[i]));
+    }
+    fprintf(stderr, " vidages du cache de sauts : %" PRIu64 " faits, %" PRIu64
+            " évités ; ratés : %" PRIu64 " entrée vidée, %" PRIu64 " autre pc, %"
+            PRIu64 " autres drapeaux\n", qatomic_read(&rv_jc_drop),
+            qatomic_read(&rv_jc_skip), qatomic_read(&rv_m_drop),
+            qatomic_read(&rv_m_other), qatomic_read(&rv_m_flags));
+}
+
+static void rv_start(void)
+{
+    if (!qatomic_read(&rv_atexit)) {
+        qatomic_set(&rv_atexit, true);
+        atexit(rv_report);
+    }
+}
+
+void pomppc_jc_flush_stat(CPUState *cpu, bool dropped)
+{
+    if (unlikely(cpu->ret_verify)) {
+        rv_start();
+        qatomic_inc(dropped ? &rv_jc_drop : &rv_jc_skip);
+    }
+}
+
+static void rv_miss_stat(int src, TranslationBlock *tb, vaddr epc, vaddr pc)
+{
+    rv_start();
+    qatomic_inc(&rv_miss[src]);
+    qatomic_inc(epc != pc ? &rv_m_other : tb == NULL ? &rv_m_drop : &rv_m_flags);
+}
+
+/* tb_lookup_cmp() without guest exceptions (second page probed nofault) */
+static bool rv_lookup_cmp(const void *p, const void *d)
+{
+    const TranslationBlock *tb = p;
+    const struct tb_desc *desc = d;
+
+    if ((tb_cflags(tb) & CF_PCREL || tb->pc == desc->pc) &&
+        tb_page_addr0(tb) == desc->page_addr0 &&
+        tb->cs_base == desc->cs_base &&
+        tb->flags == desc->flags &&
+        tb_cflags(tb) == desc->cflags) {
+        tb_page_addr_t tb_phys_page1 = tb_page_addr1(tb);
+        if (tb_phys_page1 == -1) {
+            return true;
+        }
+        return tb_phys_page1 ==
+            pomppc_code_phys_nofault(desc->env, TARGET_PAGE_ALIGN(desc->pc));
+    }
+    return false;
+}
+
+static bool ret_verify_tb(CPUState *cpu, TranslationBlock *tb, vaddr pc,
+                          uint64_t cs_base, uint32_t flags, uint32_t cflags,
+                          int src)
+{
+    struct tb_desc desc;
+    TranslationBlock *ref = NULL;
+    tb_page_addr_t phys;
+    uint64_t n;
+
+    rv_start();
+    desc.env = cpu_env(cpu);
+    desc.cs_base = cs_base;
+    desc.flags = flags;
+    desc.cflags = cflags;
+    desc.pc = pc;
+    phys = pomppc_code_phys_nofault(desc.env, pc);
+    if (phys != -1 && phys != -2) {
+        desc.page_addr0 = phys;
+        ref = qht_lookup_custom(&tb_ctx.htable, &desc,
+                                tb_hash_func(phys, (cflags & CF_PCREL ? 0 : pc),
+                                             flags, cs_base, cflags),
+                                rv_lookup_cmp);
+    }
+    if (ref == tb && tb->pc == pc && tb->cs_base == cs_base &&
+        tb->flags == flags && tb_cflags(tb) == cflags) {
+        n = qatomic_fetch_inc(&rv_hit[src]);
+        if ((qatomic_fetch_inc(&rv_total) & ((1u << 26) - 1)) == 0 && n) {
+            rv_report();
+        }
+        return true;
+    }
+    if (tb_cflags(tb) & CF_INVALID) {
+        /* invalidated by another vCPU since it was read: stock race too */
+        qatomic_inc(&rv_race[src]);
+        return false;
+    }
+    if (phys == -2) {
+        qatomic_inc(&rv_nophys[src]);
+    }
+    if (qatomic_fetch_inc(&rv_bad[src]) < 50) {
+        fprintf(stderr, "ret-verify: DIVERGENCE %s cpu %d pc 0x%" VADDR_PRIx
+                " flags 0x%08x cflags 0x%08x : cache tb %p (pc 0x%" VADDR_PRIx
+                " flags 0x%08x cflags 0x%08x phys 0x%" PRIx64 "), complet %p"
+                " (phys 0x%" PRIx64 "), mmu_idx %d\n", rv_name[src],
+                cpu->cpu_index, pc, flags, cflags, tb, tb->pc, tb->flags,
+                tb_cflags(tb), (uint64_t)tb_page_addr0(tb), ref,
+                (uint64_t)phys, cpu_mmu_index(cpu, true));
+    }
+    return false;
+}
