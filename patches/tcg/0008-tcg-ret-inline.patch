+/*
+ * POMPPC tcg/0008 (x-ret-inline).  Every indirect exit of a TB (blr, bctr,
+ * cross-page branches...) went through helper_lookup_tb_ptr: a call, the
+ * state read back from env, curr_cflags, the breakpoint test, the jump-cache
+ * probe, a return, then goto_ptr.  Here the probe of tb_lookup() is emitted
+ * inline: same hash, same entry, same comparisons as the helper --
+ *   entry.tb != NULL, entry.pc == pc, tb->flags == flags,
+ *   tb->cflags == cpu->tcg_cflags (curr_cflags() outside of gdb single-step,
+ *   one-insn-per-tb and -d nochain, which set CF_NO_GOTO_TB or
+ *   CF_NO_GOTO_PTR in the TBs they generate and are not supported here),
+ *   no breakpoint on the CPU (check_for_breakpoints),
+ * and tb->cs_base is not compared: the caller guarantees it is always 0.
+ * An invalidated TB has CF_INVALID in cflags, hence never matches.  On a hit
+ * can_do_io is set as the helper does, and the TB is entered by goto_ptr;
+ * anything else calls the helper.  The entered TB checks exit requests and
+ * interrupts in its prologue as usual.
+ */
+bool translator_can_goto_ptr_inline(DisasContextBase *db)
+{
+    return !(tb_cflags(db->tb) & (CF_NO_GOTO_PTR | CF_NO_GOTO_TB | CF_PCREL |
+                                 CF_SINGLE_STEP | CF_COUNT_MASK)) &&
+           !db->plugin_enabled;
+}
+
+void translator_lookup_and_goto_ptr_inline(DisasContextBase *db, TCGv_i64 pc,
+                                           TCGv_i32 flags, bool verify)
+{
+    const int sh = TARGET_PAGE_BITS - TB_JMP_PAGE_BITS;
+    TCGLabel *slow = gen_new_label();
+    TCGv_i64 h = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv_ptr e = tcg_temp_new_ptr();
+    TCGv_ptr tb = tcg_temp_new_ptr();
+    TCGv_ptr p = tcg_temp_new_ptr();
+    TCGv_i32 a = tcg_temp_new_i32();
+    TCGv_i32 b = tcg_temp_new_i32();
+
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+#ifndef CONFIG_USER_ONLY
+    /* hash = tb_jmp_cache_hash_func(pc), system-mode version */
+    tcg_gen_shri_i64(t, pc, sh);
+    tcg_gen_xor_i64(t, t, pc);
+    tcg_gen_shri_i64(h, t, sh);
+    tcg_gen_andi_i64(h, h, TB_JMP_PAGE_MASK);
+    tcg_gen_andi_i64(t, t, TB_JMP_ADDR_MASK);
+    tcg_gen_or_i64(h, h, t);
+#else
+#error "x-ret-inline: system mode only"
+#endif
+    tcg_gen_shli_i64(h, h, 4);
+    tcg_gen_trunc_i64_ptr(p, h);
+    tcg_gen_ld_ptr(e, tcg_env, offsetof(ArchCPU, parent_obj.tb_jmp_cache) -
+                               offsetof(ArchCPU, env));
+    tcg_gen_add_ptr(e, e, p);
+
+    /* tb = entry.tb (atomic in the helper: an aligned pointer load) */
+    tcg_gen_ld_ptr(tb, e, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_brcondi_ptr(TCG_COND_EQ, tb, 0, slow);
+    tcg_gen_ld_i64(t, e, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_brcond_i64(TCG_COND_NE, t, pc, slow);
+    tcg_gen_ld_i32(a, tb, offsetof(TranslationBlock, flags));
+    tcg_gen_brcond_i32(TCG_COND_NE, a, flags, slow);
+    tcg_gen_ld_i32(a, tb, offsetof(TranslationBlock, cflags));
+    tcg_gen_ld_i32(b, tcg_env, offsetof(ArchCPU, parent_obj.tcg_cflags) -
+                               offsetof(ArchCPU, env));
+    tcg_gen_brcond_i32(TCG_COND_NE, a, b, slow);
+    tcg_gen_ld_ptr(p, tcg_env, offsetof(ArchCPU, parent_obj.breakpoints.tqh_first) -
+                               offsetof(ArchCPU, env));
+    tcg_gen_brcondi_ptr(TCG_COND_NE, p, 0, slow);
+
+    if (verify) {
+        gen_helper_lookup_tb_ptr_check(p, tcg_env, tb);
+    } else {
+        set_can_do_io(db, true);
+        tcg_gen_ld_ptr(p, tb, offsetof(TranslationBlock, tc.ptr));
+    }
+    tcg_gen_goto_ptr(p);
+
+    gen_set_label(slow);
+    gen_helper_lookup_tb_ptr(p, tcg_env);
+    tcg_gen_goto_ptr(p);
+}
