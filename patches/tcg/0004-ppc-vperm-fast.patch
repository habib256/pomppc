+/* vperm-fast: début (extrait tel quel par POMPPC tools/tcg/vpermproof.sh) */
+/*
+ * x-vperm-fast: helper_VPERM as one 32-byte table lookup.
+ * result.VsrB(i) = (s & 0x10 ? b : a).VsrB(s & 0xf), s = c.VsrB(i) & 0x1f.
+ * On a little-endian host VsrB(i) is u8[15 - i]; with T = b.u8[0..15] then
+ * a.u8[0..15], result.u8[j] = T[31 - (c.u8[j] & 31)] = T[~c.u8[j] & 31]
+ * (s < 16: T[31 - s] = a.u8[15 - s]; s >= 16: T[31 - s] = b.u8[31 - s]).
+ * On a big-endian host VsrB(i) is u8[i]: T = a.u8 then b.u8, index s.
+ * An arm64 host does the lookup with a single tbl on two registers.
+ * All three operands are read before r is written (r may alias them).
+ */
+void helper_VPERM_FAST(ppc_avr_t *r, ppc_avr_t *a, ppc_avr_t *b, ppc_avr_t *c)
+{
+#if defined(__aarch64__) && !HOST_BIG_ENDIAN
+    uint8x16x2_t t = { { vld1q_u8(b->u8), vld1q_u8(a->u8) } };
+    uint8x16_t idx = vandq_u8(vmvnq_u8(vld1q_u8(c->u8)), vdupq_n_u8(31));
+
+    vst1q_u8(r->u8, vqtbl2q_u8(t, idx));
+#else
+    uint8_t t[32], res[16];
+    int j;
+
+#if HOST_BIG_ENDIAN
+    memcpy(t, a->u8, 16);
+    memcpy(t + 16, b->u8, 16);
+    for (j = 0; j < 16; j++) {
+        res[j] = t[c->u8[j] & 31];
+    }
+#else
+    memcpy(t, b->u8, 16);
+    memcpy(t + 16, a->u8, 16);
+    for (j = 0; j < 16; j++) {
+        res[j] = t[~c->u8[j] & 31];
+    }
+#endif
+    memcpy(r->u8, res, 16);
+#endif
+}
+/* vperm-fast: fin */
