+/*
+ * POMPPC tcg/0049: the execution counters of x-tier2 (gen_t2_counter): an
+ * index into a table of each vCPU (CPUState.t2_ctrs), reused round robin.
+ * A counter in the TranslationBlock, next to its code, cost +80 % on
+ * t2bench (a store near code: the host's self-modifying-code check clears
+ * its pipeline), one table shared by the vCPUs +32 % (the lines of the hot
+ * TBs bounced between their caches).
+ */
+static unsigned t2_nctr;
+
+static uint32_t t2_ctr_alloc(void)
+{
+    CPUState *c;
+    uint32_t i;
+
+    do {
+        i = qatomic_fetch_inc(&t2_nctr) & (T2_NCTR - 1);
+    } while (!i);
+    CPU_FOREACH(c) {
+        if (c->t2_ctrs) {
+            qatomic_set(&c->t2_ctrs[i], 0);
+        }
+    }
+    return i;
+}
