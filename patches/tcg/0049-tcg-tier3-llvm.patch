diff -ruN a/include/tcg/tier3.h b/include/tcg/tier3.h
--- a/include/tcg/tier3.h
+++ b/include/tcg/tier3.h
@@ -0,0 +1,145 @@
+/*
+ * POMPPC tcg/0049 (x-tier3): compiled regions, the second level of the
+ * fast translator (docs/plan-traducteur-rapide.md, section 10).
+ *
+ * A region is a set of hot TBs linked by their hot exits (direct branches,
+ * same page or not, and returns of the calls it contains).  The TCG ops of
+ * each TB, exactly as TCG would translate them, are captured (tcg.c,
+ * t3_capture) into a small copy that outlives the translation, then the
+ * whole region is compiled by LLVM (tcg/tier3.c) into ONE host function,
+ * where the TB exits that lead to another TB of the region become plain
+ * branches: the guest registers stay in host registers from one TB to the
+ * next and are written back to env at the region exits, before the helpers
+ * that read them and on the slow path of the memory accesses only.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef TCG_TIER3_H
+#define TCG_TIER3_H
+
+/* the kind of a captured argument */
+enum {
+    T3A_TEMP,           /* EBB or TB temp: idx */
+    T3A_GLOBAL,         /* env-based global: idx, v = offset in env */
+    T3A_CONST,          /* constant: v */
+    T3A_ENV,            /* the env pointer (TEMP_FIXED) */
+    T3A_RAW,            /* constant argument of the op: v */
+    T3A_LABEL,          /* label: idx = label id */
+};
+
+typedef struct T3Arg {
+    int64_t v;
+    uint32_t idx;
+    uint8_t kind;
+    uint8_t type;       /* TCGType of a temp */
+} T3Arg;
+
+typedef struct T3Op {
+    uint16_t opc;
+    uint8_t p1, p2;     /* param1/param2 of the TCGOp */
+    uint8_t nargs;
+    uint8_t align;      /* qemu_ld/st: alignment bits of the fast path */
+    uint8_t headcheck;  /* the ld of icount_decr made by gen_tb_start */
+    uint32_t a;         /* first argument in T3Block.args */
+    uint64_t pc;        /* guest pc of the instruction (last insn_start) */
+} T3Op;
+
+#define T3_MAX_GLOBALS 256
+
+typedef struct T3Block {
+    uint64_t pc;
+    uint32_t icount;
+    int nops, nargs, nlabels;
+    T3Op *ops;
+    T3Arg *args;
+    const char *reject;         /* non-NULL: cannot be compiled, why */
+    /* direct exits seen at capture (constant nip at an exit) */
+    int nexit;
+    uint64_t exit_pc[8];
+    /* constants written to the link register (bl): candidate returns */
+    int nlr;
+    uint64_t lr_pc[4];
+    bool indirect;              /* an exit with a computed nip */
+} T3Block;
+
+/* globals seen by the captures: type and offset in env, by index */
+typedef struct T3Global {
+    intptr_t ofs;
+    uint8_t type;
+    bool known;
+} T3Global;
+extern T3Global t3_globals[T3_MAX_GLOBALS];
+
+/*
+ * What the target tells the region compiler (set at CPU realize):
+ * offsets in env of the pc (PowerPC nip), the link register and the TB
+ * flags (hflags), the TCG global index of nip and lr.
+ */
+typedef struct T3Target {
+    intptr_t pc_ofs, lr_ofs, flags_ofs;
+    int pc_size;                /* 4 or 8 */
+} T3Target;
+extern T3Target t3_target;
+
+#define T3_MAX_BLOCKS 64
+
+typedef struct T3Region {
+    uint64_t pc;
+    uint32_t flags, cflags;
+    uint64_t cs_base;
+    int nb;
+    T3Block *b[T3_MAX_BLOCKS];
+    void *tb[T3_MAX_BLOCKS];        /* the tier-1 TBs (TranslationBlock *) */
+    uint64_t page[T3_MAX_BLOCKS];   /* virtual page of block i */
+    uintptr_t addend[T3_MAX_BLOCKS];/* host - virtual address of that page */
+    bool ret_target[T3_MAX_BLOCKS]; /* reached by a predicted return */
+    int code_mmu_idx;
+    int addr_type;                  /* TCGType of guest addresses */
+    int dead;                       /* set when a TB of the region goes */
+    void *stub;                     /* TranslationBlock that enters it */
+    const void *(*fn)(void *env);
+    const void *(*fn_log)(void *env);   /* x-tier2-verify copy */
+    void **xcache;                  /* direct exits: TB last seen (chaining) */
+    int nxcache;
+    /* formation → (compile thread) → install */
+    void *priv;                     /* T3Code[]: code copies (install check) */
+    void *head;                     /* the hot TB the region replaces */
+    void *cpu;                      /* the vCPU that formed it, installs it */
+    unsigned flush_count;           /* tb_flush count at formation */
+    int ninsns, npages, tries;
+    bool with_log, compiled;
+    char why[160];
+    struct T3Region *qnext;
+    uint64_t insns;                 /* guest instructions run in it (stats) */
+    uint64_t entries;
+    unsigned id;
+    size_t code_size;
+    double compile_ms;
+    struct T3Region *next;
+} T3Region;
+
+/* region exits by kind (POMPPC_T3_STATS) */
+enum {
+    T3X_MAIN,       /* exit_tb 0: back to the main loop */
+    T3X_REQ,        /* head check of a TB (exit request) */
+    T3X_CHK,        /* back edge: exit request or region dead */
+    T3X_PAGE,       /* cross-page edge: the page maps elsewhere */
+    T3X_DIRECT,     /* direct branch out of the region */
+    T3X_INDIRECT,   /* computed branch (blr, bctr), no prediction */
+    T3X_RETMISS,    /* computed branch, predicted returns missed */
+    T3X_GOTOPTR,    /* other goto_ptr */
+    T3X_N
+};
+extern uint64_t t3_exit_stats[T3X_N];
+
+/* accel/tcg: a direct exit of a region, TB looked up and kept in *slot */
+const void *t3_chain(void *env, void **slot);
+#define T3_XCACHE 256
+
+/* tcg/tier3.c */
+bool t3_compile(T3Region *r, bool with_log, char *why, size_t whylen);
+void t3_block_free(T3Block *b);
+/* tcg.c: capture of the next translation into *b (NULL: none) */
+void t3_capture_set(T3Block *b);
+
+#endif
