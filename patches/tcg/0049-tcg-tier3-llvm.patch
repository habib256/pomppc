+#define T3_NWORDS (T3_MAX_GLOBALS / 64)
+typedef struct { uint64_t w[T3_NWORDS]; } T3Set;
+
+static inline void set_add(T3Set *s, int i) { s->w[i >> 6] |= 1ull << (i & 63); }
+static inline bool set_has(const T3Set *s, int i) { return s->w[i >> 6] >> (i & 63) & 1; }
+static inline void set_clear(T3Set *s) { memset(s, 0, sizeof(*s)); }
+static inline bool set_union(T3Set *d, const T3Set *s)
+{
+    bool ch = false;
+    for (int i = 0; i < T3_NWORDS; i++) {
+        uint64_t n = d->w[i] | s->w[i];
+        ch |= n != d->w[i];
+        d->w[i] = n;
+    }
+    return ch;
+}
+
+/* exits of a segment */
+enum {
+    SX_FALL,        /* falls into the next segment */
+    SX_BR,          /* br label */
+    SX_BRCOND,      /* brcond: label or next */
+    SX_MAIN,        /* exit_tb 0: back to the main loop */
+    SX_REQ,         /* exit_tb TB_EXIT_REQUESTED: head check */
+    SX_CHAIN,       /* exit_tb tb|n (goto_tb not chained): nip known or not */
+    SX_LOOKUP,      /* call lookup_tb_ptr + goto_ptr */
+    SX_GOTOPTR,     /* other goto_ptr */
+    SX_NORET,       /* noreturn helper */
+};
+
+#define T3_MAX_SUCC 72
+
+typedef struct Seg {
+    int blk, s, e;          /* ops [s, e) of block blk */
+    int kind;
+    int label;              /* SX_BR / SX_BRCOND target label */
+    bool nip_known;         /* SX_CHAIN / SX_LOOKUP: nip constant at the exit */
+    uint64_t nip;
+    int nsucc;
+    int succ[T3_MAX_SUCC];  /* successor segments (dataflow) */
+    T3Set in;
+    LLVMBasicBlockRef bb;
+} Seg;
+
+typedef struct Gen {
+    LLVMContextRef C;
+    LLVMModuleRef M;
+    LLVMBuilderRef B, BA;
+    LLVMValueRef F, env;
+    LLVMTypeRef i1, i8, i16, i32, i64, ptr, vt;
+    T3Region *r;
+    bool log;
+    T3Set used, written;
+    LLVMValueRef gval[T3_MAX_GLOBALS];
+    GHashTable *temps;
+    LLVMValueRef carry, budget;
+    Seg *seg;
+    int nseg, segcap;
+    int *entry;                 /* first segment of each block */
+    int **labseg;               /* [block][label] -> segment */
+    LLVMBasicBlockRef chk[T3_MAX_BLOCKS], pgb[T3_MAX_BLOCKS], pgc[T3_MAX_BLOCKS];
+    LLVMBasicBlockRef entry_bb;
+    const char *err;
+    int mutant;                 /* POMPPC_T3_MUTANT (tools/tcg/t3proof.sh) */
+} Gen;
