diff -ruN a/accel/tcg/tier3-exec.c.inc b/accel/tcg/tier3-exec.c.inc
--- a/accel/tcg/tier3-exec.c.inc
+++ b/accel/tcg/tier3-exec.c.inc
@@ -0,0 +1,935 @@
+/*
+ * POMPPC tcg/0049 (x-tier3=N): compiled regions, formed where x-tier2
+ * would form a trace (docs/plan-traducteur-rapide.md section 10).
+ * Included by cpu-exec.c.
+ *
+ * t3_form(): from the hot TB, the region grows breadth first along the
+ * exits seen in the captured ops (constant nip of a goto_tb or of a lookup,
+ * same page or not) and the returns of its calls (constant link register),
+ * through TBs that exist, are hot (count >= x-tier2 / 16), stay in one
+ * page each and whose ops can all be compiled; at most T3_MAX_BLOCKS TBs,
+ * 1024 instructions, 8 pages.  The region is compiled (tcg/tier3.c), then
+ * the hot TB is replaced by an entry TB (translator.c, gen_t3_stub) that
+ * calls it.
+ *
+ * Invalidation: the region is linked to the tier-1 TB of each of its
+ * blocks and to its entry TB; when one of them is invalidated (its code
+ * changed, tb_flush) the region is dead: its entry TB and its back edges
+ * see it and leave.  At install the guest code of every block is compared
+ * with the bytes it was compiled from (after the links are made, so that
+ * any later change kills the region).  Cross-page edges check at run time
+ * that the virtual page still maps the same host page (code TLB entry).
+ */
+#include "tcg/tier3.h"
+#include "accel/tcg/probe.h"
+
+typedef struct T3Link {
+    T3Region *r;
+    struct T3Link *next, *all;
+} T3Link;
+
+static QemuSpin t3_spin;
+static T3Link *t3_links_all;
+static T3Region *t3_regions;
+static unsigned t3_nreg, t3_ndead;
+static double t3_t0;                    /* first request (s) */
+static int64_t t3_epoch_next;           /* next reset of the TB counters */
+
+/*
+ * x-tier3: hotness is a rate.  Every second the execution counts of all TBs
+ * are cleared, so that x-tier2 = N means "N executions within one second":
+ * only the code hot NOW forms regions, not the code that added up to N
+ * executions since the boot.
+ */
+static uint64_t t3_tier1_insns;        /* (POMPPC_T3_STATS) counted so far */
+
+static gboolean t3_reset_tb(gpointer key, gpointer value, gpointer data)
+{
+    TranslationBlock *tb = value;
+
+    if (tb->t2_state != T3_STUB) {
+        CPUState *c;
+        CPU_FOREACH(c) {
+            t3_tier1_insns += (uint64_t)tb_t2_count(c, tb) * tb->icount;
+        }
+    }
+    return FALSE;
+}
+
+static void t3_epoch(void)
+{
+    static int noepoch = -1;
+    int64_t now;
+
+    if (noepoch < 0) {
+        noepoch = getenv("POMPPC_T3_NOEPOCH") != NULL;
+    }
+    if (noepoch) {
+        return;
+    }
+    now = get_clock();
+
+    if (now >= qatomic_read(&t3_epoch_next)) {
+        CPUState *c;
+
+        qatomic_set(&t3_epoch_next, now + NANOSECONDS_PER_SECOND);
+        if (getenv("POMPPC_T3_STATS")) {
+            tcg_tb_foreach(t3_reset_tb, NULL);   /* tier-1 count, then clear */
+        }
+        CPU_FOREACH(c) {
+            if (c->t2_ctrs) {
+                memset(c->t2_ctrs, 0, T2_NCTR * sizeof(uint32_t));
+            }
+        }
+    }
+}
+
+static void t3_kill(T3Region *r)
+{
+    if (!qatomic_xchg(&r->dead, 1)) {
+        qatomic_inc(&t3_ndead);
+    }
+}
+
+enum {
+    T3S_ASK, T3S_FORM, T3S_BLOCKS, T3S_INSNS, T3S_FULL, T3S_DROP, T3S_FAIL,
+    T3S_DEAD0, T3S_SMALL, T3S_PAGES, T3S_CODE, T3S_EXC,
+    T3S_BADSTUB, T3S_BADCODE, T3S_BADTB, T3S_INVAL, T3S_FLUSHK, T3S_MEMBER,
+    T3S_N
+};
+static uint64_t t3_g[T3S_N];
+static double t3_ms_total, t3_ms_max;
+static bool t3_atexit_done;
+
+#define T3_NREJ 32
+static struct { const char *why; uint64_t n; } t3_rej[T3_NREJ];
+
+static void t3_reject(const char *why)
+{
+    qemu_spin_lock(&t3_spin);
+    for (int i = 0; i < T3_NREJ; i++) {
+        if (!t3_rej[i].why || !strcmp(t3_rej[i].why, why)) {
+            t3_rej[i].why = why;
+            t3_rej[i].n++;
+            break;
+        }
+    }
+    qemu_spin_unlock(&t3_spin);
+}
+
+static gboolean t3_sum_tb(gpointer key, gpointer value, gpointer data)
+{
+    const TranslationBlock *tb = value;
+    uint64_t *sum = data;
+
+    if (tb->t2_state != T3_STUB) {
+        CPUState *c;
+        CPU_FOREACH(c) {
+            sum[0] += (uint64_t)tb_t2_count(c, tb) * tb->icount;
+        }
+    }
+    return FALSE;
+}
+
+static void t3_report(void)
+{
+    uint64_t entries = 0, insns = 0, dead = 0, code = 0, nb = 0;
+
+    if (!t3_g[T3S_ASK]) {
+        return;
+    }
+    for (T3Region *r = t3_regions; r; r = r->next) {
+        entries += r->entries;
+        insns += r->insns;
+        dead += r->dead;
+        code += r->code_size;
+        nb++;
+    }
+    fprintf(stderr, "x-tier3 : %" PRIu64 " demandes, %" PRIu64 " régions "
+            "(%" PRIu64 " blocs, %" PRIu64 " instructions invité, %" PRIu64
+            " pages hors tête), %" PRIu64 " écartées, %" PRIu64
+            " échecs de compilation, %" PRIu64 " sans boucle, budget plein %"
+            PRIu64 ", %" PRIu64 " mortes (dont %" PRIu64 " à l'installation)\n",
+            t3_g[T3S_ASK], t3_g[T3S_FORM], t3_g[T3S_BLOCKS], t3_g[T3S_INSNS],
+            t3_g[T3S_PAGES], t3_g[T3S_DROP], t3_g[T3S_FAIL], t3_g[T3S_SMALL],
+            t3_g[T3S_FULL], dead, t3_g[T3S_DEAD0]);
+    fprintf(stderr, "x-tier3 : morts à l'installation : TB d'entrée %" PRIu64
+            ", code changé %" PRIu64 ", TB invalidé %" PRIu64 " ; après : TB "
+            "invalidé %" PRIu64 " ; têtes déjà dans une région : %" PRIu64 "\n",
+            t3_g[T3S_BADSTUB], t3_g[T3S_BADCODE], t3_g[T3S_BADTB],
+            t3_g[T3S_INVAL], t3_g[T3S_MEMBER]);
+    fprintf(stderr, "x-tier3 : compilation %.1f ms au total, %.2f ms en "
+            "moyenne, %.1f ms au plus ; %" PRIu64 " octets de code ; %" PRIu64
+            " entrées dans les régions\n", t3_ms_total,
+            t3_g[T3S_FORM] ? t3_ms_total / t3_g[T3S_FORM] : 0.0, t3_ms_max,
+            code, entries);
+    if (insns) {
+        uint64_t sum[1] = { 0 };
+
+        tcg_tb_foreach(t3_sum_tb, sum);
+        sum[0] += t3_tier1_insns;
+        fprintf(stderr, "x-tier3 : couverture %" PRIu64 " instructions dans "
+                "les régions, %" PRIu64 " hors régions (TB comptés) : %.1f %%\n",
+                insns, sum[0], 100.0 * insns / (insns + sum[0]));
+    }
+    if (getenv("POMPPC_T3_STATS")) {
+        static const char *xn[T3X_N] = {
+            "boucle principale", "demande de sortie (tête de TB)",
+            "arête arrière (sortie demandée, région morte)", "page changée",
+            "branchement direct hors région", "branchement calculé",
+            "retour prédit manqué", "goto_ptr",
+        };
+        uint64_t tot = 0;
+        for (int k = 0; k < T3X_N; k++) {
+            tot += t3_exit_stats[k];
+        }
+        for (int k = 0; k < T3X_N; k++) {
+            fprintf(stderr, "x-tier3 : sorties %-46s %12" PRIu64 " (%.1f %%)\n",
+                    xn[k], t3_exit_stats[k],
+                    tot ? 100.0 * t3_exit_stats[k] / tot : 0.0);
+        }
+    }
+    if (getenv("POMPPC_T3_STATS")) {
+        /* the 20 regions with the most entries */
+        T3Region **v = g_new(T3Region *, nb ? nb : 1);
+        int n = 0;
+
+        for (T3Region *r = t3_regions; r; r = r->next) {
+            v[n++] = r;
+        }
+        for (int i = 0; i < n && i < 20; i++) {
+            int best = i;
+            for (int j = i + 1; j < n; j++) {
+                if (v[j]->entries > v[best]->entries) {
+                    best = j;
+                }
+            }
+            T3Region *t = v[best];
+            v[best] = v[i];
+            v[i] = t;
+            fprintf(stderr, "x-tier3 : #%d région %u 0x%" PRIx64 " %d blocs "
+                    "%" PRIu64 " entrées %" PRIu64 " instr. (%.1f par entrée)%s\n",
+                    i, t->id, t->pc, t->nb, t->entries, t->insns,
+                    t->entries ? (double)t->insns / t->entries : 0.0,
+                    t->dead ? " morte" : "");
+        }
+        g_free(v);
+    }
+    for (int i = 0; i < T3_NREJ && t3_rej[i].why; i++) {
+        fprintf(stderr, "x-tier3 : bloc écarté (%s) : %" PRIu64 "\n",
+                t3_rej[i].why, t3_rej[i].n);
+    }
+}
+
+static void t3_link_tb(TranslationBlock *tb, T3Region *r)
+{
+    T3Link *l = g_new(T3Link, 1);
+
+    l->r = r;
+    qemu_spin_lock(&t3_spin);
+    l->next = tb->t3_link;
+    tb->t3_link = l;
+    l->all = t3_links_all;
+    t3_links_all = l;
+    qemu_spin_unlock(&t3_spin);
+}
+
+void t3_tb_invalidated(TranslationBlock *tb)
+{
+    qemu_spin_lock(&t3_spin);
+    for (T3Link *l = tb->t3_link; l; l = l->next) {
+        if (!l->r->dead) {
+            static int nlog;
+            qatomic_add(&t3_g[T3S_INVAL], 1);
+            if (getenv("POMPPC_T3_LOG") && qatomic_fetch_inc(&nlog) < 40) {
+                fprintf(stderr, "x-tier3 : région %u 0x%" PRIx64 " morte : TB 0x%"
+                        VADDR_PRIx " (page 0x%" PRIx64 ") invalidé%s\n", l->r->id,
+                        l->r->pc, tb->pc, (uint64_t)tb_page_addr0(tb),
+                        tb == l->r->stub ? " (TB d'entrée)" : "");
+            }
+        }
+        t3_kill(l->r);
+    }
+    tb->t3_link = NULL;
+    qemu_spin_unlock(&t3_spin);
+}
+
+/* tb_flush: exclusive, every TB goes */
+void t3_flush(void)
+{
+    T3Link *l, *n;
+
+    qemu_spin_lock(&t3_spin);
+    for (T3Region *r = t3_regions; r; r = r->next) {
+        t3_kill(r);
+        r->stub = NULL;
+        for (int i = 0; i < r->nb; i++) {
+            r->tb[i] = NULL;
+        }
+        if (r->xcache) {
+            memset(r->xcache, 0, sizeof(void *) * T3_XCACHE);
+        }
+    }
+    for (l = t3_links_all; l; l = n) {
+        n = l->all;
+        g_free(l);
+    }
+    t3_links_all = NULL;
+    qemu_spin_unlock(&t3_spin);
+}
+
+const void *HELPER(t3_run)(CPUArchState *env, void *pr)
+{
+    T3Region *r = pr;
+    CPUState *cpu = env_cpu(env);
+    const void *p;
+
+    if (unlikely(qatomic_read(&r->dead))) {
+        /* the main loop throws its entry TB away: a new TB can get hot */
+        if (!cpu->t3_kill) {
+            cpu->t3_kill = r;
+            qatomic_set(&cpu->neg.icount_decr.u16.high, -1);
+        }
+        return NULL;
+    }
+    r->entries++;
+    cpu->t3_active = true;
+    p = r->fn(env);
+    cpu->t3_active = false;
+    return p;
+}
+
+static void t3_kill_stub(CPUState *cpu)
+{
+    T3Region *r = cpu->t3_kill;
+    TranslationBlock *stub;
+
+    cpu->t3_kill = NULL;
+    qemu_spin_lock(&t3_spin);
+    stub = r->stub;
+    r->stub = NULL;
+    qemu_spin_unlock(&t3_spin);
+    if (stub && stub->t3_region == r && !(tb_cflags(stub) & CF_INVALID)) {
+        mmap_lock();
+        tb_phys_invalidate(stub, -1);
+        mmap_unlock();
+    }
+}
+
+/*
+ * A direct exit of a region to a TB of the same page (as goto_tb chains):
+ * as helper_lookup_tb_ptr, and the TB is kept in *slot, which the region
+ * checks next time (same pc, same cflags: not invalid) instead of a lookup.
+ */
+const void *t3_chain(void *penv, void **slot)
+{
+    CPUArchState *env = penv;
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb;
+    TCGTBCPUState s;
+
+    cpu->neg.can_do_io = true;
+    s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    s.cflags = curr_cflags(cpu);
+    if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
+        cpu_loop_exit(cpu);
+    }
+    tb = tb_lookup(cpu, s, 1);
+    if (tb == NULL) {
+        return tcg_code_gen_epilogue;
+    }
+    if (unlikely(cpu->t2_verify) && tb->t2_state >= T2_TRACE) {
+        return tcg_code_gen_epilogue;
+    }
+    if (s.cflags == curr_cflags(cpu)) {
+        qatomic_set(slot, tb);
+    }
+    return tb->tc.ptr;
+}
+
+/* the guest code of a block, copied at capture (install check) */
+typedef struct T3Code {
+    uint8_t *host;
+    uint8_t *copy;
+    uint32_t size;
+} T3Code;
+
+static TranslationBlock *t3_capture_tb(CPUState *cpu, TCGTBCPUState s,
+                                       T3Block *b)
+{
+    TranslationBlock *ct;
+
+    s.cflags |= CF_T3_CAP;
+    mmap_lock();
+    t3_capture_set(b);
+    ct = tb_gen_code(cpu, s);
+    t3_capture_set(NULL);
+    if (ct) {
+        tb_phys_invalidate(ct, -1);
+    }
+    mmap_unlock();
+    return ct;
+}
+
+static void t3_region_free(T3Region *r, T3Code *code)
+{
+    for (int i = 0; i < r->nb; i++) {
+        t3_block_free(r->b[i]);
+        g_free(code[i].copy);
+    }
+    g_free(r->xcache);
+    g_free(r);
+}
+
+/* does the region loop (a cycle among its blocks)? */
+static bool t3_has_cycle(T3Region *r)
+{
+    uint64_t reach[T3_MAX_BLOCKS] = { 0 };   /* reach[k]: successors of k */
+    bool changed = true;
+
+    for (int k = 0; k < r->nb; k++) {
+        T3Block *b = r->b[k];
+        for (int j = 0; j < r->nb; j++) {
+            for (int i = 0; i < b->nexit; i++) {
+                if (b->exit_pc[i] == r->b[j]->pc) {
+                    reach[k] |= 1ull << j;
+                }
+            }
+            if (b->indirect && r->ret_target[j]) {
+                reach[k] |= 1ull << j;
+            }
+        }
+    }
+    while (changed) {
+        changed = false;
+        for (int k = 0; k < r->nb; k++) {
+            uint64_t n = reach[k];
+            for (int j = 0; j < r->nb; j++) {
+                if (reach[k] >> j & 1) {
+                    n |= reach[j];
+                }
+            }
+            changed |= n != reach[k];
+            reach[k] = n;
+        }
+    }
+    for (int k = 0; k < r->nb; k++) {
+        if (reach[k] >> k & 1) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * The compile thread: regions formed by the vCPUs are compiled here, so that
+ * a vCPU never waits for LLVM; the vCPU that formed a region installs it
+ * (t3_install_ready, from its main loop).
+ */
+static QemuMutex t3_qlock;
+static QemuCond t3_qcond;
+static T3Region *t3_qhead, **t3_qtail = &t3_qhead;
+static int t3_qlen;
+static bool t3_thread_started;
+static QemuThread t3_thread;
+
+static void t3_region_free2(T3Region *r)
+{
+    T3Code *code = r->priv;
+
+    for (int i = 0; i < r->nb; i++) {
+        t3_block_free(r->b[i]);
+        if (code) {
+            g_free(code[i].copy);
+        }
+    }
+    g_free(code);
+    g_free(r->xcache);
+    g_free(r);
+}
+
+static void *t3_compile_thread(void *arg)
+{
+    rcu_register_thread();
+    for (;;) {
+        T3Region *r;
+        CPUState *cpu;
+
+        qemu_mutex_lock(&t3_qlock);
+        while (!t3_qhead) {
+            qemu_cond_wait(&t3_qcond, &t3_qlock);
+        }
+        r = t3_qhead;
+        t3_qhead = r->qnext;
+        if (!t3_qhead) {
+            t3_qtail = &t3_qhead;
+        }
+        t3_qlen--;
+        qemu_mutex_unlock(&t3_qlock);
+
+        r->compiled = t3_compile(r, r->with_log, r->why, sizeof(r->why));
+        cpu = r->cpu;
+        qemu_spin_lock(&t3_spin);
+        r->qnext = cpu->t3_ready;
+        cpu->t3_ready = r;
+        qemu_spin_unlock(&t3_spin);
+        qatomic_set(&cpu->neg.icount_decr.u16.high, -1);
+    }
+    return NULL;
+}
+
+static void t3_queue_push(T3Region *r)
+{
+    qemu_mutex_lock(&t3_qlock);
+    if (!t3_thread_started) {
+        t3_thread_started = true;
+        qemu_cond_init(&t3_qcond);
+        qemu_thread_create(&t3_thread, "t3-llvm", t3_compile_thread, NULL,
+                           QEMU_THREAD_DETACHED);
+    }
+    if (t3_qlen >= 16) {
+        /* LLVM behind: forget this one, its TB stays asked (no new request) */
+        qemu_mutex_unlock(&t3_qlock);
+        qatomic_add(&t3_g[T3S_DROP], 1);
+        t3_region_free2(r);
+        return;
+    }
+    r->qnext = NULL;
+    *t3_qtail = r;
+    t3_qtail = &r->qnext;
+    t3_qlen++;
+    qemu_cond_signal(&t3_qcond);
+    qemu_mutex_unlock(&t3_qlock);
+}
+
+/*
+ * Install a compiled region (vCPU thread): links first, then the entry TB,
+ * then the code check.  The vCPU must be in the context the region was
+ * formed in (TB flags, same physical page for its head): if not, later.
+ */
+static bool t3_install(CPUState *cpu, T3Region *r)
+{
+    TranslationBlock *a = r->head, *stub;
+    T3Code *code = r->priv;
+    TCGTBCPUState s;
+    bool bad;
+
+    if (!r->compiled) {
+        static int nfail;
+        qatomic_add(&t3_g[T3S_FAIL], 1);
+        if (qatomic_fetch_inc(&nfail) < 10) {
+            fprintf(stderr, "x-tier3 : région 0x%" PRIx64 " non compilée : %s\n",
+                    r->pc, r->why);
+        }
+        t3_region_free2(r);
+        return true;
+    }
+    if (qatomic_read(&tb_ctx.tb_flush_count) != r->flush_count ||
+        (tb_cflags(a) & CF_INVALID) || qatomic_read(&a->t3_link) ||
+        qatomic_read(&t3_nreg) - qatomic_read(&t3_ndead) >= cpu->t3_max) {
+        qatomic_add(&t3_g[T3S_DROP], 1);
+        t3_region_free2(r);
+        return true;
+    }
+    s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    {
+        CPUTLBEntryFull *full;
+        void *ph = NULL;
+
+        if (s.flags == r->flags) {
+            /* (never fault here: probe the head page first) */
+            probe_access_full(cpu_env(cpu), r->pc, 1, MMU_INST_FETCH,
+                              r->code_mmu_idx, true, &ph, &full, 0);
+        }
+        if (!ph) {
+            s.flags = ~r->flags;        /* not now */
+        }
+    }
+    if (s.flags != r->flags || s.cs_base != r->cs_base ||
+        curr_cflags(cpu) != r->cflags ||
+        get_page_addr_code(cpu_env(cpu), r->pc) != tb_page_addr0(a)) {
+        if (++r->tries > 100000) {
+            qatomic_add(&t3_g[T3S_DROP], 1);
+            t3_region_free2(r);
+            return true;
+        }
+        return false;           /* another context: try again later */
+    }
+    t3_ms_total += r->compile_ms;
+    t3_ms_max = MAX(t3_ms_max, r->compile_ms);
+    if (getenv("POMPPC_T3_NOINSTALL")) {
+        /* control: everything but the installation */
+        qatomic_add(&t3_g[T3S_DROP], 1);
+        t3_region_free2(r);
+        return true;
+    }
+
+    for (int k = 1; k < r->nb; k++) {
+        t3_link_tb(r->tb[k], r);
+    }
+    mmap_lock();
+    tb_phys_invalidate(a, -1);
+    cpu->t3_install = r;
+    s.pc = r->pc;
+    s.cflags = r->cflags;
+    stub = tb_gen_code(cpu, s);
+    cpu->t3_install = NULL;
+    mmap_unlock();
+    bad = !stub || stub->t2_state != T3_STUB || stub->t3_region != r;
+    if (bad) {
+        qatomic_add(&t3_g[T3S_BADSTUB], 1);
+    }
+    if (!bad) {
+        t3_link_tb(stub, r);
+        r->stub = stub;
+    }
+    for (int k = 0; k < r->nb; k++) {
+        if (memcmp(code[k].host, code[k].copy, code[k].size) != 0) {
+            qatomic_add(&t3_g[T3S_BADCODE], 1);
+            bad = true;
+        }
+        if (k > 0 && (tb_cflags((TranslationBlock *)r->tb[k]) & CF_INVALID)) {
+            qatomic_add(&t3_g[T3S_BADTB], 1);
+            bad = true;
+        }
+        g_free(code[k].copy);
+        code[k].copy = NULL;
+    }
+    g_free(code);
+    r->priv = NULL;
+    if (bad) {
+        t3_kill(r);
+        qatomic_add(&t3_g[T3S_DEAD0], 1);
+    }
+    r->id = qatomic_fetch_inc(&t3_nreg);
+    qemu_spin_lock(&t3_spin);
+    r->next = t3_regions;
+    t3_regions = r;
+    qemu_spin_unlock(&t3_spin);
+    qatomic_add(&t3_g[T3S_FORM], 1);
+    qatomic_add(&t3_g[T3S_BLOCKS], r->nb);
+    qatomic_add(&t3_g[T3S_INSNS], r->ninsns);
+    qatomic_add(&t3_g[T3S_PAGES], r->npages - 1);
+    if (getenv("POMPPC_T3_LOG")) {
+        fprintf(stderr, "x-tier3 : région %u 0x%" PRIx64 " : %d blocs, %d "
+                "instructions, %d pages, %.2f ms, %zu octets, à %.1f s\n", r->id,
+                r->pc, r->nb, r->ninsns, r->npages, r->compile_ms, r->code_size,
+                get_clock_realtime() / 1e9 - t3_t0);
+        if (atoi(getenv("POMPPC_T3_LOG")) > 1) {
+            for (int k = 0; k < r->nb; k++) {
+                fprintf(stderr, "   bloc %d 0x%" PRIx64 " %u instr.%s\n", k,
+                        r->b[k]->pc, r->b[k]->icount,
+                        r->ret_target[k] ? " (retour)" : "");
+            }
+        }
+    }
+    return true;
+}
+
+static void t3_install_ready(CPUState *cpu)
+{
+    T3Region *list, *r, *keep = NULL;
+
+    qemu_spin_lock(&t3_spin);
+    list = cpu->t3_ready;
+    cpu->t3_ready = NULL;
+    qemu_spin_unlock(&t3_spin);
+    while ((r = list)) {
+        list = r->qnext;
+        if (!t3_install(cpu, r)) {
+            r->qnext = keep;
+            keep = r;
+        }
+    }
+    if (keep) {
+        qemu_spin_lock(&t3_spin);
+        for (r = keep; r->qnext; r = r->qnext) {
+        }
+        r->qnext = cpu->t3_ready;
+        cpu->t3_ready = keep;
+        qemu_spin_unlock(&t3_spin);
+    }
+}
+
+static void t3_form(CPUState *cpu)
+{
+#ifndef CONFIG_USER_ONLY
+    TranslationBlock *a = cpu->t2_pending;
+    CPUArchState *env = cpu_env(cpu);
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    T3Code code[T3_MAX_BLOCKS];
+    T3Region *r;
+    uint32_t min_count = MAX(cpu->t2_thresh / 16, 1);
+    int insns = 0, npages = 1;
+    uint64_t pages[8];
+    cpu->t2_pending = NULL;
+    qatomic_add(&t3_g[T3S_ASK], 1);
+    if (!t3_t0) {
+        t3_t0 = get_clock_realtime() / 1e9;
+    }
+    if (getenv("POMPPC_T3_NOFORM")) {
+        return;                 /* control: counters and epochs only */
+    }
+    if (!qatomic_xchg(&t3_atexit_done, true)) {
+        atexit(t3_report);
+    }
+    /* x-tier3=N: at most N live regions */
+    if (qatomic_read(&t3_nreg) - qatomic_read(&t3_ndead) >= cpu->t3_max) {
+        qatomic_add(&t3_g[T3S_FULL], 1);
+        return;
+    }
+    s.cflags = curr_cflags(cpu);
+    /*
+     * A TB that is a block of a live region does not become the head of
+     * another: installing it would invalidate the TB, i.e. kill the region
+     * it belongs to (regions killing each other in turn).
+     */
+    if (qatomic_read(&a->t3_link)) {
+        qatomic_add(&t3_g[T3S_MEMBER], 1);
+        return;
+    }
+    if ((tb_cflags(a) & CF_INVALID) || a->flags != s.flags ||
+        a->cs_base != s.cs_base || tb_cflags(a) != s.cflags ||
+        (tb_cflags(a) & CF_PCREL) || tb_page_addr1(a) != -1 ||
+        get_page_addr_code(env, a->pc) != tb_page_addr0(a)) {
+        qatomic_add(&t3_g[T3S_DROP], 1);
+        return;
+    }
+    r = g_new0(T3Region, 1);
+    r->pc = a->pc;
+    r->flags = s.flags;
+    r->cflags = s.cflags;
+    r->cs_base = s.cs_base;
+    r->code_mmu_idx = cpu_mmu_index(cpu, true);
+    r->addr_type = tcg_ctx->addr_type;
+    r->xcache = g_new0(void *, T3_XCACHE);
+    pages[0] = a->pc & TARGET_PAGE_MASK;
+
+    /* breadth first from the hot TB */
+    for (int q = -1; q < r->nb; q++) {
+        uint64_t cand[16];
+        bool is_ret[16];
+        int nc = 0;
+
+        if (q < 0) {
+            cand[nc] = a->pc;
+            is_ret[nc++] = false;
+        } else {
+            T3Block *qb = r->b[q];
+            for (int i = 0; i < qb->nexit && nc < 16; i++) {
+                cand[nc] = qb->exit_pc[i];
+                is_ret[nc++] = false;
+            }
+            for (int i = 0; i < qb->nlr && nc < 16; i++) {
+                cand[nc] = qb->lr_pc[i];
+                is_ret[nc++] = true;
+            }
+        }
+        for (int c = 0; c < nc && r->nb < T3_MAX_BLOCKS; c++) {
+            TCGTBCPUState sc = s;
+            TranslationBlock *t, *ct;
+            T3Block *b;
+            void *host;
+            uint64_t page = cand[c] & TARGET_PAGE_MASK;
+            int k, p;
+
+            for (k = 0; k < r->nb && r->b[k]->pc != cand[c]; k++) {
+            }
+            if (k < r->nb) {
+                if (is_ret[c]) {
+                    r->ret_target[k] = true;
+                }
+                continue;
+            }
+            sc.pc = cand[c];
+            t = q < 0 ? a : tb_htable_lookup(cpu, sc);
+            if (!t || (tb_cflags(t) & CF_INVALID) || tb_page_addr1(t) != -1 ||
+                t->t2_state == T2_TRACE || t->t2_state == T3_STUB ||
+                (q >= 0 && tb_t2_count(cpu, t) < min_count) ||
+                insns + t->icount > 1024) {
+                continue;
+            }
+            for (p = 0; p < npages && pages[p] != page; p++) {
+            }
+            if (p == npages && npages == 8) {
+                continue;
+            }
+            {
+                /* never fault here: probe first (the page may be unmapped) */
+                CPUTLBEntryFull *full;
+                void *ph = NULL;
+
+                probe_access_full(env, cand[c], 1, MMU_INST_FETCH,
+                                  r->code_mmu_idx, true, &ph, &full, 0);
+                if (!ph || get_page_addr_code_hostp(env, cand[c], &host) !=
+                    tb_page_addr0(t) || !host) {
+                    continue;
+                }
+            }
+            b = g_new0(T3Block, 1);
+            ct = t3_capture_tb(cpu, sc, b);
+            if (!b->reject && (!ct || b->icount != t->icount ||
+                               b->pc != cand[c])) {
+                b->reject = "capture différente du TB";
+            }
+            if (b->reject) {
+                t3_reject(b->reject);
+                t3_block_free(b);
+                if (q < 0) {
+                    g_free(r->xcache);
+                    g_free(r);
+                    return;
+                }
+                continue;
+            }
+            if (p == npages) {
+                pages[npages++] = page;
+            }
+            k = r->nb++;
+            r->b[k] = b;
+            r->tb[k] = t;
+            r->page[k] = page;
+            r->addend[k] = (uintptr_t)host - cand[c];
+            r->ret_target[k] = is_ret[c];
+            code[k].host = host;
+            code[k].size = t->size;
+            code[k].copy = g_memdup2(host, t->size);
+            insns += t->icount;
+        }
+    }
+    /*
+     * A region pays an entry (helper call, guest registers loaded) and an
+     * exit (registers stored, next TB looked up): it gains only if it runs
+     * long, i.e. if it loops.  POMPPC_T3_ANY=1 takes any region.
+     */
+    if (!t3_has_cycle(r) && !getenv("POMPPC_T3_ANY")) {
+        qatomic_add(&t3_g[T3S_SMALL], 1);
+        t3_region_free(r, code);
+        return;
+    }
+
+    r->priv = g_memdup2(code, sizeof(T3Code) * r->nb);
+    r->head = a;
+    r->cpu = cpu;
+    r->flush_count = qatomic_read(&tb_ctx.tb_flush_count);
+    r->ninsns = insns;
+    r->npages = npages;
+    r->with_log = cpu->t2_verify != 0;
+    if (getenv("POMPPC_T3_SYNC")) {
+        /* compile here, in the vCPU thread (the vCPU waits) */
+        r->compiled = t3_compile(r, r->with_log, r->why, sizeof(r->why));
+        t3_install(cpu, r);
+    } else {
+        t3_queue_push(r);
+    }
+#endif
+}
+
+/* x-tier2-verify on a region: its logged copy, then its TBs replayed */
+#define T3_REPLAY_MAX 4096
+
+static bool t3_verify(CPUState *cpu, TCGTBCPUState s, TranslationBlock *stub)
+{
+#ifndef CONFIG_USER_ONLY
+    T3Region *r = stub->t3_region;
+    T2Log *l = cpu->t2_log;
+    vaddr end_pc;
+    char why[160];
+    int steps;
+    static int nreport;
+    vaddr rpc[8];
+
+    if (!cpu->t2_regs || !r || !r->fn_log || qatomic_read(&r->dead)) {
+        return false;
+    }
+    if (!l) {
+        l = cpu->t2_log = g_new0(T2Log, 1);
+        l->e0 = g_malloc0(cpu->t2_regs_size);
+        l->e1 = g_malloc0(cpu->t2_regs_size);
+    }
+    qatomic_add(&t2_g[T2S_VRUN], 1);
+    cpu->t2_regs(cpu, l->e0, 0, NULL, 0);
+    l->n = l->pos = 0;
+    l->overflow = l->unverif = l->diverged = false;
+    cpu->t2_vrun = 1;                   /* an exception here is real */
+    cpu->t3_active = true;
+    r->entries++;
+    r->fn_log(cpu_env(cpu));
+    cpu->t3_active = false;
+    cpu->t2_vrun = 0;
+    end_pc = cpu->cc->tcg_ops->get_tb_cpu_state(cpu).pc;
+    cpu->t2_regs(cpu, l->e1, 0, NULL, 0);
+    if (l->overflow || l->unverif) {
+        qatomic_add(&t2_g[T2S_VSKIP], 1);
+        return true;
+    }
+
+    cpu->t2_regs(cpu, l->e0, 1, NULL, 0);
+    l->pos = 0;
+    for (steps = 0; steps < T3_REPLAY_MAX; steps++) {
+        TCGTBCPUState sr = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+        TranslationBlock *rt;
+
+        if (steps && l->pos == l->n && sr.pc == end_pc) {
+            break;
+        }
+        if (steps < 8) {
+            rpc[steps] = sr.pc;
+        }
+        if (sr.flags != s.flags || l->diverged) {
+            t2_diverge(l, "contexte changé", sr.pc, 0, 0);
+            break;
+        }
+        sr.cflags = curr_cflags(cpu) | CF_T2_REPLAY | T2_VFLAGS;
+        rt = tb_htable_lookup(cpu, sr);
+        if (!rt) {
+            mmap_lock();
+            rt = tb_gen_code(cpu, sr);
+            mmap_unlock();
+        }
+        cpu->t2_vrun = 2;
+        t2_exec_one(cpu, rt);
+        cpu->t2_vrun = 0;
+    }
+    if (!l->diverged && steps == T3_REPLAY_MAX) {
+        t2_diverge(l, "pas de fin", end_pc, 0, 0);
+    }
+    if (!l->diverged && l->pos != l->n) {
+        t2_diverge(l, "accès manquants", 0, 0, 0);
+    }
+    qatomic_add(&t2_g[T2S_VACC], l->pos);
+    if (!l->diverged && cpu->t2_regs(cpu, l->e1, 2, why, sizeof(why))) {
+        l->diverged = true;
+        snprintf(l->why, sizeof(l->why), "registres : %s", why);
+    }
+    if (l->diverged) {
+        qatomic_add(&t2_g[T2S_VBAD], 1);
+        if (qatomic_fetch_inc(&nreport) < 30) {
+            fprintf(stderr, "x-tier3-verify : DIVERGENCE région %u 0x%" PRIx64
+                    " (%d blocs, sortie 0x%" VADDR_PRIx ") : %s ; blocs",
+                    r->id, r->pc, r->nb, end_pc, l->why);
+            for (int k = 0; k < steps && k < 8; k++) {
+                fprintf(stderr, " 0x%" VADDR_PRIx, rpc[k]);
+            }
+            fprintf(stderr, " ; journal");
+            for (uint32_t k = 0; k < l->n && k < 24; k++) {
+                fprintf(stderr, " %c%" PRIx64, l->e[k].memop == T2_MARK ? '>' :
+                        l->e[k].st ? 'w' : 'r', l->e[k].addr);
+            }
+            fprintf(stderr, "\n");
+        }
+    } else {
+        qatomic_add(&t2_g[T2S_VOK], 1);
+    }
+    cpu->t2_regs(cpu, l->e1, 1, NULL, 0);      /* the real state */
+    return true;
+#else
+    return false;
+#endif
+}
+
+static void __attribute__((constructor)) t3_exec_init(void)
+{
+    qemu_spin_init(&t3_spin);
+    qemu_mutex_init(&t3_qlock);
+}
