+static QemuMutex t3_jit_lock;
+static LLVMOrcLLJITRef t3_jit;
+static LLVMTargetMachineRef t3_tm;
+static bool t3_jit_ok;
+static unsigned t3_nmod;
+
+/* ---- code ranges (perf map, statistics), Linux: our own memory manager */
+#ifdef __linux__
+#include <sys/mman.h>
+#define T3_ARENA (256u << 20)
+static uint8_t *t3_arena;
+static size_t t3_arena_used;
+static size_t t3_last_code;
+
+static uint8_t *t3_alloc(uintptr_t size, unsigned align)
+{
+    size_t p;
+
+    if (align < 16) {
+        align = 16;
+    }
+    p = ROUND_UP(t3_arena_used, align);
+    if (p + size > T3_ARENA) {
+        return NULL;
+    }
+    t3_arena_used = p + size;
+    return t3_arena + p;
+}
+
+static struct { uint8_t *p; uintptr_t size; } t3_sec[8];
+static int t3_nsec;
+
+static uint8_t *t3_mm_code(void *opaque, uintptr_t size, unsigned align,
+                           unsigned id, const char *name)
+{
+    uint8_t *p = t3_alloc(size, align);
+
+    t3_last_code += size;
+    if (t3_nsec < 8) {
+        t3_sec[t3_nsec].p = p;
+        t3_sec[t3_nsec++].size = size;
+    }
+    return p;
+}
+
+static uint8_t *t3_mm_data(void *opaque, uintptr_t size, unsigned align,
+                           unsigned id, const char *name, LLVMBool ro)
+{
+    return t3_alloc(size, align);
+}
+
+static LLVMBool t3_mm_finalize(void *opaque, char **err)
+{
+    return 0;
+}
+
+static void t3_mm_destroy(void *opaque) { }
+static void *t3_mm_ctx(void *opaque) { return NULL; }
+static void t3_mm_term(void *opaque) { }
+
+static LLVMOrcObjectLayerRef t3_layer(void *ctx, LLVMOrcExecutionSessionRef es,
+                                      const char *triple)
+{
+    return LLVMOrcCreateRTDyldObjectLinkingLayerWithMCJITMemoryManagerLikeCallbacks(
+        es, NULL, t3_mm_ctx, t3_mm_term, t3_mm_code, t3_mm_data,
+        t3_mm_finalize, t3_mm_destroy);
+}
+#endif
+
+static bool t3_jit_init(char *why, size_t whylen)
+{
+    static bool done;
+    LLVMErrorRef e;
+    LLVMOrcLLJITBuilderRef jb;
+    char *triple, *err = NULL;
+    LLVMTargetRef T;
+
+    if (done) {
+        return t3_jit_ok;
+    }
+    done = true;
+    LLVMInitializeNativeTarget();
+    LLVMInitializeNativeAsmPrinter();
+    jb = LLVMOrcCreateLLJITBuilder();
+#ifdef __linux__
+    t3_arena = mmap(NULL, T3_ARENA, PROT_READ | PROT_WRITE | PROT_EXEC,
+                    MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (t3_arena == MAP_FAILED) {
+        snprintf(why, whylen, "mmap de l'arène");
+        return false;
+    }
+    LLVMOrcLLJITBuilderSetObjectLinkingLayerCreator(jb, t3_layer, NULL);
+#endif
+    e = LLVMOrcCreateLLJIT(&t3_jit, jb);
+    if (e) {
+        char *m = LLVMGetErrorMessage(e);
+        snprintf(why, whylen, "LLJIT : %s", m);
+        LLVMDisposeErrorMessage(m);
+        return false;
+    }
+    {
+        /* the libcalls LLVM may emit (128-bit division...) from the process */
+        LLVMOrcDefinitionGeneratorRef gen;
+        e = LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
+                &gen, LLVMOrcLLJITGetGlobalPrefix(t3_jit), NULL, NULL);
+        if (e) {
+            char *m = LLVMGetErrorMessage(e);
+            snprintf(why, whylen, "symboles du processus : %s", m);
+            LLVMDisposeErrorMessage(m);
+            return false;
+        }
+        LLVMOrcJITDylibAddGenerator(LLVMOrcLLJITGetMainJITDylib(t3_jit), gen);
+    }
+    triple = LLVMGetDefaultTargetTriple();
+    if (LLVMGetTargetFromTriple(triple, &T, &err)) {
+        snprintf(why, whylen, "cible : %s", err);
+        return false;
+    }
+    t3_tm = LLVMCreateTargetMachine(T, triple, LLVMGetHostCPUName(),
+                                    LLVMGetHostCPUFeatures(),
+                                    LLVMCodeGenLevelDefault, LLVMRelocDefault,
+                                    LLVMCodeModelJITDefault);
+    t3_jit_ok = true;
+    return true;
+}
+
+/* ---- helpers of IR building */
+
+static LLVMTypeRef ty(Gen *g, int type)
+{
+    return type == TCG_TYPE_I32 ? g->i32 : g->i64;
+}
+
+static LLVMValueRef cint(LLVMTypeRef t, uint64_t v)
+{
+    return LLVMConstInt(t, v, 0);
+}
+
+static LLVMValueRef envp(Gen *g, intptr_t ofs)
+{
+    LLVMValueRef idx = cint(g->i64, ofs);
+    return LLVMBuildGEP2(g->B, g->i8, g->env, &idx, 1, "");
+}
+
+static LLVMValueRef absp(Gen *g, const void *p)
+{
+    return LLVMConstIntToPtr(cint(g->i64, (uintptr_t)p), g->ptr);
+}
+
+static LLVMValueRef load(Gen *g, LLVMTypeRef t, LLVMValueRef p)
+{
+    LLVMValueRef v = LLVMBuildLoad2(g->B, t, p, "");
+    LLVMSetAlignment(v, 1);
+    return v;
+}
+
+static void store(Gen *g, LLVMValueRef v, LLVMValueRef p)
+{
+    LLVMValueRef s = LLVMBuildStore(g->B, v, p);
+    LLVMSetAlignment(s, 1);
+}
+
+static LLVMValueRef temp_slot(Gen *g, T3Arg *a)
+{
+    gpointer key = GUINT_TO_POINTER((a->idx << 2) | (a->type & 3));
+    LLVMValueRef s = g_hash_table_lookup(g->temps, key);
+
+    if (!s) {
+        s = LLVMBuildAlloca(g->BA, ty(g, a->type), "t");
+        g_hash_table_insert(g->temps, key, s);
+    }
+    return s;
+}
+
+static LLVMValueRef get(Gen *g, T3Arg *a)
+{
+    switch (a->kind) {
+    case T3A_CONST:
+        return cint(ty(g, a->type), a->v);
+    case T3A_ENV:
+        return LLVMBuildPtrToInt(g->B, g->env, g->i64, "");
+    case T3A_GLOBAL:
+        return LLVMBuildLoad2(g->B, ty(g, t3_globals[a->idx].type),
+                              g->gval[a->idx], "");
+    case T3A_TEMP:
+        return LLVMBuildLoad2(g->B, ty(g, a->type), temp_slot(g, a), "");
+    default:
+        g->err = "argument non valeur";
+        return cint(g->i64, 0);
+    }
+}
+
+static void set(Gen *g, T3Arg *a, LLVMValueRef v)
+{
+    LLVMTypeRef want = a->kind == T3A_GLOBAL ? ty(g, t3_globals[a->idx].type)
+                                             : ty(g, a->type);
+    if (LLVMTypeOf(v) != want) {
+        v = LLVMBuildZExtOrBitCast(g->B, v, want, "");  /* (i1 results) */
+    }
+    switch (a->kind) {
+    case T3A_GLOBAL:
+        LLVMBuildStore(g->B, v, g->gval[a->idx]);
+        break;
+    case T3A_TEMP:
+        LLVMBuildStore(g->B, v, temp_slot(g, a));
+        break;
+    default:
+        g->err = "écriture d'un non-temp";
+        break;
+    }
+}
+
+static LLVMValueRef intrin(Gen *g, const char *name, LLVMTypeRef t,
+                           LLVMValueRef *args, int n)
+{
+    unsigned id = LLVMLookupIntrinsicID(name, strlen(name));
+    LLVMValueRef f = LLVMGetIntrinsicDeclaration(g->M, id, &t, 1);
+    LLVMTypeRef ft = LLVMIntrinsicGetType(g->C, id, &t, 1);
+
+    return LLVMBuildCall2(g->B, ft, f, args, n, "");
+}
+
+static LLVMValueRef call_abs(Gen *g, LLVMTypeRef ret, const void *fn,
+                             LLVMValueRef *args, LLVMTypeRef *types, int n)
+{
+    LLVMTypeRef ft = LLVMFunctionType(ret, types, n, 0);
+    LLVMValueRef c = LLVMBuildCall2(g->B, ft, absp(g, fn), args, n, "");
+    return c;
+}
+
+/* store the dirty globals of @d to env */
+static void gsync_m(Gen *g, const T3Set *d, bool exit)
+{
+    bool skip = exit && g->mutant == 2;     /* mutant: one global lost */
+
+    for (int i = 0; i < T3_MAX_GLOBALS; i++) {
+        if (set_has(d, i) && set_has(&g->written, i)) {
+            if (skip) {
+                skip = false;
+                continue;
+            }
+            LLVMValueRef v = LLVMBuildLoad2(g->B, ty(g, t3_globals[i].type),
+                                            g->gval[i], "");
+            store(g, v, envp(g, t3_globals[i].ofs));
+        }
+    }
+}
+
+static void gsync(Gen *g, const T3Set *d)
+{
+    gsync_m(g, d, false);
+}
+
+static void reload(Gen *g)
+{
+    for (int i = 0; i < T3_MAX_GLOBALS; i++) {
+        if (set_has(&g->used, i)) {
+            LLVMTypeRef t = ty(g, t3_globals[i].type);
+            LLVMBuildStore(g->B, load(g, t, envp(g, t3_globals[i].ofs)),
+                           g->gval[i]);
+        }
+    }
+}
+
+static void store_pc_env(Gen *g, uint64_t pc)
+{
+    LLVMTypeRef t = t3_target.pc_size == 4 ? g->i32 : g->i64;
+    store(g, cint(t, pc), envp(g, t3_target.pc_ofs));
+}
+
+static void store_t3_pc(Gen *g, uint64_t pc)
+{
+    store(g, cint(g->i64, pc),
+          envp(g, offsetof(CPUState, t3_pc) - sizeof(CPUState)));
+}
+
+static void ret_epilogue(Gen *g)
+{
+    LLVMBuildRet(g->B, absp(g, tcg_code_gen_epilogue));
+}
+
+/* POMPPC_T3_STATS: region exits by kind */
+uint64_t t3_exit_stats[T3X_N];
+static void stat_exit(Gen *g, int k)
+{
+    if (getenv("POMPPC_T3_STATS")) {
+        LLVMValueRef p = absp(g, &t3_exit_stats[k]);
+        LLVMValueRef v = LLVMBuildLoad2(g->B, g->i64, p, "");
+        LLVMBuildStore(g->B, LLVMBuildAdd(g->B, v, cint(g->i64, 1), ""), p);
+    }
+}
+
+static LLVMValueRef call_lookup(Gen *g)
+{
+    LLVMValueRef a = g->env;
+    LLVMTypeRef t = g->ptr;
+    return call_abs(g, g->ptr, (const void *)helper_lookup_tb_ptr, &a, &t, 1);
+}
+
+/* ---- segmentation and dataflow */
+
+static int new_seg(Gen *g, int blk, int s)
+{
+    Seg *x;
+
+    if (g->nseg == g->segcap) {
+        g->segcap = g->segcap ? g->segcap * 2 : 64;
+        g->seg = g_renew(Seg, g->seg, g->segcap);
+    }
+    x = &g->seg[g->nseg];
+    memset(x, 0, sizeof(*x));
+    x->blk = blk;
+    x->s = x->e = s;
+    x->kind = SX_FALL;
+    x->label = -1;
+    return g->nseg++;
+}
+
+static int member_of(T3Region *r, uint64_t pc)
+{
+    for (int i = 0; i < r->nb; i++) {
+        if (r->b[i]->pc == pc) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static bool is_lookup_call(T3Block *b, T3Op *o)
+{
+    const TCGHelperInfo *info;
+
+    if (o->opc != INDEX_op_call) {
+        return false;
+    }
+    info = (const void *)(uintptr_t)b->args[o->a + o->nargs - 1].v;
+    return !strcmp(info->name, "lookup_tb_ptr");
+}
+
+static unsigned call_flags(T3Block *b, T3Op *o)
+{
+    const TCGHelperInfo *info = (const void *)(uintptr_t)b->args[o->a + o->nargs - 1].v;
+    return info->flags;
+}
+
+static bool nip_write(T3Block *b, T3Op *o, bool *known, uint64_t *val)
+{
+    const TCGOpDef *def = &tcg_op_defs[o->opc];
+    int nb_o = o->opc == INDEX_op_call ? o->p2 : def->nb_oargs;
+
+    for (int i = 0; i < nb_o; i++) {
+        T3Arg *d = &b->args[o->a + i];
+        if (d->kind == T3A_GLOBAL && d->v == t3_target.pc_ofs) {
+            if (o->opc == INDEX_op_mov && b->args[o->a + 1].kind == T3A_CONST) {
+                *known = true;
+                *val = b->args[o->a + 1].v;
+                if (t3_target.pc_size == 4) {
+                    *val = (uint32_t)*val;
+                }
+            } else {
+                *known = false;
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+static void segment(Gen *g)
+{
+    T3Region *r = g->r;
+
+    g->entry = g_new0(int, r->nb);
+    g->labseg = g_new0(int *, r->nb);
+    for (int k = 0; k < r->nb; k++) {
+        T3Block *b = r->b[k];
+        int cur = new_seg(g, k, 0);
+        bool known = false;
+        uint64_t nip = 0;
+
+        g->entry[k] = cur;
+        g->labseg[k] = g_new(int, b->nlabels + 1);
+        for (int i = 0; i <= b->nlabels; i++) {
+            g->labseg[k][i] = -1;
+        }
+        for (int i = 0; i < b->nops; i++) {
+            T3Op *o = &b->ops[i];
+            Seg *s;
+
+            if (o->opc == INDEX_op_set_label) {
+                if (g->seg[cur].s != i) {
+                    g->seg[cur].e = i;
+                    cur = new_seg(g, k, i);
+                }
+                g->labseg[k][b->args[o->a].idx] = cur;
+                known = false;
+            }
+            nip_write(b, o, &known, &nip);
+            s = &g->seg[cur];
+            s->e = i + 1;
+            switch (o->opc) {
+            case INDEX_op_br:
+                s->kind = SX_BR;
+                s->label = b->args[o->a].idx;
+                break;
+            case INDEX_op_brcond:
+                s->kind = SX_BRCOND;
+                s->label = b->args[o->a + 3].idx;
+                break;
+            case INDEX_op_exit_tb: {
+                uintptr_t v = b->args[o->a].v;
+                s->kind = v == 0 ? SX_MAIN :
+                          (v & TB_EXIT_MASK) == TB_EXIT_REQUESTED ? SX_REQ :
+                          SX_CHAIN;
+                s->nip_known = known;
+                s->nip = nip;
+                break;
+            }
+            case INDEX_op_goto_ptr:
+                s->kind = SX_GOTOPTR;
+                break;
+            case INDEX_op_call:
+                if (is_lookup_call(b, o) && i + 1 < b->nops &&
+                    b->ops[i + 1].opc == INDEX_op_goto_ptr) {
+                    s->kind = SX_LOOKUP;
+                    s->nip_known = known;
+                    s->nip = nip;
+                    s->e = i + 2;
+                    i++;
+                } else if (call_flags(b, o) & TCG_CALL_NO_RETURN) {
+                    s->kind = SX_NORET;
+                } else {
+                    continue;
+                }
+                break;
+            default:
+                continue;
+            }
+            /* the segment ends here; what follows starts a new one */
+            if (i + 1 < b->nops) {
+                cur = new_seg(g, k, i + 1);
+            }
+        }
+    }
+}
+
+/* internal destinations of an exit segment: (block, cross-page) pairs */
+static int exit_targets(Gen *g, Seg *s, int *dst)
+{
+    T3Region *r = g->r;
+    int n = 0, j;
+
+    if (s->kind != SX_CHAIN && s->kind != SX_LOOKUP) {
+        return 0;
+    }
+    if (s->nip_known) {
+        j = member_of(r, s->nip);
+        if (j >= 0) {
+            dst[n++] = j;
+        }
+        return n;
+    }
+    for (j = 0; j < r->nb; j++) {
+        if (r->ret_target[j]) {
+            dst[n++] = j;
+        }
+    }
+    return n;
+}
+
+static void link_succ(Gen *g)
+{
+    for (int i = 0; i < g->nseg; i++) {
+        Seg *s = &g->seg[i];
+        int dst[T3_MAX_BLOCKS], n;
+
+        switch (s->kind) {
+        case SX_FALL:
+            if (i + 1 < g->nseg && g->seg[i + 1].blk == s->blk) {
+                s->succ[s->nsucc++] = i + 1;
+            }
+            break;
+        case SX_BRCOND:
+            if (i + 1 < g->nseg && g->seg[i + 1].blk == s->blk) {
+                s->succ[s->nsucc++] = i + 1;
+            }
+            /* fall through */
+        case SX_BR: {
+            int t = s->label >= 0 ? g->labseg[s->blk][s->label] : -1;
+            if (t < 0) {
+                g->err = "étiquette absente";
+                return;
+            }
+            s->succ[s->nsucc++] = t;
+            break;
+        }
+        default:
+            n = exit_targets(g, s, dst);
+            for (int k = 0; k < n && s->nsucc < T3_MAX_SUCC; k++) {
+                s->succ[s->nsucc++] = g->entry[dst[k]];
+            }
+            break;
+        }
+    }
+}
+
+/* the effect of op @o on the dirty set */
+static void transfer_op(Gen *g, T3Block *b, T3Op *o, T3Set *d)
+{
+    const TCGOpDef *def = &tcg_op_defs[o->opc];
+
+    if (o->opc == INDEX_op_call) {
+        unsigned fl = call_flags(b, o);
+        int no = o->p2;
+
+        if (is_lookup_call(b, o)) {
+            return;             /* an exit: handled by its segment */
+        }
+        if (!(fl & TCG_CALL_NO_READ_GLOBALS)) {
+            set_clear(d);       /* synced */
+        }
+        for (int i = 0; i < no; i++) {
+            T3Arg *a = &b->args[o->a + i];
+            if (a->kind == T3A_GLOBAL) {
+                set_add(d, a->idx);
+            }
+        }
+        return;
+    }
+    for (int i = 0; i < def->nb_oargs; i++) {
+        T3Arg *a = &b->args[o->a + i];
+        if (a->kind == T3A_GLOBAL) {
+            set_add(d, a->idx);
+        }
+    }
+}
+
+static void dataflow(Gen *g)
+{
+    bool changed = true;
+    int iter = 0;
+
+    while (changed && iter++ < 1000) {
+        changed = false;
+        for (int i = 0; i < g->nseg; i++) {
+            Seg *s = &g->seg[i];
+            T3Block *b = g->r->b[s->blk];
+            T3Set d = s->in;
+
+            for (int k = s->s; k < s->e; k++) {
+                transfer_op(g, b, &b->ops[k], &d);
+            }
+            for (int k = 0; k < s->nsucc; k++) {
+                changed |= set_union(&g->seg[s->succ[k]].in, &d);
+            }
+        }
+    }
+}
+
+/* conditional branch, @t very likely */
+static void likely_br(Gen *g, LLVMValueRef c, LLVMBasicBlockRef t,
+                      LLVMBasicBlockRef f)
+{
+    LLVMValueRef br = LLVMBuildCondBr(g->B, c, t, f);
+    const char *n = "branch_weights";
+    LLVMMetadataRef md[3] = {
+        LLVMMDStringInContext2(g->C, n, strlen(n)),
+        LLVMValueAsMetadata(cint(g->i32, 4000)),
+        LLVMValueAsMetadata(cint(g->i32, 1)),
+    };
+    LLVMSetMetadata(br, LLVMGetMDKindIDInContext(g->C, "prof", 4),
+                    LLVMMetadataAsValue(g->C, LLVMMDNodeInContext2(g->C, md, 3)));
+}
+
+/* ---- the edge into block j: page check, then head check on back edges */
+
+static LLVMBasicBlockRef bb_new(Gen *g, const char *name)
+{
+    return LLVMAppendBasicBlockInContext(g->C, g->F, name);
+}
+
+static void exit_to_main_at(Gen *g, const T3Set *d, uint64_t pc, int kind)
+{
+    stat_exit(g, kind);
+    gsync(g, d);
+    store_pc_env(g, pc);
+    ret_epilogue(g);
+}
+
+static LLVMBasicBlockRef head_check(Gen *g, int j)
+{
+    LLVMBasicBlockRef save = LLVMGetInsertBlock(g->B);
+    LLVMBasicBlockRef c, x;
+    LLVMValueRef v, dead, cond;
+
+    if (g->chk[j]) {
+        return g->chk[j];
+    }
+    c = g->chk[j] = bb_new(g, "chk");
+    x = bb_new(g, "chkx");
+    LLVMPositionBuilderAtEnd(g->B, c);
+    v = LLVMBuildLoad2(g->B, g->i32,
+                       envp(g, offsetof(CPUState, neg.icount_decr.u32) -
+                               sizeof(CPUState)), "");
+    LLVMSetVolatile(v, 1);
+    dead = LLVMBuildLoad2(g->B, g->i32, absp(g, &g->r->dead), "");
+    LLVMSetVolatile(dead, 1);
+    cond = LLVMBuildOr(g->B,
+                       LLVMBuildICmp(g->B, LLVMIntSLT, v, cint(g->i32, 0), ""),
+                       LLVMBuildICmp(g->B, LLVMIntNE, dead, cint(g->i32, 0), ""),
+                       "");
+    if (g->log) {
+        /* x-tier2-verify copy: at most 16 back edges per run */
+        LLVMValueRef n = LLVMBuildLoad2(g->B, g->i32, g->budget, "");
+        n = LLVMBuildSub(g->B, n, cint(g->i32, 1), "");
+        LLVMBuildStore(g->B, n, g->budget);
+        cond = LLVMBuildOr(g->B, cond,
+                           LLVMBuildICmp(g->B, LLVMIntSLT, n, cint(g->i32, 0), ""),
+                           "");
+    }
+    likely_br(g, LLVMBuildNot(g->B, cond, ""), g->seg[g->entry[j]].bb, x);
+    LLVMPositionBuilderAtEnd(g->B, x);
+    exit_to_main_at(g, &g->seg[g->entry[j]].in, g->r->b[j]->pc, T3X_CHK);
+    LLVMPositionBuilderAtEnd(g->B, save);
+    return c;
+}
+
+static LLVMBasicBlockRef page_check(Gen *g, int j, bool back)
+{
+    LLVMBasicBlockRef save = LLVMGetInsertBlock(g->B);
+    LLVMBasicBlockRef *slot = back ? &g->pgc[j] : &g->pgb[j];
+    LLVMBasicBlockRef c, x, next;
+    T3Region *r = g->r;
+    uint64_t page = r->page[j];
+    int fi = mmuidx_to_fast_index(r->code_mmu_idx);
+    intptr_t fast = offsetof(CPUNegativeOffsetState, tlb.f[fi]) -
+                    sizeof(CPUNegativeOffsetState);
+    LLVMValueRef mask, table, idx, ent, cmp, add, ok;
+
+    if (*slot) {
+        return *slot;
+    }
+    next = back ? head_check(g, j) : g->seg[g->entry[j]].bb;
+    c = *slot = bb_new(g, "pg");
+    x = bb_new(g, "pgx");
+    LLVMPositionBuilderAtEnd(g->B, c);
+    mask = load(g, g->i64, envp(g, fast + offsetof(CPUTLBDescFast, mask)));
+    table = load(g, g->i64, envp(g, fast + offsetof(CPUTLBDescFast, table)));
+    idx = LLVMBuildAnd(g->B, cint(g->i64, page >> (TARGET_PAGE_BITS -
+                                                  CPU_TLB_ENTRY_BITS)),
+                       mask, "");
+    ent = LLVMBuildAdd(g->B, table, idx, "");
+    cmp = load(g, g->i64, LLVMBuildIntToPtr(g->B,
+              LLVMBuildAdd(g->B, ent, cint(g->i64, offsetof(CPUTLBEntry, addr_code)), ""),
+              g->ptr, ""));
+    add = load(g, g->i64, LLVMBuildIntToPtr(g->B,
+              LLVMBuildAdd(g->B, ent, cint(g->i64, offsetof(CPUTLBEntry, addend)), ""),
+              g->ptr, ""));
+    ok = LLVMBuildAnd(g->B,
+                      LLVMBuildICmp(g->B, LLVMIntEQ, cmp, cint(g->i64, page), ""),
+                      LLVMBuildICmp(g->B, LLVMIntEQ, add, cint(g->i64, r->addend[j]), ""),
+                      "");
+    likely_br(g, ok, next, x);
+    LLVMPositionBuilderAtEnd(g->B, x);
+    exit_to_main_at(g, &g->seg[g->entry[j]].in, r->b[j]->pc, T3X_PAGE);
+    LLVMPositionBuilderAtEnd(g->B, save);
+    return c;
+}
+
+static LLVMBasicBlockRef edge_to(Gen *g, int from, int j)
+{
+    T3Region *r = g->r;
+    bool back = j <= from;
+
+    if (r->page[j] != r->page[from]) {
+        return page_check(g, j, back);
+    }
+    return back ? head_check(g, j) : g->seg[g->entry[j]].bb;
+}
+
+/* ---- guest accesses */
+
+static const void *ld_helper(MemOp mop)
+{
+    switch (mop & MO_SIZE) {
+    case MO_8:  return (const void *)helper_ldub_mmu;
+    case MO_16: return (const void *)helper_lduw_mmu;
+    case MO_32: return (const void *)helper_ldul_mmu;
+    default:    return (const void *)helper_ldq_mmu;
+    }
+}
+
+static const void *st_helper(MemOp mop)
+{
+    switch (mop & MO_SIZE) {
+    case MO_8:  return (const void *)helper_stb_mmu;
+    case MO_16: return (const void *)helper_stw_mmu;
+    case MO_32: return (const void *)helper_stl_mmu;
+    default:    return (const void *)helper_stq_mmu;
+    }
+}
+
+static LLVMTypeRef size_ty(Gen *g, MemOp mop)
+{
+    switch (mop & MO_SIZE) {
+    case MO_8:  return g->i8;
+    case MO_16: return g->i16;
+    case MO_32: return g->i32;
+    default:    return g->i64;
+    }
+}
+
+static void gen_qemu_ldst(Gen *g, T3Block *b, T3Op *o, const T3Set *d, bool is_ld)
+{
+    T3Arg *val = &b->args[o->a], *addr = &b->args[o->a + 1];
+    MemOpIdx oi = b->args[o->a + 2].v;
+    MemOp mop = get_memop(oi);
+    unsigned s_bits = mop & MO_SIZE;
+    unsigned s_mask = (1u << s_bits) - 1, a_mask = (1u << o->align) - 1;
+    int fi = mmuidx_to_fast_index(get_mmuidx(oi));
+    intptr_t fast = offsetof(CPUNegativeOffsetState, tlb.f[fi]) -
+                    sizeof(CPUNegativeOffsetState);
+    LLVMTypeRef T = ty(g, o->p1), ST = size_ty(g, mop);
+    bool a32 = g->r->addr_type == TCG_TYPE_I32;
+    LLVMValueRef av = get(g, addr), a64, mask, table, idx, ent, cmp, c, hit;
+    LLVMValueRef v = NULL, sv = NULL;
+    LLVMBasicBlockRef fastbb = bb_new(g, "f"), slowbb = bb_new(g, "s"),
+                      join = bb_new(g, "j");
+    int cmp_ofs = is_ld ? offsetof(CPUTLBEntry, addr_read)
+                        : offsetof(CPUTLBEntry, addr_write);
+
+    a64 = a32 ? LLVMBuildZExt(g->B, av, g->i64, "") : av;
+    if (!is_ld) {
+        sv = get(g, val);
+    }
+    mask = load(g, g->i64, envp(g, fast + offsetof(CPUTLBDescFast, mask)));
+    table = load(g, g->i64, envp(g, fast + offsetof(CPUTLBDescFast, table)));
+    idx = LLVMBuildAnd(g->B,
+                       LLVMBuildLShr(g->B, a64, cint(g->i64, TARGET_PAGE_BITS -
+                                                         CPU_TLB_ENTRY_BITS), ""),
+                       mask, "");
+    ent = LLVMBuildAdd(g->B, table, idx, "");
+    if (a32) {
+        uint32_t tm = (uint32_t)(TARGET_PAGE_MASK | a_mask);
+        c = av;
+        if (a_mask < s_mask) {
+            c = LLVMBuildAdd(g->B, c, cint(g->i32, s_mask - a_mask), "");
+        }
+        c = LLVMBuildAnd(g->B, c, cint(g->i32, tm), "");
+        cmp = load(g, g->i32, LLVMBuildIntToPtr(g->B,
+                  LLVMBuildAdd(g->B, ent, cint(g->i64, cmp_ofs + (HOST_BIG_ENDIAN ? 4 : 0)), ""),
+                  g->ptr, ""));
+    } else {
+        uint64_t tm = (uint64_t)(TARGET_PAGE_MASK | a_mask);
+        c = av;
+        if (a_mask < s_mask) {
+            c = LLVMBuildAdd(g->B, c, cint(g->i64, s_mask - a_mask), "");
+        }
+        c = LLVMBuildAnd(g->B, c, cint(g->i64, tm), "");
+        cmp = load(g, g->i64, LLVMBuildIntToPtr(g->B,
+                  LLVMBuildAdd(g->B, ent, cint(g->i64, cmp_ofs), ""), g->ptr, ""));
+    }
+    hit = LLVMBuildICmp(g->B, LLVMIntEQ, cmp, c, "");
+    likely_br(g, hit, fastbb, slowbb);
+
+    /* fast path */
+    LLVMPositionBuilderAtEnd(g->B, fastbb);
+    {
+        LLVMValueRef addend = load(g, g->i64, LLVMBuildIntToPtr(g->B,
+                LLVMBuildAdd(g->B, ent, cint(g->i64, offsetof(CPUTLBEntry, addend)), ""),
+                g->ptr, ""));
+        LLVMValueRef host = LLVMBuildIntToPtr(g->B,
+                                              LLVMBuildAdd(g->B, a64, addend, ""),
+                                              g->ptr, "");
+        if (is_ld) {
+            /*
+             * volatile: every guest access is made, in program order, as
+             * TCG makes them (another vCPU or a device may see each one)
+             */
+            v = load(g, ST, host);
+            LLVMSetVolatile(v, 1);
+            if ((mop & MO_BSWAP) && s_bits > MO_8) {
+                v = intrin(g, "llvm.bswap", ST, &v, 1);
+            }
+            if (ST != T) {
+                v = (mop & MO_SIGN) ? LLVMBuildSExt(g->B, v, T, "")
+                                    : LLVMBuildZExt(g->B, v, T, "");
+            }
+            set(g, val, v);
+        } else {
+            LLVMValueRef x = ST != T ? LLVMBuildTrunc(g->B, sv, ST, "") : sv;
+            if ((mop & MO_BSWAP) && s_bits > MO_8) {
+                x = intrin(g, "llvm.bswap", ST, &x, 1);
+            }
+            LLVMValueRef st = LLVMBuildStore(g->B, x, host);
+            LLVMSetVolatile(st, 1);
+            LLVMSetAlignment(st, 1);
+        }
+        LLVMBuildBr(g->B, join);
+    }
+
+    /* slow path: as TCG, env up to date but nip (cpu->t3_pc), and I/O allowed */
+    LLVMPositionBuilderAtEnd(g->B, slowbb);
+    gsync(g, d);
+    store_t3_pc(g, o->pc);
+    store(g, cint(g->i8, 1), envp(g, offsetof(CPUState, neg.can_do_io) -
+                                     sizeof(CPUState)));
+    if (is_ld) {
+        LLVMValueRef args[4] = { g->env, a64, cint(g->i32, oi), cint(g->i64, 1) };
+        LLVMTypeRef ts[4] = { g->ptr, g->i64, g->i32, g->i64 };
+        LLVMValueRef r = call_abs(g, g->i64, ld_helper(mop), args, ts, 4);
+        LLVMValueRef x = LLVMBuildTrunc(g->B, r, ST, "");
+        if (ST != T) {
+            x = (mop & MO_SIGN) ? LLVMBuildSExt(g->B, x, T, "")
+                                : LLVMBuildZExt(g->B, x, T, "");
+        }
+        set(g, val, x);
+    } else {
+        bool q = s_bits == MO_64;
+        LLVMValueRef x = q || o->p1 == TCG_TYPE_I32 ? sv
+                         : LLVMBuildTrunc(g->B, sv, g->i32, "");
+        LLVMValueRef args[5] = { g->env, a64, x, cint(g->i32, oi), cint(g->i64, 1) };
+        LLVMTypeRef ts[5] = { g->ptr, g->i64, q ? g->i64 : g->i32, g->i32, g->i64 };
+        call_abs(g, g->vt, st_helper(mop), args, ts, 5);
+    }
+    LLVMBuildBr(g->B, join);
+
+    LLVMPositionBuilderAtEnd(g->B, join);
+    if (g->log) {
+        LLVMValueRef lv = is_ld ? get(g, val) : sv;
+        LLVMValueRef args[5], r;
+        LLVMTypeRef ts[5] = { g->ptr, g->i64, g->i64, g->i32, g->i32 };
+
+        r = LLVMTypeOf(lv) == g->i64 ? lv : LLVMBuildZExt(g->B, lv, g->i64, "");
+        args[0] = g->env;
+        args[1] = a64;
+        args[2] = r;
+        args[3] = cint(g->i32, mop & MO_SIZE);
+        args[4] = cint(g->i32, !is_ld);
+        call_abs(g, g->vt, (const void *)helper_t2_log, args, ts, 5);
+    }
+}
+
+/* ---- ops */
+
+static LLVMValueRef cmpv(Gen *g, int cond, LLVMValueRef a, LLVMValueRef b)
+{
+    LLVMIntPredicate p;
+
+    switch (cond) {
+    case TCG_COND_ALWAYS: return cint(g->i1, 1);
+    case TCG_COND_NEVER:  return cint(g->i1, 0);
+    case TCG_COND_TSTEQ:
+        return LLVMBuildICmp(g->B, LLVMIntEQ, LLVMBuildAnd(g->B, a, b, ""),
+                             cint(LLVMTypeOf(a), 0), "");
+    case TCG_COND_TSTNE:
+        return LLVMBuildICmp(g->B, LLVMIntNE, LLVMBuildAnd(g->B, a, b, ""),
+                             cint(LLVMTypeOf(a), 0), "");
+    case TCG_COND_EQ:  p = LLVMIntEQ; break;
+    case TCG_COND_NE:  p = LLVMIntNE; break;
+    case TCG_COND_LT:  p = LLVMIntSLT; break;
+    case TCG_COND_GE:  p = LLVMIntSGE; break;
+    case TCG_COND_GT:  p = LLVMIntSGT; break;
+    case TCG_COND_LE:  p = LLVMIntSLE; break;
+    case TCG_COND_LTU: p = LLVMIntULT; break;
+    case TCG_COND_GEU: p = LLVMIntUGE; break;
+    case TCG_COND_GTU: p = LLVMIntUGT; break;
+    case TCG_COND_LEU: p = LLVMIntULE; break;
+    default:
+        g->err = "condition";
+        return cint(g->i1, 0);
+    }
+    return LLVMBuildICmp(g->B, p, a, b, "");
+}
+
+static uint64_t lomask(int len)
+{
+    return len >= 64 ? ~0ull : (1ull << len) - 1;
+}
+
+static void gen_carry(Gen *g, T3Block *b, T3Op *o, bool sub, bool cin, int c1,
+                      bool cout)
+{
+    T3Arg *A = &b->args[o->a];
+    LLVMTypeRef T = ty(g, o->p1);
+    int bits = o->p1 == TCG_TYPE_I32 ? 32 : 64;
+    LLVMTypeRef W = LLVMIntTypeInContext(g->C, bits + 1);
+    LLVMValueRef x = LLVMBuildZExt(g->B, get(g, &A[1]), W, "");
+    LLVMValueRef y = LLVMBuildZExt(g->B, get(g, &A[2]), W, "");
+    LLVMValueRef k, s;
+
+    if (cin) {
+        k = LLVMBuildZExt(g->B, LLVMBuildLoad2(g->B, g->i1, g->carry, ""), W, "");
+    } else {
+        k = cint(W, c1);
+    }
+    if (sub) {
+        s = LLVMBuildSub(g->B, LLVMBuildSub(g->B, x, y, ""), k, "");
+    } else {
+        s = LLVMBuildAdd(g->B, LLVMBuildAdd(g->B, x, y, ""), k, "");
+    }
+    set(g, &A[0], LLVMBuildTrunc(g->B, s, T, ""));
+    if (cout) {
+        LLVMValueRef c = LLVMBuildTrunc(g->B,
+                                        LLVMBuildLShr(g->B, s, cint(W, bits), ""),
+                                        g->i1, "");
+        LLVMBuildStore(g->B, c, g->carry);
+    }
+}
+
+static void gen_call(Gen *g, T3Block *b, T3Op *o, T3Set *d)
+{
+    int no = o->p2, ni = o->p1;
+    const void *fn = (const void *)(uintptr_t)b->args[o->a + no + ni].v;
+    const TCGHelperInfo *info = (const void *)(uintptr_t)b->args[o->a + no + ni + 1].v;
+    unsigned fl = info->flags;
+    LLVMValueRef args[16];
+    LLVMTypeRef ts[16], rt;
+    LLVMValueRef r;
+
+    if (ni > 16) {
+        g->err = "appel à trop d'arguments";
+        return;
+    }
+    switch (info->typemask & 7) {
+    case 0: case 1: rt = g->vt; break;
+    case 2: case 3: rt = g->i32; break;
+    case 4: case 5: case 6: rt = g->i64; break;
+    default:
+        g->err = "appel : type de retour";
+        return;
+    }
+    if (!(fl & TCG_CALL_NO_READ_GLOBALS)) {
+        gsync(g, d);
+        set_clear(d);
+        store_t3_pc(g, o->pc);
+    }
+    for (int i = 0; i < ni; i++) {
+        T3Arg *a = &b->args[o->a + no + i];
+        if (a->kind == T3A_ENV) {
+            args[i] = g->env;
+            ts[i] = g->ptr;
+        } else {
+            args[i] = get(g, a);
+            ts[i] = LLVMTypeOf(args[i]);
+        }
+    }
+    r = call_abs(g, rt, fn, args, ts, ni);
+    if (fl & TCG_CALL_NO_RETURN) {
+        LLVMBuildUnreachable(g->B);
+        return;
+    }
+    /*
+     * (TCG_CALL_NO_READ_GLOBALS implies TCG_CALL_NO_WRITE_GLOBALS.)  The
+     * reload first: the output may be a global (call sraw, r3, ...).
+     */
+    if (!(fl & (TCG_CALL_NO_WRITE_GLOBALS | TCG_CALL_NO_READ_GLOBALS))) {
+        reload(g);
+    }
+    if (no) {
+        set(g, &b->args[o->a], r);
+    }
+    for (int i = 0; i < no; i++) {
+        T3Arg *a = &b->args[o->a + i];
+        if (a->kind == T3A_GLOBAL) {
+            set_add(d, a->idx);
+        }
+    }
+}
+
+static LLVMValueRef host_ptr(Gen *g, T3Arg *base, intptr_t ofs)
+{
+    if (base->kind == T3A_ENV) {
+        return envp(g, ofs);
+    }
+    return LLVMBuildIntToPtr(g->B,
+                             LLVMBuildAdd(g->B, get(g, base), cint(g->i64, ofs), ""),
+                             g->ptr, "");
+}
+
+/* one op; false when it ended the LLVM block */
+static void gen_op(Gen *g, T3Block *b, T3Op *o, T3Set *d)
+{
+    T3Arg *A = &b->args[o->a];
+    LLVMBuilderRef B = g->B;
+    LLVMTypeRef T = ty(g, o->p1);
+    int bits = o->p1 == TCG_TYPE_I32 ? 32 : 64;
+    LLVMValueRef x, y, z;
+
+#define IN(n) get(g, &A[n])
+#define OUT(n, v) set(g, &A[n], (v))
+    switch (o->opc) {
+    case INDEX_op_mov:
+        OUT(0, IN(1));
+        break;
+    case INDEX_op_add: OUT(0, LLVMBuildAdd(B, IN(1), IN(2), "")); break;
+    case INDEX_op_sub: OUT(0, LLVMBuildSub(B, IN(1), IN(2), "")); break;
+    case INDEX_op_mul: OUT(0, LLVMBuildMul(B, IN(1), IN(2), "")); break;
+    case INDEX_op_and: OUT(0, LLVMBuildAnd(B, IN(1), IN(2), "")); break;
+    case INDEX_op_or:  OUT(0, LLVMBuildOr(B, IN(1), IN(2), "")); break;
+    case INDEX_op_xor: OUT(0, LLVMBuildXor(B, IN(1), IN(2), "")); break;
+    case INDEX_op_andc: OUT(0, LLVMBuildAnd(B, IN(1), LLVMBuildNot(B, IN(2), ""), "")); break;
+    case INDEX_op_orc:  OUT(0, LLVMBuildOr(B, IN(1), LLVMBuildNot(B, IN(2), ""), "")); break;
+    case INDEX_op_eqv:  OUT(0, LLVMBuildNot(B, LLVMBuildXor(B, IN(1), IN(2), ""), "")); break;
+    case INDEX_op_nand: OUT(0, LLVMBuildNot(B, LLVMBuildAnd(B, IN(1), IN(2), ""), "")); break;
+    case INDEX_op_nor:  OUT(0, LLVMBuildNot(B, LLVMBuildOr(B, IN(1), IN(2), ""), "")); break;
+    case INDEX_op_not:  OUT(0, LLVMBuildNot(B, IN(1), "")); break;
+    case INDEX_op_neg:  OUT(0, LLVMBuildNeg(B, IN(1), "")); break;
+    case INDEX_op_shl:
+        OUT(0, LLVMBuildShl(B, IN(1), LLVMBuildAnd(B, IN(2), cint(T, bits - 1), ""), ""));
+        break;
+    case INDEX_op_shr:
+        OUT(0, LLVMBuildLShr(B, IN(1), LLVMBuildAnd(B, IN(2), cint(T, bits - 1), ""), ""));
+        break;
+    case INDEX_op_sar:
+        OUT(0, LLVMBuildAShr(B, IN(1), LLVMBuildAnd(B, IN(2), cint(T, bits - 1), ""), ""));
+        break;
+    case INDEX_op_rotl: {
+        LLVMValueRef a[3] = { IN(1), IN(1), IN(2) };
+        OUT(0, intrin(g, "llvm.fshl", T, a, 3));
+        break;
+    }
+    case INDEX_op_rotr: {
+        LLVMValueRef a[3] = { IN(1), IN(1), IN(2) };
+        OUT(0, intrin(g, "llvm.fshr", T, a, 3));
+        break;
+    }
+    case INDEX_op_extract2: {
+        LLVMValueRef a[3] = { IN(2), IN(1), cint(T, A[3].v) };
+        OUT(0, intrin(g, "llvm.fshr", T, a, 3));
+        break;
+    }
+    case INDEX_op_bswap16:
+    case INDEX_op_bswap32: {
+        LLVMTypeRef N = o->opc == INDEX_op_bswap16 ? g->i16 : g->i32;
+        int fl = A[2].v;
+        x = LLVMBuildTruncOrBitCast(B, IN(1), N, "");
+        x = intrin(g, "llvm.bswap", N, &x, 1);
+        if (N != T) {
+            x = (fl & TCG_BSWAP_OS) ? LLVMBuildSExt(B, x, T, "")
+                                    : LLVMBuildZExt(B, x, T, "");
+        }
+        OUT(0, x);
+        break;
+    }
+    case INDEX_op_bswap64:
+        x = IN(1);
+        OUT(0, intrin(g, "llvm.bswap", T, &x, 1));
+        break;
+    case INDEX_op_clz:
+    case INDEX_op_ctz: {
+        LLVMValueRef a[2] = { IN(1), cint(g->i1, 1) };
+        y = intrin(g, o->opc == INDEX_op_clz ? "llvm.ctlz" : "llvm.cttz", T, a, 2);
+        z = LLVMBuildICmp(B, LLVMIntEQ, a[0], cint(T, 0), "");
+        OUT(0, LLVMBuildSelect(B, z, IN(2), y, ""));
+        break;
+    }
+    case INDEX_op_ctpop:
+        x = IN(1);
+        OUT(0, intrin(g, "llvm.ctpop", T, &x, 1));
+        break;
+    case INDEX_op_deposit: {
+        int pos = A[3].v, len = A[4].v;
+        uint64_t m = lomask(len) << pos;
+        if (bits == 32) {
+            m = (uint32_t)m;
+        }
+        x = LLVMBuildAnd(B, IN(1), cint(T, ~m), "");
+        y = LLVMBuildAnd(B, LLVMBuildShl(B, IN(2), cint(T, pos), ""), cint(T, m), "");
+        OUT(0, LLVMBuildOr(B, x, y, ""));
+        break;
+    }
+    case INDEX_op_extract: {
+        int pos = A[2].v, len = A[3].v;
+        x = LLVMBuildLShr(B, IN(1), cint(T, pos), "");
+        if (pos + len < bits) {
+            x = LLVMBuildAnd(B, x, cint(T, lomask(len)), "");
+        }
+        OUT(0, x);
+        break;
+    }
+    case INDEX_op_sextract: {
+        int pos = A[2].v, len = A[3].v;
+        x = LLVMBuildShl(B, IN(1), cint(T, bits - pos - len), "");
+        OUT(0, LLVMBuildAShr(B, x, cint(T, bits - len), ""));
+        break;
+    }
+    case INDEX_op_divs: OUT(0, LLVMBuildSDiv(B, IN(1), IN(2), "")); break;
+    case INDEX_op_divu: OUT(0, LLVMBuildUDiv(B, IN(1), IN(2), "")); break;
+    case INDEX_op_rems: OUT(0, LLVMBuildSRem(B, IN(1), IN(2), "")); break;
+    case INDEX_op_remu: OUT(0, LLVMBuildURem(B, IN(1), IN(2), "")); break;
+    case INDEX_op_mulu2:
+    case INDEX_op_muls2:
+    case INDEX_op_muluh:
+    case INDEX_op_mulsh: {
+        LLVMTypeRef W = LLVMIntTypeInContext(g->C, bits * 2);
+        bool sg = o->opc == INDEX_op_muls2 || o->opc == INDEX_op_mulsh;
+        bool two = o->opc == INDEX_op_mulu2 || o->opc == INDEX_op_muls2;
+        int ia = two ? 2 : 1;
+        LLVMValueRef p;
+        x = sg ? LLVMBuildSExt(B, IN(ia), W, "") : LLVMBuildZExt(B, IN(ia), W, "");
+        y = sg ? LLVMBuildSExt(B, IN(ia + 1), W, "") : LLVMBuildZExt(B, IN(ia + 1), W, "");
+        p = LLVMBuildMul(B, x, y, "");
+        z = LLVMBuildTrunc(B, LLVMBuildLShr(B, p, cint(W, bits), ""), T, "");
+        if (two) {
+            OUT(0, LLVMBuildTrunc(B, p, T, ""));
+            OUT(1, z);
+        } else {
+            OUT(0, z);
+        }
+        break;
+    }
+    case INDEX_op_divu2:
+    case INDEX_op_divs2: {
+        /* (q, r) = (ah:al) / b, the quotient fits (the frontend checks) */
+        LLVMTypeRef W = LLVMIntTypeInContext(g->C, bits * 2);
+        bool sg = o->opc == INDEX_op_divs2;
+        LLVMValueRef n, dv;
+        n = LLVMBuildOr(B, LLVMBuildShl(B, sg ? LLVMBuildSExt(B, IN(3), W, "")
+                                              : LLVMBuildZExt(B, IN(3), W, ""),
+                                        cint(W, bits), ""),
+                        LLVMBuildZExt(B, IN(2), W, ""), "");
+        dv = sg ? LLVMBuildSExt(B, IN(4), W, "") : LLVMBuildZExt(B, IN(4), W, "");
+        OUT(0, LLVMBuildTrunc(B, sg ? LLVMBuildSDiv(B, n, dv, "")
+                                    : LLVMBuildUDiv(B, n, dv, ""), T, ""));
+        OUT(1, LLVMBuildTrunc(B, sg ? LLVMBuildSRem(B, n, dv, "")
+                                    : LLVMBuildURem(B, n, dv, ""), T, ""));
+        break;
+    }
+    case INDEX_op_setcond:
+        OUT(0, LLVMBuildZExt(B, cmpv(g, A[3].v, IN(1), IN(2)), T, ""));
+        break;
+    case INDEX_op_negsetcond:
+        OUT(0, LLVMBuildSExt(B, cmpv(g, A[3].v, IN(1), IN(2)), T, ""));
+        break;
+    case INDEX_op_movcond:
+        OUT(0, LLVMBuildSelect(B, cmpv(g, A[5].v, IN(1), IN(2)), IN(3), IN(4), ""));
+        break;
+    case INDEX_op_ext_i32_i64:
+        OUT(0, LLVMBuildSExt(B, IN(1), g->i64, ""));
+        break;
+    case INDEX_op_extu_i32_i64:
+        OUT(0, LLVMBuildZExt(B, IN(1), g->i64, ""));
+        break;
+    case INDEX_op_extrl_i64_i32:
+        OUT(0, LLVMBuildTrunc(B, IN(1), g->i32, ""));
+        break;
+    case INDEX_op_extrh_i64_i32:
+        OUT(0, LLVMBuildTrunc(B, LLVMBuildLShr(B, IN(1), cint(g->i64, 32), ""),
+                              g->i32, ""));
+        break;
+    case INDEX_op_addco:  gen_carry(g, b, o, false, false, 0, true); break;
+    case INDEX_op_addc1o: gen_carry(g, b, o, false, false, 1, true); break;
+    case INDEX_op_addci:  gen_carry(g, b, o, false, true, 0, false); break;
+    case INDEX_op_addcio: gen_carry(g, b, o, false, true, 0, true); break;
+    case INDEX_op_subbo:  gen_carry(g, b, o, true, false, 0, true); break;
+    case INDEX_op_subb1o: gen_carry(g, b, o, true, false, 1, true); break;
+    case INDEX_op_subbi:  gen_carry(g, b, o, true, true, 0, false); break;
+    case INDEX_op_subbio: gen_carry(g, b, o, true, true, 0, true); break;
+    case INDEX_op_ld8u: case INDEX_op_ld8s: case INDEX_op_ld16u:
+    case INDEX_op_ld16s: case INDEX_op_ld32u: case INDEX_op_ld32s:
+    case INDEX_op_ld: {
+        LLVMTypeRef N;
+        bool sg = o->opc == INDEX_op_ld8s || o->opc == INDEX_op_ld16s ||
+                  o->opc == INDEX_op_ld32s;
+        if (o->headcheck) {
+            OUT(0, cint(T, 0));     /* only on the back edges (head_check) */
+            break;
+        }
+        switch (o->opc) {
+        case INDEX_op_ld8u: case INDEX_op_ld8s: N = g->i8; break;
+        case INDEX_op_ld16u: case INDEX_op_ld16s: N = g->i16; break;
+        case INDEX_op_ld32u: case INDEX_op_ld32s: N = g->i32; break;
+        default: N = T; break;
+        }
+        x = load(g, N, host_ptr(g, &A[1], A[2].v));
+        if (N != T) {
+            x = sg ? LLVMBuildSExt(B, x, T, "") : LLVMBuildZExt(B, x, T, "");
+        }
+        OUT(0, x);
+        break;
+    }
+    case INDEX_op_st8: case INDEX_op_st16: case INDEX_op_st32:
+    case INDEX_op_st: {
+        LLVMTypeRef N;
+        switch (o->opc) {
+        case INDEX_op_st8: N = g->i8; break;
+        case INDEX_op_st16: N = g->i16; break;
+        case INDEX_op_st32: N = g->i32; break;
+        default: N = T; break;
+        }
+        x = IN(0);
+        if (N != T) {
+            x = LLVMBuildTrunc(B, x, N, "");
+        }
+        store(g, x, host_ptr(g, &A[1], A[2].v));
+        break;
+    }
+    case INDEX_op_qemu_ld:
+        gen_qemu_ldst(g, b, o, d, true);
+        break;
+    case INDEX_op_qemu_st:
+        gen_qemu_ldst(g, b, o, d, false);
+        break;
+    case INDEX_op_mb:
+        LLVMBuildFence(B, (A[0].v & TCG_MO_ST_LD) ?
+                       LLVMAtomicOrderingSequentiallyConsistent :
+                       LLVMAtomicOrderingAcquireRelease, 0, "");
+        break;
+    case INDEX_op_call:
+        gen_call(g, b, o, d);
+        break;
+    case INDEX_op_goto_tb:
+    case INDEX_op_set_label:
+    case INDEX_op_insn_start:
+    case INDEX_op_discard:
+        break;
+    default:
+        g->err = tcg_op_defs[o->opc].name;
+        break;
+    }
+#undef IN
+#undef OUT
+    /* dirty set: outputs of non-call ops */
+    if (o->opc != INDEX_op_call) {
+        const TCGOpDef *def = &tcg_op_defs[o->opc];
+        for (int i = 0; i < def->nb_oargs; i++) {
+            if (A[i].kind == T3A_GLOBAL) {
+                set_add(d, A[i].idx);
+            }
+        }
+    }
+}
+
+/* the exit of segment @si, with dirty set @d */
+static void gen_exit(Gen *g, int si, T3Set *d)
+{
+    Seg *s = &g->seg[si];
+    T3Block *b = g->r->b[s->blk];
+    int dst[T3_MAX_BLOCKS], n;
+
+    switch (s->kind) {
+    case SX_FALL:
+        if (si + 1 < g->nseg && g->seg[si + 1].blk == s->blk) {
+            LLVMBuildBr(g->B, g->seg[si + 1].bb);
+        } else {
+            LLVMBuildUnreachable(g->B);
+        }
+        return;
+    case SX_BR:
+        LLVMBuildBr(g->B, g->seg[g->labseg[s->blk][s->label]].bb);
+        return;
+    case SX_BRCOND: {
+        T3Op *o = &b->ops[s->e - 1];
+        T3Arg *A = &b->args[o->a];
+        int cond = A[2].v;
+        LLVMValueRef c;
+        LLVMBasicBlockRef nx;
+
+        if (g->mutant == 1 && s->blk == 0) {
+            cond ^= 1;          /* mutant: the branches of the head reversed */
+        }
+        c = cmpv(g, cond, get(g, &A[0]), get(g, &A[1]));
+        if (si + 1 < g->nseg && g->seg[si + 1].blk == s->blk) {
+            nx = g->seg[si + 1].bb;
+        } else {
+            g->err = "brcond sans suite";
+            return;
+        }
+        LLVMBuildCondBr(g->B, c, g->seg[g->labseg[s->blk][s->label]].bb, nx);
+        return;
+    }
+    case SX_MAIN:
+        stat_exit(g, T3X_MAIN);
+        gsync_m(g, d, true);
+        ret_epilogue(g);
+        return;
+    case SX_REQ:
+        exit_to_main_at(g, d, b->pc, T3X_REQ);
+        return;
+    case SX_GOTOPTR: {
+        T3Op *o = &b->ops[s->e - 1];
+        LLVMValueRef p = get(g, &b->args[o->a]);
+        stat_exit(g, T3X_GOTOPTR);
+        gsync(g, d);
+        LLVMBuildRet(g->B, LLVMBuildIntToPtr(g->B, p, g->ptr, ""));
+        return;
+    }
+    case SX_NORET:
+        return;                 /* unreachable already there */
+    case SX_CHAIN:
+    case SX_LOOKUP:
+        break;
+    }
+    n = exit_targets(g, s, dst);
+    if (s->nip_known && n == 1) {
+        LLVMBuildBr(g->B, edge_to(g, s->blk, dst[0]));
+        return;
+    }
+    if (n > 0) {
+        /* predicted returns: compare nip with the return points */
+        T3Arg nipa = { .kind = T3A_GLOBAL };
+        LLVMValueRef nipv, sw;
+        LLVMBasicBlockRef dflt = bb_new(g, "ind");
+        int gi = -1;
+
+        for (int i = 0; i < T3_MAX_GLOBALS; i++) {
+            if (t3_globals[i].known && t3_globals[i].ofs == t3_target.pc_ofs) {
+                gi = i;
+            }
+        }
+        if (gi < 0 || !set_has(&g->used, gi)) {
+            g->err = "nip inconnu";
+            return;
+        }
+        nipa.idx = gi;
+        nipa.type = t3_globals[gi].type;
+        nipv = get(g, &nipa);
+        sw = LLVMBuildSwitch(g->B, nipv, dflt, n);
+        for (int k = 0; k < n; k++) {
+            LLVMAddCase(sw, cint(LLVMTypeOf(nipv), g->r->b[dst[k]]->pc),
+                        edge_to(g, s->blk, dst[k]));
+        }
+        LLVMPositionBuilderAtEnd(g->B, dflt);
+    }
+    /* leave: sync, lookup the next TB */
+    stat_exit(g, s->nip_known ? T3X_DIRECT : n ? T3X_RETMISS : T3X_INDIRECT);
+    gsync_m(g, d, true);
+    if (s->nip_known && (s->nip & TARGET_PAGE_MASK) == g->r->page[s->blk] &&
+        g->r->xcache && g->r->nxcache < T3_XCACHE && !g->mutant) {
+        /*
+         * a direct exit in the page of its block (where a TB would chain by
+         * goto_tb): the TB seen last time, if still valid, without lookup
+         */
+        void **slot = &g->r->xcache[g->r->nxcache++];
+        LLVMBasicBlockRef hit = bb_new(g, "xh"), chk = bb_new(g, "xc"),
+                          miss = bb_new(g, "xm");
+        LLVMValueRef tb = load(g, g->i64, absp(g, slot)), pc, cf, ok;
+
+        LLVMBuildCondBr(g->B, LLVMBuildICmp(g->B, LLVMIntNE, tb, cint(g->i64, 0), ""),
+                        chk, miss);
+        LLVMPositionBuilderAtEnd(g->B, chk);
+        pc = load(g, g->i64, LLVMBuildIntToPtr(g->B,
+                 LLVMBuildAdd(g->B, tb, cint(g->i64, offsetof(TranslationBlock, pc)), ""),
+                 g->ptr, ""));
+        cf = load(g, g->i32, LLVMBuildIntToPtr(g->B,
+                 LLVMBuildAdd(g->B, tb, cint(g->i64, offsetof(TranslationBlock, cflags)), ""),
+                 g->ptr, ""));
+        LLVMSetVolatile(cf, 1);
+        ok = LLVMBuildAnd(g->B,
+                          LLVMBuildICmp(g->B, LLVMIntEQ, pc, cint(g->i64, s->nip), ""),
+                          LLVMBuildICmp(g->B, LLVMIntEQ, cf, cint(g->i32, g->r->cflags), ""),
+                          "");
+        likely_br(g, ok, hit, miss);
+        LLVMPositionBuilderAtEnd(g->B, hit);
+        LLVMBuildRet(g->B, load(g, g->ptr, LLVMBuildIntToPtr(g->B,
+                 LLVMBuildAdd(g->B, tb, cint(g->i64, offsetof(TranslationBlock, tc.ptr)), ""),
+                 g->ptr, "")));
+        LLVMPositionBuilderAtEnd(g->B, miss);
+        {
+            LLVMValueRef args[2] = { g->env, absp(g, slot) };
+            LLVMTypeRef ts[2] = { g->ptr, g->ptr };
+            LLVMBuildRet(g->B, call_abs(g, g->ptr, (const void *)t3_chain, args, ts, 2));
+        }
+        return;
+    }
+    LLVMBuildRet(g->B, call_lookup(g));
+}
+
+static void gen_seg(Gen *g, int si)
+{
+    Seg *s = &g->seg[si];
+    T3Block *b = g->r->b[s->blk];
+    T3Set d = s->in;
+    int end = s->e;
+
+    LLVMPositionBuilderAtEnd(g->B, s->bb);
+    if (si == g->entry[s->blk]) {
+        if (g->log) {
+            LLVMValueRef args[5] = { g->env, cint(g->i64, b->pc), cint(g->i64, 0),
+                                     cint(g->i32, T2_MARK), cint(g->i32, 2) };
+            LLVMTypeRef ts[5] = { g->ptr, g->i64, g->i64, g->i32, g->i32 };
+            call_abs(g, g->vt, (const void *)helper_t2_log, args, ts, 5);
+        }
+        if (getenv("POMPPC_T3_STATS")) {
+            LLVMValueRef p = absp(g, &g->r->insns);
+            LLVMValueRef v = LLVMBuildLoad2(g->B, g->i64, p, "");
+            LLVMBuildStore(g->B, LLVMBuildAdd(g->B, v, cint(g->i64, b->icount), ""), p);
+        }
+    }
+    switch (s->kind) {
+    case SX_BR: case SX_BRCOND: case SX_MAIN: case SX_REQ: case SX_CHAIN:
+    case SX_GOTOPTR:
+        end = s->e - 1;         /* the last op is the exit */
+        break;
+    case SX_LOOKUP:
+        end = s->e - 2;         /* call lookup_tb_ptr; goto_ptr */
+        break;
+    default:
+        break;
+    }
+    for (int k = s->s; k < end && !g->err; k++) {
+        gen_op(g, b, &b->ops[k], &d);
+    }
+    if (s->kind == SX_NORET) {
+        return;                 /* gen_call put the unreachable */
+    }
+    if (!g->err) {
+        gen_exit(g, si, &d);
+    }
+}
+
+static void collect_used(Gen *g)
+{
+    T3Region *r = g->r;
+
+    for (int k = 0; k < r->nb; k++) {
+        T3Block *b = r->b[k];
+        for (int i = 0; i < b->nops; i++) {
+            T3Op *o = &b->ops[i];
+            int no = o->opc == INDEX_op_call ? o->p2 : tcg_op_defs[o->opc].nb_oargs;
+            for (int j = 0; j < o->nargs; j++) {
+                T3Arg *a = &b->args[o->a + j];
+                if (a->kind == T3A_GLOBAL) {
+                    set_add(&g->used, a->idx);
+                    if (j < no) {
+                        set_add(&g->written, a->idx);
+                    }
+                }
+            }
+        }
+    }
+    /* nip: always (exits store it, predicted returns read it) */
+    for (int i = 0; i < T3_MAX_GLOBALS; i++) {
+        if (t3_globals[i].known && t3_globals[i].ofs == t3_target.pc_ofs) {
+            set_add(&g->used, i);
+        }
+    }
+}
+
+static LLVMValueRef gen_function(Gen *g, const char *name)
+{
+    LLVMTypeRef ft = LLVMFunctionType(g->ptr, &g->ptr, 1, 0);
+    LLVMBasicBlockRef first;
+
+    g->F = LLVMAddFunction(g->M, name, ft);
+    g->env = LLVMGetParam(g->F, 0);
+    g->entry_bb = bb_new(g, "entry");
+    LLVMPositionBuilderAtEnd(g->BA, g->entry_bb);
+    g->temps = g_hash_table_new(NULL, NULL);
+    memset(g->gval, 0, sizeof(g->gval));
+    memset(g->chk, 0, sizeof(g->chk));
+    memset(g->pgb, 0, sizeof(g->pgb));
+    memset(g->pgc, 0, sizeof(g->pgc));
+    for (int i = 0; i < T3_MAX_GLOBALS; i++) {
+        if (set_has(&g->used, i)) {
+            g->gval[i] = LLVMBuildAlloca(g->BA, ty(g, t3_globals[i].type), "g");
+        }
+    }
+    g->carry = LLVMBuildAlloca(g->BA, g->i1, "carry");
+    g->budget = LLVMBuildAlloca(g->BA, g->i32, "budget");
+    for (int i = 0; i < g->nseg; i++) {
+        g->seg[i].bb = bb_new(g, "s");
+    }
+    /* the loads of the entry come after all the allocas (made lazily) */
+    first = bb_new(g, "load");
+    LLVMPositionBuilderAtEnd(g->B, first);
+    reload(g);
+    LLVMBuildStore(g->B, cint(g->i32, 16), g->budget);
+    LLVMBuildBr(g->B, g->seg[g->entry[0]].bb);
+    for (int i = 0; i < g->nseg && !g->err; i++) {
+        gen_seg(g, i);
+    }
+    /* the allocas block falls into the loads */
+    LLVMPositionBuilderAtEnd(g->BA, g->entry_bb);
+    LLVMBuildBr(g->BA, first);
+    g_hash_table_destroy(g->temps);
+    return g->F;
+}
+
+bool t3_compile(T3Region *r, bool with_log, char *why, size_t whylen)
+{
+    Gen gg = { 0 }, *g = &gg;
+    char name[2][32];
+    LLVMErrorRef e;
+    LLVMOrcThreadSafeContextRef tsc;
+    LLVMOrcThreadSafeModuleRef tsm;
+    LLVMOrcExecutorAddress addr;
+    LLVMPassBuilderOptionsRef po;
+    int64_t t0 = get_clock();
+    size_t code0;
+    bool ok = false;
+
+    qemu_mutex_lock(&t3_jit_lock);
+    if (!t3_jit_init(why, whylen)) {
+        goto out;
+    }
+    g->r = r;
+    if (getenv("POMPPC_T3_MUTANT") && (t3_nmod & 1)) {
+        g->mutant = atoi(getenv("POMPPC_T3_MUTANT"));
+    }
+    g->C = LLVMContextCreate();
+    snprintf(name[0], sizeof(name[0]), "t3r%u", t3_nmod);
+    snprintf(name[1], sizeof(name[1]), "t3l%u", t3_nmod);
+    t3_nmod++;
+    g->M = LLVMModuleCreateWithNameInContext(name[0], g->C);
+    g->B = LLVMCreateBuilderInContext(g->C);
+    g->BA = LLVMCreateBuilderInContext(g->C);
+    g->i1 = LLVMInt1TypeInContext(g->C);
+    g->i8 = LLVMInt8TypeInContext(g->C);
+    g->i16 = LLVMInt16TypeInContext(g->C);
+    g->i32 = LLVMInt32TypeInContext(g->C);
+    g->i64 = LLVMInt64TypeInContext(g->C);
+    g->ptr = LLVMPointerTypeInContext(g->C, 0);
+    g->vt = LLVMVoidTypeInContext(g->C);
+
+    collect_used(g);
+    segment(g);
+    link_succ(g);
+    if (g->err) {
+        snprintf(why, whylen, "%s", g->err);
+        goto fail;
+    }
+    dataflow(g);
+    for (int v = 0; v < (with_log ? 2 : 1); v++) {
+        g->log = v == 1;
+        gen_function(g, name[v]);
+        if (g->err) {
+            snprintf(why, whylen, "%s", g->err);
+            goto fail;
+        }
+    }
+    {
+        char *msg = NULL;
+        if (LLVMVerifyModule(g->M, LLVMReturnStatusAction, &msg)) {
+            if (getenv("POMPPC_T3_DUMP")) {
+                LLVMDumpModule(g->M);
+            }
+            snprintf(why, whylen, "IR invalide : %.120s", msg ? msg : "?");
+            LLVMDisposeMessage(msg);
+            goto fail;
+        }
+        LLVMDisposeMessage(msg);
+    }
+    if (getenv("POMPPC_T3_DUMP")) {
+        char fn[64];
+        snprintf(fn, sizeof(fn), "/tmp/t3-%u-pre.ll", t3_nmod - 1);
+        LLVMPrintModuleToFile(g->M, fn, NULL);
+    }
+    po = LLVMCreatePassBuilderOptions();
+    e = LLVMRunPasses(g->M, getenv("POMPPC_T3_PASSES") ? getenv("POMPPC_T3_PASSES")
+                                                       : "default<O2>", t3_tm, po);
+    LLVMDisposePassBuilderOptions(po);
+    if (e) {
+        char *m = LLVMGetErrorMessage(e);
+        snprintf(why, whylen, "passes : %s", m);
+        LLVMDisposeErrorMessage(m);
+        goto fail;
+    }
+    if (getenv("POMPPC_T3_DUMP")) {
+        char fn[64];
+        snprintf(fn, sizeof(fn), "/tmp/t3-%u.ll", t3_nmod - 1);
+        LLVMPrintModuleToFile(g->M, fn, NULL);
+    }
+    LLVMDisposeBuilder(g->B);
+    LLVMDisposeBuilder(g->BA);
+    g->B = g->BA = NULL;
+    tsc = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(g->C);
+    tsm = LLVMOrcCreateNewThreadSafeModule(g->M, tsc);
+    g->M = NULL;
+    g->C = NULL;
+#ifdef __linux__
+    code0 = t3_last_code;
+    t3_nsec = 0;
+#else
+    code0 = 0;
+#endif
+    e = LLVMOrcLLJITAddLLVMIRModule(t3_jit, LLVMOrcLLJITGetMainJITDylib(t3_jit), tsm);
+    LLVMOrcDisposeThreadSafeContext(tsc);
+    if (e) {
+        char *m = LLVMGetErrorMessage(e);
+        snprintf(why, whylen, "ajout : %s", m);
+        LLVMDisposeErrorMessage(m);
+        goto out;
+    }
+    for (int v = 0; v < (with_log ? 2 : 1); v++) {
+        e = LLVMOrcLLJITLookup(t3_jit, &addr, name[v]);
+        if (e) {
+            char *m = LLVMGetErrorMessage(e);
+            snprintf(why, whylen, "recherche : %s", m);
+            LLVMDisposeErrorMessage(m);
+            goto out;
+        }
+        if (v == 0) {
+            r->fn = (void *)(uintptr_t)addr;
+        } else {
+            r->fn_log = (void *)(uintptr_t)addr;
+        }
+    }
+#ifdef __linux__
+    r->code_size = t3_last_code - code0;
+    for (int i = 0; i < t3_nsec; i++) {
+        char nm[64];
+        snprintf(nm, sizeof(nm), "t3-%u-0x%" PRIx64, t3_nmod - 1, r->pc);
+        perf_report_named(t3_sec[i].p, t3_sec[i].size, nm);
+    }
+#endif
+    ok = true;
+    goto out;
+
+fail:
+    if (g->B) {
+        LLVMDisposeBuilder(g->B);
+        LLVMDisposeBuilder(g->BA);
+    }
+    if (g->M) {
+        LLVMDisposeModule(g->M);
+    }
+    if (g->C) {
+        LLVMContextDispose(g->C);
+    }
+out:
+    for (int k = 0; g->labseg && k < r->nb; k++) {
+        g_free(g->labseg[k]);
+    }
+    g_free(g->labseg);
+    g_free(g->entry);
+    g_free(g->seg);
+    r->compile_ms = (get_clock() - t0) / 1e6;
+    qemu_mutex_unlock(&t3_jit_lock);
+    return ok;
+}
+
+static void __attribute__((constructor)) t3_init_lock(void)
+{
+    qemu_mutex_init(&t3_jit_lock);
+}
diff -ruN a/tcg/tier3-capture.c.inc b/tcg/tier3-capture.c.inc
--- a/tcg/tier3-capture.c.inc
+++ b/tcg/tier3-capture.c.inc
@@ -0,0 +1,362 @@
+/*
+ * POMPPC tcg/0049 (x-tier3): capture of the TCG ops of one translation,
+ * after tcg_optimize() and the unreachable code pass, into a T3Block that
+ * the region compiler (tcg/tier3.c) turns into LLVM IR.  Included by tcg.c
+ * (it needs the op definitions, the temps and the backend's alignment
+ * rules).  The capture does not change the translation: the TB is then
+ * generated as usual (and thrown away by the caller).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "tcg/tier3.h"
+
+T3Global t3_globals[T3_MAX_GLOBALS];
+T3Target t3_target;
+static __thread T3Block *t3_cap;
+
+void t3_capture_set(T3Block *b)
+{
+    t3_cap = b;
+}
+
+void t3_block_free(T3Block *b)
+{
+    if (b) {
+        g_free(b->ops);
+        g_free(b->args);
+        g_free(b);
+    }
+}
+
+/* the host's atomicity of the fast path, as its prepare_host_addr() */
+#if defined(__x86_64__)
+#define T3_HOST_ATOM MO_ATOM_WITHIN16
+#elif defined(__aarch64__)
+#define T3_HOST_ATOM (have_lse2 ? MO_ATOM_WITHIN16 : MO_ATOM_IFALIGN)
+#else
+#define T3_HOST_ATOM MO_ATOM_IFALIGN
+#endif
+
+static T3Arg *t3_new_arg(T3Block *b, int *cap)
+{
+    if (b->nargs == *cap) {
+        *cap = *cap ? *cap * 2 : 256;
+        b->args = g_renew(T3Arg, b->args, *cap);
+    }
+    return &b->args[b->nargs++];
+}
+
+static bool t3_cap_temp(TCGContext *s, T3Block *b, int *cap, TCGArg a)
+{
+    TCGTemp *ts = arg_temp(a);
+    T3Arg *r = t3_new_arg(b, cap);
+    size_t idx = temp_idx(ts);
+
+    memset(r, 0, sizeof(*r));
+    r->idx = idx;
+    r->type = ts->base_type;
+    if (ts->base_type != TCG_TYPE_I32 && ts->base_type != TCG_TYPE_I64) {
+        b->reject = "temp i128/vecteur";
+        return false;
+    }
+    switch (ts->kind) {
+    case TEMP_CONST:
+        r->kind = T3A_CONST;
+        r->v = ts->val;
+        return true;
+    case TEMP_FIXED:
+        if (ts == tcgv_ptr_temp(tcg_env)) {
+            r->kind = T3A_ENV;
+            return true;
+        }
+        b->reject = "registre fixe";
+        return false;
+    case TEMP_GLOBAL:
+        if (ts->indirect_reg || ts->mem_base != tcgv_ptr_temp(tcg_env) ||
+            idx >= T3_MAX_GLOBALS) {
+            b->reject = "global indirect";
+            return false;
+        }
+        r->kind = T3A_GLOBAL;
+        r->v = ts->mem_offset;
+        if (!t3_globals[idx].known) {
+            t3_globals[idx].ofs = ts->mem_offset;
+            t3_globals[idx].type = ts->base_type;
+            qatomic_set(&t3_globals[idx].known, true);
+        }
+        return true;
+    case TEMP_EBB:
+    case TEMP_TB:
+        r->kind = T3A_TEMP;
+        return true;
+    default:
+        b->reject = "temp inconnu";
+        return false;
+    }
+}
+
+static void t3_cap_raw(T3Block *b, int *cap, int64_t v, int kind)
+{
+    T3Arg *r = t3_new_arg(b, cap);
+
+    memset(r, 0, sizeof(*r));
+    r->kind = kind;
+    r->v = v;
+    if (kind == T3A_LABEL) {
+        r->idx = arg_label(v)->id;
+    }
+}
+
+/* does [ofs, ofs + size) of env overlap a TCG global?  (TCG would read
+ * the memory copy, which a region keeps stale longer) */
+static bool t3_env_aliases_global(TCGContext *s, intptr_t ofs, int size)
+{
+    for (int i = 0; i < s->nb_globals; i++) {
+        TCGTemp *ts = &s->temps[i];
+        int gsize = ts->base_type == TCG_TYPE_I32 ? 4 : 8;
+
+        if (ts->kind != TEMP_GLOBAL || ts->mem_base != tcgv_ptr_temp(tcg_env)) {
+            continue;
+        }
+        if (ofs < ts->mem_offset + gsize && ts->mem_offset < ofs + size) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static int t3_ldst_size(TCGOpcode opc, TCGType type)
+{
+    switch (opc) {
+    case INDEX_op_ld8u: case INDEX_op_ld8s: case INDEX_op_st8:
+        return 1;
+    case INDEX_op_ld16u: case INDEX_op_ld16s: case INDEX_op_st16:
+        return 2;
+    case INDEX_op_ld32u: case INDEX_op_ld32s: case INDEX_op_st32:
+        return 4;
+    default:
+        return type == TCG_TYPE_I32 ? 4 : 8;
+    }
+}
+
+static void t3_add_pc(uint64_t *v, int *n, int max, uint64_t pc)
+{
+    for (int i = 0; i < *n; i++) {
+        if (v[i] == pc) {
+            return;
+        }
+    }
+    if (*n < max) {
+        v[(*n)++] = pc;
+    }
+}
+
+static void t3_capture(TCGContext *s, T3Block *b)
+{
+    TCGOp *op;
+    int cap_ops = 0, cap_args = 0;
+    uint64_t pc = 0;
+    bool seen_insn = false, nip_known = false;
+    uint64_t nip_val = 0;
+    intptr_t icount_ofs = offsetof(CPUState, neg.icount_decr.u32) -
+                          sizeof(CPUState);
+
+    g_free(b->ops);
+    g_free(b->args);
+    b->ops = NULL;
+    b->args = NULL;
+    b->nops = b->nargs = b->nlabels = 0;
+    b->reject = NULL;
+    b->icount = 0;
+    b->nexit = b->nlr = 0;
+    b->indirect = false;
+
+    QTAILQ_FOREACH(op, &s->ops, link) {
+        TCGOpcode opc = op->opc;
+        const TCGOpDef *def = &tcg_op_defs[opc];
+        int nb_o = def->nb_oargs, nb_i = def->nb_iargs, nb_c = def->nb_cargs;
+        T3Op *t;
+        int i;
+
+        if (opc == INDEX_op_insn_start) {
+            pc = tcg_get_insn_start_param(op, 0);
+            if (!seen_insn) {
+                b->pc = pc;
+            }
+            seen_insn = true;
+            b->icount++;
+            continue;
+        }
+        if (opc == INDEX_op_discard) {
+            continue;
+        }
+        switch (opc) {
+        case INDEX_op_plugin_cb:
+        case INDEX_op_plugin_mem_cb:
+        case INDEX_op_qemu_ld2:
+        case INDEX_op_qemu_st2:
+        case INDEX_op_ppc_fp32:         /* POMPPC 0014: not translated (yet) */
+        case INDEX_op_ppc_vfp:          /* POMPPC 0022 */
+            b->reject = def->name;
+            return;
+        default:
+            break;
+        }
+        if (def->flags & TCG_OPF_VECTOR) {
+            b->reject = "vecteur";
+            return;
+        }
+        if (opc >= INDEX_op_last_generic && opc != INDEX_op_call) {
+            b->reject = def->name;      /* ppc_fp32, ppc_vfp, host ops */
+            return;
+        }
+        if (b->nops == cap_ops) {
+            cap_ops = cap_ops ? cap_ops * 2 : 128;
+            b->ops = g_renew(T3Op, b->ops, cap_ops);
+        }
+        t = &b->ops[b->nops++];
+        memset(t, 0, sizeof(*t));
+        t->opc = opc;
+        t->p1 = op->param1;
+        t->p2 = op->param2;
+        t->a = b->nargs;
+        t->pc = pc;
+
+        if (opc == INDEX_op_call) {
+            const TCGHelperInfo *info = tcg_call_info(op);
+            int no = TCGOP_CALLO(op), ni = TCGOP_CALLI(op);
+
+            if (no > 1 || info->out_kind != TCG_CALL_RET_NORMAL) {
+                b->reject = "appel à résultat i128";
+                return;
+            }
+            for (i = 0; i < ni; i++) {
+                if (info->in[i].kind == TCG_CALL_ARG_BY_REF ||
+                    info->in[i].kind == TCG_CALL_ARG_BY_REF_N) {
+                    b->reject = "appel à argument i128";
+                    return;
+                }
+            }
+            if (!strcmp(info->name, "lookup_tb_ptr_check")) {
+                b->reject = "lookup_tb_ptr_check";
+                return;
+            }
+            for (i = 0; i < no + ni; i++) {
+                if (!t3_cap_temp(s, b, &cap_args, op->args[i])) {
+                    return;
+                }
+            }
+            t3_cap_raw(b, &cap_args, (int64_t)(uintptr_t)tcg_call_func(op),
+                       T3A_RAW);
+            t3_cap_raw(b, &cap_args, (int64_t)(uintptr_t)info, T3A_RAW);
+            t->nargs = no + ni + 2;
+            if (!strcmp(info->name, "lookup_tb_ptr")) {
+                if (nip_known) {
+                    t3_add_pc(b->exit_pc, &b->nexit, 8, nip_val);
+                } else {
+                    b->indirect = true;
+                }
+            }
+            continue;
+        }
+
+        for (i = 0; i < nb_o + nb_i; i++) {
+            if (!t3_cap_temp(s, b, &cap_args, op->args[i])) {
+                return;
+            }
+        }
+        for (i = 0; i < nb_c; i++) {
+            TCGArg c = op->args[nb_o + nb_i + i];
+            bool lab = (opc == INDEX_op_br || opc == INDEX_op_set_label) ||
+                       (opc == INDEX_op_brcond && i == 1);
+
+            t3_cap_raw(b, &cap_args, c, lab ? T3A_LABEL : T3A_RAW);
+            if (lab && b->args[b->nargs - 1].idx + 1 > b->nlabels) {
+                b->nlabels = b->args[b->nargs - 1].idx + 1;
+            }
+        }
+        t->nargs = nb_o + nb_i + nb_c;
+
+        switch (opc) {
+        case INDEX_op_qemu_ld:
+        case INDEX_op_qemu_st: {
+            MemOpIdx oi = op->args[nb_o + nb_i];
+            MemOp mop = get_memop(oi);
+
+            t->align = atom_and_align_for_opc(s, mop, T3_HOST_ATOM,
+                                              (mop & MO_SIZE) == MO_128).align;
+            if ((mop & MO_SIZE) > MO_64) {
+                b->reject = "accès 128 bits";
+                return;
+            }
+            break;
+        }
+        case INDEX_op_ld8u: case INDEX_op_ld8s: case INDEX_op_ld16u:
+        case INDEX_op_ld16s: case INDEX_op_ld32u: case INDEX_op_ld32s:
+        case INDEX_op_ld:
+        case INDEX_op_st8: case INDEX_op_st16: case INDEX_op_st32:
+        case INDEX_op_st: {
+            T3Arg *base = &b->args[t->a + 1];
+            intptr_t ofs = b->args[t->a + 2].v;
+            int size = t3_ldst_size(opc, op->param1);
+
+            if (base->kind == T3A_ENV) {
+                if (!seen_insn && opc == INDEX_op_ld && ofs == icount_ofs &&
+                    op->param1 == TCG_TYPE_I32) {
+                    t->headcheck = 1;
+                } else if (t3_env_aliases_global(s, ofs, size)) {
+                    b->reject = "accès à env qui recouvre un global";
+                    return;
+                }
+            }
+            break;
+        }
+        case INDEX_op_set_label:
+            nip_known = false;
+            break;
+        case INDEX_op_mov: {
+            T3Arg *d = &b->args[t->a], *src = &b->args[t->a + 1];
+
+            if (d->kind == T3A_GLOBAL && d->v == t3_target.pc_ofs) {
+                nip_known = src->kind == T3A_CONST;
+                nip_val = src->v;
+                if (t3_target.pc_size == 4) {
+                    nip_val = (uint32_t)nip_val;
+                }
+            } else if (d->kind == T3A_GLOBAL && d->v == t3_target.lr_ofs &&
+                       src->kind == T3A_CONST) {
+                uint64_t v = src->v;
+
+                if (t3_target.pc_size == 4) {
+                    v = (uint32_t)v;
+                }
+                t3_add_pc(b->lr_pc, &b->nlr, 4, v);
+            }
+            break;
+        }
+        case INDEX_op_exit_tb: {
+            uintptr_t v = op->args[0];
+
+            if (v != 0 && (v & TB_EXIT_MASK) != TB_EXIT_REQUESTED) {
+                if (nip_known) {
+                    t3_add_pc(b->exit_pc, &b->nexit, 8, nip_val);
+                } else {
+                    b->indirect = true;
+                }
+            }
+            break;
+        }
+        default:
+            break;
+        }
+        /* any other write to nip makes it unknown */
+        for (i = 0; i < nb_o; i++) {
+            T3Arg *d = &b->args[t->a + i];
+
+            if (opc != INDEX_op_mov && d->kind == T3A_GLOBAL &&
+                d->v == t3_target.pc_ofs) {
+                nip_known = false;
+            }
+        }
+    }
+}
