+static unsigned qemu_poll_ns_mode(void)
+{
+    static gsize mode_once;
+
+    if (g_once_init_enter(&mode_once)) {
+        const char *e = getenv("POMPPC_POLL_NS");
+        unsigned mode = e && *e && strcmp(e, "0") ? 1 : 0;
+        if (e && (!strcmp(e, "2") || !strcmp(e, "3"))) {
+            mode = e[0] - '0';
+        }
+        g_once_init_leave(&mode_once, mode + 1);
+    }
+    return mode_once - 1;
+}
+
+/* POMPPC tcg/0067: each poll thread has its own expiration budget.
+ * [A] M4 diagnostics 02/11: mode 2, about 11000 expirations/s on UT,
+ * about 2000 on zen; files in bench/tcg/ab/m4-attente-diag2-0211.
+ * [F] Policy to validate on all five games: at 128 precise expirations
+ * within 32 ms, use the existing millisecond path for 250 ms. If the
+ * burst resumes within 32 ms of that deadline, double the pause up to
+ * 2 s; an isolated burst resets it to 250 ms. This is
+ * host wakeup coalescing, not an alteration of guest code or clocks. */
+enum {
+    POLLNS_WINDOW_US = 32000,
+    POLLNS_LIMIT = 128,
+    POLLNS_BACKOFF_US = 250000,
+    POLLNS_MAX_BACKOFF_US = 2000000,
+};
+static __thread struct {
+    int64_t window_us;
+    int64_t resume_us;
+    int64_t backoff_us;
+    unsigned expired;
+} pollns_budget;
+
+static bool qemu_poll_ns_precision_allowed(void)
+{
+    int64_t now = g_get_monotonic_time();
+
+    if (now < pollns_budget.resume_us) {
+        return false;
+    }
+    if (now - pollns_budget.window_us >= POLLNS_WINDOW_US) {
+        pollns_budget.window_us = now;
+        pollns_budget.expired = 0;
+    }
+    return true;
+}
+
+static void qemu_poll_ns_precision_expired(void)
+{
+    int64_t now = g_get_monotonic_time();
+
+    /* A delayed host scheduling turn is not a dense expiration burst. */
+    if (now - pollns_budget.window_us >= POLLNS_WINDOW_US) {
+        pollns_budget.window_us = now;
+        pollns_budget.expired = 0;
+    }
+    if (++pollns_budget.expired >= POLLNS_LIMIT) {
+        if (pollns_budget.backoff_us &&
+            now - pollns_budget.resume_us <= POLLNS_WINDOW_US) {
+            pollns_budget.backoff_us = MIN(pollns_budget.backoff_us * 2,
+                                          POLLNS_MAX_BACKOFF_US);
+        } else {
+            pollns_budget.backoff_us = POLLNS_BACKOFF_US;
+        }
+        pollns_budget.resume_us = now + pollns_budget.backoff_us;
+        trace_pomppc_poll_budget_backoff(pollns_budget.expired,
+                                       pollns_budget.backoff_us);
+    }
+}
