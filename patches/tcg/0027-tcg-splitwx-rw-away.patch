+     */
+    if (near && !saved_addr) {
+        tcg_jit_addr = ((uintptr_t)&alloc_code_gen_buffer_anon &
+                        ~(uintptr_t)0xffffffffu) + 8 * GiB;
+    }
+    int rw_ret = alloc_code_gen_buffer_anon(size, PROT_READ | PROT_WRITE,
+                                           MAP_PRIVATE | MAP_ANONYMOUS, errp);
+    tcg_jit_near = near;
+    tcg_jit_addr = saved_addr;
+    if (rw_ret < 0) {
         return -1;
     }
-    tcg_jit_near = near;
 
