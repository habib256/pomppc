--- a/accel/tcg/cputlb.c	2026-11-01 04:44:12.483859065 +0400
+++ b/accel/tcg/cputlb.c	2026-11-01 04:46:33.377414782 +0400
@@ -709,6 +709,24 @@
     return -1;
 }
 
+/*
+ * POMPPC tcg/0063: drop the pages [base, end) of @idxmap from the TLB under a
+ * single lock, leaving the jump cache alone (the caller knows the translation
+ * of no instruction changed).
+ */
+void pomppc_tlb_flush_range_nojc(CPUState *cpu, vaddr base, vaddr end,
+                                 MMUIdxMap idxmap)
+{
+    assert_cpu_is_self(cpu);
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    for (MMUIdxMap work = idxmap & cpu->neg.tlb.c.dirty; work; work &= work - 1) {
+        for (vaddr page = base; page != end; page += TARGET_PAGE_SIZE) {
+            tlb_flush_page_locked(cpu, ctz32(work), page);
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+}
