--- a/target/ppc/mmu_helper.c	2026-11-01 04:44:12.500480525 +0400
+++ b/target/ppc/mmu_helper.c	2026-11-01 04:46:33.394894429 +0400
@@ -262,12 +262,47 @@
     env->IBAT[1][nr] = value;
 }
 
+/*
+ * POMPPC tcg/0063 x-dbat-lite: the pages a data BAT translated, flushed from
+ * the translated mmu_idx it was valid in only (1: supervisor, Vs; 0: user,
+ * Vp; a real-mode mmu_idx never goes through a BAT), at that BAT's own size,
+ * and without the jump cache: a data BAT translates no instruction fetch.
+ * bcopy_physvir_32 of the Tiger kernel (copypv, each page of a read()) sets
+ * DBAT0/1 then clears them, ~2 000 times/s in Colin McRae: the stock flush
+ * dropped the user pages and jump cache groups at those addresses.
+ */
+static void do_invalidate_dbat_lite(CPUPPCState *env, target_ulong BATu)
+{
+    MMUIdxMap idxmap = ((BATu & 2) ? 2 : 0) | ((BATu & 1) ? 1 : 0);
+    target_ulong mask = (BATu << 15) & 0x0FFE0000UL;
+    target_ulong base = BATu & ~0x0001FFFFUL & ~mask;
+
+    if (!idxmap) {
+        return;
+    }
+    if ((mask + 0x00020000) >> TARGET_PAGE_BITS > 64) {
+        tlb_flush_by_mmuidx(env_cpu(env), idxmap);
+        return;
+    }
+    env->ms[PPC_MS_BAT_PAGES] += env->mem_stats;
+    pomppc_tlb_flush_range_nojc(env_cpu(env), base, base + mask + 0x00020000,
+                                idxmap);
+}
