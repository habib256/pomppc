+/*
+ * x-fprf-lazy (POMPPC tcg/0046, docs/tcg-g4.md section 37).  fprf_src is
+ * PPC_FPRF_NONE (the smallest denormal: never a short-path result, which is
+ * a zero or a normal) when env->fpscr holds the whole architected FPSCR;
+ * otherwise FPRF is the class of fprf_src (helper_compute_fprf_float64())
+ * and FI is 1.
+ */
+#define PPC_FPRF_NONE 1ull
+
+/* the FPRF field of helper_compute_fprf_float64(x) (sNaN: quiet bit clear) */
+static inline unsigned ppc_fprf_of(uint64_t x)
+{
+    bool neg = x >> 63;
+    unsigned exp = (x >> 52) & 0x7ff;
+    uint64_t frac = x & ((1ull << 52) - 1);
+
+    if (exp == 0x7ff) {
+        if (frac == 0) {
+            return neg ? 0x09 : 0x05;
+        }
+        return (frac >> 51) & 1 ? 0x11 : 0x00;
+    }
+    if (exp == 0) {
+        if (frac == 0) {
+            return neg ? 0x12 : 0x02;
+        }
+        return neg ? 0x18 : 0x14;
+    }
+    return neg ? 0x08 : 0x04;
+}
+
+static inline target_ulong ppc_fpscr_lazy(target_ulong fpscr, uint64_t src)
+{
+    if (src == PPC_FPRF_NONE) {
+        return fpscr;
+    }
+    return (fpscr & ~(target_ulong)((0x1f << 12) | (1 << 17))) |
+           (target_ulong)ppc_fprf_of(src) << 12 | 1 << 17;
+}
+
+/* the architected FPSCR */
+static inline target_ulong ppc_fpscr_get(CPUPPCState *env)
+{
+    return ppc_fpscr_lazy(env->fpscr, env->fprf_src);
+}
+
+/* make env->fpscr the architected FPSCR */
+static inline void ppc_fprf_flush(CPUPPCState *env)
+{
+    if (env->fprf_src != PPC_FPRF_NONE) {
+        env->fpscr = ppc_fpscr_get(env);
+        env->fprf_src = PPC_FPRF_NONE;
+    }
+}
