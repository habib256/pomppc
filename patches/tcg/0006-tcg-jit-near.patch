+/*
+ * POMPPC (docs/tcg-g4.md §14) : placement du tampon du JIT, posé par les
+ * propriétés x-jit-near / x-jit-addr de l'accélérateur avant tcg_init().
+ * tcg_jit_near : chercher une place dans la même fenêtre de 4 Gio (bits 63..32)
+ * que le texte de QEMU ; tcg_jit_addr : adresse demandée (indication), 0 = au
+ * choix du noyau.
+ */
+extern bool tcg_jit_near;
+extern uint64_t tcg_jit_addr;
+
