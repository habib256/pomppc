diff --git a/target/ppc/lmw-vector.h b/target/ppc/lmw-vector.h
--- /dev/null
+++ b/target/ppc/lmw-vector.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* POMPPC: RAM copies after probe_contiguous has checked the entire access.
+ * Four guest big-endian words at a time, preserving 32-bit zero extension.
+ * No overread, including the final one to three words and unaligned input.
+ */
+#ifndef PPC_LMW_VECTOR_H
+#define PPC_LMW_VECTOR_H
+
+#if defined(__aarch64__) && !HOST_BIG_ENDIAN
+#include <arm_neon.h>
+
+static inline void ppc_lmw_vector(target_ulong *gpr, const void *host,
+                                  unsigned reg)
+{
+    const uint8_t *p = host;
+    for (; reg + 4 <= 32; reg += 4, p += 16) {
+        uint32x4_t w = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(p)));
+#if TARGET_LONG_BITS == 64
+        vst1q_u64(&gpr[reg], vmovl_u32(vget_low_u32(w)));
+        vst1q_u64(&gpr[reg + 2], vmovl_u32(vget_high_u32(w)));
+#else
+        vst1q_u32(&gpr[reg], w);
+#endif
+    }
+    for (; reg < 32; reg++, p += 4) {
+        gpr[reg] = ldl_be_p(p);
+    }
+}
+
+static inline void ppc_stmw_vector(const target_ulong *gpr, void *host,
+                                   unsigned reg)
+{
+    uint8_t *p = host;
+    for (; reg + 4 <= 32; reg += 4, p += 16) {
+#if TARGET_LONG_BITS == 64
+        uint32x4_t w = vcombine_u32(vmovn_u64(vld1q_u64(&gpr[reg])),
+                                    vmovn_u64(vld1q_u64(&gpr[reg + 2])));
+#else
+        uint32x4_t w = vld1q_u32(&gpr[reg]);
+#endif
+        vst1q_u8(p, vrev32q_u8(vreinterpretq_u8_u32(w)));
+    }
+    for (; reg < 32; reg++, p += 4) {
+        stl_be_p(p, gpr[reg]);
+    }
+}
+#endif
+#endif
