+static bool vfp_add4(float_status *s, uint32_t *r, const uint32_t *a,
+                     const uint32_t *b, bool sub)
+{
+    uint32_t res[4];
+    bool ok = vfp_can_use_fpu(s), inf = false;
+    int i;
