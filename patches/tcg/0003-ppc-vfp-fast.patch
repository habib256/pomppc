+static inline int vfp_zon(uint32_t x)
+{
+    uint32_t e = (x >> 23) & 0xff;
+    return (e != 0 && e != 0xff) || !(x & 0x7fffffff);
+}
+
+static inline float vfp_f(uint32_t x)
