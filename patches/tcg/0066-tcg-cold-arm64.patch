+/* POMPPC tcg/0066: prepare imm26 veneers in the hot TB tail.  The
+ * original B.cond/CBNZ and its fast fall-through stay unchanged.  raddr
+ * stays in the body, so memory and deferred FP faults retain their PC. */
+static int tcg_out_cold_veneers(TCGContext *s)
+{
+    TCGLabelQemuLdst *lb;
+
+    QSIMPLEQ_FOREACH(lb, &s->ldst_labels, next) {
+        if ((void *)(s->code_ptr + 1) > s->code_gen_highwater) {
+            return -1;
+        }
+        if (!reloc_pc19(lb->label_ptr[0], tcg_splitwx_to_rx(s->code_ptr))) {
+            return -2;
+        }
+        lb->label_ptr[0] = s->code_ptr;
+        tcg_out_insn(s, branch, B, 0);
+    }
+    return 0;
+}
