+/* POMPPC tcg/0066: cold code and its literal pool share a region, but
+ * not the hot pool. Restore every hot cursor/list even on overflow or a
+ * failed relocation; a failed TB must not publish a partial cold tail. */
+static int tcg_out_cold_finalize(TCGContext *s)
+{
+    tcg_insn_unit *hot, *cold;
+    void *hot_highwater, *hot_data;
+    TCGLabelPoolData *hot_pool;
+    int i;
+
+    if (!s->code_cold_ptr || QSIMPLEQ_EMPTY(&s->ldst_labels)) {
+        return tcg_out_ldst_finalize(s);
+    }
+#ifdef TCG_TARGET_COLD_VENEERS
+    i = tcg_out_cold_veneers(s);
+    if (i < 0) {
+        if (i == -1) {
+            qatomic_set(&s->code_gen_ptr, s->code_gen_highwater);
+        }
+        return i;
+    }
+#endif
+    hot = s->code_ptr;
+    hot_highwater = s->code_gen_highwater;
+    hot_data = s->data_gen_ptr;
+    hot_pool = s->pool_labels;
+    s->code_ptr = s->code_cold_ptr;
+    s->code_gen_highwater = s->code_cold_highwater;
+    s->data_gen_ptr = NULL;
+    s->pool_labels = NULL;
+
+    i = tcg_out_ldst_finalize(s);
+    if (i >= 0) {
+        i = tcg_out_pool_finalize(s);
+    }
+    cold = s->code_ptr;
+    s->code_ptr = hot;
+    s->code_gen_highwater = hot_highwater;
+    s->data_gen_ptr = hot_data;
+    s->pool_labels = hot_pool;
+    if (i == -1) {
+        qatomic_set(&s->code_gen_ptr, hot_highwater);
+    }
+    if (i < 0) {
+        return i;
+    }
+#ifndef CONFIG_TCG_INTERPRETER
+    flush_idcache_range((uintptr_t)tcg_splitwx_to_rx(s->code_cold_ptr),
+                        (uintptr_t)s->code_cold_ptr,
+                        tcg_ptr_byte_diff(cold, s->code_cold_ptr));
+#endif
+    s->code_cold_ptr = cold;
+    return 0;
+}
