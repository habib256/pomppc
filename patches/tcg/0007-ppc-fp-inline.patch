diff --git a/target/ppc/fpu_helper.c b/target/ppc/fpu_helper.c
index 867c53484..5755d1ac4 100644
--- a/target/ppc/fpu_helper.c
+++ b/target/ppc/fpu_helper.c
@@ -22,6 +22,8 @@
 #include "exec/exec-all.h"
 #include "internal.h"
 #include "fpu/softfloat.h"
