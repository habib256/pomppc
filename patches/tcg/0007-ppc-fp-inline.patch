 static inline float128 float128_snan_to_qnan(float128 x)
 {
@@ -3724,3 +3726,331 @@ void helper_XVF64GERNN(CPUPPCState *env, ppc_vsr_t *a, ppc_vsr_t *b,
     vsxger(env, a, b, at, mask, true, true, true, vsxger_mul64,
            vsxger_muladd64, vsxger_zero64);
 }
+
+/*
+ * x-fp-inline (POMPPC patches/tcg/0007, docs/tcg-g4.md section 15).
+ *
+ * The generated code of fadds fsubs fmuls fmadds fmsubs fnmadds fnmsubs
+ * (and fcmpu, fully inline) takes a short path when
+ *
+ *   fpi_gate(fpscr):  FPSCR[XX] = 1, XE = OE = UE = 0, RN = 00 -- exactly
+ *                     the "primed" state of x-fast-fp (ppc_fp_primed()),
+ *                     plus round-to-nearest-even;
+ *   helper_fp32_fast() does not return FPI_FAIL: every operand is exactly a
+ *                     float32 zero or normal, and the result can have
+ *                     neither overflowed nor underflowed (fadds/fsubs: any
+ *                     finite sum, tiny sums are exact; the others: a result
+ *                     above FLT_MIN, or the exact result of a zero product).
+ *
+ * In that state the original sequence (reset_fpstatus, helper_FxxxS,
+ * fprf_check_float64) only ever: returns the correctly rounded float32
+ * result (what the host computes), leaves fp_status.float_exception_flags =
+ * float_flag_inexact (primed, and no other flag can be raised), writes
+ * FPRF from the result and sets FI.  fpi_fpscr_arith() is that update; the
+ * translator emits the same thing as TCG ops.  Anything else -- NaN,
+ * infinity, denormal or float64-only operand, overflow, a tiny result,
+ * another rounding mode, an armed trap, XX clear -- runs the original
+ * helpers, unchanged.
+ *
+ * Proof: tools/tcg/fpproof.sh (this block extracted as is and compared with
+ * the real helpers of the built tree) and x-fp-verify (every inline result
+ * of a running guest re-computed by the original helpers).
+ */
+/* fp-inline: début (FPI_*: internal.h) */
+static inline bool fpi_gate(uint64_t fpscr)
+{
+    return (fpscr & FPI_GATE_MASK) == FP_XX;
+}
+
+/* Same test as f64_is_f32_zon() in fpu/softfloat.c. */
+static inline bool fpi_zon(uint64_t x)
+{
+    uint64_t frac = x & MAKE_64BIT_MASK(0, 52);
+    int exp = extract64(x, 52, 11);
+
+    if (exp == 0) {
+        return frac == 0;
+    }
+    return (frac & MAKE_64BIT_MASK(0, 29)) == 0 &&
+           exp >= 0x381 && exp <= 0x47e;
+}
+
+/* Both exact for the values fpi_zon() accepts, and for float32 results. */
+static inline float fpi_f32(uint64_t x)
+{
+    union { double d; uint64_t u; } v = { .u = x };
+    return (float)v.d;
+}
+
+static inline uint64_t fpi_f64(float f)
+{
+    union { double d; uint64_t u; } v;
+
+    v.d = f;
+    return v.u;
+}
+
+/*
+ * frT for a = frA, b = frB, c = frC (fmuls uses a and c, fadds/fsubs a and
+ * b), or FPI_FAIL.  One IEEE float32 operation, correctly rounded to
+ * nearest-even by the host: bit for bit what float64r32_* computes for
+ * these operands.  fmadds & co. use fmaf(): PowerPC rounds a*c+b once.
+ */
+uint64_t helper_fp32_fast(uint64_t a, uint64_t b, uint64_t c, uint32_t op)
+{
+    float fa, fb, fc, r;
+
+    switch (op) {
+    case FPI_ADD:
+    case FPI_SUB:
+        if (!fpi_zon(a) || !fpi_zon(b)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_f32(a);
+        fb = fpi_f32(b);
+        r = op == FPI_ADD ? fa + fb : fa - fb;
+        /*
+         * Overflow goes back to the helpers.  A tiny sum (zero included) of
+         * two float32 is always exact: no underflow, no inexact, and the
+         * helpers class its float64 widening as they do here (FPRF looks at
+         * the float64: a float32 denormal is a float64 normal).
+         */
+        if (isinf(r)) {
+            return FPI_FAIL;
+        }
+        return fpi_f64(r);
+    case FPI_MUL:
+        if (!fpi_zon(a) || !fpi_zon(c)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_f32(a);
+        fc = fpi_f32(c);
+        r = fa * fc;
+        if (fa != 0 && fc != 0 && (isinf(r) || fabsf(r) <= FLT_MIN)) {
+            return FPI_FAIL;
+        }
+        return fpi_f64(r);
+    case FPI_MADD:
+    case FPI_MSUB:
+    case FPI_NMADD:
+    case FPI_NMSUB:
+        if (!fpi_zon(a) || !fpi_zon(b) || !fpi_zon(c)) {
+            return FPI_FAIL;
+        }
+        fa = fpi_f32(a);
+        fb = fpi_f32(b);
+        fc = fpi_f32(c);
+        if (op == FPI_MSUB || op == FPI_NMSUB) {
+            fb = -fb;
+        }
+        r = fmaf(fa, fc, fb);
+        /*
+         * A zero product makes the sum exact (b is zero or normal); else
+         * overflow and tiny results, zero included (it may be an underflow),
+         * go back to the helpers.
+         */
+        if (fa != 0 && fc != 0 && (isinf(r) || fabsf(r) <= FLT_MIN)) {
+            return FPI_FAIL;
+        }
+        if (op == FPI_NMADD || op == FPI_NMSUB) {
+            r = -r;             /* after rounding, zero included */
+        }
+        return fpi_f64(r);
+    }
+    return FPI_FAIL;
+}
+
+/*
+ * FPSCR after the original sequence, for a short-path result r: FPRF is
+ * that of the float64 r, which is +-zero or a float64 normal (every float32,
+ * denormals included, widens to one).
+ */
+static inline uint64_t fpi_fpscr_arith(uint64_t fpscr, uint64_t r)
+{
+    uint64_t neg = r >> 63;
+    uint64_t fprf = (r << 1) == 0 ? (neg << 4) | 0x02    /* +-zero */
+                                  : 0x04ull << neg;      /* +-normal */
+
+    return (fpscr & ~(uint64_t)(FP_FPRF | FP_FI)) |
+           (fprf << FPSCR_FPRF) | FP_FI;
+}
+
+/*
+ * fcmpu: when neither operand is a NaN and the FPSCR is primed (fcmpu does
+ * not depend on RN), the original sequence sets FPCC and CR[bf] to
+ * 8 (<), 4 (>) or 2 (=), sets FI and leaves the primed flags.  The
+ * comparison is done on integers: sign-magnitude turned into two's
+ * complement (-0 and +0 both become 0).  Returns the CR field, or 0 when
+ * the helpers must run.
+ */
+static inline int64_t fpi_cmp_key(uint64_t x)
+{
+    return (int64_t)x < 0 ? -(int64_t)(x & INT64_MAX) : (int64_t)x;
+}
+
+static inline uint32_t fpi_fcmpu(uint64_t fpscr, uint64_t a, uint64_t b)
+{
+    int64_t ka, kb;
+
+    if ((fpscr & (FP_XX | FP_XE | FP_OE | FP_UE)) != FP_XX ||
+        (a & INT64_MAX) > 0x7ff0000000000000ull ||
+        (b & INT64_MAX) > 0x7ff0000000000000ull) {
+        return 0;
+    }
+    ka = fpi_cmp_key(a);
+    kb = fpi_cmp_key(b);
+    return ka < kb ? 8 : ka > kb ? 4 : 2;
+}
+
+static inline uint64_t fpi_fpscr_fcmpu(uint64_t fpscr, uint32_t crf)
+{
+    return (fpscr & ~(uint64_t)(FP_FPCC | FP_FI)) |
+           ((uint64_t)crf << FPSCR_FPCC) | FP_FI;
+}
+/* fp-inline: fin */
+
+/*
+ * x-fp-verify: every short-path result is recomputed here by the original
+ * sequence (reset_fpstatus, the helper, fprf_check_float64), and the
+ * result, the FPSCR, the soft-fp flags and the exception state compared.
+ * The generated code then stores its own values (so the guest runs exactly
+ * as with x-fp-verify off).  Counters are global, printed every 2^22
+ * checks and at exit.
+ */
+static const char *const fpi_names[FPI_NOPS] = {
+    "fadds", "fsubs", "fmuls", "fmadds", "fmsubs", "fnmadds", "fnmsubs",
+    "fcmpu",
+};
+static uint64_t fpv_ok[FPI_NOPS], fpv_bad[FPI_NOPS];
+static uint64_t fpv_slow_gate[FPI_NOPS], fpv_slow_opnd[FPI_NOPS];
+static uint64_t fpv_total;
+static bool fpv_atexit;
+
+static void fpv_report(void)
+{
+    uint64_t ok = 0, bad = 0;
+    int i;
+
+    for (i = 0; i < FPI_NOPS; i++) {
+        ok += qatomic_read(&fpv_ok[i]);
+        bad += qatomic_read(&fpv_bad[i]);
+    }
+    fprintf(stderr, "fp-verify: %" PRIu64 " vérifiés, %" PRIu64
+            " divergences ;", ok, bad);
+    for (i = 0; i < FPI_NOPS; i++) {
+        fprintf(stderr, " %s %" PRIu64 "/%" PRIu64 " (repli fpscr %" PRIu64
+                ", opérandes %" PRIu64 ")", fpi_names[i],
+                qatomic_read(&fpv_ok[i]), qatomic_read(&fpv_bad[i]),
+                qatomic_read(&fpv_slow_gate[i]),
+                qatomic_read(&fpv_slow_opnd[i]));
+    }
+    fprintf(stderr, "\n");
+}
+
+static void fpv_count(int op, bool good)
+{
+    if (!qatomic_read(&fpv_atexit)) {
+        qatomic_set(&fpv_atexit, true);
+        atexit(fpv_report);
+    }
+    qatomic_inc(good ? &fpv_ok[op] : &fpv_bad[op]);
+    if ((qatomic_fetch_inc(&fpv_total) & ((1u << 22) - 1)) == 0) {
+        fpv_report();
+    }
+}
+
+void helper_fpv_arith(CPUPPCState *env, uint32_t op, uint64_t a, uint64_t b,
+                      uint64_t c, uint64_t r, target_ulong fpscr_new)
+{
+    CPUState *cs = env_cpu(env);
+    target_ulong fpscr_old = env->fpscr;
+    int excp = cs->exception_index;
+    uint64_t ref;
+    int flags;
+    bool good;
+
+    helper_reset_fpstatus(env);
+    switch (op) {
+    case FPI_ADD:
+        ref = helper_FADDS(env, a, b);
+        break;
+    case FPI_SUB:
+        ref = helper_FSUBS(env, a, b);
+        break;
+    case FPI_MUL:
+        ref = helper_FMULS(env, a, c);
+        break;
+    case FPI_MADD:
+        ref = helper_FMADDS(env, a, c, b);
+        break;
+    case FPI_MSUB:
+        ref = helper_FMSUBS(env, a, c, b);
+        break;
+    case FPI_NMADD:
+        ref = helper_FNMADDS(env, a, c, b);
+        break;
+    default:
+        ref = helper_FNMSUBS(env, a, c, b);
+        break;
+    }
+    helper_compute_fprf_float64(env, ref);
+    do_float_check_status(env, true, GETPC());
+    flags = get_float_exception_flags(&env->fp_status);
+    /* helpers == generated code, and generated code == the C model */
+    good = ref == r && env->fpscr == fpscr_new &&
+           flags == float_flag_inexact && cs->exception_index == excp &&
+           fpi_fpscr_arith(fpscr_old, r) == fpscr_new;
+    if (!good) {
+        fprintf(stderr, "fp-verify: DIVERGENCE %s a=%016" PRIx64 " b=%016"
+                PRIx64 " c=%016" PRIx64 " fpscr=%08" PRIx64 " : inline %016"
+                PRIx64 " fpscr %08" PRIx64 ", helpers %016" PRIx64
+                " fpscr %08" PRIx64 " drapeaux %x excp %d->%d\n",
+                fpi_names[op], a, b, c, (uint64_t)fpscr_old, r,
+                (uint64_t)fpscr_new, ref, (uint64_t)env->fpscr, flags, excp,
+                cs->exception_index);
+    }
+    fpv_count(op, good);
+}
+
+void helper_fpv_fcmpu(CPUPPCState *env, uint32_t crf, uint64_t a, uint64_t b,
+                      uint32_t ret, target_ulong fpscr_new)
+{
+    CPUState *cs = env_cpu(env);
+    target_ulong fpscr_old = env->fpscr;
+    uint32_t crf_old = env->crf[crf];
+    int excp = cs->exception_index;
+    uint32_t ref;
+    int flags;
+    bool good;
+
+    helper_reset_fpstatus(env);
+    helper_fcmpu(env, a, b, crf);
+    do_float_check_status(env, true, GETPC());
+    ref = env->crf[crf];
+    flags = get_float_exception_flags(&env->fp_status);
+    good = ref == ret && env->fpscr == fpscr_new &&
+           flags == float_flag_inexact && cs->exception_index == excp &&
+           fpi_fcmpu(fpscr_old, a, b) == ret &&
+           fpi_fpscr_fcmpu(fpscr_old, ret) == fpscr_new;
+    if (!good) {
+        fprintf(stderr, "fp-verify: DIVERGENCE fcmpu a=%016" PRIx64 " b=%016"
+                PRIx64 " fpscr=%08" PRIx64 " : inline cr %x fpscr %08" PRIx64
+                ", helpers cr %x fpscr %08" PRIx64 " drapeaux %x\n",
+                a, b, (uint64_t)fpscr_old, ret, (uint64_t)fpscr_new, ref,
+                (uint64_t)env->fpscr, flags);
+    }
+    /* the generated code writes cpu_crf[crf] itself afterwards */
+    env->crf[crf] = crf_old;
+    fpv_count(FPI_CMPU, good);
+}
+
+/* x-fp-verify: why the helpers ran (fpscr state, or operands/result). */
+void helper_fpv_slow(CPUPPCState *env, uint32_t op, uint64_t a, uint64_t b,
+                     uint64_t c, target_ulong fpscr)
+{
+    bool gate = op == FPI_CMPU
+        ? (fpscr & (FP_XX | FP_XE | FP_OE | FP_UE)) == FP_XX
+        : fpi_gate(fpscr);
+
+    qatomic_inc(gate ? &fpv_slow_opnd[op] : &fpv_slow_gate[op]);
+}
