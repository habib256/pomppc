+/* sign-magnitude -> two's complement (fpi_cmp_key() of fpu_helper.c) */
+static void gen_fpi_cmp_key(TCGv_i64 k, TCGv_i64 x)
+{
+    TCGv_i64 m = tcg_temp_new_i64();
+
+    tcg_gen_andi_i64(m, x, INT64_MAX);
+    tcg_gen_neg_i64(m, m);
+    tcg_gen_movcond_i64(TCG_COND_LT, k, x, tcg_constant_i64(0), m, x);
+}
+
+/*
+ * x-fp-inline: fcmpu without its two helpers when neither operand is a NaN
+ * and the FPSCR is primed (fpi_fcmpu() of fpu_helper.c).
+ */
+static void gen_fcmpu_inline(DisasContext *ctx)
+{
+    int bf = crfD(ctx->opcode);
+    TCGLabel *l_slow = gen_new_label();
+    TCGLabel *l_done = gen_new_label();
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 bad = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv_i64 ka = tcg_temp_new_i64();
+    TCGv_i64 kb = tcg_temp_new_i64();
+    TCGv_i64 ret = tcg_temp_new_i64();
+    TCGv_i32 ret32 = tcg_temp_new_i32();
+    TCGv g = tcg_temp_new();
+    TCGv nf = tcg_temp_new();
+    TCGv rt = tcg_temp_new();
+
+    get_fpr(a, rA(ctx->opcode));
+    get_fpr(b, rB(ctx->opcode));
+    tcg_gen_andi_tl(g, cpu_fpscr, FP_XX | FP_XE | FP_OE | FP_UE);
+    tcg_gen_xori_tl(g, g, FP_XX);                   /* 0 iff primed */
+    tcg_gen_extu_tl_i64(bad, g);
+    tcg_gen_andi_i64(t, a, INT64_MAX);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, t, t, 0x7ff0000000000000ull);
+    tcg_gen_or_i64(bad, bad, t);
+    tcg_gen_andi_i64(t, b, INT64_MAX);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, t, t, 0x7ff0000000000000ull);
+    tcg_gen_or_i64(bad, bad, t);
+    tcg_gen_brcondi_i64(TCG_COND_NE, bad, 0, l_slow);
+
+    gen_fpi_cmp_key(ka, a);
+    gen_fpi_cmp_key(kb, b);
+    tcg_gen_movcond_i64(TCG_COND_GT, ret, ka, kb, tcg_constant_i64(4),
+                        tcg_constant_i64(2));
+    tcg_gen_movcond_i64(TCG_COND_LT, ret, ka, kb, tcg_constant_i64(8), ret);
+    tcg_gen_extrl_i64_i32(ret32, ret);
+    tcg_gen_trunc_i64_tl(rt, ret);
+    tcg_gen_shli_tl(rt, rt, FPSCR_FPCC);
+    tcg_gen_andi_tl(nf, cpu_fpscr, ~(target_ulong)(FP_FPCC | FP_FI));
+    tcg_gen_or_tl(nf, nf, rt);
+    tcg_gen_ori_tl(nf, nf, FP_FI);
+    if (ctx->fp_verify) {
+        gen_helper_fpv_fcmpu(tcg_env, tcg_constant_i32(bf), a, b, ret32, nf);
+    }
+    tcg_gen_mov_i32(cpu_crf[bf], ret32);
+    tcg_gen_mov_tl(cpu_fpscr, nf);
+    gen_fpi_store_primed_flags();
+    tcg_gen_br(l_done);
+
+    gen_set_label(l_slow);
+    if (ctx->fp_verify) {
+        gen_helper_fpv_slow(tcg_env, tcg_constant_i32(FPI_CMPU), a, b,
+                            tcg_constant_i64(0), cpu_fpscr);
+    }
+    gen_reset_fpstatus();
+    gen_helper_fcmpu(tcg_env, a, b, tcg_constant_i32(bf));
+    gen_helper_float_check_status(tcg_env);
+
+    gen_set_label(l_done);
+}
