+/*
+ * x-fp-inline (POMPPC tcg/0007): short path of the scalar single-precision
+ * arithmetic.  See the "fp-inline" block of fpu_helper.c for why it is
+ * exact.  One branch per instruction:
+ *
+ *   r = helper_fp32_fast(a, b, c, op)          pure call (NO_RWG_SE)
+ *   if ((fpscr & FPI_GATE_MASK) != XX || r == FPI_FAIL) goto slow
+ *   frT = r ; fpscr = fpi_fpscr_arith(fpscr, r) ; flags = inexact
+ *   goto done
+ * slow:
+ *   the original sequence (reset_fpstatus, helper, fprf_check_float64)
+ * done:
+ */
+static void gen_fpi_slow_call(int op, TCGv_i64 d, TCGv_i64 a, TCGv_i64 b,
+                              TCGv_i64 c)
+{
+    switch (op) {
+    case FPI_ADD:
+        gen_helper_FADDS(d, tcg_env, a, b);
+        break;
+    case FPI_SUB:
+        gen_helper_FSUBS(d, tcg_env, a, b);
+        break;
+    case FPI_MUL:
+        gen_helper_FMULS(d, tcg_env, a, c);
+        break;
+    case FPI_MADD:
+        gen_helper_FMADDS(d, tcg_env, a, c, b);
+        break;
+    case FPI_MSUB:
+        gen_helper_FMSUBS(d, tcg_env, a, c, b);
+        break;
+    case FPI_NMADD:
+        gen_helper_FNMADDS(d, tcg_env, a, c, b);
+        break;
+    default:
+        gen_helper_FNMSUBS(d, tcg_env, a, c, b);
+        break;
+    }
+}
+
+/* fpi_fpscr_arith() of fpu_helper.c */
+static void gen_fpi_fpscr_arith(TCGv dst, TCGv_i64 r)
+{
+    TCGv_i64 neg = tcg_temp_new_i64();
+    TCGv_i64 zer = tcg_temp_new_i64();
+    TCGv_i64 z = tcg_temp_new_i64();
+    TCGv_i64 n = tcg_temp_new_i64();
+    TCGv t = tcg_temp_new();
+
+    tcg_gen_shri_i64(neg, r, 63);
+    tcg_gen_shli_i64(zer, r, 1);                    /* 0 iff +-0 */
+    tcg_gen_shli_i64(z, neg, 4);
+    tcg_gen_ori_i64(z, z, 0x02);                    /* 0x02 / 0x12 */
+    tcg_gen_shl_i64(n, tcg_constant_i64(0x04), neg); /* 0x04 / 0x08 */
+    tcg_gen_movcond_i64(TCG_COND_EQ, n, zer, tcg_constant_i64(0), z, n);
+    tcg_gen_shli_i64(n, n, FPSCR_FPRF);
+    tcg_gen_trunc_i64_tl(t, n);
+    tcg_gen_andi_tl(dst, cpu_fpscr, ~(target_ulong)(FP_FPRF | FP_FI));
+    tcg_gen_or_tl(dst, dst, t);
+    tcg_gen_ori_tl(dst, dst, FP_FI);
+}
