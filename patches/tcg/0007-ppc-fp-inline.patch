+static void gen_fpi_store_primed_flags(void)
+{
+    tcg_gen_st16_i32(tcg_constant_i32(float_flag_inexact), tcg_env,
+                     offsetof(CPUPPCState, fp_status.float_exception_flags));
+}
+
+static bool do_fp_inline(DisasContext *ctx, int op, int frt, int fra,
+                         int frb, int frc, bool rc)
+{
+    TCGLabel *l_slow = gen_new_label();
+    TCGLabel *l_done = gen_new_label();
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 c = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    TCGv_i64 bad = tcg_temp_new_i64();
+    TCGv_i64 f = tcg_temp_new_i64();
+    TCGv g = tcg_temp_new();
+    TCGv nf = tcg_temp_new();
+
+    REQUIRE_INSNS_FLAGS(ctx, FLOAT);
+    REQUIRE_FPU(ctx);
+
+    get_fpr(a, fra);
+    if (op == FPI_ADD || op == FPI_SUB || op >= FPI_MADD) {
+        get_fpr(b, frb);
+    } else {
+        tcg_gen_movi_i64(b, 0);
+    }
+    if (op >= FPI_MUL) {
+        get_fpr(c, frc);
+    } else {
+        tcg_gen_movi_i64(c, 0);
+    }
+    gen_helper_fp32_fast(r, a, b, c, tcg_constant_i32(op));
+    tcg_gen_andi_tl(g, cpu_fpscr, FPI_GATE_MASK);
+    tcg_gen_xori_tl(g, g, FP_XX);                   /* 0 iff gate open */
+    tcg_gen_extu_tl_i64(bad, g);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, f, r, FPI_FAIL);
+    tcg_gen_or_i64(bad, bad, f);
+    tcg_gen_brcondi_i64(TCG_COND_NE, bad, 0, l_slow);
+
+    gen_fpi_fpscr_arith(nf, r);
+    if (ctx->fp_verify) {
+        gen_helper_fpv_arith(tcg_env, tcg_constant_i32(op), a, b, c, r, nf);
+    }
+    set_fpr(frt, r);
+    tcg_gen_mov_tl(cpu_fpscr, nf);
+    gen_fpi_store_primed_flags();
+    tcg_gen_br(l_done);
+
+    gen_set_label(l_slow);
+    if (ctx->fp_verify) {
+        gen_helper_fpv_slow(tcg_env, tcg_constant_i32(op), a, b, c, cpu_fpscr);
+    }
+    gen_reset_fpstatus();
+    gen_fpi_slow_call(op, r, a, b, c);
+    set_fpr(frt, r);
+    gen_compute_fprf_float64(r);
+
+    gen_set_label(l_done);
+    if (unlikely(rc)) {
+        gen_set_cr1_from_fpscr(ctx);
+    }
+    return true;
+}
+
+static bool do_fpi_ab(DisasContext *ctx, arg_A_tab *a,
+                      void (*helper)(TCGv_i64, TCGv_ptr, TCGv_i64, TCGv_i64),
+                      int op)
+{
+    if (ctx->fp_inline) {
+        return do_fp_inline(ctx, op, a->frt, a->fra, a->frb, 0, a->rc);
+    }
+    return do_helper_ab(ctx, a, helper);
+}
+
+static bool do_fpi_ac(DisasContext *ctx, arg_A_tac *a,
+                      void (*helper)(TCGv_i64, TCGv_ptr, TCGv_i64, TCGv_i64),
+                      int op)
+{
+    if (ctx->fp_inline) {
+        return do_fp_inline(ctx, op, a->frt, a->fra, 0, a->frc, a->rc);
+    }
+    return do_helper_ac(ctx, a, helper);
+}
+
+static bool do_fpi_acb(DisasContext *ctx, arg_A *a,
+                       void (*helper)(TCGv_i64, TCGv_ptr, TCGv_i64,
+                                      TCGv_i64, TCGv_i64),
+                       int op)
+{
+    if (ctx->fp_inline) {
+        return do_fp_inline(ctx, op, a->frt, a->fra, a->frb, a->frc, a->rc);
+    }
+    return do_helper_acb(ctx, a, helper);
+}
