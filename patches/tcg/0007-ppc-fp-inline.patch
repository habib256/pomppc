+/*
+ * x-fp-inline (POMPPC tcg/0007): the operations with a short path, shared by
+ * the translator (translate/fp-impl.c.inc) and the helpers (fpu_helper.c).
+ */
+enum {
+    FPI_ADD, FPI_SUB, FPI_MUL, FPI_MADD, FPI_MSUB, FPI_NMADD, FPI_NMSUB,
+    FPI_CMPU, FPI_NOPS
+};
+/* helper_fp32_fast() "take the helpers" result: a NaN, never a result. */
+#define FPI_FAIL 0x7ff8000000000001ull
