+/*
+ * x-lmw-inline-verify (POMPPC tcg/0032).  After an inline lmw (reg > 0) or
+ * stmw (reg | 0x100), the words of [addr, addr + 4 * (32 - r)) read through
+ * the TLB without fault must equal the low 32 bits of r..r31: what the
+ * helper would have loaded, or what it would have stored.  I/O pages are
+ * not re-read (counted).
+ */
+static void lmwv_report(CPUPPCState *env)
+{
+    fprintf(stderr, "lmw-inline-verify: cpu %d, %" PRIu64 " checked, %" PRIu64
+            " on I/O (not re-read), %" PRIu64 " divergent\n",
+            env_cpu(env)->cpu_index, env->lmwv_n, env->lmwv_io, env->lmwv_bad);
+}
+
+void helper_lmw_verify(CPUPPCState *env, target_ulong addr, uint32_t arg)
+{
+    uint32_t reg = arg & 31;
+    int mmu_idx = ppc_env_mmu_index(env, false);
+    void *host = tlb_vaddr_to_host(env, addr, MMU_DATA_LOAD, mmu_idx);
+
+    if (!host) {
+        env->lmwv_io++;
+        return;
+    }
+    for (uint32_t r = reg; r < 32; r++, host += 4) {
+        if ((uint32_t)env->gpr[r] != (uint32_t)ldl_be_p(host)) {
+            if (env->lmwv_bad++ < 20) {
+                fprintf(stderr, "lmw-inline-verify: DIVERGENCE %s r%u ea 0x"
+                        TARGET_FMT_lx " reg %08x mem %08x\n",
+                        arg & 0x100 ? "stmw" : "lmw", r, addr,
+                        (uint32_t)env->gpr[r], (uint32_t)ldl_be_p(host));
+            }
+            break;
+        }
+    }
+    if ((++env->lmwv_n & 0x3ffff) == 0) {
+        lmwv_report(env);
+    }
+}
