 /***                    Integer load and store multiple                    ***/
 
+/*
+ * POMPPC tcg/0032 (x-lmw-inline).  lmw/stmw of n <= PPC_LMW_INLINE_MAX
+ * registers (all of them: on x86-64 hosts the 19-register form of the
+ * prologues gains too, docs/tcg-g4.md section 32): if [EA, EA + 4n) lies in
+ * one page, n word accesses in the generated code, else the helper.  In one
+ * page every word goes through the same TLB entry: the first access faults
+ * (at EA, with the same access type) or none does -- the all-or-nothing of
+ * the helper, which probes the whole range first.  Same width, order and
+ * endianness as the helper's I/O path (cpu_ldl_mmu/cpu_stl_mmu, MO_UNALN),
+ * the RAM path being equivalent to it.  The page offset of EA does not wrap
+ * in 32-bit mode: EA + 4n stays in the page.  rA in the loaded range (an
+ * invalid form) is harmless: EA is in a temporary.
+ */
+#define PPC_LMW_INLINE_MAX 32
+
+static bool gen_lmw_inline(DisasContext *ctx, TCGv ea, int reg, bool store)
+{
+    int n = 32 - reg;
+    TCGLabel *l_helper, *l_done;
+    TCGv off, a;
+
+    if (!ctx->lmw_inline || n > PPC_LMW_INLINE_MAX) {
+        return false;
+    }
+    l_helper = gen_new_label();
+    l_done = gen_new_label();
+    off = tcg_temp_new();
+    a = tcg_temp_new();
+    tcg_gen_andi_tl(off, ea, ~TARGET_PAGE_MASK);
+    tcg_gen_brcondi_tl(TCG_COND_GTU, off, TARGET_PAGE_SIZE - 4 * n, l_helper);
+    for (int i = 0; i < n; i++) {
+        tcg_gen_addi_tl(a, ea, 4 * i);
+        if (store) {
+            tcg_gen_qemu_st_tl(cpu_gpr[reg + i], a, ctx->mem_idx,
+                               DEF_MEMOP(MO_UL | MO_UNALN));
+        } else {
+            tcg_gen_qemu_ld_tl(cpu_gpr[reg + i], a, ctx->mem_idx,
+                               DEF_MEMOP(MO_UL | MO_UNALN));
+        }
+    }
+    if (ctx->lmw_verify) {
+        gen_helper_lmw_verify(tcg_env, ea,
+                              tcg_constant_i32(reg | (store ? 0x100 : 0)));
+    }
+    tcg_gen_br(l_done);
+    gen_set_label(l_helper);
+    if (store) {
+        gen_helper_stmw(tcg_env, ea, tcg_constant_i32(reg));
+    } else {
+        gen_helper_lmw(tcg_env, ea, tcg_constant_i32(reg));
+    }
+    gen_set_label(l_done);
+    return true;
+}
+
