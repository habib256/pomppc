+/*
+ * POMPPC tcg/0041 (x-pteg-map).  The same search with the PTEG translated
+ * once: one address_space_translate for its 64 bytes instead of one per
+ * word (up to 16 here, 32 for both groups), then the words read from the
+ * host pointer, in the same order, with the same barrier.  ldl_phys on RAM
+ * is exactly ldl_be_p on that pointer (address_space_ldm_internal); a PTEG
+ * that is not directly accessible RAM (never under Mac OS X: the table is
+ * in RAM) falls back to the stock search.  R and C are still set by
+ * stb_phys, which keeps the dirty tracking of the page.
+ */
+static hwaddr ppc_hash32_pteg_search_map(PowerPCCPU *cpu, hwaddr pteg_off,
+                                         bool secondary, target_ulong ptem,
+                                         ppc_hash_pte32_t *pte)
+{
+    hwaddr addr = ppc_hash32_hpt_base(cpu) + pteg_off;
+    hwaddr xlat, len = HASH_PTEG_SIZE_32;
+    MemoryRegion *mr;
+    const uint8_t *p;
+    uint32_t pte0, pte1;
+
+    RCU_READ_LOCK_GUARD();
+    mr = address_space_translate(CPU(cpu)->as, addr, &xlat, &len, false,
+                                 MEMTXATTRS_UNSPECIFIED);
+    if (len < HASH_PTEG_SIZE_32 ||
+        !memory_access_is_direct(mr, false, MEMTXATTRS_UNSPECIFIED)) {
+        cpu->env.ptegm_slow++;
+        return ppc_hash32_pteg_search(cpu, pteg_off, secondary, ptem, pte);
+    }
+    p = qemu_map_ram_ptr(mr->ram_block, xlat);
+    for (int i = 0; i < HPTES_PER_GROUP; i++) {
+        pte0 = ldl_be_p(p + i * HASH_PTE_SIZE_32);
+        /* pte0 holds the valid bit and is read first, as above */
+        smp_rmb();
+        pte1 = ldl_be_p(p + i * HASH_PTE_SIZE_32 + HASH_PTE_SIZE_32 / 2);
+
+        if ((pte0 & HPTE32_V_VALID)
+            && (secondary == !!(pte0 & HPTE32_V_SECONDARY))
+            && HPTE32_V_COMPARE(pte0, ptem)) {
+            pte->pte0 = pte0;
+            pte->pte1 = pte1;
+            return pteg_off + i * HASH_PTE_SIZE_32;
+        }
+    }
+    return -1;
+}
+
+/*
+ * x-pteg-map-verify: the stock search done again and compared.  The guest
+ * may change the group between the two reads (another CPU writing a PTE):
+ * a mismatch is a divergence only if a second mapped search still
+ * disagrees with the stock one.
+ */
+static hwaddr ppc_hash32_pteg_search_verify(PowerPCCPU *cpu, hwaddr pteg_off,
+                                            bool secondary, target_ulong ptem,
+                                            ppc_hash_pte32_t *pte)
+{
+    CPUPPCState *env = &cpu->env;
+    ppc_hash_pte32_t a = { 0 }, b = { 0 };
+    hwaddr oa, ob;
+
+    oa = ppc_hash32_pteg_search_map(cpu, pteg_off, secondary, ptem, &a);
+    ob = ppc_hash32_pteg_search(cpu, pteg_off, secondary, ptem, &b);
+    env->ptegv_n++;
+    if (oa != ob || (oa != -1 && (a.pte0 != b.pte0 || a.pte1 != b.pte1))) {
+        oa = ppc_hash32_pteg_search_map(cpu, pteg_off, secondary, ptem, &a);
+        if (oa != ob || (oa != -1 && (a.pte0 != b.pte0 || a.pte1 != b.pte1))) {
+            env->ptegv_bad++;
+            fprintf(stderr, "x-pteg-map-verify: cpu %d DIVERGENCE pteg 0x%"
+                    HWADDR_PRIx " sec %d ptem 0x%x : map 0x%" HWADDR_PRIx
+                    " %08x %08x, stock 0x%" HWADDR_PRIx " %08x %08x\n",
+                    CPU(cpu)->cpu_index, pteg_off, secondary, (uint32_t)ptem,
+                    oa, a.pte0, a.pte1, ob, b.pte0, b.pte1);
+        } else {
+            env->ptegv_race++;
+        }
+    }
+    if ((env->ptegv_n & ((1u << 22) - 1)) == 0) {
+        fprintf(stderr, "x-pteg-map-verify: cpu %d %" PRIu64 " searches, %"
+                PRIu64 " divergences, %" PRIu64 " races, %" PRIu64
+                " not RAM\n", CPU(cpu)->cpu_index, env->ptegv_n,
+                env->ptegv_bad, env->ptegv_race, env->ptegm_slow);
+    }
+    *pte = b;
+    return ob;
+}
