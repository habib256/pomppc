+/* POMPPC tcg/0064 (x-tb-head): counters, printed at exit */
+static uint64_t tbh_count[TBH_N];
+static bool tbh_atexit;
+
+static void tbh_report(void)
+{
+    fprintf(stderr, "tb-head: x-tb-head=%u ; accès d'E/S : %" PRIu64
+            " par la dernière instruction de leur bloc, %" PRIu64
+            " au milieu (recompilés), %" PRIu64 " hors bloc, %" PRIu64
+            " instruction introuvable ; chaînages : %" PRIu64
+            " vers l'avant (après la vérification), %" PRIu64
+            " vers l'arrière ; vérification : %" PRIu64 " identiques, %"
+            PRIu64 " DIVERGENCES\n", tcg_tb_head,
+            qatomic_read(&tbh_count[TBH_IO_LAST]),
+            qatomic_read(&tbh_count[TBH_IO_MID]),
+            qatomic_read(&tbh_count[TBH_IO_OUT]),
+            qatomic_read(&tbh_count[TBH_IO_NOFIND]),
+            qatomic_read(&tbh_count[TBH_LINK_FWD]),
+            qatomic_read(&tbh_count[TBH_LINK_BACK]),
+            qatomic_read(&tbh_count[TBH_VERIFY_OK]),
+            qatomic_read(&tbh_count[TBH_VERIFY_BAD]));
+}
+
+void pomppc_tb_head_bad(CPUState *cpu, uintptr_t retaddr, bool derived)
+{
+    pomppc_tb_head_stat(TBH_VERIFY_BAD);
+    if (qatomic_read(&tbh_count[TBH_VERIFY_BAD]) <= 8) {
+        TranslationBlock *tb = retaddr ? tcg_tb_lookup(retaddr) : NULL;
+        fprintf(stderr, "tb-head: DIVERGENCE cpu %d : can_do_io rangé %d,"
+                " déduit %d, retaddr %p, bloc pc 0x%" VADDR_PRIx
+                " (%u instructions)\n", cpu->cpu_index, cpu->neg.can_do_io,
+                derived, (void *)retaddr, tb ? tb->pc : 0,
+                tb ? tb->icount : 0);
+    }
+}
+
+void pomppc_tb_head_stat(int what)
+{
+    if (!qatomic_read(&tbh_atexit) && !qatomic_xchg(&tbh_atexit, true)) {
+        atexit(tbh_report);
+    }
+    qatomic_inc(&tbh_count[what]);
+}
