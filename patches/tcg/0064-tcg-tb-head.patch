+/*
+ * POMPPC tcg/0064 (x-tb-head, TB_HEAD_CDIO): the value can_do_io would have
+ * when an I/O access returns to retaddr.  The TB stores false before its
+ * first insn (if it has more than one) and true before its last one; outside
+ * of a TB, cpu_exec leaves it true.  So: true unless retaddr is in a TB, at
+ * an insn that is not its last.  A retaddr inside a TB but outside of its
+ * insns (none is known: the slow paths pass the return address of the fast
+ * path) counts as "can do": the recompile would not find the insn either.
+ */
+bool cpu_io_last_insn(CPUState *cpu, uintptr_t retaddr)
+{
+    TranslationBlock *tb;
+    uintptr_t off;
+    bool last;
+
+    if (!retaddr) {
+        pomppc_tb_head_stat(TBH_IO_OUT);
+        return true;
+    }
+    tb = tcg_tb_lookup(retaddr);
+    if (!tb) {
+        pomppc_tb_head_stat(TBH_IO_OUT);
+        return true;
+    }
+    /* as cpu_unwind_data_from_tb: the insn whose code contains retaddr - 2 */
+    off = retaddr - GETPC_ADJ - (uintptr_t)tb->tc.ptr;
+    last = off >= tb->last_insn_off;
+    if (unlikely(tcg_tb_head_mutant == 2)) {
+        last = off < tb->last_insn_off;     /* épreuve : la règle à l'envers */
+    }
+    pomppc_tb_head_stat(last ? TBH_IO_LAST : TBH_IO_MID);
+    return last;
+}
