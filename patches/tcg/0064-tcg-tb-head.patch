+
+static void tcg_set_tb_head(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+    if (value > (TB_HEAD_CDIO | TB_HEAD_FWD | TB_HEAD_VERIFY)) {
+        error_setg(errp, "x-tb-head must be between 0 and 7");
+        return;
+    }
+    if (tb_jmp_cache_bits_frozen && value != tcg_tb_head) {
+        error_setg(errp, "x-tb-head cannot change once a CPU exists");
+        return;
+    }
+    tcg_tb_head = value;
+}
