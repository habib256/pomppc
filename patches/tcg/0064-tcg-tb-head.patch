+/*
+ * POMPPC tcg/0064 (x-tb-head, accelerator property, fixed before the first
+ * CPU; forced to 0 under icount).  A lighter TB head
+ * (docs/anatomie-ppc32.md):
+ *   TB_HEAD_CDIO  no can_do_io stores in the TBs (two byte stores per TB):
+ *                 io_prepare() derives it from the return address instead,
+ *                 true exactly when the access is made by the last guest
+ *                 insn of its TB (or from outside any TB), i.e. the value the
+ *                 stores would have left.
+ *   TB_HEAD_FWD   a goto_tb towards a TB of HIGHER pc is chained past the
+ *                 target's exit-request check (icount_decr, 3 host insns).
+ *                 Every cycle of chained TBs contains an edge to a lower or
+ *                 equal pc, which still checks; indirect entries (goto_ptr,
+ *                 inline jump cache) and the main loop enter at tc.ptr.
+ *                 Pending interrupts and exit requests are seen at most one
+ *                 forward chain later.
+ *   TB_HEAD_VERIFY  (épreuve) the stores are kept and every I/O access
+ *                 compares the derived value with the stored one.
+ */
+#define TB_HEAD_CDIO   1u
+#define TB_HEAD_FWD    2u
+#define TB_HEAD_VERIFY 4u   /* keep the stores, compare with the derived value */
+extern unsigned tcg_tb_head;
+extern int tcg_tb_head_mutant;      /* POMPPC_TBHEAD_MUTANT, épreuves */
+#ifndef CONFIG_USER_ONLY
+bool cpu_io_last_insn(CPUState *cpu, uintptr_t retaddr);
+#endif
+void pomppc_tb_head_stat(int what);
+void pomppc_tb_head_bad(CPUState *cpu, uintptr_t retaddr, bool derived);
+#define TBH_IO_LAST   0
+#define TBH_IO_MID    1
+#define TBH_IO_OUT    2
+#define TBH_IO_NOFIND 3
+#define TBH_LINK_FWD  4
+#define TBH_LINK_BACK 5
+#define TBH_VERIFY_OK 6
+#define TBH_VERIFY_BAD 7
+#define TBH_N         8
+
 void tb_phys_invalidate(TranslationBlock *tb, tb_page_addr_t page_addr);
 void tb_set_jmp_target(TranslationBlock *tb, int n, uintptr_t addr);
 
