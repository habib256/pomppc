     g_string_append(g, " lmwh");
     for (int i = 0; i < 32; i++) {
         g_string_append_printf(g, " %u", env->ms_lmw_hist[i]);
@@ -1879,6 +1889,7 @@ bool ppc_cpu_tlb_fill(CPUState *cs, vaddr eaddr, int size,
     uint64_t t0 = 0;
 
     if (unlikely(cpu->env.mem_stats)) {
+        cs->tlb_miss_stats = true;      /* POMPPC tcg/0042 */
         if ((cpu->env.ms[PPC_MS_FILL0 + (mmu_idx & 3)] & 1023) == 0) {
             ppc_mem_stats_tick(&cpu->env);
         }
