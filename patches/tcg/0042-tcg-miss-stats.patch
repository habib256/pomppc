                            cs->neg.tlb.c.dw_idx, cs->neg.tlb.c.dw_ent);
+    /* POMPPC tcg/0042: misses of mmu_idx 0-3, then reset with the window */
+    for (int i = 0; i < 4; i++) {
+        CPUTLBCommon *c = &cs->neg.tlb.c;
+
+        g_string_append_printf(g, " miss%d %" PRIu64 " %" PRIu64 " %" PRIu64
