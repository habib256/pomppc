+/*
+ * x-fp-flat (POMPPC patches/tcg/0013, docs/tcg-g4.md section 22).
+ *
+ * x-fp-inline (above) needs one branch per instruction in the generated
+ * code: "short path or original sequence".  That branch ends a TCG basic
+ * block, so every guest register held in a host register is written back
+ * and read again at every fadds/fmadds/fcmpu -- measured: about 1 ns per
+ * instruction when they come in a row.  x-fp-flat emits one call and no
+ * branch; the choice is made here, in C:
+ *
+ *   short path  exactly the x-fp-inline one: fpi_gate(), helper_fp32_fast(),
+ *               fpi_fpscr_arith() (fpi_fcmpu(), fpi_fpscr_fcmpu() for fcmpu),
+ *               soft-fp flags = inexact;
+ *   otherwise   the original sequence, in the same order, with the return
+ *               address of the generated code: reset_fpstatus, the helper,
+ *               frT written, fprf_check_float64 (fcmpu: reset_fpstatus,
+ *               fcmpu, float_check_status).
+ *
+ * The helper is TCG_CALL_NO_WG: TCG writes the dirty globals back before
+ * the call (the original sequence may raise a deferred FP exception, which
+ * needs them) and keeps its copies after it.  It writes no global as far as
+ * TCG can tell: the new FPSCR (and the CR field of fcmpu) is returned, and
+ * the generated code assigns it.  The original sequence does write
+ * env->fpscr (and env->crf[bf]) in memory -- with the very value returned,
+ * so TCG's view stays consistent.  frT is written here too before
+ * float_check_status, as in the original sequence, where a deferred
+ * exception is raised after the target FPR update.
+ */
+static uint64_t fpf_slow(CPUPPCState *env, uint32_t op, uint64_t a,
+                         uint64_t b, uint64_t c, uintptr_t ra)
+{
+    float64 r;
+
+    switch (op) {
+    case FPI_ADD:
+        r = float64r32_add(a, b, &env->fp_status);
+        addsub_flags_handler(env, get_float_exception_flags(&env->fp_status),
+                             ra);
+        return r;
+    case FPI_SUB:
+        r = float64r32_sub(a, b, &env->fp_status);
+        addsub_flags_handler(env, get_float_exception_flags(&env->fp_status),
+                             ra);
+        return r;
+    case FPI_MUL:
+        r = float64r32_mul(a, c, &env->fp_status);
+        mul_flags_handler(env, get_float_exception_flags(&env->fp_status), ra);
+        return r;
+    case FPI_MADD:
+        return do_fmadds(env, a, c, b, MADD_FLGS, ra);
+    case FPI_MSUB:
+        return do_fmadds(env, a, c, b, MSUB_FLGS, ra);
+    case FPI_NMADD:
+        return do_fmadds(env, a, c, b, NMADD_FLGS, ra);
+    default:
+        return do_fmadds(env, a, c, b, NMSUB_FLGS, ra);
+    }
+}
+
+static Int128 fp32_flat(CPUPPCState *env, uint64_t a, uint64_t b, uint64_t c,
+                        uint64_t fpscr, uint32_t op, uint32_t frt,
+                        uintptr_t ra)
+{
+    uint64_t r;
+
+    if (fpi_gate(fpscr)) {
+        r = helper_fp32_fast(a, b, c, op);
+        if (r != FPI_FAIL) {
+            uint64_t nf = fpi_fpscr_arith(fpscr, r);
+
+            if (unlikely(env->fp_verify)) {
+                helper_fpv_arith(env, op, a, b, c, r, nf);
+                env->fpscr = fpscr;
+            }
+            set_float_exception_flags(float_flag_inexact, &env->fp_status);
+            return int128_make128(r, nf);
+        }
+    }
+    if (unlikely(env->fp_verify)) {
+        helper_fpv_slow(env, op, a, b, c, fpscr);
+    }
+    helper_reset_fpstatus(env);
+    r = fpf_slow(env, op, a, b, c, ra);
+    *cpu_fpr_ptr(env, frt) = r;
+    helper_compute_fprf_float64(env, r);
+    do_float_check_status(env, true, ra);
+    return int128_make128(r, env->fpscr);
+}
+
+/*
+ * fpscr == env->fpscr (TCG_CALL_NO_WG: the globals are synced before the
+ * call); passed in a register so that the short path reads no memory.
+ * sel = op | frT << 8.
+ */
+Int128 helper_fp32_flat(CPUPPCState *env, uint64_t a, uint64_t b, uint64_t c,
+                        uint64_t fpscr, uint32_t sel)
+{
+    return fp32_flat(env, a, b, c, fpscr, sel & 0xff, sel >> 8, GETPC());
+}
+
+/* fcmpu: returns (CR field, FPSCR) */
+static Int128 fcmpu_flat(CPUPPCState *env, uint64_t a, uint64_t b,
+                         uint64_t fpscr, uint32_t bf, uintptr_t ra)
+{
+    uint32_t crf = fpi_fcmpu(fpscr, a, b);
+
+    if (crf) {
+        uint64_t nf = fpi_fpscr_fcmpu(fpscr, crf);
+
+        if (unlikely(env->fp_verify)) {
+            helper_fpv_fcmpu(env, bf, a, b, crf, nf);
+            env->fpscr = fpscr;
+        }
+        set_float_exception_flags(float_flag_inexact, &env->fp_status);
+        return int128_make128(crf, nf);
+    }
+    if (unlikely(env->fp_verify)) {
+        helper_fpv_slow(env, FPI_CMPU, a, b, 0, fpscr);
+    }
+    helper_reset_fpstatus(env);
+    do_fcmpu(env, a, b, bf, ra);
+    do_float_check_status(env, true, ra);
+    return int128_make128(env->crf[bf], env->fpscr);
+}
+
+Int128 helper_fcmpu_flat(CPUPPCState *env, uint64_t a, uint64_t b,
+                         uint64_t fpscr, uint32_t bf)
+{
+    return fcmpu_flat(env, a, b, fpscr, bf, GETPC());
+}
