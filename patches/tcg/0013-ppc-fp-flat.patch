+/*
+ * x-fp-flat (POMPPC tcg/0013): the same instructions as one call and no
+ * branch; helper_fp32_flat() of fpu_helper.c chooses between the short path
+ * and the original sequence, and returns (frT, FPSCR).
+ */
+static bool do_fp_flat(DisasContext *ctx, int op, int frt, int fra, int frb,
+                       int frc, bool rc)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_constant_i64(0);
+    TCGv_i64 c = tcg_constant_i64(0);
+    TCGv_i64 r = tcg_temp_new_i64();
+    TCGv_i64 f = tcg_temp_new_i64();
+    TCGv_i128 ret = tcg_temp_new_i128();
+
+    REQUIRE_INSNS_FLAGS(ctx, FLOAT);
+    REQUIRE_FPU(ctx);
+
+    tcg_gen_extu_tl_i64(f, cpu_fpscr);
+    get_fpr(a, fra);
+    if (op == FPI_ADD || op == FPI_SUB || op >= FPI_MADD) {
+        b = tcg_temp_new_i64();
+        get_fpr(b, frb);
+    }
+    if (op >= FPI_MUL) {
+        c = tcg_temp_new_i64();
+        get_fpr(c, frc);
+    }
+    gen_helper_fp32_flat(ret, tcg_env, a, b, c, f,
+                         tcg_constant_i32(op | frt << 8));
+    tcg_gen_extr_i128_i64(r, f, ret);
+    set_fpr(frt, r);
+    tcg_gen_trunc_i64_tl(cpu_fpscr, f);
     if (unlikely(rc)) {
         gen_set_cr1_from_fpscr(ctx);
     }
     return true;
+}
+
+static void gen_fcmpu_flat(DisasContext *ctx)
+{
+    int bf = crfD(ctx->opcode);
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 crf = tcg_temp_new_i64();
+    TCGv_i64 f = tcg_temp_new_i64();
+    TCGv_i128 ret = tcg_temp_new_i128();
+
+    get_fpr(a, rA(ctx->opcode));
+    get_fpr(b, rB(ctx->opcode));
+    tcg_gen_extu_tl_i64(f, cpu_fpscr);
+    gen_helper_fcmpu_flat(ret, tcg_env, a, b, f, tcg_constant_i32(bf));
+    tcg_gen_extr_i128_i64(crf, f, ret);
+    tcg_gen_extrl_i64_i32(cpu_crf[bf], crf);
+    tcg_gen_trunc_i64_tl(cpu_fpscr, f);
 }
 
