+/*
+ * POMPPC tcg/0010.  Write-protect a page before its code is read by the
+ * translator (called with @pd locked).  A page without TBs is not
+ * protected: another vCPU may store to it through a TLB entry without
+ * TLB_NOTDIRTY.  If the protection were only set when the TB is linked
+ * (tb_page_add), a store
+ * landing between the translator's read of the guest code and the link
+ * would never be seen, and the stale TB would stay valid until the next
+ * write to the page.  Protecting first makes every later store take the
+ * notdirty path, which blocks on the page lock held here and invalidates
+ * the new TB once it is linked.
+ */
+static void tb_page_protect_locked(PageDesc *pd, tb_page_addr_t paddr)
+{
+    if (!pd->first_tb) {
+        tlb_protect_code(paddr & TARGET_PAGE_MASK);
+    }
+}
+
 void tb_lock_page0(tb_page_addr_t paddr)
 {
-    page_lock(page_find_alloc(paddr >> TARGET_PAGE_BITS, true));
+    PageDesc *pd = page_find_alloc(paddr >> TARGET_PAGE_BITS, true);
+
+    page_lock(pd);
+    tb_page_protect_locked(pd, paddr);
 }
 
 void tb_lock_page1(tb_page_addr_t paddr0, tb_page_addr_t paddr1)
@@ -418,11 +441,13 @@ void tb_lock_page1(tb_page_addr_t paddr0, tb_page_addr_t paddr1)
     if (pindex0 < pindex1) {
         /* Correct locking order, we may block. */
         page_lock(pd1);
+        tb_page_protect_locked(pd1, paddr1);
         return;
     }
 
     /* Incorrect locking order, we cannot block lest we deadlock. */
     if (!page_trylock(pd1)) {
+        tb_page_protect_locked(pd1, paddr1);
         return;
     }
 
@@ -434,6 +459,9 @@ void tb_lock_page1(tb_page_addr_t paddr0, tb_page_addr_t paddr1)
     page_unlock(pd0);
     page_lock(pd1);
     page_lock(pd0);
+    /* page0 was unlocked: a store may have unprotected it meanwhile */
+    tb_page_protect_locked(pd1, paddr1);
+    tb_page_protect_locked(pd0, paddr0);
     siglongjmp(tcg_ctx->jmp_trans, -3);
 }
 
@@ -1193,6 +1221,70 @@ void tb_invalidate_phys_range(tb_page_addr_t start, tb_page_addr_t last)
     page_collection_unlock(pages);
 }
 
+/*
+ * POMPPC tcg/0010.  Invalidate the TBs that overlap [@start, @last] (one
+ * page), for an instruction-cache synchronisation of the guest (PowerPC
+ * icbi, x-icbi-sync).
+ *
+ * A store to a page holding code invalidates the TBs of the written bytes
+ * *before* the store is performed (notdirty_write).  With MTTCG another
+ * vCPU can translate the old bytes in between and link a TB that no later
+ * store has invalidated yet: the guest's own synchronisation (dcbst, sync,
+ * icbi, isync, then a flag) does not help, the stale TB stays valid until
+ * the next store to those bytes.  icbi comes after the store in program
+ * order: invalidating here closes the window.  The overlap is tested with
+ * the page lock held, so a translation in progress (it holds the lock from
+ * before it reads the code until the TB is linked) is waited for; a
+ * translation that starts after reads the new bytes.  Returns true if TBs
+ * were invalidated.
+ *
+ * Fast path (almost every icbi, e.g. the kernel's after a page-in): a page
+ * whose DIRTY_MEMORY_CODE bit is set holds no TB (the bit is cleared under
+ * the page lock before a TB is linked, and set only once the page has none),
+ * and a translation that has not cleared it yet will read our stores: the
+ * translator clears the bit before it reads the code, and the barrier below
+ * orders our stores before our read of the bit.
+ */
+bool tb_invalidate_phys_line_sync(tb_page_addr_t start, tb_page_addr_t last)
+{
+    PageDesc *pd;
+    TranslationBlock *tb;
+    PageForEachNext n;
+    bool hit = false;
+
+    tcg_debug_assert(((start ^ last) & TARGET_PAGE_MASK) == 0);
+    smp_mb();
+    if (cpu_physical_memory_get_dirty_flag(start, DIRTY_MEMORY_CODE)) {
+        return false;
+    }
+    pd = page_find(start >> TARGET_PAGE_BITS);
+    if (!pd) {
+        return false;
+    }
+    page_lock(pd);
+    PAGE_FOR_EACH_TB(start, last, pd, tb, n) {
+        tb_page_addr_t tb_start = tb_page_addr0(tb);
+        tb_page_addr_t tb_last = tb_start + tb->size - 1;
+
+        if (n == 0) {
+            tb_last = MIN(tb_last, tb_start | ~TARGET_PAGE_MASK);
+        } else {
+            tb_start = tb_page_addr1(tb);
+            tb_last = tb_start + (tb_last & ~TARGET_PAGE_MASK);
+        }
+        if (!(tb_last < start || tb_start > last)) {
+            hit = true;
+            break;
+        }
+    }
+    page_unlock(pd);
+    if (hit) {
+        /* takes the locks of every page of the TBs found, in order */
+        tb_invalidate_phys_range(start, last);
+    }
+    return hit;
+}
+
 /*
  * Call with all @pages in the range [@start, @start + len[ locked.
  */
