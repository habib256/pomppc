diff --git a/tcg/x86_64/tcg-target.c.inc b/tcg/x86_64/tcg-target.c.inc
index 1fc45e4..79af8cd 100644
--- a/tcg/x86_64/tcg-target.c.inc
+++ b/tcg/x86_64/tcg-target.c.inc
@@ -1875,6 +1875,395 @@ static bool tcg_out_qemu_st_slow_path(TCGContext *s, TCGLabelQemuLdst *l)
     return true;
 }
 
+#if TCG_TARGET_PPC_FP32_IMPL
+/*
+ * POMPPC tcg/0017 (x-fp-native, x-fp-native64 on x86_64 hosts):
+ * INDEX_op_ppc_fp32, as tcg/aarch64 (tcg/0014, 0016) does it.
+ *
+ * The short path of x-fp-inline (target/ppc/fpu_helper.c, fpi_fp32() and
+ * fpi_fp64()) done by the host FPU inline: VEX scalar SSE and FMA3, round to
+ * nearest-even, no DAZ/FTZ (QEMU leaves MXCSR at its default).  Each test of
+ * that short path is a jcc to an out-of-line stub that calls the C helper
+ * given by the op (the whole x-fp-flat helper: short path or original
+ * sequence), as the qemu_ld/st slow paths do.  The op is
+ * TCG_OPF_CALL_CLOBBER: no live value is left in a call-clobbered register,
+ * so the call-clobbered GPRs that hold no argument, the two outputs before
+ * they are written and XMM0-XMM3 are free scratch here.  SysV only: at most
+ * six of its nine call-clobbered GPRs hold an argument, two are left.
+ *
+ * PowerPC FPSCR bits (QEMU numbering, target/ppc/cpu.h; the translator
+ * checks them at build time): XX = 25, XE = 3, UE = 5, OE = 6, RN = 1:0,
+ * FPRF = 16:12 (FPCC = 15:12), FI = 17.
+ */
+#define PFP_XX          (1u << 25)
+#define PFP_TRAPS       ((1u << 3) | (1u << 5) | (1u << 6))
+#define PFP_FI          (1u << 17)
+
+enum { PFP_ADD, PFP_SUB, PFP_MUL, PFP_MADD, PFP_MSUB, PFP_NMADD, PFP_NMSUB,
+       PFP_CMPU,
+       PFP_D = 8 };     /* PFP_D + PFP_ADD..PFP_NMSUB: the double forms */
+
+/* VEX.LIG scalar forms; P_SIMDF2 (single) becomes P_SIMDF3 for double */
+#define PFP_VADDSS      (0x58 | P_EXT | P_SIMDF3)
+#define PFP_VSUBSS      (0x5c | P_EXT | P_SIMDF3)
+#define PFP_VMULSS      (0x59 | P_EXT | P_SIMDF3)
+#define PFP_VCVTSD2SS   (0x5a | P_EXT | P_SIMDF2)
+#define PFP_VCVTSS2SD   (0x5a | P_EXT | P_SIMDF3)
+#define PFP_VFMADD231   (0xb9 | P_EXT38 | P_DATA16)     /* | P_VEXW: sd */
+#define PFP_VFMSUB231   (0xbb | P_EXT38 | P_DATA16)
+
+/* the scalar op of the double form: same opcode, 0xf2 instead of 0xf3 */
+static int pfp_dbl(int opc, bool dbl)
+{
+    return dbl ? (opc & ~P_SIMDF3) | P_SIMDF2 : opc;
+}
+
+static TCGReg pfp_scratch(TCGRegSet *used)
+{
+    for (TCGReg r = TCG_REG_EAX; r <= TCG_REG_R15; r++) {
+        if (tcg_regset_test_reg(tcg_target_call_clobber_regs, r) &&
+            !tcg_regset_test_reg(*used, r)) {
+            tcg_regset_set_reg(*used, r);
+            return r;
+        }
+    }
+    g_assert_not_reached();
+}
+
+/* jcc rel32 to the stub, patched by tcg_out_ppc_fp32_slow_path() */
+static void pfp_jslow(TCGContext *s, TCGLabelQemuLdst *l, int jcc)
+{
+    tcg_debug_assert(l->fp_njmp < ARRAY_SIZE(l->fp_jmp));
+    if (jcc == JCC_JMP) {
+        tcg_out8(s, OPC_JMP_long);
+    } else {
+        tcg_out_opc(s, OPC_JCC_long + jcc, 0, 0, 0);
+    }
+    l->fp_jmp[l->fp_njmp++] = s->code_ptr;
+    s->code_ptr += 4;
+}
+
+/* short forward jcc, resolved by pfp_here() */
+static tcg_insn_unit *pfp_jshort(TCGContext *s, int jcc)
+{
+    tcg_out8(s, OPC_JCC_short + jcc);
+    s->code_ptr += 1;
+    return s->code_ptr - 1;
+}
+
+static void pfp_here(TCGContext *s, tcg_insn_unit *p)
+{
+    ptrdiff_t d = s->code_ptr - p - 1;
+
+    tcg_debug_assert(d >= 0 && d <= 127);
+    *p = d;
+}
+
+static void pfp_mov(TCGContext *s, TCGReg d, TCGReg n)
+{
+    tcg_out_mov(s, TCG_TYPE_I64, d, n);
+}
+
+/* t = x << 1 (sets ZF: x is a zero) */
+static void pfp_shl1(TCGContext *s, TCGReg t, TCGReg x)
+{
+    pfp_mov(s, t, x);
+    tgen_arithr(s, ARITH_ADD + P_REXW, t, t);
+}
+
+static void pfp_cmpr(TCGContext *s, TCGReg a, TCGReg b)
+{
+    tgen_arithr(s, ARITH_CMP + P_REXW, a, b);
+}
+
+static void pfp_cmov(TCGContext *s, int jcc, TCGReg d, TCGReg n)
+{
+    tcg_out_modrm(s, OPC_CMOVCC | jcc | P_REXW, d, n);
+}
+
+/*
+ * One operand x, a float32 zero or normal held as a double (fpi_zon()):
+ * t = x << 1 == 0, or its low 29 fraction bits zero and its exponent in
+ * [0x381, 0x47e].  Double forms (fpi_zon64()): t == 0, or an exponent in
+ * [1, 0x7fe].
+ */
+static void pfp_zon(TCGContext *s, TCGLabelQemuLdst *l, bool dbl, TCGReg x,
+                    TCGReg t, TCGReg u)
+{
+    tcg_insn_unit *ok;
+
+    pfp_shl1(s, t, x);
+    ok = pfp_jshort(s, JCC_JE);
+    if (!dbl) {
+        tcg_out_modrm(s, OPC_GRP3_Ev + P_REXW, EXT3_TESTi, t);
+        tcg_out32(s, 0x3ffffffe);                       /* low 29 bits */
+        pfp_jslow(s, l, JCC_JNE);
+    }
+    pfp_mov(s, u, t);
+    tcg_out_shifti(s, SHIFT_SHR + P_REXW, u, 53);       /* exponent */
+    tgen_arithi(s, ARITH_SUB, u, dbl ? 1 : 0x381, 0);
+    tgen_arithi(s, ARITH_CMP, u, dbl ? 0x7fe : 0xfe, 0);
+    pfp_jslow(s, l, JCC_JAE);
+    pfp_here(s, ok);
+}
+
+/* vmovq xmm, r64 / vmovq r64, xmm */
+static void pfp_movq_xr(TCGContext *s, TCGReg x, TCGReg r)
+{
+    tcg_out_vex_modrm(s, OPC_MOVD_VyEy | P_VEXW, x, 0, r);
+}
+
+static void pfp_movq_rx(TCGContext *s, TCGReg r, TCGReg x)
+{
+    tcg_out_vex_modrm(s, OPC_MOVD_EyVy | P_VEXW, x, 0, r);
+}
+
+static void tcg_out_ppc_fp32(TCGContext *s, const TCGArg *args)
+{
+    TCGReg xr = args[0], xnf = args[1];
+    TCGReg xa = args[2], xb = args[3], xc = args[4], xf = args[5];
+    unsigned sel = args[6], op = sel & 0xff;
+    uint64_t fst = args[8];
+    TCGRegSet used = 0;
+    TCGLabelQemuLdst *l = new_ldst_label(s);
+    TCGReg t, u;
+
+    l->is_ppc_fp32 = true;
+    l->fp_sel = sel;
+    l->fp_in[0] = xa;
+    l->fp_in[1] = xb;
+    l->fp_in[2] = xc;
+    l->fp_out[0] = xr;
+    l->fp_out[1] = xnf;
+    l->fp_slow = (const void *)args[7];
+
+    tcg_regset_set_reg(used, xr);
+    tcg_regset_set_reg(used, xnf);
+    tcg_regset_set_reg(used, xa);
+    tcg_regset_set_reg(used, xb);
+    tcg_regset_set_reg(used, xc);
+    tcg_regset_set_reg(used, xf);
+    t = pfp_scratch(&used);
+    u = pfp_scratch(&used);
+
+    /* the gate: XX = 1, XE = OE = UE = 0 (and RN = 00 but for fcmpu) */
+    pfp_mov(s, t, xf);
+    tgen_arithi(s, ARITH_AND + P_REXW, t,
+                PFP_XX | PFP_TRAPS | (op == PFP_CMPU ? 0 : 3), 0);
+    tgen_arithi(s, ARITH_CMP + P_REXW, t, PFP_XX, 0);
+    pfp_jslow(s, l, JCC_JNE);
+
+    if (op == PFP_CMPU) {
+        /*
+         * fpi_fcmpu(): no NaN (magnitude > 0x7ff0...), then a signed
+         * comparison of sign-magnitude turned into two's complement.
+         * t = |a|, xnf = |b|, u = infinity, then scratch.
+         */
+        pfp_shl1(s, t, xa);
+        tcg_out_shifti(s, SHIFT_SHR + P_REXW, t, 1);
+        pfp_shl1(s, xnf, xb);
+        tcg_out_shifti(s, SHIFT_SHR + P_REXW, xnf, 1);
+        tcg_out_movi(s, TCG_TYPE_I64, u, 0x7ff0000000000000ull);
+        pfp_cmpr(s, t, u);
+        pfp_jslow(s, l, JCC_JA);
+        pfp_cmpr(s, xnf, u);
+        pfp_jslow(s, l, JCC_JA);
+        pfp_mov(s, u, t);
+        tcg_out_modrm(s, OPC_GRP3_Ev + P_REXW, EXT3_NEG, u);
+        tcg_out_modrm(s, OPC_TESTL + P_REXW, xa, xa);
+        pfp_cmov(s, JCC_JS, t, u);
+        pfp_mov(s, u, xnf);
+        tcg_out_modrm(s, OPC_GRP3_Ev + P_REXW, EXT3_NEG, u);
+        tcg_out_modrm(s, OPC_TESTL + P_REXW, xb, xb);
+        pfp_cmov(s, JCC_JS, xnf, u);
+        /* r = 2 (eq), 4 (gt), 8 (lt); movi of a non-zero leaves the flags */
+        tcg_out_movi(s, TCG_TYPE_I64, xr, 2);
+        tcg_out_movi(s, TCG_TYPE_I64, u, 4);
+        pfp_cmpr(s, t, xnf);
+        pfp_cmov(s, JCC_JG, xr, u);
+        tcg_out_movi(s, TCG_TYPE_I64, u, 8);
+        pfp_cmov(s, JCC_JL, xr, u);
+        /* fpi_fpscr_fcmpu(): FPCC = crf, FI = 1 */
+        pfp_mov(s, u, xr);
+        tcg_out_shifti(s, SHIFT_SHL + P_REXW, u, 12);
+        pfp_mov(s, xnf, xf);
+        tgen_arithi(s, ARITH_AND + P_REXW, xnf, ~(tcg_target_long)0xf000, 0);
+        tgen_arithr(s, ARITH_OR + P_REXW, xnf, u);
+        tgen_arithi(s, ARITH_OR + P_REXW, xnf, PFP_FI, 0);
+    } else {
+        bool dbl = op >= PFP_D;
+        unsigned base = dbl ? op - PFP_D : op;
+        bool use_b = base != PFP_MUL;
+        bool use_c = base >= PFP_MUL;
+        TCGReg vr;
+        tcg_insn_unit *ok;
+
+        /* operands: fpi_zon() / fpi_zon64() */
+        pfp_zon(s, l, dbl, xa, t, u);
+        if (use_b) {
+            pfp_zon(s, l, dbl, xb, t, u);
+        }
+        if (use_c) {
+            pfp_zon(s, l, dbl, xc, t, u);
+        }
+
+        /* the operation, as fpi_fp32() (float32) or fpi_fp64() */
+        pfp_movq_xr(s, TCG_REG_XMM0, xa);
+        if (!dbl) {
+            tcg_out_vex_modrm(s, PFP_VCVTSD2SS, TCG_REG_XMM0, TCG_REG_XMM0,
+                              TCG_REG_XMM0);
+        }
+        if (use_b) {
+            pfp_movq_xr(s, TCG_REG_XMM1, xb);
+            if (!dbl) {
+                tcg_out_vex_modrm(s, PFP_VCVTSD2SS, TCG_REG_XMM1,
+                                  TCG_REG_XMM1, TCG_REG_XMM1);
+            }
+        }
+        if (use_c) {
+            pfp_movq_xr(s, TCG_REG_XMM2, xc);
+            if (!dbl) {
+                tcg_out_vex_modrm(s, PFP_VCVTSD2SS, TCG_REG_XMM2,
+                                  TCG_REG_XMM2, TCG_REG_XMM2);
+            }
+        }
+        switch (base) {
+        case PFP_ADD:
+            tcg_out_vex_modrm(s, pfp_dbl(PFP_VADDSS, dbl), TCG_REG_XMM3,
+                              TCG_REG_XMM0, TCG_REG_XMM1);
+            vr = TCG_REG_XMM3;
+            break;
+        case PFP_SUB:
+            tcg_out_vex_modrm(s, pfp_dbl(PFP_VSUBSS, dbl), TCG_REG_XMM3,
+                              TCG_REG_XMM0, TCG_REG_XMM1);
+            vr = TCG_REG_XMM3;
+            break;
+        case PFP_MUL:
+            tcg_out_vex_modrm(s, pfp_dbl(PFP_VMULSS, dbl), TCG_REG_XMM3,
+                              TCG_REG_XMM0, TCG_REG_XMM2);
+            vr = TCG_REG_XMM3;
+            break;
+        case PFP_MADD:
+        case PFP_NMADD:
+            /* xmm1 = a * c + b, one rounding */
+            tcg_out_vex_modrm(s, PFP_VFMADD231 | (dbl ? P_VEXW : 0),
+                              TCG_REG_XMM1, TCG_REG_XMM0, TCG_REG_XMM2);
+            vr = TCG_REG_XMM1;
+            break;
+        case PFP_MSUB:
+        case PFP_NMSUB:
+            /* xmm1 = a * c - b, one rounding: the same as a * c + -b */
+            tcg_out_vex_modrm(s, PFP_VFMSUB231 | (dbl ? P_VEXW : 0),
+                              TCG_REG_XMM1, TCG_REG_XMM0, TCG_REG_XMM2);
+            vr = TCG_REG_XMM1;
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        if (!dbl) {
+            tcg_out_vex_modrm(s, PFP_VCVTSS2SD, vr, vr, vr);
+        }
+        pfp_movq_rx(s, xr, vr);
+        if (base == PFP_NMADD || base == PFP_NMSUB) {
+            /* after rounding, zero included */
+            tcg_out_modrm(s, OPC_GRPBT + P_REXW, OPC_GRPBT_BTC, xr);
+            tcg_out8(s, 63);
+        }
+
+        /* the result: t = r << 1, u = infinity << 1 */
+        pfp_shl1(s, t, xr);
+        tcg_out_movi(s, TCG_TYPE_I64, u, 0xffe0000000000000ull);
+        if (base <= PFP_SUB) {
+            /* any finite sum */
+            pfp_cmpr(s, t, u);
+            pfp_jslow(s, l, JCC_JE);
+            if (dbl) {
+                /* and zero or normal (|r| >= DBL_MIN) */
+                tcg_out_movi(s, TCG_TYPE_I64, u, 1ull << 53);
+                pfp_cmpr(s, t, u);
+                ok = pfp_jshort(s, JCC_JAE);
+                tcg_out_modrm(s, OPC_TESTL + P_REXW, t, t);
+                pfp_jslow(s, l, JCC_JNE);
+                pfp_here(s, ok);
+            }
+        } else {
+            /* a zero product, or FLT_MIN (DBL_MIN) < |r| < inf */
+            tcg_insn_unit *z1, *z2;
+
+            pfp_shl1(s, u, xa);
+            z1 = pfp_jshort(s, JCC_JE);
+            pfp_shl1(s, u, xc);
+            z2 = pfp_jshort(s, JCC_JE);
+            tcg_out_movi(s, TCG_TYPE_I64, u, 0xffe0000000000000ull);
+            pfp_cmpr(s, t, u);
+            pfp_jslow(s, l, JCC_JAE);
+            tcg_out_movi(s, TCG_TYPE_I64, u,
+                         dbl ? 1ull << 53 : 0x381ull << 53);
+            pfp_cmpr(s, t, u);
+            pfp_jslow(s, l, JCC_JBE);
+            pfp_here(s, z1);
+            pfp_here(s, z2);
+        }
+
+        /*
+         * fpi_fpscr_arith(): FPRF of r (+-zero, +-normal), FI = 1.
+         * t = sign, u = 4 << sign (normal), t = 2 | sign << 4 (zero).
+         */
+        pfp_mov(s, t, xr);
+        tcg_out_shifti(s, SHIFT_SHR + P_REXW, t, 63);
+        pfp_mov(s, u, t);
+        tcg_out_shifti(s, SHIFT_SHL + P_REXW, u, 2);
+        tgen_arithi(s, ARITH_ADD + P_REXW, u, 4, 0);
+        tcg_out_shifti(s, SHIFT_SHL + P_REXW, t, 4);
+        tgen_arithi(s, ARITH_OR + P_REXW, t, 2, 0);
+        pfp_shl1(s, xnf, xr);
+        pfp_cmov(s, JCC_JE, u, t);
+        tcg_out_shifti(s, SHIFT_SHL + P_REXW, u, 12);
+        pfp_mov(s, xnf, xf);
+        tgen_arithi(s, ARITH_AND + P_REXW, xnf,
+                    ~(tcg_target_long)(0x1f000 | PFP_FI), 0);
+        tgen_arithr(s, ARITH_OR + P_REXW, xnf, u);
+        tgen_arithi(s, ARITH_OR + P_REXW, xnf, PFP_FI, 0);
+    }
+
+    /* short path: soft-float exception flags = inexact (primed), movw imm */
+    tcg_out_modrm_offset(s, OPC_MOVL_EvIz | P_DATA16, 0, TCG_AREG0,
+                         (uint32_t)fst);
+    tcg_out16(s, fst >> 32);
+    l->raddr = tcg_splitwx_to_rx(s->code_ptr);
+}
+
+/*
+ * The stub: rdi = env, rsi rdx rcx = frA frB frC, r8d = selector, r9 =
+ * return address in the generated code (for a deferred FP exception); the
+ * helper returns (result, FPSCR) in rax:rdx.  The inputs go through the
+ * stack (any assignment of them to the argument registers is fine), so does
+ * rdx on the way back.
+ */
+static bool tcg_out_ppc_fp32_slow_path(TCGContext *s, TCGLabelQemuLdst *l)
+{
+    for (unsigned i = 0; i < l->fp_njmp; i++) {
+        tcg_patch32(l->fp_jmp[i], s->code_ptr - l->fp_jmp[i] - 4);
+    }
+    tcg_out_push(s, l->fp_in[0]);
+    tcg_out_push(s, l->fp_in[1]);
+    tcg_out_push(s, l->fp_in[2]);
+    tcg_out_pop(s, tcg_target_call_iarg_regs[3]);
+    tcg_out_pop(s, tcg_target_call_iarg_regs[2]);
+    tcg_out_pop(s, tcg_target_call_iarg_regs[1]);
+    tcg_out_mov(s, TCG_TYPE_PTR, tcg_target_call_iarg_regs[0], TCG_AREG0);
+    tcg_out_movi(s, TCG_TYPE_I32, tcg_target_call_iarg_regs[4], l->fp_sel);
+    tcg_out_movi(s, TCG_TYPE_PTR, tcg_target_call_iarg_regs[5],
+                 (uintptr_t)l->raddr);
+    tcg_out_branch(s, 1, l->fp_slow);
+    tcg_out_push(s, TCG_REG_RDX);
+    tcg_out_mov(s, TCG_TYPE_I64, l->fp_out[0], TCG_REG_RAX);
+    tcg_out_pop(s, l->fp_out[1]);
+    tcg_out_jmp(s, l->raddr);
+    return true;
+}
+#endif /* TCG_TARGET_PPC_FP32_IMPL */
