+/*
+ * POMPPC tcg/0062: the mask that flushes the old BAT.  Stock QEMU takes the
+ * new value's; x-bat-old-mask takes the old one's.  The first 64 writes that
+ * leave a valid BAT larger than the new mask are reported on stderr either way
+ * (the flush stock QEMU truncates).
+ */
+static target_ulong bat_old_flush_mask(CPUPPCState *env, char id, int nr,
+                                       target_ulong old, target_ulong value,
+                                       target_ulong mask)
+{
+    target_ulong omask = (old << 15) & 0x0FFE0000UL;
+
+    if ((old & 3) && omask > mask && env->bat_trunc_log < 64) {
+        env->bat_trunc_log++;
+        fprintf(stderr, "bat-old-mask: cpu %d %cBAT%du " TARGET_FMT_lx
+                " -> " TARGET_FMT_lx " nip " TARGET_FMT_lx
+                " : ancien bloc %u Kio, vidage %s %u Kio\n",
+                env_cpu(env)->cpu_index, id, nr, old, value, env->nip,
+                (unsigned)((omask + 0x20000) >> 10),
+                env->bat_old_mask ? "complet," : "tronqué à",
+                (unsigned)(((env->bat_old_mask ? omask : mask) + 0x20000) >> 10));
+    }
+    return env->bat_old_mask ? omask : mask;
+}
