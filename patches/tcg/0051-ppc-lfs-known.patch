+    TCGOp *top;
+
+    if (!ctx->lfs_known || ctx->base.plugin_enabled) {
+        return false;
+    }
+    w = tcg_temp_new_i64();
+    r = tcg_temp_new_i64();
+    nf = tcg_temp_new_i64();
+    tcg_gen_qemu_ld_i64(w, ea, ctx->mem_idx, DEF_MEMOP(MO_UL));
+    if (update) {
+        tcg_gen_mov_tl(cpu_gpr[ra], ea);
+    }
+    tcg_gen_ppc_fp32(r, nf, w, w, w, w, FPI_LFS | rt << 8,
+                     ppc_fp32_native_slow, 0, 0);
+    top = tcg_last_op();
+    if (ctx->fp_verify) {
+        gen_helper_fpn_lfs(tcg_env, w, r);
+    }
+    set_fpr(rt, r);
+    ctx->fpk_valid |= 1u << rt;
+    ctx->fpk_prod[rt] = top;
+    ctx->fpk_handled = true;
+    return true;
+}
