+void ppc_tlbp_drop(CPUPPCState *env, MMUIdxMap idxmap, int kind, uint64_t arg)
+{
+    env->tlbp_ops++;
+    env->tlbp_scans++;
+    env->tlbp_dropped += pomppc_tlb_flush_match(env_cpu(env), idxmap,
+                                                tlbp_match[kind], arg, 0, true);
+    ppc_tlbp_verify_tick(env);
