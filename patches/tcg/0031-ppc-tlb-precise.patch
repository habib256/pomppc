+ * The stock code does tlb_flush_all_cpus_synced(): every other CPU flushes
+ * at its next exit, this one in an exclusive section before it goes on.
+ * Same synchronisation, restricted to the classes and pages; one copy of
+ * the set per CPU, freed by its work.
+ */
+void ppc_tlbp_cls_global(CPUPPCState *env)
+{
+    CPUState *src = env_cpu(env), *cs;
+    struct PPCTlbieSet s = env->tlbie_global;
+
+    env->tlbie_global.cls = env->tlbie_local.cls = 0;
+    env->tlbie_global.n = env->tlbie_local.n = 0;
+    CPU_FOREACH(cs) {
+        if (cs != src) {
+            async_run_on_cpu(cs, tlbp_cls_work,
+                             RUN_ON_CPU_HOST_PTR(g_memdup2(&s, sizeof(s))));
+        }
+    }
+    async_safe_run_on_cpu(src, tlbp_cls_work,
+                          RUN_ON_CPU_HOST_PTR(g_memdup2(&s, sizeof(s))));
+}
