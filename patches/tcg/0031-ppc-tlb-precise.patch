+/*
+ * POMPPC tcg/0031 (x-tlb-precise).  The page an entry translates: from the
+ * first comparator that is valid (they all hold the same page).
+ */
+static inline vaddr pomppc_entry_page(CPUTLBEntry *e)
+{
+    uint64_t a;
+
+    if (!((a = e->addr_read) & TLB_INVALID_MASK) ||
+        !((a = tlb_addr_write(e)) & TLB_INVALID_MASK) ||
+        !((a = e->addr_code) & TLB_INVALID_MASK)) {
+        return a & TARGET_PAGE_MASK;
+    }
+    return -1;
+}
+
+void pomppc_jc_clear_page(CPUState *cpu, vaddr page)
+{
+    tb_jmp_cache_clear_page(cpu, page - TARGET_PAGE_SIZE);
+    tb_jmp_cache_clear_page(cpu, page);
+}
+
+size_t pomppc_tlb_flush_match(CPUState *cpu, MMUIdxMap idxmap,
+                              PomppcTlbMatch match, uint64_t arg, uint16_t cls,
+                              bool jc)
+{
+    MMUIdxMap dirty;
+    size_t dropped = 0;
+
+    assert_cpu_is_self(cpu);
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    /* a clean mmu_idx has no entry: flushed, nothing filled since */
+    dirty = idxmap & cpu->neg.tlb.c.dirty;
+    for (MMUIdxMap work = dirty; work; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDescFast *f = cpu_tlb_fast(cpu, mmu_idx);
+        CPUTLBDesc *d = &cpu->neg.tlb.d[mmu_idx];
+        size_t n = (f->mask >> CPU_TLB_ENTRY_BITS) + 1;
+
+        /* the index of a page is its number modulo n (n >= 64) */
+        for (int c = 0; c < 16; c++) {
+            if (cls && !((cls >> c) & 1)) {
+                continue;
+            }
+            for (size_t j = c; j < n; j += 16) {
+                vaddr page = pomppc_entry_page(&f->table[j]);
+                if (page != (vaddr)-1 && match(page, arg)) {
+                    memset(&f->table[j], -1, sizeof(f->table[j]));
+                    tlb_n_used_entries_dec(cpu, mmu_idx);
+                    dropped++;
+                }
+            }
+        }
+        for (size_t j = 0; j < CPU_VTLB_SIZE; j++) {
+            vaddr page = pomppc_entry_page(&d->vtable[j]);
+            if (page != (vaddr)-1 && match(page, arg)) {
+                memset(&d->vtable[j], -1, sizeof(d->vtable[j]));
+                tlb_n_used_entries_dec(cpu, mmu_idx);
+                dropped++;
+            }
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    /*
+     * The jump cache is not checked against the TLB, and an evicted entry
+     * leaves its jump cache entries behind: drop those of @idxmap, as the
+     * stock flush of those mmu_idx does (x-jc-idx: through its log).
+     */
+    if (!jc) {
+        /* the caller clears the jump cache pages it knows */
+    } else if (cpu->jc_by_idx) {
+        tcg_flush_jmp_cache_idx(cpu, idxmap);
+    } else {
+        tcg_flush_jmp_cache(cpu);
+    }
+    return dropped;
+}
