+static void tlbp_cls_work(CPUState *cs, run_on_cpu_data d)
+{
+    struct PPCTlbieSet *s = d.host_ptr;
+
+    ppc_tlbp_drop_tlbie(cpu_env(cs), s);
+    g_free(s);
