+/*
+ * x-tlb-precise (POMPPC tcg/0031).  Predicates on the virtual page of a TLB
+ * entry: kind 0, arg = mask of segments; kind 1, arg = mask of tlbie
+ * classes (EA[16:19]); kind 2, arg = first page << 32 | last byte of a BAT
+ * range.  32-bit effective addresses only (32-bit hash MMU).
+ */
+static bool tlbp_match_seg(vaddr page, uint64_t segs)
+{
+    return page <= UINT32_MAX && ((segs >> ((page >> 28) & 15)) & 1);
+}
+
+static bool tlbp_match_cls(vaddr page, uint64_t cls)
+{
+    return page <= UINT32_MAX &&
+           ((cls >> ((page >> TARGET_PAGE_BITS) & 15)) & 1);
+}
+
+static bool tlbp_match_range(vaddr page, uint64_t r)
+{
+    return page >= (r >> 32) && page <= (uint32_t)r;
+}
+
+static const PomppcTlbMatch tlbp_match[3] = {
+    tlbp_match_seg, tlbp_match_cls, tlbp_match_range,
+};
+
+/* one comparator of a kept entry, re-translated as access t */
+static void tlbp_verify_one(CPUPPCState *env, int mmu_idx, uint64_t cmp,
+                            MMUAccessType t, CPUTLBEntryFull *full)
+{
+    PowerPCCPU *cpu = env_archcpu(env);
+    hwaddr raddr;
+    int psize, prot;
+    bool ok;
+    vaddr a = cmp & TARGET_PAGE_MASK;
+
+    if (cmp & TLB_INVALID_MASK) {
+        return;
+    }
+    env->tlbp_entries++;
+    ok = ppc_xlate(cpu, a, t, &raddr, &psize, &prot, mmu_idx, false);
+    if (!ok ||
+        (raddr & TARGET_PAGE_MASK) != (full->phys_addr & TARGET_PAGE_MASK)) {
+        int k, free_k = -1;
+
+        for (k = 0; k < PPC_TLBP_SUS; k++) {
+            if (!env->tlbp_s[k].used) {
+                free_k = free_k < 0 ? k : free_k;
+            } else if (env->tlbp_s[k].page == a &&
+                       env->tlbp_s[k].idx == mmu_idx &&
+                       env->tlbp_s[k].access == t &&
+                       env->tlbp_s[k].phys == full->phys_addr) {
+                break;
+            }
+        }
+        if (k == PPC_TLBP_SUS) {
+            /* a new suspect (or no room left: judged now) */
+            if (free_k >= 0) {
+                env->tlbp_s[free_k].page = a;
+                env->tlbp_s[free_k].phys = full->phys_addr;
+                env->tlbp_s[free_k].idx = mmu_idx;
+                env->tlbp_s[free_k].access = t;
+                env->tlbp_s[free_k].age = 0;
+                env->tlbp_s[free_k].seen = 1;
+                env->tlbp_s[free_k].used = 1;
+                env->tlbp_sus++;
+                return;
+            }
+        } else {
+            env->tlbp_s[k].seen = 1;
+            if (++env->tlbp_s[k].age < PPC_TLBP_AGE) {
+                return;
+            }
+            env->tlbp_s[k].used = 0;
+        }
+        /*
+         * No translation at all: the PTE went away without a tlbie (OpenBIOS
+         * evicts its identity PTEs so); a 7400 keeps such an entry too.  A
+         * different page is the serious kind.  Both are counted.
+         */
+        env->tlbp_bad_nopte += !ok;
+        if (env->tlbp_bad++ < 20) {
+            CPUState *o;
+            uint32_t others = 0;
+            CPU_FOREACH(o) {
+                if (o != env_cpu(env)) {
+                    others |= cpu_env(o)->tlb_need_flush;
+                }
+            }
+            fprintf(stderr, "x-tlb-precise-verify: DIVERGENCE cpu %d idx %d "
+                    "access %d ea 0x%" PRIx64 " tlb 0x%" HWADDR_PRIx
+                    " now 0x%" HWADDR_PRIx " (other CPUs pending flush 0x%x)"
+                    " sr 0x%" PRIx64 " snap 0x%" PRIx64 "\n",
+                    env_cpu(env)->cpu_index, mmu_idx, t, (uint64_t)a,
+                    full->phys_addr, raddr, others,
+                    (uint64_t)env->sr[(a >> 28) & 15],
+                    (uint64_t)env->sr_snap[mmu_idx & 1][(a >> 28) & 15]);
+        }
+    }
+}
+
+static void tlbp_verify(CPUPPCState *env)
+{
+    CPUState *cs = env_cpu(env);
+
+    if (env->tlb_need_flush & (TLB_NEED_LOCAL_FLUSH | TLB_NEED_GLOBAL_FLUSH |
+                               TLB_NEED_CLS_LOCAL | TLB_NEED_SR_CHECK) ||
+        !cpu_work_list_empty(cs)) {
+        /*
+         * Stale entries are legitimate until that flush, or until the
+         * flush another CPU queued here (its tlbie, then sync) has run.
+         */
+        return;
+    }
+    for (int k = 0; k < PPC_TLBP_SUS; k++) {
+        env->tlbp_s[k].seen = 0;
+    }
+    for (int i = 0; i < 2; i++) {
+        CPUTLBDescFast *f = cpu_tlb_fast(cs, i);
+        CPUTLBDesc *d = &cs->neg.tlb.d[i];
+        size_t n = (f->mask >> CPU_TLB_ENTRY_BITS) + 1;
+
+        if (env->sr_tlb && i != ppc_env_mmu_index(env, false) &&
+            i != ppc_env_mmu_index(env, true)) {
+            continue;   /* x-sr-tlb: checked when it becomes current */
+        }
+        for (size_t j = 0; j < n + CPU_VTLB_SIZE; j++) {
+            CPUTLBEntry *e = j < n ? &f->table[j] : &d->vtable[j - n];
+            CPUTLBEntryFull *full = j < n ? &d->fulltlb[j]
+                                          : &d->vfulltlb[j - n];
+
+            tlbp_verify_one(env, i, e->addr_read, MMU_DATA_LOAD, full);
+            tlbp_verify_one(env, i, qatomic_read(&e->addr_write),
+                            MMU_DATA_STORE, full);
+            tlbp_verify_one(env, i, e->addr_code, MMU_INST_FETCH, full);
+        }
+    }
+    /* suspects of a checked mmu_idx no longer seen stale: resolved */
+    for (int k = 0; k < PPC_TLBP_SUS; k++) {
+        int i = env->tlbp_s[k].idx;
+
+        if (env->tlbp_s[k].used && !env->tlbp_s[k].seen &&
+            (!env->sr_tlb || i == ppc_env_mmu_index(env, false) ||
+             i == ppc_env_mmu_index(env, true))) {
+            env->tlbp_s[k].used = 0;
+            env->tlbp_resolved++;
+        }
+    }
+    if ((++env->tlbp_runs & 0x3ff) == 0) {
+        fprintf(stderr, "x-tlb-precise-verify: cpu %d, %" PRIu64 " precise "
+                "invalidations, %" PRIu64 " entries dropped, %" PRIu64
+                " checks, %" PRIu64 " accesses re-translated, %" PRIu64
+                " suspects (%" PRIu64 " resolved), %" PRIu64 " divergent"
+                " (%" PRIu64 " without PTE, %" PRIu64 " other page)\n",
+                cs->cpu_index, env->tlbp_ops, env->tlbp_dropped,
+                env->tlbp_runs, env->tlbp_entries, env->tlbp_sus,
+                env->tlbp_resolved, env->tlbp_bad, env->tlbp_bad_nopte,
+                env->tlbp_bad - env->tlbp_bad_nopte);
+    }
+}
+
+void ppc_tlbp_verify_tick(CPUPPCState *env)
+{
