+/*
+ * tlbie classes and pages: the TLB entries of mmu_idx 0 and 1 in those
+ * classes (only the slots at those indexes modulo 16 hold them); the jump
+ * cache pages of the operands under each segment, or a whole flush of its
+ * mmu_idx 0 and 1 (pages overflowed, or every class dropped since the last
+ * whole flush).
+ */
+static void ppc_tlbp_drop_tlbie(CPUPPCState *env, const struct PPCTlbieSet *s)
+{
+    CPUState *cs = env_cpu(env);
+    bool whole;
+
+    env->tlbp_ops++;
+    env->tlbie_cls_seen |= s->cls;
+    whole = s->n > PPC_TLBIE_PAGES || env->tlbie_cls_seen == 0xffff;
+    if (whole) {
+        env->tlbie_cls_seen = 0;
+    }
+    env->tlbp_dropped += pomppc_tlb_flush_match(cs, 3, tlbp_match_cls, s->cls,
+                                                s->cls, whole);
+    if (!whole) {
+        for (unsigned j = 0; j < s->n; j++) {
+            for (uint32_t seg = 0; seg < 16; seg++) {
+                vaddr pg = (s->pg[j] << TARGET_PAGE_BITS) & 0x0fffffff;
+
+                pomppc_jc_clear_page(cs, (vaddr)(seg << 28) | pg);
+            }
+        }
+    }
+    ppc_tlbp_verify_tick(env);
+}
+
+void ppc_tlbp_drop_local(CPUPPCState *env)
+{
+    struct PPCTlbieSet s = env->tlbie_local;
+
+    env->tlbie_local.cls = 0;
+    env->tlbie_local.n = 0;
+    ppc_tlbp_drop_tlbie(env, &s);
+}
+
+/*
+ * Segments @segs of mmu_idx @idx: the logged pages one by one (with their
+ * jump cache pages, as tlb_flush_page does), a scan for the overflowed
+ * segments.  Every entry of a segment was filled since its last drop, hence
+ * logged, or the log overflowed.
+ */
+void ppc_tlbp_drop_segs(CPUPPCState *env, int idx, uint16_t segs)
+{
+    CPUState *cs = env_cpu(env);
+    uint16_t over = 0;
+
+    env->tlbp_ops++;
+    for (int s = 0; s < 16; s++) {
+        unsigned n = env->seglog_n[idx][s];
+
+        if (!((segs >> s) & 1)) {
+            continue;
+        }
+        if (n > PPC_TLBP_LOG) {
+            over |= 1 << s;
+        } else {
+            for (unsigned j = 0; j < n; j++) {
+                tlb_flush_page_by_mmuidx(cs, (vaddr)env->seglog[idx][s][j]
+                                         << TARGET_PAGE_BITS, 1 << idx);
+            }
+        }
+        env->seglog_n[idx][s] = 0;
+    }
+    if (over) {
+        env->tlbp_scans++;
+        env->tlbp_dropped += pomppc_tlb_flush_match(cs, 1 << idx,
+                                                    tlbp_match_seg, over, 0,
+                                                    true);
+    }
+    ppc_tlbp_verify_tick(env);
+}
