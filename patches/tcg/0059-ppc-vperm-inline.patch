+/*
+ * POMPPC tcg/0059, x-vperm-verify: each vperm that x-vperm-inline translated
+ * re-done by helper_VPERM on the operands saved before the inline ops
+ * (env->vpv_in) and compared; on a divergence vD gets the helper's value.
+ * Summary on stderr every 2^26 checks and at exit.
+ */
+static uint64_t vpv_n, vpv_bad;
+static bool vpv_atexit;
+
+static void vpv_report(void)
+{
+    fprintf(stderr, "vperm-verify: %" PRIu64 " vperm vérifiés, %" PRIu64
+            " divergences\n", qatomic_read(&vpv_n), qatomic_read(&vpv_bad));
+}
+
+void helper_vperm_verify(CPUPPCState *env, uint32_t rd)
+{
+    ppc_avr_t ref, *r = cpu_avr_ptr(env, rd & 31);
+    bool bad;
+
+    helper_VPERM(&ref, &env->vpv_in[0], &env->vpv_in[1], &env->vpv_in[2]);
+    bad = ref.VsrD(0) != r->VsrD(0) || ref.VsrD(1) != r->VsrD(1);
+    if (!qatomic_read(&vpv_atexit)) {
+        qatomic_set(&vpv_atexit, true);
+        atexit(vpv_report);
+    }
+    if (bad) {
+        if (qatomic_fetch_inc(&vpv_bad) < 20) {
+            fprintf(stderr, "vperm-verify: v%u: en ligne %016" PRIx64 "%016"
+                    PRIx64 ", helper %016" PRIx64 "%016" PRIx64 "\n",
+                    rd & 31, r->VsrD(0), r->VsrD(1), ref.VsrD(0), ref.VsrD(1));
+        }
+        *r = ref;
+    }
+    if ((qatomic_fetch_inc(&vpv_n) & ((1u << 26) - 1)) == 0) {
+        vpv_report();
+    }
+}
+
 void helper_VPERM_FAST(ppc_avr_t *r, ppc_avr_t *a, ppc_avr_t *b, ppc_avr_t *c)
