+/*
+ * POMPPC tcg/0059: AltiVec vperm (see INDEX_op_ppc_vperm_vec).  No generic
+ * expansion: false, with nothing emitted, when the backend has none; the
+ * front end then keeps its helper.
+ */
+bool tcg_gen_ppc_vperm_vec(TCGv_vec r, TCGv_vec a, TCGv_vec b, TCGv_vec c)
+{
+    TCGTemp *rt = tcgv_vec_temp(r);
+    TCGTemp *at = tcgv_vec_temp(a);
+    TCGTemp *bt = tcgv_vec_temp(b);
+    TCGTemp *ct = tcgv_vec_temp(c);
+    TCGType type = rt->base_type;
+    int can;
+
+    tcg_debug_assert(at->base_type >= type);
+    tcg_debug_assert(bt->base_type >= type);
+    tcg_debug_assert(ct->base_type >= type);
+    can = tcg_can_emit_vec_op(INDEX_op_ppc_vperm_vec, type, MO_8);
+    if (can > 0) {
+        vec_gen_4(INDEX_op_ppc_vperm_vec, type, MO_8,
+                  temp_arg(rt), temp_arg(at), temp_arg(bt), temp_arg(ct));
+    } else if (can < 0) {
+        const TCGOpcode *hold_list = tcg_swap_vecop_list(NULL);
+        tcg_expand_vec_op(INDEX_op_ppc_vperm_vec, type, MO_8,
+                          temp_arg(rt), temp_arg(at), temp_arg(bt), temp_arg(ct));
+        tcg_swap_vecop_list(hold_list);
+    } else {
+        return false;
+    }
+    return true;
+}
