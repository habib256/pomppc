--- a/target/ppc/translate/vmx-impl.c.inc	2026-10-30 19:44:42.634350932 +0400
+++ b/target/ppc/translate/vmx-impl.c.inc	2026-10-30 19:45:34.917664433 +0400
@@ -2650,10 +2650,51 @@
 TRANS_FLAGS2(ALTIVEC_207, VSUBEUQM, do_va_helper, gen_helper_VSUBEUQM)
 TRANS_FLAGS2(ALTIVEC_207, VSUBECUQ, do_va_helper, gen_helper_VSUBECUQ)
 
+/*
+ * x-vperm-inline (POMPPC tcg/0059): vperm as host vector ops, the three
+ * operands read before vD is written (vD may be any of them).  False when
+ * the TCG backend has no ppc_vperm_vec (the caller then uses the helper).
+ * x-vperm-verify: the operands saved, helper_vperm_verify compares.
+ */
+static bool do_vperm_inline(DisasContext *ctx, arg_VPERM *a)
+{
+    TCGv_vec va, vb, vc, vr;
+
+    if (!tcg_can_emit_vec_op(INDEX_op_ppc_vperm_vec, TCG_TYPE_V128, MO_8)) {
+        return false;
+    }
+    va = tcg_temp_new_vec(TCG_TYPE_V128);
+    vb = tcg_temp_new_vec(TCG_TYPE_V128);
+    vc = tcg_temp_new_vec(TCG_TYPE_V128);
+    vr = tcg_temp_new_vec(TCG_TYPE_V128);
+    tcg_gen_ld_vec(va, tcg_env, avr_full_offset(a->vra));
+    tcg_gen_ld_vec(vb, tcg_env, avr_full_offset(a->vrb));
+    tcg_gen_ld_vec(vc, tcg_env, avr_full_offset(a->rc));
+    if (ctx->vperm_verify) {
+        tcg_gen_st_vec(va, tcg_env, offsetof(CPUPPCState, vpv_in[0]));
+        tcg_gen_st_vec(vb, tcg_env, offsetof(CPUPPCState, vpv_in[1]));
+        tcg_gen_st_vec(vc, tcg_env, offsetof(CPUPPCState, vpv_in[2]));
+    }
+    if (!tcg_gen_ppc_vperm_vec(vr, va, vb, vc)) {
+        g_assert_not_reached();         /* tcg_can_emit_vec_op said yes */
+    }
+    tcg_gen_st_vec(vr, tcg_env, avr_full_offset(a->vrt));
+    if (ctx->vperm_verify) {
+        gen_helper_vperm_verify(tcg_env, tcg_constant_i32(a->vrt));
+    }
+    return true;
+}
+
 /* x-vperm-fast: the same bytes through helper_VPERM_FAST (int_helper.c) */
 static bool trans_VPERM(DisasContext *ctx, arg_VPERM *a)
 {
     REQUIRE_INSNS_FLAGS(ctx, ALTIVEC);
+    if (ctx->vperm_inline) {
+        REQUIRE_VECTOR(ctx);
+        if (do_vperm_inline(ctx, a)) {
+            return true;
+        }
+    }
     return do_va_helper(ctx, a, ctx->vperm_fast ? gen_helper_VPERM_FAST
                                                 : gen_helper_VPERM);
 }
