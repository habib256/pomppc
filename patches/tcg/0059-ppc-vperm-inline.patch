+/*
+ * POMPPC tcg/0059: AltiVec vperm in six ops instead of a helper call.
+ * k = ~c & 31 selects byte k of b (k < 16) or k - 16 of a.  pshufb takes the
+ * low four bits of each index and gives 0 where bit 7 is set: with
+ * i = k + 0x70 (0x70..0x8f), pshufb(b, i) is b[k] for k < 16 and 0 after;
+ * i ^ 0x80 (0xf0..0xff, 0x00..0x0f) does the opposite for a.  Both halves
+ * then combine with an or.  Same bytes as helper_VPERM_FAST (tcg/0019).
+ */
+static void expand_vec_ppc_vperm(TCGType type, TCGv_vec r, TCGv_vec a,
+                                 TCGv_vec b, TCGv_vec c)
+{
+    TCGv_vec i = tcg_temp_new_vec(type);
+    TCGv_vec ta = tcg_temp_new_vec(type);
+    TCGv_vec tb = tcg_temp_new_vec(type);
+
+    tcg_gen_andc_vec(MO_8, i, tcg_constant_vec(type, MO_8, 0x1f), c);
+    tcg_gen_add_vec(MO_8, i, i, tcg_constant_vec(type, MO_8, 0x70));
+    vec_gen_3(INDEX_op_x86_pshufb_vec, type, MO_8,
+              tcgv_vec_arg(tb), tcgv_vec_arg(b), tcgv_vec_arg(i));
+    tcg_gen_xor_vec(MO_8, i, i, tcg_constant_vec(type, MO_8, 0x80));
+    vec_gen_3(INDEX_op_x86_pshufb_vec, type, MO_8,
+              tcgv_vec_arg(ta), tcgv_vec_arg(a), tcgv_vec_arg(i));
+    tcg_gen_or_vec(MO_8, r, ta, tb);
+    tcg_temp_free_vec(i);
+    tcg_temp_free_vec(ta);
+    tcg_temp_free_vec(tb);
+}
