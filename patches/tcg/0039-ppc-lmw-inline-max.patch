@@ -210,6 +210,12 @@
     DEFINE_PROP_BOOL("x-lmw-inline-verify", PowerPCCPU, env.lmw_inline_verify,
                      false),
     /*
+     * POMPPC tcg/0039.  x-lmw-inline-max: most registers of an inline
+     * lmw/stmw (32, every count: the behaviour of tcg/0032; 8: only the
