     uint64_t lmwv_n, lmwv_bad, lmwv_io;
+    /* x-lmw-inline-max (POMPPC tcg/0039): most registers inline, 0-32 */
+    uint32_t lmw_inline_max;
     /*
      * x-dcbz-inline (POMPPC tcg/0035): dcbz with a 32-byte line as four
      * 8-byte stores of zero in the generated code (those of the helper's
