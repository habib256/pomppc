+/*
+ * POMPPC auto-profileur (diagnostic, 27/10/2026, sans perf) : POMPPC_SELFPROF=PREFIXE.
+ * Chaque fil vCPU arme un minuteur sur son temps CPU (1 kHz, SIGPROF) ; le gestionnaire
+ * note le rip interrompu tant que le fichier PREFIXE.on existe (sondé par un fil toutes
+ * les 200 ms). À l'effacement du fichier, les rip sont écrits dans PREFIXE.<tid>.bin
+ * (u64 petit-boutiens).
+ */
+#include <signal.h>
+#include <time.h>
+#include <ucontext.h>
+#define SP_MAX 4
+#define SP_N (1 << 21)
+static const char *sp_prefix;
+static int sp_on;
+static struct { pid_t tid; uint64_t *buf; unsigned n; } sp_thr[SP_MAX];
+static unsigned sp_nthr;
+static __thread int sp_idx = -1;
+
+static void sp_handler(int sig, siginfo_t *si, void *ucv)
+{
+    ucontext_t *uc = ucv;
+    int i = sp_idx;
+    if (i < 0 || !qatomic_read(&sp_on)) {
+        return;
+    }
+    unsigned n = sp_thr[i].n;
+    if (n < SP_N) {
+        sp_thr[i].buf[n] = uc->uc_mcontext.gregs[REG_RIP];
+        sp_thr[i].n = n + 1;
+    }
+}
+
+static void *sp_poller(void *arg)
+{
+    g_autofree char *on = g_strdup_printf("%s.on", sp_prefix);
+    for (;;) {
+        bool f = access(on, F_OK) == 0;
+        if (f && !sp_on) {
+            for (unsigned i = 0; i < sp_nthr; i++) {
+                sp_thr[i].n = 0;
+            }
+            qatomic_set(&sp_on, 1);
+        } else if (!f && sp_on) {
+            qatomic_set(&sp_on, 0);
+            g_usleep(10000);
+            for (unsigned i = 0; i < sp_nthr; i++) {
+                g_autofree char *fn = g_strdup_printf("%s.%d.bin", sp_prefix,
+                                                      (int)sp_thr[i].tid);
+                FILE *fp = fopen(fn, "wb");
+                if (fp) {
+                    fwrite(sp_thr[i].buf, 8, sp_thr[i].n, fp);
+                    fclose(fp);
+                }
+            }
+        }
+        g_usleep(200000);
+    }
+    return NULL;
+}
+
+static void sp_thread_start(void)
+{
+    static QemuMutex lock;
+    static bool init;
+    struct sigevent sev = { 0 };
+    struct itimerspec its = { { 0, 1000000 }, { 0, 1000000 } };
+    timer_t t;
+
+    if (!sp_prefix) {
+        sp_prefix = getenv("POMPPC_SELFPROF");
+        if (!sp_prefix || !*sp_prefix) {
+            sp_prefix = "";
+        }
+    }
+    if (!*sp_prefix) {
+        return;
+    }
+    if (!qatomic_xchg(&init, true)) {
+        struct sigaction sa = { 0 };
+        QemuThread th;
+        qemu_mutex_init(&lock);
+        sa.sa_sigaction = sp_handler;
+        sa.sa_flags = SA_SIGINFO | SA_RESTART;
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGPROF, &sa, NULL);
+        qemu_thread_create(&th, "selfprof", sp_poller, NULL, QEMU_THREAD_DETACHED);
+    }
+    if (sp_nthr >= SP_MAX) {
+        return;
+    }
+    {
+        sigset_t ss;
+        sigemptyset(&ss);
+        sigaddset(&ss, SIGPROF);
+        pthread_sigmask(SIG_UNBLOCK, &ss, NULL);   /* qemu_thread_create bloque tout */
+    }
+    sp_thr[sp_nthr].tid = qemu_get_thread_id();
+    sp_thr[sp_nthr].buf = g_new0(uint64_t, SP_N);
+    sp_idx = sp_nthr++;
+    sev.sigev_notify = SIGEV_THREAD_ID;
+    sev.sigev_signo = SIGPROF;
+    sev._sigev_un._tid = qemu_get_thread_id();
+    if (timer_create(CLOCK_THREAD_CPUTIME_ID, &sev, &t) == 0) {
+        timer_settime(t, 0, &its, NULL);
+    }
+}
