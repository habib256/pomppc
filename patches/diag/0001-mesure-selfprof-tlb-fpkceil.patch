+    }
+    if (logt) {
+        fprintf(stderr, "pomppc-tlb: table %zu entrées (%zu Kio)\n", n, sz >> 10);
+    }
+    if (huge && sz >= 2 * MiB) {
+        p = qemu_try_memalign(2 * MiB, sz);
+        if (p) {
+            qemu_madvise(p, sz, QEMU_MADV_HUGEPAGE);
+        }
+    } else {
+        p = qemu_try_memalign(64, sz);
+    }
+    return p;
+}
