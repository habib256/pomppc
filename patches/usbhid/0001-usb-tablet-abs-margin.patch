diff --git a/hw/input/hid.c b/hw/input/hid.c
index 0f28827..64a4141 100644
--- a/hw/input/hid.c
+++ b/hw/input/hid.c
@@ -404,6 +404,18 @@ int hid_pointer_poll(HIDState *hs, uint8_t *buf, int len)
         break;
 
     case HID_TABLET:
+        if (hs->abs_margin_pct) {
+            /*
+             * POMPPC x-abs-margin: [0, max] into [m, max - m], m computed
+             * as the guest does (IOHIDEventDriver: logical range * pct / 200).
+             */
+            int m = INPUT_EVENT_ABS_MAX * hs->abs_margin_pct / 200;
+
+            dx = m + (int64_t)dx * (INPUT_EVENT_ABS_MAX - 2 * m) /
+                 INPUT_EVENT_ABS_MAX;
+            dy = m + (int64_t)dy * (INPUT_EVENT_ABS_MAX - 2 * m) /
+                 INPUT_EVENT_ABS_MAX;
+        }
         if (len > l) {
             buf[l++] = e->buttons_state;
         }
diff --git a/hw/usb/dev-hid.c b/hw/usb/dev-hid.c
