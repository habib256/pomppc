         DEFINE_PROP_STRING("display", USBHIDState, display),
         DEFINE_PROP_UINT32("head", USBHIDState, head, 0),
+        /*
+         * POMPPC (patches/usbhid/0001): margin, in percent of each axis, that
+         * the guest drops from the absolute range (Mac OS X 10.4.11: 15).
+         */
+        DEFINE_PROP_UINT32("x-abs-margin", USBHIDState, hid.abs_margin_pct, 0),
 };
 
 static void usb_tablet_class_initfn(ObjectClass *klass, const void *data)
diff --git a/include/hw/input/hid.h b/include/hw/input/hid.h
index 6a9d7bf..40fa7ff 100644
--- a/include/hw/input/hid.h
+++ b/include/hw/input/hid.h
@@ -41,6 +41,13 @@ struct HIDState {
     uint32_t n;
     int kind;
     int32_t protocol;
+    /*
+     * POMPPC (patches/usbhid/0001): usb-tablet "x-abs-margin", percent.
+     * Mac OS X 10.4.11's IOHIDEventDriver drops pct/2 % of an absolute
+     * axis at each end (15 there); the tablet then reports into that
+     * window so the guest maps it back onto the whole screen.  0: off.
+     */
+    uint32_t abs_margin_pct;
     uint8_t idle;
     bool idle_pending;
     QEMUTimer *idle_timer;
