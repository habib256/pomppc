     /* GPIO 1 is up by default */
     macio_set_gpio(s, 1, true);
+    /* Idem pour les deux lignes candidates du reset du CPU 1 (actives bas) */
+    macio_set_gpio(s, 3, true);
+    macio_set_gpio(s, 4, true);
 }
 
