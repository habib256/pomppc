diff --git a/hw/misc/macio/gpio.c b/hw/misc/macio/gpio.c
index 7cad62819a..85325238cf 100644
--- a/hw/misc/macio/gpio.c
+++ b/hw/misc/macio/gpio.c
@@ -34,6 +34,58 @@
 #include "qemu/module.h"
 #include "trace.h"
 
+/* GPIO register bits (names from BALATON Zoltan's SMP series) */
+#define OUT_DATA    0x01
+#define IN_DATA     0x02
+#define OUT_ENABLE  0x04
+
+/*
+ * Effet d'un niveau de GPIO sur sa ligne d'interruption externe.
+ *
+ * Séparé de macio_set_gpio() parce que les deux sens existent : une entrée
+ * pilotée depuis l'extérieur (macio_set_gpio) et une sortie pilotée par le CPU
+ * via le registre (macio_gpio_write). Le second cas doit garder le registre
+ * relisible, ce que macio_set_gpio() ne sait pas faire.
+ */
+static void macio_gpio_set_extirq(MacIOGPIOState *s, uint32_t gpio, bool state)
+{
+    switch (gpio) {
+    case 1:
+    case 3:
+    case 4:
+        /*
+         * Level low. GPIO 1 : ligne d'extension du PMU (amont).
+         * GPIO 3 et 4 : Active low, CPU1 reset. Tiger n'a pas de propriété
+         * « soft-reset » dans le firmware livré et retombe sur son offset
+         * codé en dur, 0x5B ou 0x5C selon les versions : soit GPIO 3, soit
+         * GPIO 4 (la fenêtre GPIO est mappée à 0x50 dans le BAR du macio, et
+         * ses huit premiers octets sont les registres de niveau). Les deux
+         * sont donc câblés, sinon 0x5B tombe dans LOG_UNIMP en silence.
+         */
+        if (!state) {
+            trace_macio_gpio_irq_assert(gpio);
+            qemu_irq_raise(s->gpio_extirqs[gpio]);
+        } else {
+            trace_macio_gpio_irq_deassert(gpio);
+            qemu_irq_lower(s->gpio_extirqs[gpio]);
+        }
+        break;
+
+    case 9:
+        /* Edge, triggered by NMI below */
+        if (state) {
+            trace_macio_gpio_irq_assert(gpio);
+            qemu_irq_raise(s->gpio_extirqs[gpio]);
+        } else {
+            trace_macio_gpio_irq_deassert(gpio);
+            qemu_irq_lower(s->gpio_extirqs[gpio]);
+        }
+        break;
+
+    default:
+        qemu_log_mask(LOG_UNIMP, "GPIO: setting unimplemented GPIO %d", gpio);
+    }
+}
 
