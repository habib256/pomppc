 static void macio_gpio_write(void *opaque, hwaddr addr, uint64_t value,
                              unsigned size)
 {
     MacIOGPIOState *s = opaque;
-    uint8_t ibit;
+    uint8_t ibit, old;
 
     trace_macio_gpio_write(addr, value);
 
@@ -109,13 +136,31 @@ static void macio_gpio_write(void *opaque, hwaddr addr, uint64_t value,
     if (addr < 36) {
         value &= ~2;
 
-        if (value & 4) {
-            ibit = (value & 1) << 1;
+        if (value & OUT_ENABLE) {
+            ibit = (value & OUT_DATA) << 1;
         } else {
-            ibit = s->gpio_regs[addr] & 2;
+            ibit = s->gpio_regs[addr] & IN_DATA;
         }
 
+        /*
+         * Le registre est TOUJOURS stocké, y compris pour la ligne de reset du
+         * CPU 1 : OUT_ENABLE et OUT_DATA doivent rester relisibles, sinon un
+         * pilote qui fait lecture-modification-écriture repart de zéro.
+         * Seul le NIVEAU de la ligne est dérivé pour l'interruption externe.
+         */
+        old = s->gpio_regs[addr];
         s->gpio_regs[addr] = value | ibit;
+
+        if (addr == 3 || addr == 4) {
+            /* Sortie inactive : la ligne est tirée haut (reset relâché). */
+            bool level = (value & OUT_ENABLE) ? !!(ibit & IN_DATA) : true;
+            bool prev = (old & OUT_ENABLE) ? !!(old & IN_DATA) : true;
+
+            trace_macio_set_gpio(addr, level);
+            if (level != prev) {
+                macio_gpio_set_extirq(s, addr, level);
+            }
+        }
     }
 }
 
