+/*
+ * Relâche le cœur secondaire. Exécuté SUR LE THREAD DU vCPU VISÉ (via
+ * async_run_on_cpu), jamais sur celui du cœur qui écrit le GPIO : réécrire
+ * MSR/NIP/SPR/TLB d'un vCPU qui tourne corrompt son état. Même motif que
+ * hw/ppc/ppce500_spin.c et target/arm/arm-powerctl.c.
+ */
+static void cpu_kick_work(CPUState *cs, run_on_cpu_data data)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+
+    cpu_reset(cs);
+
+    /*
+     * APRÈS cpu_reset() : celui-ci repose MSR[EP], donc excp_prefix à
+     * 0xFFF00000 (hreg_store_msr ne recalcule excp_prefix que si MSR[EP]
+     * change). Le poser avant ne marcherait qu'au tout premier kick ; dès que
+     * le cœur 1 a tourné sous Darwin (EP = 0), le kick suivant le renverrait
+     * dans la ROM OpenBIOS à 0xFFF00100 au lieu du vecteur en RAM.
+     */
+    cpu->env.excp_prefix = 0;
+
+    /* Pose cs->halted = 0 puis délivre POWERPC_EXCP_RESET (vecteur 0x100). */
+    ppc_cpu_do_system_reset(cs);
+}
+
+static void cpu_kick(void *opaque, int n, int level)
+{
+    if (level) {
+        /*
+         * async_run_on_cpu() met le travail en file PUIS appelle
+         * qemu_cpu_kick(), qui diffuse sur halt_cond : c'est ce qui sort le
+         * thread du cœur secondaire de son qemu_cond_wait(). Sans cela il
+         * dormirait jusqu'au prochain événement fortuit.
+         */
+        async_run_on_cpu(CPU(opaque), cpu_kick_work, RUN_ON_CPU_NULL);
+    }
+}
