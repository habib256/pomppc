diff --git a/hw/misc/macio/gpio.c b/hw/misc/macio/gpio.c
index 85325238c..e7536e6e9 100644
--- a/hw/misc/macio/gpio.c
+++ b/hw/misc/macio/gpio.c
@@ -53,6 +53,8 @@ static void macio_gpio_set_extirq(MacIOGPIOState *s, uint32_t gpio, bool state)
     case 1:
     case 3:
     case 4:
+    case 15: /* ESSAI smp-coeurs : reset CPU 2 (0x67, KL_GPIO_RESET_CPU2 de Linux) */
+    case 16: /* ESSAI smp-coeurs : reset CPU 3 (0x68) */
         /*
          * Level low. GPIO 1 : ligne d'extension du PMU (amont).
          * GPIO 3 et 4 : Active low, CPU1 reset. Tiger n'a pas de propriété
@@ -151,7 +153,7 @@ static void macio_gpio_write(void *opaque, hwaddr addr, uint64_t value,
         old = s->gpio_regs[addr];
         s->gpio_regs[addr] = value | ibit;
 
-        if (addr == 3 || addr == 4) {
+        if (addr == 3 || addr == 4 || addr == 15 || addr == 16) {
             /* Sortie inactive : la ligne est tirée haut (reset relâché). */
             bool level = (value & OUT_ENABLE) ? !!(ibit & IN_DATA) : true;
             bool prev = (old & OUT_ENABLE) ? !!(old & IN_DATA) : true;
@@ -200,7 +202,7 @@ static void macio_gpio_init(Object *obj)
     MacIOGPIOState *s = MACIO_GPIO(obj);
     int i;
 
-    for (i = 0; i < 10; i++) {
+    for (i = 0; i < 17; i++) {
         sysbus_init_irq(sbd, &s->gpio_extirqs[i]);
     }
 
@@ -229,6 +231,8 @@ static void macio_gpio_reset(DeviceState *dev)
     /* Idem pour les deux lignes candidates du reset du CPU 1 (actives bas) */
     macio_set_gpio(s, 3, true);
     macio_set_gpio(s, 4, true);
+    macio_set_gpio(s, 15, true);
+    macio_set_gpio(s, 16, true);
 }
 
 static void macio_gpio_nmi(NMIState *n, int cpu_index, Error **errp)
diff --git a/hw/ppc/mac_newworld.c b/hw/ppc/mac_newworld.c
index 57072f11d..22e533258 100644
--- a/hw/ppc/mac_newworld.c
+++ b/hw/ppc/mac_newworld.c
@@ -448,6 +448,13 @@ static void ppc_core99_init(MachineState *machine)
         assert(s != NULL);
         sysbus_connect_irq(s, 3, qemu_allocate_irq(cpu_kick, cpus[1], 3));
         sysbus_connect_irq(s, 4, qemu_allocate_irq(cpu_kick, cpus[1], 4));
+        /* ESSAI smp-coeurs : CPU 2 et 3 sur GPIO 15/16 (0x67/0x68, Linux) */
+        if (machine->smp.cpus > 2) {
+            sysbus_connect_irq(s, 15, qemu_allocate_irq(cpu_kick, cpus[2], 15));
+        }
+        if (machine->smp.cpus > 3) {
+            sysbus_connect_irq(s, 16, qemu_allocate_irq(cpu_kick, cpus[3], 16));
+        }
     }
 
     for (i = 0; i < 4; i++) {
@@ -657,7 +664,7 @@ static void core99_machine_class_init(ObjectClass *oc, void *data)
      * Deux cœurs au plus : le MacIO ne porte qu'une ligne de reset pour le
      * cœur secondaire (GPIO 3 / GPIO 4), et le firmware n'en relâche qu'un.
      */
-    mc->max_cpus = 2;
+    mc->max_cpus = 4; /* ESSAI POMPPC smp-coeurs : sonder -smp 3/4 */
     mc->default_boot_order = "cd";
     mc->default_display = "std";
     mc->default_nic = "sungem";
diff --git a/include/hw/misc/macio/gpio.h b/include/hw/misc/macio/gpio.h
index 7d2aa886c..4f6cfeb03 100644
--- a/include/hw/misc/macio/gpio.h
