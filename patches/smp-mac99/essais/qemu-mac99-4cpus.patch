@@ -39,7 +39,7 @@ struct MacIOGPIOState {
     /*< public >*/
 
     MemoryRegion gpiomem;
-    qemu_irq gpio_extirqs[10];
+    qemu_irq gpio_extirqs[17]; /* ESSAI smp-coeurs : 15, 16 = reset CPU 2, 3 */
     uint8_t gpio_levels[8];
     uint8_t gpio_regs[36]; /* XXX Check count */
 };
