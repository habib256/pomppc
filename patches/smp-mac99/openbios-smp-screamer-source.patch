Source of patches/smp-mac99/openbios-smp-screamer.elf (GPL-2.0, OpenBIOS).
Base: https://github.com/mcayland/openbios.git commit e1e703ac0ad615ab0d7edea54db600aaa629bf07
("macio: add awacs/screamer device", Mark Cave-Ayland, 2019-08-22), plus this diff.
Build: ./config/scripts/switch-arch ppc && make (powerpc cross gcc); obj-ppc/openbios-qemu.elf
is byte-identical to openbios-smp-screamer.elf (sha1 f11083a8f54782530be6154dfa56c6a9c3ace97e).

diff --git a/Makefile.target b/Makefile.target
index 4c54105..0ad3da4 100644
--- a/Makefile.target
+++ b/Makefile.target
@@ -25,11 +25,11 @@ NM     := $(TARGET)nm
 STRIP  := $(TARGET)strip
 RANLIB := $(TARGET)ranlib
 
-CFLAGS+= -Os -g -DNATIVE_BITWIDTH_EQUALS_HOST_BITWIDTH -USWAP_ENDIANNESS
+CFLAGS+= -O1 -g -DNATIVE_BITWIDTH_EQUALS_HOST_BITWIDTH -USWAP_ENDIANNESS
 CFLAGS+= -Wall -Wredundant-decls -Wshadow -Wpointer-arith
 CFLAGS+= -Wstrict-prototypes -Wmissing-declarations -Wundef -Wendif-labels
 CFLAGS+= -Wstrict-aliasing -Wwrite-strings -Wmissing-prototypes -Wnested-externs
-CFLAGS+= -Werror
+CFLAGS+= -Werror -Wno-error
 # Flags for dependency generation
 CFLAGS+= -MMD -MP -MT $@ -MF '$(*D)/$(*F).d'
 INCLUDES := -I$(SRCDIR)/include -I$(SRCDIR)/kernel/include -I$(ODIR)/target/include
diff --git a/arch/ppc/qemu/init.c b/arch/ppc/qemu/init.c
