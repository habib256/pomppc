+/*
+ * The compute_fprf + float_check_status pair that every arithmetic floating
+ * point instruction emits, merged into a single helper call.  Strictly the
+ * same effects, in the same order; GETPC() still designates the same guest
+ * instruction, so a deferred exception is still raised with the right return
+ * address.
+ */
+void helper_fprf_check_float64(CPUPPCState *env, float64 arg)
+{
+    helper_compute_fprf_float64(env, arg);
+    do_float_check_status(env, true, GETPC());
+}
