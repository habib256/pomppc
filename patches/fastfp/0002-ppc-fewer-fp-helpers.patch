+/*
+ * Clearing (or priming) the soft-fp exception flags happens before *every*
+ * floating point instruction, so it is emitted inline rather than paid as a
+ * helper call -- which would also force TCG to spill every global first.
+ *
+ * The value to store is the same one helper_reset_fpstatus() computes:
+ *
+ *   (fpscr & (XX|XE|OE|UE)) == XX  ?  env->fp_prime_mask  :  0
+ *
+ * env->fp_prime_mask is float_flag_inexact when the x-fast-fp property is on
+ * and 0 otherwise (it is fixed at reset), so in the default mode this always
+ * stores 0 -- exactly the historical behaviour.  See ppc_fp_primed() in
+ * fpu_helper.c, which is the same expression, evaluated in C.
+ */
 static inline void gen_reset_fpstatus(void)
 {
-    gen_helper_reset_fpstatus(tcg_env);
+    TCGv t = tcg_temp_new();
+    TCGv_i32 v = tcg_temp_new_i32();
+    TCGv_i32 m = tcg_temp_new_i32();
+
+    tcg_gen_andi_tl(t, cpu_fpscr, FP_XX | FP_XE | FP_OE | FP_UE);
+    tcg_gen_setcondi_tl(TCG_COND_EQ, t, t, FP_XX);
+    tcg_gen_trunc_tl_i32(v, t);
+    tcg_gen_neg_i32(v, v);                     /* 0 -> 0, 1 -> all ones */
+    tcg_gen_ld16u_i32(m, tcg_env,
+                      offsetof(CPUPPCState, fp_prime_mask));
+    tcg_gen_and_i32(v, v, m);
+    tcg_gen_st16_i32(v, tcg_env,
+                     offsetof(CPUPPCState, fp_status.float_exception_flags));
 }
 
+/*
+ * compute_fprf then float_check_status: one helper call instead of two.
+ * helper_fprf_check_float64() does exactly the same two things, in the same
+ * order.
+ */
 static inline void gen_compute_fprf_float64(TCGv_i64 arg)
 {
-    gen_helper_compute_fprf_float64(tcg_env, arg);
-    gen_helper_float_check_status(tcg_env);
+    gen_helper_fprf_check_float64(tcg_env, arg);
 }
 
