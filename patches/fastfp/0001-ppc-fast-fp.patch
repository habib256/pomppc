+/*
+ * "Fast floating point" mode (the x-fast-fp CPU property).
+ *
+ * The hardfloat paths of fpu/softfloat.c only run when float_flag_inexact is
+ * already set in float_status: that is how they get away with never reading
+ * the host FPU exception flags.  PowerPC normally defeats this, because
+ * FPSCR[FI] is not sticky and helper_reset_fpstatus() therefore clears the
+ * soft-fp flags before every floating point instruction.
+ *
+ * In fast mode we *prime* fp_status with float_flag_inexact instead of
+ * clearing it, but only once:
+ *
+ *   - FPSCR[XX] (which IS sticky) is already set, so no 0 -> 1 transition of
+ *     XX can be missed -- until then everything runs on soft-fp and XX is
+ *     set exactly, at the first genuinely inexact result;
+ *   - FPSCR[XE] is clear, so no inexact trap can be owed;
+ *   - FPSCR[OE] and FPSCR[UE] are clear, because they make soft-fp re-bias
+ *     overflowed/underflowed results, which the host FPU cannot reproduce
+ *     (can_use_fpu() double-checks this).
+ *
+ * The predicate only reads FPSCR bits that a floating point instruction
+ * never changes between its reset_fpstatus and its float_check_status, so
+ * evaluating it again in do_float_check_status() yields the same answer as
+ * at reset time.
+ */
+static inline bool ppc_fp_primed(CPUPPCState *env)
+{
+    return env->fast_fp &&
+           (env->fpscr & FP_XX) &&
+           !(env->fpscr & (FP_XE | FP_OE | FP_UE));
+}
