+/*
+ * float64r32: the operands are float64, the result is rounded to float32
+ * precision and then stored back as a float64 (PowerPC single precision).
+ *
+ * Whenever every operand happens to be *exactly* a float32 that is zero or
+ * normal, the whole operation is a plain float32 operation: a single
+ * correctly rounded result, which the host FPU produces natively.  Widening
+ * that float32 result back to float64 is exact, so the answer is bit for bit
+ * the one the soft path computes.  Anything else (float64 values with no
+ * float32 equivalent, denormals, infinities, NaNs) is left to soft-fp.
+ */
+static inline bool f64_is_f32_zon(union_float64 a)
+{
+    uint64_t frac = a.s & MAKE_64BIT_MASK(0, 52);
+    int exp = extract64(a.s, 52, 11);
+
+    if (exp == 0) {
+        /* Zero is fine; a float64 denormal is never a float32 normal. */
+        return frac == 0;
+    }
+    /*
+     * The significand must fit in the 23 bits of a float32, and the exponent
+     * must lie in the float32 *normal* range: 0x381 == 1023 - 126 and
+     * 0x47e == 1023 + 127.  This rejects Inf/NaN (exp == 0x7ff) and every
+     * value that would be a float32 denormal.
+     */
+    return (frac & MAKE_64BIT_MASK(0, 29)) == 0 &&
+           exp >= 0x381 && exp <= 0x47e;
+}
+
+/* Both conversions below are exact for the values f64_is_f32_zon() accepts. */
+static inline union_float32 f64_to_f32_exact(union_float64 a)
+{
+    union_float32 r;
+
+    r.h = a.h;
+    return r;
+}
+
+static inline float64 f32_to_f64_exact(union_float32 a)
+{
+    union_float64 r;
+
+    r.h = a.h;
+    return r.s;
+}
+
+typedef float64 (*soft_f64r32_op2_fn)(float64 a, float64 b, float_status *s);
+
+static inline float64
+float64r32_gen2(float64 xa, float64 xb, float_status *s,
+                hard_f32_op2_fn hard, soft_f64r32_op2_fn soft,
+                f32_check_fn pre, f32_check_fn post)
+{
+    union_float64 ua, ub;
+    union_float32 fa, fb, fr;
+
+    ua.s = xa;
+    ub.s = xb;
+
+    if (unlikely(!can_use_fpu(s))) {
+        goto soft;
+    }
+
+    float64_input_flush2(&ua.s, &ub.s, s);
+    if (unlikely(!f64_is_f32_zon(ua) || !f64_is_f32_zon(ub))) {
+        goto soft;
+    }
+    fa = f64_to_f32_exact(ua);
+    fb = f64_to_f32_exact(ub);
+    if (unlikely(!pre(fa, fb))) {
+        goto soft;
+    }
+
+    fr.h = hard(fa.h, fb.h);
+    if (unlikely(f32_is_inf(fr))) {
+        float_raise(float_flag_overflow, s);
+    } else if (unlikely(fabsf(fr.h) <= FLT_MIN) && post(fa, fb)) {
+        goto soft;
+    }
+    return f32_to_f64_exact(fr);
+
+ soft:
+    return soft(ua.s, ub.s, s);
+}
+
