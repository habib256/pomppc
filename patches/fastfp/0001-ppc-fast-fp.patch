+float64 QEMU_FLATTEN
+float64r32_muladd(float64 xa, float64 xb, float64 xc, int flags,
+                  float_status *s)
+{
+    union_float64 ua, ub, uc;
+    union_float32 fa, fb, fc, fr;
+
+    ua.s = xa;
+    ub.s = xb;
+    uc.s = xc;
+
+    if (unlikely(!can_use_fpu(s))) {
+        goto soft;
+    }
+    if (unlikely(flags & float_muladd_halve_result)) {
+        goto soft;
+    }
+
+    float64_input_flush3(&ua.s, &ub.s, &uc.s, s);
+    if (unlikely(!f64_is_f32_zon(ua) ||
+                 !f64_is_f32_zon(ub) ||
+                 !f64_is_f32_zon(uc))) {
+        goto soft;
+    }
+    if (unlikely(force_soft_fma)) {
+        goto soft;
+    }
+
+    /*
+     * The three operands are exact float32 values, so a*b + c rounded once
+     * to float32 is exactly what fmaf() computes.  ua/ub/uc are left
+     * untouched: the negations below apply to the float32 copies only, so
+     * the soft path can still be taken afterwards.
+     */
+    fa = f64_to_f32_exact(ua);
+    fb = f64_to_f32_exact(ub);
+    fc = f64_to_f32_exact(uc);
+
+    /*
+     * When (a || b) == 0, there's no need to check for under/over flow,
+     * since we know the addend is (normal || 0) and the product is 0.
+     */
+    if (float32_is_zero(fa.s) || float32_is_zero(fb.s)) {
+        union_float32 up;
+        bool prod_sign;
+
+        prod_sign = float32_is_neg(fa.s) ^ float32_is_neg(fb.s);
+        prod_sign ^= !!(flags & float_muladd_negate_product);
+        up.s = float32_set_sign(float32_zero, prod_sign);
+
+        if (flags & float_muladd_negate_c) {
+            fc.h = -fc.h;
+        }
+        fr.h = up.h + fc.h;
+    } else {
+        if (flags & float_muladd_negate_product) {
+            fa.h = -fa.h;
+        }
+        if (flags & float_muladd_negate_c) {
+            fc.h = -fc.h;
+        }
+
+        fr.h = fmaf(fa.h, fb.h, fc.h);
+
+        if (unlikely(f32_is_inf(fr))) {
+            float_raise(float_flag_overflow, s);
+        } else if (unlikely(fabsf(fr.h) <= FLT_MIN)) {
+            goto soft;
+        }
+    }
+    if (flags & float_muladd_negate_result) {
+        fr.s = float32_chs(fr.s);
+    }
+    return f32_to_f64_exact(fr);
+
+ soft:
+    return soft_f64r32_muladd(ua.s, ub.s, uc.s, flags, s);
+}
