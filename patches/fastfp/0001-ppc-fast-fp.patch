+                  float_status *s)
+{
+    union_float64 ua, ub, uc;
+    union_float32 fa, fb, fc, fr;
+
+    ua.s = xa;
+    ub.s = xb;
+    uc.s = xc;
+
+    if (unlikely(!can_use_fpu(s))) {
+        goto soft;
+    }
