diff --git a/hw/display/Kconfig b/hw/display/Kconfig
index 1b02fa0..3c1a2e4 100644
--- a/hw/display/Kconfig
+++ b/hw/display/Kconfig
@@ -145,3 +145,8 @@ config QFB_PCI
     bool
     default y if PCI_DEVICES
     depends on PCI
+
+config QGPU_PCI
+    bool
+    default y if PCI_DEVICES
+    depends on PCI
diff --git a/hw/display/meson.build b/hw/display/meson.build
index 7235958..8b1f0c2 100644
--- a/hw/display/meson.build
+++ b/hw/display/meson.build
@@ -141,6 +141,20 @@ if config_all_devices.has_key('CONFIG_VIRTIO_VGA')
 endif
 
 system_ss.add(when: 'CONFIG_QFB_PCI', if_true: files('qfb-pci.c'))
+# qgpu : le transport (device), le cœur et le backend logiciel sont toujours
+# compilés ; le backend OpenGL l'est aussi, et retombe sur un stub si l'hôte
+# n'a ni OpenGL.framework (macOS) ni EGL+GL (Linux) — cf. qgpu-gl.c.
+qgpu_ss = ss.source_set()
+qgpu_ss.add(files('qgpu-pci.c', 'qgpu-core.c', 'qgpu-soft.c', 'qgpu-gl.c'))
+if host_os == 'darwin'
+  qgpu_ss.add(dependency('appleframeworks', modules: ['OpenGL']))
+else
+  qgpu_egl = dependency('egl', required: false)
+  qgpu_gl = dependency('gl', required: false)
+  qgpu_ss.add(when: [qgpu_egl, qgpu_gl], if_true: [qgpu_egl, qgpu_gl])
+endif
+system_ss.add_all(when: 'CONFIG_QGPU_PCI', if_true: qgpu_ss)
+
 system_ss.add(when: 'CONFIG_OMAP', if_true: files('omap_lcdc.c'))
 
 modules += { 'hw-display': hw_display_modules }
