+/* ------------------------------------------------------------------------
+ * POMPPC — diagnostic des saccades (29/09). SCREAMER_DIAG=<fichier> : une
+ * ligne par seconde (compteurs) et des lignes EVT horodatées. Horloge murale
+ * en ms (corrélation avec l'invité) ; intervalles sur l'horloge monotone.
+ * ---------------------------------------------------------------------- */
+static struct {
+    FILE *f;
+    bool init;
+    int64_t t_rep, t_cb, t_tx;
+    uint64_t cb_n, sil_frames, sil_ev, pulls, dma_bytes, dma_cmds, zero_frames,
+             zero_gaps, stale, cmds_seen;
+    int64_t cb_maxgap, tx_maxgap;
+    int ring_min, ring_max, freeb_max;
+    /* suite de trames nulles de l'invité en cours, et avons-nous déjà eu du son */
+    uint64_t zrun;
+    bool heard;
+    int16_t pl, pr;
+    uint64_t fc_reads, cp_reads, zpos_logs, dma_total;
+    uint32_t cmd_min;
+    hwaddr cmd_addr0;
+    int64_t pos0;
+    FILE *wav;
+    bool sil_prev;
+    int64_t pcm_t0;
+    uint64_t sauts;
+    double energie;
+    /* empreinte de la commande DBDMA en cours */
+    uint32_t h, hcmd;
+    bool hnz;
+    struct { uint32_t cmd, h; } tab[4096];
+    uint64_t ca_calls, ca_empty, ca_empty_frames, q_n;
+    int64_t q_ns;
+} dg;
+
+static int64_t dg_wall_ms(void)
+{
+    return g_get_real_time() / 1000;
+}
+
+static bool dg_on(void)
+{
+    if (!dg.init) {
+        const char *p = getenv("SCREAMER_DIAG");
+
+        dg.init = true;
+        if (p && *p) {
+            dg.f = fopen(p, "a");
+            if (dg.f) {
+                setvbuf(dg.f, NULL, _IOLBF, 0);
+                fprintf(dg.f, "# %" PRId64 " début du diagnostic Screamer\n",
+                        dg_wall_ms());
+                p = getenv("SCREAMER_PCM");
+                if (p && *p) {
+                    dg.wav = fopen(p, "ab");
+                }
+            }
+        }
+        dg.ring_min = INT_MAX;
+        dg.t_rep = get_clock();
+    }
+    return dg.f != NULL;
+}
+
+static void dg_scan(const uint8_t *p, int frames)
+{
+    const uint32_t *w = (const uint32_t *)p;
+    int i;
+
+    for (i = 0; i < frames; i++) {
+        uint32_t v = w[i];
+
+        int16_t l = (int16_t)((p[4 * i] << 8) | p[4 * i + 1]);
+        int16_t r = (int16_t)((p[4 * i + 2] << 8) | p[4 * i + 3]);
+
+        if (abs(l - dg.pl) > 12000 || abs(r - dg.pr) > 12000) {
+            dg.sauts++;
+        }
+        dg.energie += (double)l * l + (double)r * r;
+        dg.pl = l;
+        dg.pr = r;
+        dg.h = (dg.h ^ v) * 16777619u;
+        if (v == 0) {
+            dg.zero_frames++;
+            dg.zrun++;
+        } else {
+            dg.hnz = true;
+            if (dg.zrun >= 441 && dg.heard && dg.zpos_logs < 4000) {
+                dg.zpos_logs++;
+                fprintf(dg.f, "ZPOS %" PRId64 " fin=%" PRId64 " long=%" PRIu64 "\n",
+                        dg_wall_ms(), dg.pos0 + i, dg.zrun);
+            }
+            if (dg.zrun >= 441 && dg.heard) {
+                dg.zero_gaps++;
+                fprintf(dg.f, "EVT %" PRId64 " trou_invite %.1f ms de zéros\n",
+                        dg_wall_ms(), dg.zrun * 1000.0 / 44100);
+            }
+            dg.zrun = 0;
+            dg.heard = true;
+        }
+    }
+}
+
+static void dg_cmd_begin(uint32_t cmd, hwaddr addr, int len)
+{
+    if (!dg_on()) {
+        return;
+    }
+    dg.h = 2166136261u;
+    dg.hcmd = cmd;
+    dg.cmd_addr0 = addr;
+    if (!dg.cmd_min || cmd < dg.cmd_min) {
+        dg.cmd_min = cmd;
+    }
+    dg.hnz = false;
+    if (dg.cmds_seen < 64) {
+        fprintf(dg.f, "CMD %" PRId64 " cmdptr=0x%x addr=0x%" HWADDR_PRIx
+                " len=%d\n", dg_wall_ms(), cmd, addr, len);
+    }
+    dg.cmds_seen++;
+}
+
+static void dg_cmd_end(void)
+{
+    unsigned k = (dg.hcmd >> 4) & 4095;
+
+    dg.dma_cmds++;
+    if (dg.hnz && dg.tab[k].cmd == dg.hcmd && dg.tab[k].h == dg.h) {
+        dg.stale++;
+    }
+    dg.tab[k].cmd = dg.hcmd;
+    dg.tab[k].h = dg.h;
+}
+
+static void dg_report(ScreamerState *s)
+{
+    int64_t now = get_clock();
+    uint64_t c, e, ef, qn;
+    int64_t qns;
+
+    if (now - dg.t_rep < 1000000000LL) {
+        return;
+    }
+    c = qatomic_read(&audio_diag_ca_calls);
+    e = qatomic_read(&audio_diag_ca_empty);
+    ef = qatomic_read(&audio_diag_ca_empty_frames);
+    qn = qgpu_diag_sync_n;
+    qns = qgpu_diag_sync_ns;
+    fprintf(dg.f, "SEC %" PRId64 " rate=%u cb=%" PRIu64 " cbgap_max=%.1f "
+            "tick_max=%.1f ring=%d..%d freeb_max=%d sil=%" PRIu64 "/%" PRIu64
+            " pulls=%" PRIu64 " dma_Bps=%" PRIu64 " cmds=%" PRIu64
+            " txgap_max=%.1f zero=%" PRIu64 " trous=%" PRIu64 " perimes=%" PRIu64
+            " ca=%" PRIu64 " ca_vide=%" PRIu64 " ca_minpend=%" PRId64
+            " ca_frames=%u qsync=%" PRIu64 " qsync_ms=%.1f qsync_max=%.1f"
+            " sauts=%" PRIu64 " rms=%.0f lect_fc=%" PRIu64 " lect_cmdptr=%" PRIu64 "\n",
+            dg_wall_ms(), s->rate, dg.cb_n, dg.cb_maxgap / 1e6,
+            audio_diag_timer_maxgap_ns / 1e6,
+            dg.ring_min == INT_MAX ? -1 : dg.ring_min, dg.ring_max, dg.freeb_max,
+            dg.sil_frames, dg.sil_ev, dg.pulls,
+            dg.dma_bytes * 1000000000ULL / (uint64_t)(now - dg.t_rep), dg.dma_cmds,
+            dg.tx_maxgap / 1e6, dg.zero_frames, dg.zero_gaps, dg.stale,
+            c - dg.ca_calls, e - dg.ca_empty,
+            audio_diag_ca_minpend == INT64_MAX ? -1 : audio_diag_ca_minpend,
+            audio_diag_ca_frames, qn - dg.q_n, (qns - dg.q_ns) / 1e6,
+            qgpu_diag_sync_max_ns / 1e6, dg.sauts,
+            dg.dma_bytes ? sqrt(dg.energie / (dg.dma_bytes / 2)) : 0.0,
+            dg.fc_reads, dbdma_diag_cmdptr_reads[s->dma_tx_ch & 31] - dg.cp_reads);
+    dg.cp_reads = dbdma_diag_cmdptr_reads[s->dma_tx_ch & 31];
+    dg.fc_reads = 0;
+    if (e != dg.ca_empty) {
+        fprintf(dg.f, "EVT %" PRId64 " hote_vide %" PRIu64 " appels (%" PRIu64
+                " trames muettes)\n", dg_wall_ms(), e - dg.ca_empty,
+                ef - dg.ca_empty_frames);
+    }
+    dg.ca_calls = c;
+    dg.ca_empty = e;
+    dg.ca_empty_frames = ef;
+    dg.q_n = qn;
+    dg.q_ns = qns;
+    qgpu_diag_sync_max_ns = 0;
+    audio_diag_ca_minpend = INT64_MAX;
+    audio_diag_timer_maxgap_ns = 0;
+    dg.t_rep = now;
+    dg.cb_n = dg.sil_frames = dg.sil_ev = dg.pulls = dg.dma_bytes = 0;
+    dg.dma_cmds = dg.zero_frames = dg.zero_gaps = dg.stale = 0;
+    dg.sauts = 0;
+    dg.energie = 0;
+    dg.cb_maxgap = dg.tx_maxgap = 0;
+    dg.ring_min = INT_MAX;
+    dg.ring_max = 0;
+    dg.freeb_max = 0;
+}
