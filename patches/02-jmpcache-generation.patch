diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index bb424c8..2ed23b7 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -9,19 +9,26 @@
 #ifndef ACCEL_TCG_TB_JMP_CACHE_H
 #define ACCEL_TCG_TB_JMP_CACHE_H
 
-#define TB_JMP_CACHE_BITS 12
+#define TB_JMP_CACHE_BITS 14
 #define TB_JMP_CACHE_SIZE (1 << TB_JMP_CACHE_BITS)
 
 /*
  * Accessed in parallel; all accesses to 'tb' must be atomic.
  * For CF_PCREL, accesses to 'pc' must be protected by a
  * load_acquire/store_release to 'tb'.
+ *
+ * Invalidation par génération: un flush lié à un changement de contexte (TLB)
+ * n'efface plus les entrées une par une (O(N)), il incrémente 'cur_gen' (O(1)).
+ * Une entrée n'est valide que si son 'gen' vaut 'cur_gen'. 'gen' et 'cur_gen'
+ * ne sont écrits que par le thread du CPU propriétaire.
  */
 struct CPUJumpCache {
     struct rcu_head rcu;
+    uint32_t cur_gen;
     struct {
         TranslationBlock *tb;
         vaddr pc;
+        uint32_t gen;
     } array[TB_JMP_CACHE_SIZE];
 };
 
diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
index c1708af..86028d1 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -671,3 +671,25 @@ void tcg_flush_jmp_cache(CPUState *cpu)
         qatomic_set(&jc->array[i].tb, NULL);
     }
 }
+
+/*
+ * Invalidation O(1) du jmp cache pour un changement de contexte (flush TLB).
+ * On incrémente la génération: les entrées d'une génération antérieure sont
+ * ignorées au lookup. À réserver aux flushs qui NE libèrent PAS de TB
+ * (les libérations passent par tcg_flush_jmp_cache, qui efface réellement).
+ * Débordement 32 bits (~très rare): on retombe sur un effacement complet.
+ */
+void tcg_bump_jmp_cache_gen(CPUState *cpu)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+
+    if (unlikely(jc == NULL)) {
+        return;
+    }
+    if (unlikely(++jc->cur_gen == 0)) {
+        for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+            qatomic_set(&jc->array[i].tb, NULL);
+        }
+        jc->cur_gen = 1;
+    }
+}
