POMPPC tcg/0067 : attente courte precise seulement au repos des vCPU

[D] QEMU v11.1.2, all_cpu_threads_idle sous BQL dans qemu_main_loop.
Mode POMPPC_POLL_NS=3 : sous 1 ms, select precis seulement lorsque tous
les vCPU sont inactifs ; sinon g_poll. Etat local au fil, les autres
boucles d'E/S ne deviennent pas precises. Modes 0/1/2 conserves.
Initialisation du mode par g_once, sans course entre fils.
[F] Hypothese generique de cadence : a mesurer sur les cinq jeux.
Aucun allumage par defaut, aucune modification du noyau ni des horloges.

--- a/util/qemu-timer.c
+++ b/util/qemu-timer.c
@@ -332,22 +332,28 @@
  * ERR, comme glib).  Repli sur g_poll (-2) si un descripteur dépasse
  * FD_SETSIZE.
  */
+/* POMPPC tcg/0067: only the main system loop declares its idle state.
+ * Other poll threads default to the coarse path in adaptive mode. */
+static __thread bool pollns_cpus_idle;
+
 static bool qemu_poll_ns_select_on(int64_t timeout)
 {
-    static int mode = -1;
-
-    if (mode < 0) {
+    static gsize mode_once;
+
+    if (g_once_init_enter(&mode_once)) {
         const char *e = getenv("POMPPC_POLL_NS");
-        mode = e && *e && strcmp(e, "0") ? 1 : 0;
-        if (e && !strcmp(e, "2")) {
-            mode = 2;
-        }
-    }
-    /* POMPPC tcg/0065 : mode 2, seulement les delais sous 1 ms.
-     * [F] Hypothese a mesurer sur les cinq jeux : garder l'arrondi de
-     * g_poll pour les delais longs eviterait la perte d'UT du mode 1.
-     * Aucun mode n'est actif sans POMPPC_POLL_NS. */
-    return mode == 1 || (mode == 2 && timeout < SCALE_MS);
+        unsigned mode = e && *e && strcmp(e, "0") ? 1 : 0;
+        if (e && (!strcmp(e, "2") || !strcmp(e, "3"))) {
+            mode = e[0] - '0';
+        }
+        g_once_init_leave(&mode_once, mode + 1);
+    }
+    unsigned mode = mode_once - 1;
+    /* [F] Generic scheduling hypothesis: precise wakeups while all vCPUs
+     * are idle; preserve the coarse path while they execute. Must pass
+     * the five-game A/B before enabling. No guest-PC or clock shortcut. */
+    return mode == 1 || (timeout < SCALE_MS &&
+                        (mode == 2 || (mode == 3 && pollns_cpus_idle)));
 }
 
